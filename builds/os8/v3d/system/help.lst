     000036  0000  
     000037  0000  
     000040  0000  
     000041  0000  
  72 000042  0000  TXTNAM, ZBLOCK 10 /CURRENT SCRIPT FILE NAME BEING LOOKED AT
     000043  0000  
     000044  0000  
     000045  0000  
     000046  0000  
     000047  0000  
     000050  0000  
     000051  0000  
  73 000052  0000  NAMCNT, 0       /NUMBER OF NAMES IN THE COMMAND DECODER AREA
  74 000053  0000  BLKCNT, 0       /NUMBER OF AVAILABLE BLOCKS ON OUTPUT
  75 000054  0000  OUTADR, 0       /ADDRESS OF OUTPUT HANDLER
  76 000055  0000  LINCNT, 0       /COUNT OF NUMBER OF NAMES ON '*' OR 'HELP' LINE
  77 000056  7773  LINMAX, -5      /MAXIMUN NUMBER OF NAMES/LINE ON '*' OR 'HELP' LINE
  78 000057  0000  FILNAM, ZBLOCK  4 /OUTPUT FILE NAME
