$JOB
/BLDRL2.BI

.R R2VRFY
.AS RKA0 SRCE



/Get an unused copy of BUILD.SV so that $BUILD command will work
.DEL BUILDZ.SV
.COP BUILDZ.SV<BUILDV.SV

.RU SYS:BUILDZ

LO SRCE:BATV4
LO SRCE:LPTSER
LO SRCE:TTYSER
LO SRCE:RL20AB
LO SRCE:RL20CD
LO SRCE:RL201E
LO SRCE:RL21AB
LO SRCE:RL21CD
LO SRCE:R2SYV4

IN BAT,BAT
IN LPTS,LPT
IN TTYS,TTY
IN R0AB,R20A,R20B
IN R0CD,R20C,R20D
IN R1AB,R21A,R21B
IN R1CD,R21C,R21D
IN R01E,R20E,R21E
IN R2SY,SYS

DSK=SYS

BUILD
SRCE:OS8V4
SRCE:CDV4
/REBOOT THE MASTER, THEN SUBMIT RL2FIN.BI
BOOT

$END

