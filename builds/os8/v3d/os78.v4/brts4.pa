	SUBVSF=	0	/SUBVERSION OF STRING FUNCTIONS OVERLAY
	SUBVEF=	0	/SUBVERSION OF BASIC ERROR MESSAGE OVERLAY
	SUBVFF=	0	/SUBVERSION OF FILE FUNCTIONS OVERLAY
