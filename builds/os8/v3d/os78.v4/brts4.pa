	CIA
	TAD I	IOBLK1
	SNA CLA		/SKP IF NOT THERE
	JMP	GOTBLK	/OTHERWISE WE HAVE IT NOW
	CIF
	JMS I	(CALLF0	/WRITE CURRENT BLOCK IF DIRTY
	WRBLK
	CIF
	JMS I	(CALLF0	/NOW INIT BLOCK (TO RESET DIRTY BIT)
	BLINIT
	CDF
	TAD	PRODL	/POINT AT THE BLOCK NOW
