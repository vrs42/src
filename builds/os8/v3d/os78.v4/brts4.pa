	DCA I	IOBLK1
	TAD	(210	/NOW CALL THE DRIVER TO READ THE BLOCK
	CIF
	JMS I	(CALLF0
	DRCALL
	CDF
GOTBLK,	TAD	PRODH	/GET READY TO CALCULATE BYTE POINTERS
