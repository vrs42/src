	DCA	PRODH
	TAD	(3	/DIVIDE BY 3 FOR BYTE POINTER
	JMS I	(DIV23
	TAD	PRODH	/REMAINDER = 3/2 STATE
	RTR
	CLA		/GET 2 BIT, INDICATING 3RD CHAR IN GRP
	TAD I	IOHDR1	/SET THE ODD BIT IF NECESSARY
	AND	(7777-200
