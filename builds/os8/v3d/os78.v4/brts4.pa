INTERB,	ZBLOCK	7
FPPTM5,	ZBLOCK	3
FPPTM4,	ZBLOCK	3
FPPTM3,	ZBLOCK	3
NUMBUF,
FPPTM2,	ZBLOCK	3
FPPTM1,	ZBLOCK	3

