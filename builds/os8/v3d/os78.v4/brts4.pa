DRFUN,	0		/FUNCTION CONTROL WORD
DRBUF,	0		/BUFFER ADDRESS
DRBLK,	0		/BLOCK #
	SMA CLA		/DEVICE ERROR-IS IT FATAL?
	JMP I	DRCALL	/ALLS WELL
DE,	JMS I	[ERROR	/FATAL
DRIVER,	0

