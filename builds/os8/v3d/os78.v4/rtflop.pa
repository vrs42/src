	4000		/TERMINATOR.

OPTLST, -"Z;RTZERO;NOIO		/COMMAND DECODER OPTION TABLE.
	-"D;DELETE;OUTRT	/FORMAT: NEGATIVE OPTION CHARACTER;
	-"W;WRTRT;OUTRT+INOS	/ADDRESS OF ROUTINE TO DO; OPTFLG SETTING
	-"R;RDRT;OUTOS+INRT
	-"L;DIR;OUTOS+DIRIO
	0			/TERMINATOR.

UNUSED, "<;"U;"N;"U;"S;"E;"D;">;" ;" ;" 
NODATE, "N;"O;" ;"D;"A;"T;"E;" ;" ;" 

NAMBUF, ZBLOCK 12	/FILENAME BUFFER
NAME,	ZBLOCK 4	/NAME BUFFERS
