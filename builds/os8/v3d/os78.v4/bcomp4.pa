	TAD	(ONPFX	/EMIT ON PREFIX OPCODE
	JMS I	QOUTWRD
	JMS I	QSAVECP	/SAVE SCAN POINTER
	JMS I	QCHKWD	/SEE IF GOSUB
	WGOSUB
	SKP		/SKP IF NO
	JMP	ONGOSU	/JMP IF YES
	JMS I	QRESTCP	/RESET SCAN POINTER
	JMS I	QCHKWD	/SEE IF GOTO
	WGOTO
	JMP	ONSNTX	/JMP IF NEITHER
	IAC		/JUMP = GOSUB+1
ONGOSUB,TAD	(JSUB
	DCA	ONTEMP	/SAVE THE BRANCH OPCODE
ONLUP,	JMS I	QSNUM	/GET A LINE NUMBER
	JMP	ONSNTX	/SYNTAX ERROR IF NONE
