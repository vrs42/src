	/ROUTINE TO CONVERT ARITHMETIC OPCODES TO
	/STRING ARITHMETIC PREFIX AND OPCODE
	/CALLED IF TYPE OF OPERAND IS STRING

SARCVT,	0
	TAD I	SARCVT	/PICK UP ADDR OF SKELETON IN CALL+1
	ISZ	SARCVT
	DCA	SARCAS	/STORE POINTER TO IT
	TAD I	SARCVT	/NOW GET POINTER TO SYMBOL
