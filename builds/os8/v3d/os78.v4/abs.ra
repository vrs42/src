	SECT	IABS
	ENTRY	ABS
	BASE	0
ABS,	FLDA	0		/GET RETURN ADDRESS
	STARTD
	FSTA	RETRN
	FADD	TWO		/GET ADDRESS OF ARG POINTER
	FSTA	3
	FLDA%	3		/GET ARG ADDRESS
	FSTA	3
	STARTF
	FLDA%	3		/GET ARG
	JGE	RETRN		/POSITIVE, SKIP NEGATE
	FNEG
RETRN,	0;0
TWO,	0;2
	END

