$JOB BASGEN.BI  ASSEMBLE AND SAVE BASIC VERSION 4 FOR OS78 V4

.AS C SRCE

.PAL SRCE:BCOMP4(EW)
.LOAD BCOMP4
.SAVE SYS:BCOMP.V4=2100

.PAL SRCE:BLOAD4(EW)
.LOAD BLOAD4
.SAVE SYS BLOAD.V4;3000=2100

.PAL SRCE:BMATH4
.PAL SRCE:BRTS4(WEK)
.LOAD BRTS4,BMATH4
.SAVE SYS BRTS.V4 0-6177,10000-15377;7605=2100
.SAVE SYS BASIC.OV 3400-4777,22000-26377,33400-34777;7605

.PAL SRCE:BASIC4
.LOAD BASIC4
.SAVE SYS BASIC.V4=2100

$END

