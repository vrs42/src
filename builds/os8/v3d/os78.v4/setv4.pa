	CCLBLK=67

	//PATCH THE CCL COMMAND TABLE TO ALLOW "BACKSPACE" IF OS/8;
	//OR "TERMINATE" IF OS/78 OR OS/278. IF "NO" IS ZERO, MEANS
	//78 OR 278.

FIXCCL,	0
	JMS I [SHNDLR	//READ IN CCL COMMAND TABLE
	200
	AUXBUF
