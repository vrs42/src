	JMP I KEYSRCH

/SET BAUD RATE FOR THE SERIAL PRINTER PORT OF THE VT278

	/INPUT=BAUD RATE	INPUT=BAUD RATE
	/  0  =     50		  8  =  1800
	/  1  =     75		  9  =  2000
	/  2  =    110		 10  =  2400
	/  3  =    134.5	 11  =  3600
	/  4  =    150		 12  =  4800
	/  5  =    300		 13  =  7200
	/  6  =    600		 14  =  9600
	/  7  =   1200		 15  = 19200

STBAUD,	0
	JMS I [GETWID		/USING GETWID ROUTINE, SAVES SOME DOUBLE CODING
	TAD NUM
	AND [7760		/CAN'T BE GREATER THAN 17 OCTAL
	SZA CLA
	JMP I [NUMBIG
	TAD I (7203		/MAKE SURE IT'S A SERIAL HANDLER
	TAD (-2423
	SZA CLA
	JMP I [NOTSER		/SORRY, WRONG ONE
	TAD NUM
	DCA I (7204
	JMP I STBAUD


