	*3000

SRNT,	0
	TAD I (PDNT		/GET POINTER TO TABLE
	DCA INFOT
	TAD I INFOT
	DCA INFOT		/NOW CONTAINS TABLE START
SRLOOP,	TAD I INFOT		/GET TABLE ENTRY
	JMS I (TSTTBL		/GET CORR. HANDLER NAME...
	ISZ INFOT
	ISZ INCNT		/ARE WE THRU TABLE?
	JMP SRLOOP		/
	JMP I SRNT

SETFND,	IAC
	TAD I (PTNAM		/BUMP POINTER AND STORE
	DCA NPTNAM
	TAD I NPTNAM		/ACCESS	JMS INF0
	ISZ PRPNT		//BUMP POINTER
	DCA I PRPNT		/STORE IN FOR PRINTING
	ISZ PRPNT		/ADVANCE TO NEXT SPOT
	JMP I (RESTPR		/RETURN TO RESTORE TABLE POINTER
	
RXTST,	0		//TEST TO SEE IF RXA2,3 GROUP
	TAD I (PTNAM
	DCA RXOFST		/TEMPORARILY STORE POINTER
	TAD I RXOFST
	TAD (6412		/IS STORED NAME RXA2?
	SZA CLA
	JMP I (LPTCHK		/IF NOT, SEE IF LPT FOR SERIAL OR PARALLEL
	TAD RXCNTR		/SEE IF THIS IS SECOND TIME THRU...
	TAD (400		/IF FIRST SHOULD BE 400
	SZA CLA
	JMP SETFND		/IF SO, PROCESS NAME
	TAD 36			/ADD IN THE POINTER TO THE PDNT
	CIA
	TAD INFOT		/SUBTRACT FROM POINTER TO RXA2
	DCA RXOFST
	TAD 37
	TAD RXOFST		/ADD IN OFFSET
	DCA RXOFST		/STORE POINTER TO DHIT INFO
	TAD I RXOFST
	AND (3600		/ISOLATE BLOCK OF STORAGE
	CLL RAR
	BSW			/RESITUATE IT
	TAD (15
	DCA READBK
	CIF 0
	JMS I (SHNDLR
	0210
RXBUF,	RXBUFF
READBK,	0
	JMP I (F1ERR		/ERROR RETURN
RXCONT,	TAD I RXBUF		/ISOLATE RELEVANT BITS
	AND (7770		/TO TEST FOR RX28C IOT
	TAD (-6760		/IS IT THE WANTED IOT?
	SNA CLA
	JMP I RXTST		/IF SO, RETURN TO SEARCH FOR PROPER HEADING
	ISZ RXBUF
	ISZ RXCNTR		/ARE WE DONE?
	JMP RXCONT
	JMP SETFND		/IF WE DIDN'T FIND IOT PROCESS RX78C


PRLIS,	0		//THIS ROUTINE ALLOWS US TO PRINT LIST
			//IT IS FILLED BY SETFND...
