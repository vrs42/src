	//ROUTINE TO PATCH LOCATIONS. BLOCK OF MODULE TO BE PATCHED HAS
	//BEEN READ INTO AUXBUF. ENTER WITH POINTER TO TABLE TO USE.
	//TABLE IS ARRANGED: RELATIVE LOCATION; "YES" VALUE; "NO" VALUE.

FIXUP,	0
	DCA FIXPTR
FIXLUP,	TAD I FIXPTR
	SNA
	JMP I FIXUP
	DCA FIXLOC
	ISZ FIXPTR
	TAD NO		//"NO"=1; "YES"=0.
	SZA CLA
	ISZ FIXPTR
	TAD I FIXPTR
	DCA I FIXLOC
	TAD NO
	SNA CLA
	ISZ FIXPTR
	ISZ FIXPTR
	JMP FIXLUP

FIXPTR,	0
FIXLOC,	0

