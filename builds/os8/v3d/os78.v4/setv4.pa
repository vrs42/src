	JMP I (OLDCCL	//WRONG VERSION
	TAD (CCLTBL
	JMS I (FIXUP	//WITH POINTER TO PATCHES TO USE.
	JMS I [SHNDLR
	4200
	AUXBUF
	CCLBLK		//WHEN DONE, WRITE IT BACK OUT.
	JMP I [SYSERR
	JMP I FIXCCL

