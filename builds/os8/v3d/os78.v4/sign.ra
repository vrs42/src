/
/ VERSION 5A 4-27-77  PT
/
	SECT	SIGN
	ENTRY	ISIGN
	JA	#ST
#XR,	ORG	.+10
	TEXT	'SIGN  '
#BASE,	ORG	.+3
A,	ORG	.+3
B,	ORG	.+3
	ORG	#BASE+31
	JA	#BASE
GOBACK,	0;0;0
	BASE	#BASE
ISIGN,
#ST,	STARTD
	0210
	FSTA	GOBACK+1,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FLDA%	#BASE,1+
	FSTA	A
	FLDA%	#BASE,1+
	FSTA	B
	STARTF
	FLDA%	B
	JLT	#50
	FLDA%	A
	JLT	#100
	JA	GOBACK+1
#50,	FLDA%	A
	JLT	GOBACK+1
#100,	FNEG
	JA	GOBACK+1
	END

