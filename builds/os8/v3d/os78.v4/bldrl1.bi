$JOB
/BLDRL1.BI

.R R1VRFY
.AS RKA0 SRCE



/Get an unused copy of BUILD.SV so that $BUILD command will work
.DEL BUILDZ.SV
.COP BUILDZ.SV<BUILDV.SV

.RU SYS:BUILDZ

LO SRCE:BATV4
LO SRCE:LPSV
LO SRCE:TTYSER
LO SRCE:RL0
LO SRCE:RL1
LO SRCE:RLC
LO SRCE:RXNSV4
LO SRCE:RX28C
LO SRCE:RLSYV4

IN BAT,BAT
IN LPSV,LPT
IN TTYS,TTY
IN RL0,RL0A,RL0B
IN RL1,RL1A,RL1B
IN RLC,RL0C,RL1C
IN RX02,RXA0-1
IN RX0B,RXA2-3
IN RLSY,SYS

DSK=SYS

BUILD
SRCE:OS8V4
SRCE:CDV4
BOOT

$END

