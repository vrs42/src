	A10=10		/AUTO INDEX REGISTER FOR USE HERE.

START0,	CLA CLL		/TRADITIONAL.
	KCF
	KSF
	JMP START3	/NOT 278 CPU; JUST PUT UP ID.
	TAD (ZAP-1
	JMS START1	/CLEAR & RESET TO USASCII
	TAD (LOGO-1
	JMS START1	/PRINT THE LOGO
	TAD (RESET-1
	JMS START1	/RESET ONCE MORE
	JMP I (7605	/BEFORE EXITING.

START1,	0
	DCA A10
START2,	TAD I A10
	SNA
	JMP I START1	/FINISHED WITH THIS MESSAGE.
	TLS
	TSF
	JMP .-1
	CLA
	JMP START2	/UNTIL DONE.

START3,	CDF 10
	TAD I (7726	/WHERE SCOPBIT LIVES
	CDF 0
	AND (200
	SNA CLA
	JMP START4	/HARD COPY CONSOLE
	TAD (VT52-1
	JMS START1	/CLEAR SCREEN FOR VT52 TYPES
START4,	DCA I (OSTERM
	TAD (CRLF-1
	JMS START1
	TAD (OSONLY-1
	JMS START1
	TAD (CRLF-1
	JMS START1
	JMP I (7605

CRLF,	215;212;0
ZAP,	33;"[;"H	/CURSOR HOME 
	33;"[;"J	/CLEAR THE SCREEN
RESET,	33;"(;"B	/G0 SET
	33;");"B	/G1 SET
	33;"[;"m	/NO CHARACTER ATTRIBUTES.
	0
	PAGE

			/CURSOR LINE 8 COL 25
LOGO,	33;"[;"8;";;"3;"1;"H
	33;");"0	/G1 GRAPHICS
	/33;"[;"7;"m	/REVERSE VIDEO
			/LINE 1
	/     D           I           G           I          T
	16;"l;"q;"w;"q;"w;"q;"w;"q;"w;"q;"w;"q;"w;"q;"k
	33;"[;"9;";;"3;"1;"H
			/LINE 2
	"x;17;"d;16
	"x;17;"i;16
	"x;17;"g;16
	"x;17;"i;16
	"x;17;"t;16
	"x;17;"a;16
	"x;17;"l;16;"x
	33;"[;"1;"0;";;"3;"1;"H
			/LINE 3
	16;"m;"q;"v;"q;"v;"q;"v;"q;"v;"q;"v;"q;"v;"q;"j
			/LINE 4
	33;"[;"1;"1;";;"3;"1;"H
OSONLY,	17;"O;"S;"/;"7;"8;" ;"V;"e;"r;"s;"i;"o;"n;" ;"4
OSTERM,	33;"[;"1;"7;"H
	0
VT52,	33;"H;33;"J;0

