$JOB  BLDRX1.BI  Parent:SYSGEN.BI   Subfiles:none

.AS RKA0 SRCE
.DUP RXA0:/S

/Get an unused copy of BUILD.SV so that $BUILD command will work
.DEL BUILDZ.SV
.COP BUILDZ.SV<BUILDV.SV

.RU SYS:BUILDZ

LO SRCE:BATV4
LO SRCE:LPTSER
LO SRCE:TTYSER
LO SRCE:RXNSV4
LO SRCE:RX78C
LO SRCE:RL20AB
LO SRCE:RL20CD
LO SRCE:RL201E
LO SRCE:RXSY1

IN BAT,BAT
IN LPTS,LPT
IN TTYS,TTY
IN RX02,RXA0,RXA1
IN RX0B,RXA2,RXA3
IN R0AB,R20A,R20B
IN R0CD,R20C,R20D
IN R01E,R20E,R21E
IN RX8E,SYS

DSK=SYS

BUILD
SRCE:OS8V4
SRCE:CDV4
/REBOOT MASTER, THEN SUBMIT RX1FIN.BI
BOOT

$END

