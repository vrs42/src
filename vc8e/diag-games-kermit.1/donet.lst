   1            /
   2            / Test how long until VC8E "done" is asserted.
   3            /
   4            DISD=6052       / Skip Done
   5            DILX=6053       / Load X
   6            DILY=6054       / Load Y
   7            DIXY=6055       / Intensify (X, Y)
   8            DILE=6056       / Load Enable
   9            *200
  10 00200 7201 START,  CLA IAC         / Set as
  11 00201 3213         DCA COUNT1      / first iteration
  12 00202 6053         DILX            / Start something (should be a few)
  13            /       DILY            / Start something (should be a few)
  14            /       DIXY            / Start something (should be zero!)
  15            /       DILE            / Start something (should be many)
  16 00203 6052 LOOP,   DISD            / Done yet?
  17 00204 7410         SKP             / Nope
  18 00205 5210         JMP DONE
  19 00206 2213         ISZ COUNT1      / Count a "not done" iteration
  20 00207 5203         JMP LOOP        / and try again
  21            / Two cases: DISD skipped, or counter overflowed.
  22 00210 1213 DONE,   TAD COUNT1      / Get how many iterations
  23 00211 7402         HLT             / into ac, then halt
  24 00212 5200         JMP START       / Do over!
  25 00213 0000 COUNT1, .-.
  26            $
