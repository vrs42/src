   1            /
   2            / Test how long until VC8E "done" is asserted.
   3            /
   4            DISD=6052       / Skip Done
   5            DILX=6053       / Load X
   6            DILY=6054       / Load Y
   7            DIXY=6055       / Intensify (X, Y)
   8            DILE=6056       / Load Enable
   9            *200
  10 00200 3212 START,  DCA COUNT1      / No iterations yet
  11 00201 6053         DILX            / Start something (should be a few)
  12            /       DILY            / Start something (should be a few)
  13            /       DILE            / Start something (should be many)
  14            /       DIXY            / Start something (should be zero!)
  15 00202 6052 LOOP,   DISD            / Done yet?
  16 00203 7410         SKP             / Nope
  17 00204 5207         JMP DONE
  18 00205 2212         ISZ COUNT1      / Count a "not done" iteration
  19 00206 5202         JMP LOOP        / and try again
  20            / Two cases: DISD skipped, or counter overflowed.
  21 00207 1212 DONE,   TAD COUNT1      / Get how many iterations
  22 00210 7402         HLT             / into ac, then halt
  23 00211 5200         JMP START       / Do over!
  24 00212 0000 COUNT1, .-.
  25            $
