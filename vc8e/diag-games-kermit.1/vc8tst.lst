 100 00435 0077 C077,   0077    / mask to extract a byte
 101 00436 0000 VCTXPT, .-.     / pointer to char string
 102            
 103 00437 0000 VCCHAR, .-.     / Display char from AC on screen
 104                            / Char is in 6 bit trimmed ASCII
 105                            / returns AC=0
 106 00440 1273         TAD     NPCSGN  / compare with EOL
 107 00441 7450         SNA
 108 00442 5262         JMP     VCCHCR  / got a %, use as CRLF
 109 00443 1274         TAD     PPCSGN  / undo the damage
 110 00444 7104         CLL RAL         / 2 words per char
 111 00445 1270         TAD     VCTTAP  / make address of table entry
 112 00446 3275         DCA     VCCHPT  / save pointer to char
 113 00447 1675         TAD I   VCCHPT  / get first 2 columns
 114 00450 4276         JMS     VCDCOL  / display first column
 115 00451 4276         JMS     VCDCOL  / display second column
 116 00452 2275         ISZ     VCCHPT
 117 00453 1675         TAD I   VCCHPT  / get second 2 columns
 118 00454 4276         JMS     VCDCOL  / display third column
 119 00455 4276         JMS     VCDCOL  / display final column
 120 00456 1336         TAD     VCXTMP
 121 00457 1271         TAD     VCDOTS
 122 00460 3336         DCA     VCXTMP  / advance over interchar column
 123 00461 5637         JMP I   VCCHAR
