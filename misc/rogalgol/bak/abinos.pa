/ ABINOS.PA	-8-	S.F. 10-JAN-1977
/ DELETE POINTER TO OUTPUT FILE IF CHAINING TO RALGOL
/ THIS VERSION ALLOWS OPT L (LOAD).
/ CORRECTS CHAINING FAULT AND DELETES 2ND INPUT FILE IF ANY !
/ DON'T CLEAR 17600!
/ OVERLAY FOR ALGOL COMPILER MARK 34(M) AND 40
IFDEF ERRORS <XLIST>

	ALBIN=0

OSSTRT=5600	/ START OF OS8 ROUTINES
IBUFFR=OSSTRT+400
OBUFFR=IBUFFR+400
HPAGE=IBUFFR+1000	/ PAGES FOR HANDLERS
NOPAGE=2	/ THIS DEFINES NO OF PAGES
		/ FOR HANDLERS
IFDEF ALBIN <
	OPTGM=400	/ ONLY CHECK G IF ALBIN
	OEXTN=0102	/ OUTPUT TO .AB
	IEXTN=0103	/ INPUT FROM .AC
	OPTLOC=20; FHLOC=70; INLOC=53;
	OUTLOC=63; ERROR=140; NULOUT=ERROR;
	OPS=5200;
	KBDCHK=OPTLOC+3	>	/ DUMMY FOR NOW
IFNDEF ALBIN <
	OPTGM=2400	/ CHECK BOTH IF OSACOM
	OEXTN=0103	/ OUTPUT TO .AC
	IEXTN=0114	/ INPUT FROM .AL
