
/EAE OVERLAY FOR ROGALGOL OPERATING SYSTEM

POP=JMS I 72
T4=4
MUL=701
DIV=711
PNEXT=35
SUBSA3=1625
SUBSA2=1637
PRINT=2027
NFSPAD=23
PRIN=2044
GT10=2060
ARNE=2302
ARNW=2322
XNEXT6=200

FIELD 1

*XNEXT6+15;	LSR; 5; JMP I XNEXT6

*MUL;	CLA CLL CMA RAL; DCA T4; JMS SIGN1; DCA M1; JMS SIGN1
	MQL MUY
M1,	0; JMP SIGN2

*DIV;	CLA CLL CMA RAL; DCA T4; JMS SIGN1; DCA D1; JMS SIGN1
	MQL DVI
D1,	0
SIGN2,	CLA MQA; ISZ T4; SKP; CIA; JMP I PNEXT
SIGN1,	0; POP; SPA; ISZ T4; NOP
	SPA; CIA; JMP I SIGN1

*SUBSA3+4;	MQL
*SUBSA2-1;	MUY; 0; CLA MQA

*PRINT+4;	MQL
*PRIN+3;	CLA MQA
*PRIN+7;	CLA MQA
*GT10;		DVI

*ARNE-2;	MQL; MUY; 0; CLA MQA
*ARNW-2;	MQL; MUY; 0; CLA MQA; TAD NFSPAD

$
