2970               /       ROUTINE TO CHECK FOR A VALID ASCII DECIMAL VALUE.
2971               
2972               /       ENTER WITH ASCII CHAR IN THE AC.
2973               /       EXIT RETURN + 1 IF NON-VALID ASCII DECIMAL WITH CHAR IN AC.
2974               /       EXIT RETURN + 2 IF VALID ASCII DECIMAL WITH CHAR IN AC.
2975               
2976               DECCK,  0
2977                       DCA     DECCK5          /STORE THE CHAR TO CHECK
2978                       TAD     DECCK5          /GET THE CHAR
2979                       TAD     (-"0            /CHECK FOR LESS THAN 0
2980                       SPA                     /SKIP IF NOT LESS THAN 0
2981                       JMP     DECCK1          /NON-ASCII DECIMAL
2982                       TAD     ("0-"9-1        /CHECK GREATER THAN 9
2983                       SMA CLA                 /SKIP IF LE 9
