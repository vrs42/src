5938 007025  6167          IACA                            /LOAD LINC "A" REGISTER
5939 007026  7200          CLA                             /CLEAN UP
5940 007027  6171          IAAC                            /GET IT BACK
5941 007030  7001          IAC                             /ADD ONE
5942 007031  7650          SNA CLA                         /SKIP IF NO LINC HARDWARE
5943 007032  5275          JMP     IMAL8                   /JUMP IF LINC-8
