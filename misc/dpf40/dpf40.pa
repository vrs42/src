GSERCH,	TSTLPR		/CHECK FOR SUBSCRIPT
	JMP GS1		/NONE
	JMS I DECALL	/PICK IT UP
	POPA		/RESTORE NAME
	DCA EFOP
	JMS I DPART	/CHECK PAREN MATCH,ETC.
	JMS I INTEGE	/CONVERT TO 12 BIT
GS1,	DCA SUBS	/SAVE SUBSCRIPT
	MQL		/CLEAR LAST ZERO HOLD
