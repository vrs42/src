/MACRO-8M
/ 3 JUN 69	RBH

/PAGE 7 CHANGES

/SYMBOL DEFINITIONS:
ITEM=	62
IDX=	2043

*1600
BIT6,	0		/TRANSLATE ASCII TO
	TAD Z ITEM	/FUNNY SIX-BIT
	AND Z C177	/OMITTING ] AND )
	SNA		/SKIP BLANK CHARS
	JMP I (IDX+1)
	TAD (-140)	/TEST FOR LOWER CASE
	SMA		/STILL + IF L.C.
	TAD (-40)	/MAKE L.C. INTO U.C.
	TAD Z C4	/GET RID OF ],^,& _
	SMA SZA
	JMP BIT6EX	/CLA THEN JMP IDX+1
	TAD (134-132)	/SKIM OFF [ AND \
	SMA SZA
	JMP BON		/ADD 73 TO C(AC)
	TAD CC32	/TAKE LETTERS
	SMA SZA
	JMP I BIT6	/AND EXIT DIRECTLY
	TAD CC20	/NUMERALS & HIGHER PUNCT.
	SMA
	JMP BON+5	/ADD 33 TO C(AC)
	TAD CC20	/LOWER PUNCT.
	SMA
	JMP BON+1	/ADD 54 TO C(AC)
	TAD Z C4	/LOOK FOR EOF
	SNA
	JMS I (REWIND)	/TO DO SOMETHING OBVIOUS
	TAD (34-15)	/LOOK FOR CR
	SNA
	JMP BON-1	/MAKE IT 46 (;)
	TAD Z C4	/LOOK FOR TAB
BIT6EX,	SNA CLA
	JMP BON+1	/MAKE IT 54 (SPACE)
	JMP I (IDX+1)	/IGNORE EVERYTHING ELSE
	TAD (-25)	/ADD 46
BON,	TAD (17)	/ADD 73
	TAD (-11)	/ADD 54
	SNA		/LOOK FOR )
	JMP I (IDX+1	/IGNORE )
	TAD CC32	/ADD 65
	TAD CC32	/ADD 33
	IAC
	JMP I BIT6	/RETURN WITH MASHED CHARACTER

