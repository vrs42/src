*3440
TYOUT,	0		/TTY OUTPUT
	DCA I TYPNTI	/PUT INTO BUFFER
	TAD TYPNTI	/AND ADJUST POINTER
	IAC
	AND TYRING	/MAKE IT GO IN CIRCLES
	DCA TYPNTI
	TAD TYCNTR
	TAD TYSIZE
	SMA CLA		/BUFFER FILLED?
