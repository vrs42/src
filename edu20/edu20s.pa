	DCA PT1
	TSTEND		/MORE DATA AVAILABLE?
	JMP INRDAT	/YES: USE IT
	ISZ INREAD	/SET UP SKIP RETURN
	JMP I INREAD	/EXIT
INRDAT,	TSTCOM		/COMMA SEPARATOR?
ERR490,	ERROR		/NO: DATA TO INPUT OR READ IN IMPROPER FORM
	GETC		/SKIP OVER THE COMMA
INRMOD,	ISZ PT1		/STRING OR NUMERIC DATA ITEM?
	JMP INRNUM	/NUMERIC
	PUSHJ		/STRING
		QINP
