/BCD TO BINARY CONVERSION
/INPUT IN AC    OUTPUT IN AC
*200
DBIN,  0
       DCA TEMP
       TAD MSK1
       AND TEMP
       DCA VALU
       TAD TEMP
       RTR
       RTR
       AND MSK1
       CMA
       DCA LOOP
LPA,   ISZ LOOP
       JMP .+2
       JMP NEXT
       TAD BN10
       JMP LPA
NEXT,  TAD VALU
       DCA VALU
       TAD TEMP
       RTL
       RTL
       RAL
       AND MSK1
       CMA
       DCA LOOP
       TAD VALU
LPB,   ISZ LOOP
       JMP .+2
       JMP I DBIN
       TAD BN1
       JMP LPB
MSK1,  0017
VALU,  0
TEMP,  0
LOOP,  0
BN10,  0012
BN1,   0144
       $
