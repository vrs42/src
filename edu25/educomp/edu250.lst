5569               DTWRIT, 0               /WRITE OS/8 BLOCK ON FLOPPY DISK
5570                       JMS     RXCON   /THIS CONTROLS MAIN READ/WRITE LOOP
5571                       RXW,    0       /WITH RXW (WRITE SEQUENCE CONTROL)
5572                               JMS     RXBUF   /FILL HARDWARE BUFFER
5573                               JMS     RXRW    /WRITE RX8E RECORD
5574                               JMS I   RXW     /NOTE PECULIAR RETURN
5575                       JMP I   DTWRIT  /DONE--SUBROUTINES DID THE WORK
5576               
5577               DTREAD, 0               /READ OS/8 BLOCK FROM FLOPPY DISK
5578                       L0002           /SET READ BIT IN COMMAND WORD
5579                       JMS     RXCON   /RXCON CONTROLS RX8E READ LOOP TOO
5580                       RXR,    0       /NOTE SUBR RXR IS AN ARG TO RXCON
5581                               JMS     RXRW    /FIRST READ RX8E REC
5582                               JMS     RXBUF   /THEN EMPTY HARDWARE BUFFER
5583                               JMS I   RXR     /STRANGE EXIT FROM ARG SUBR
5584                       JMP I   DTREAD  /DONE
5585               
5586               RXCON,  0               /CONTROLS READ/WRITE OF OS/8 BLK ON RX8E
5587                       CDF 0           /GET DEVICE BIT FROM FLD 0
5588                       TAD I   [DEV    /COMBINED WITH READ/WRITE BIT IN AC
5589                       CDF 10
5590                       DCA     RXFN    /SAVE COMMAND REG WORD
5591                       TAD     [-4     /READ 4 RX8E RECS PER OS/8 BLK
5592                       DCA     TM1
5593                       TAD     [DTBUF  /POINTER TO CORE BUFFER
5594                       DCA     RXBFPT
5595                       TAD     DTBLK   /CONVERT OS/8 BLKS TO RX8E RECS
5596                       CLL RTL         /MULTIPLY BY 4
5597                       DCA     RXREC
5598               RXCONL, JMS I   RXCON   /TRANSFER 1 RX8E RECORD
5599               RXCONR, 0               /POINTER TO END OF ARG SUBR
5600                       ISZ     RXREC   /NEXT RX8E RECORD
5601                       ISZ     TM1     /TRANSFERED 4 RECS YET?
5602                       JMP     RXCONL  /NO: DO NEXT ONE
5603                       JMP I   RXCONR  /YES: READ/WRITE DONE
5604               
5605               RXBUF,  0               /EMPTY/FILL RX8E'S HARDWARE BUFFER
5606                       INTR            /NO INTERRUPT ON DONE FLAG
5607                       TAD     RXBFPT  /SAVE CURRENT PLACE IN BUFFER
5608                       MQL             /(IN CASE OF ERROR)
5609                       TAD     [-12    /TEN ERROR RETRIES ALLOWED
5610                       DCA     RXERCT
5611               RXBERL, TAD     RXFN    /INITIATE EMPTY/FILL OF HARD BUFFER
5612                       LCD
5613                       MQA             /POINT TO RIGHT PLACE IN CORE BUFFER
5614                       DCA     RXBFPT
5615               RXB1,   STR             /READY TO TRANSFER A WORD?
5616                       JMP     RXB2    /NO: CHECK DONE FLAG
5617                       TAD I   RXBFPT  /GET WORD IN CASE SENDING
5618                       XDR             /TRANSFER WORD
5619                       DCA I   RXBFPT  /SAVD WORD IN CASE RECIEVING
5620                       ISZ     RXBFPT  /POINT TO NEXT CORE BUFFER WORD
5621               RXB2,   SDN             /DONE?
5622                       JMP     RXB1    /NOT SURE, CHECK TRANSFER READY FLAG
5623                       SER             /YES: ANY ERRORS OCCUR?
5624                       JMP I   RXBUF   /NO: EXIT
5625                       ISZ     RXERCT  /YES: IS IT A HARD ERROR YET?
5626                       JMP     RXBERL  /NO, TRY AGAIN
5627               RXFAT,  CIF CDF 0       /FATAL I/O ERROR
5628                       JMP     ERRDT
5629               
5630               RXRW,   0               /READ/WRITE 1 RX8E REC INTO HARDWARE BUFFER
5631                       TAD     [-12    /TEN ERROR RETRIES ALLOWED
5632                       DCA     RXERCT
5633               RXRERL, L0004           /BIT TO CAUSE ACTUAL READ OR WRITE
5634                       CLL IAC         /CLL FOR LATER; AC11 IGNORED BY LCD
5635                       INTR            /BUT AC11 SETS INTERRUPT ON DONE FLAG
5636                       TAD     RXFN    /ADD DEVICE&R/W BITS
5637                       LCD             /INITIATE ACTUAL DATA TRANSFER ON FLOPPY
5638                       DCA     RXTRAK  /NOW COMPUTE TRACK (0-114(8))
5639                       /CLL            /AND SECTOR (1-32(8)) FROM RECORD #
5640                       TAD     RXREC   /JUST LIKE OS/8, INCLUDING INTERLEAVING
5641               RXDVLP, SNL
5642                       ISZ     RXTRAK
5643                       TAD     [-15    /THIS IS DIVISION
5644                       SMA
5645                       JMP     RXDVLP
5646                       RAL             /INTERLEAVING STEP
5647                       TAD     [33
5648                       STR
5649                       JMP     .-1
5650                       XDR             /TRANSFER SECTOR #
5651                       CLA             /THEN TRANSFER TRACK #
5652                       TAD     RXTRAK
5653                       STR
5654                       JMP     .-1
5655                       XDR             /NOW ACTUAL DATA TRANSFER CAN BEGIN
5656                       CIF CDF 0       /DISMISS UNTIL DONE FLAG COMES UP
5657                       JMS     RXF0DW
5658                       SER             /ANY ERRORS?
5659                       JMP I   RXRW    /NO: EXIT
5660                       XDR             /YES: GET ERROR&STATUS WORD
5661                       RTR             /CHECK CRC(BIT11) & PARITY(BIT 10)
5662                       SPA SZL CLA
5663                       JMP     .+4
5664                       INIT            /RECALIBRATE IF NOT CRC & NOT PARITY
5665                       CIF CDF 0       /THEN WAIT FOR DONE FLAG
5666                       JMS     RXF0DW  /(NONWASTEFULLY)
5667                       ISZ     RXERCT  /HARD ERROR YET?
5668                       JMP     RXRERL  /NO: KEEP TRYING TO DO IT RIGHT
5669                       JMP     RXFAT   /YES: INDICATE FATAL ERROR
5670               
