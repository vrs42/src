  41               /
  42               /CONFIG:        TO GET THE CONFIGURER TAPE ONLY, DEFINE
  43               /       "CONFIG" AS 1.  THE CONFIGURER IS A SHORT OVERLAY
  44               /       TAPE TO EDU200 TO RERUN THE INITIAL DIALOG.
  45               IFNDEF CONFIG <CONFIG=0>
  46               IFNZRO CONFIG <NOPUNCH>
  47               /
  48               /USERS: THE NUMBER OF USERS ON THE SYSTEM.  THIS PARAMETER
  49               /       IS LEFT OVER FROM THE SYSTEM DEVELOPEMENT.  THE
  50               /       INITIAL DIALOG OVERRIDES THIS SETTING.
  51               IFNDEF USERS <USERS=1>
  52               /
  53               /PDP8I: SET TO A 1 IF THE COMPUTER ON WHICH EDU200 IS
  54               /       TO BE RUN IS A PDP-8/I OR -8/L.
  55               /       VALUE IS 0, INDICATING A PDP-8/E, -8/M, OR -8/F.
  56               /       THE INITIAL DIALOG CHECKS TO MAKE SURE IT IS
  57               /       RUNNING ON THE RIGHT MACHINE AND HALTS IF NOT.
  58               IFNDEF PDP8I <PDP8I=0>
  59               /
  60               /TD8E:  SET TO 1 IF MASS STORAGE DEVICE IS TD8E DECTAPE.
  61               /       SET TO 0 OTHERWISE.
  62               IFNDEF TD8E <TD8E=0>
  63               /
  64               /RK8E:  SET TO 1 IF MASS STORAGE DEVICE IS RK8E DISK.
  65               /       SET TO 0 OTHERWISE.
  66               IFNDEF RK8E <RK8E=0>
  67               /
  68               /RX8E:  SET TO 1 IF MASS STORAGE DEVICE IS RX8E TYPE
  69               /       FLOPPY DISK.  SET TO 0 OTHERWISE.
  70               IFNDEF RX8E <RX8E=0>
  71               /
