FSUB1,	ISZ	FFADD	/BUMP RETURN
	TAD	OPH	/IS OPERAND = 0
	SNA	CLA
	JMP I	FFADD	/YES-DONE
	TAD	ACH	/NO-IS FAC=0?
	SNA	CLA
	JMP	FAD1	/YES-DO ADD
FIX1,	TAD	ACX	/NO-DO EXPONENT CALCULATION
	CLL CMA IAC
	TAD	OPX
	SMA	SZA	/WHICH EXP. GREATER?
	JMP	FACR	/OPERANDS-SHIFT FAC
	CMA	IAC	/FAC'S-SHIFT OPERAND=DIFFRNCE+1
FAD1,	JMS	OPSR
	JMS	ACSR	/SHIFT FAC ONE PLACE RIGHT
DOADD,	TAD OPX		/TRANSFER OPX TO ACX
	DCA ACX		/(CONVENIANT MAINLY IF FAC=0)
	JMS	OADD	/DO THE ADDITION
	JMS I	FNORP	/NORMALIZE RESULT
