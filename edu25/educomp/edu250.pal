/*SORTJ* ROUTINE
XSORTJ, 0
	SNA
	TAD CHAR	/USE CHAR IF AC IS 0
	CIA
	DCA T3
	TAD I XSORTJ
	DCA XREG	/SET TO LIST
	ISZ XSORTJ
	CDF 10
	TAD I XREG
	SPA
	JMP XSORT1	/END OF LIST
	TAD T3
	SZA CLA
	JMP .-5 	/NO GO - LOOP
	TAD XREG
	CDF
	TAD I XSORTJ
	DCA XSORTJ
	CDF 10
	TAD I XSORTJ	/GET ADDRESS
	DCA XSORTJ
XSORT1, CLL CLA
	ISZ XSORTJ
	CDF
	JMP I XSORTJ
/*RTL6* ROUTINE
XRTL6,	0
	CLL RTL
	RTL
	RTL
	JMP I XRTL6
