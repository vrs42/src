PDP8I1,	GTF		/GET LINK, SAVE FIELD REG
	DCA SAVF	/SAVE FLAGS
	TAD I [0	/SAVE RESTART LOCATION
	DCA SAVRES
	SPL		/POWER FAIL INTERRUPT?
	JMP INTST	/NO, SCAN TTYS
	DCA I [0	/YES, SET UP RESTART SEQUENCE
	TAD [JMP INTPWF
	DCA I [2	/FIELD 0;*0;AND 0;CIF 10;JMP INTPWF
