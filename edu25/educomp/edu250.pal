/
/OPERAND SHIFT RIGHT-ENTER WITH POSITIVE COUNT-1
/IN AC
/
OPSR,	0
	CLL CMA
	DCA AC0		/-SHIFT COUNT
OPSR1,	TAD OPH		/IF OPERAND IS NEGATIVE,
	SMA
	JMP OPSR2
	CLA RAL		/THEN ADD 1 BEFORE SHIFTING RIGHT
	TAD OPL		/LINK WAS OV BIT; ITS CARRY IS ITSELF
	DCA OPL
	RAL		/PROPAGATE POSSIBLE CARRY
	TAD OPH		/ADD HIGH ORDER
	SKP		/LINK IS COMPLEMENT OF SIGN BIT
OPSR2,	STL		/PROPAGATE 0 SIGN BIT FOR POSITIVE NUMBERS
	CML RAR		/SHIFT RIGHT, PROPAGATING SIGN
	DCA OPH		/STORE HIGH ORDER
	TAD OPL		/GET LOW ORDER
	RAR		/SHIFT RIGHT (LINK IS NOW OVERFLOW BIT)
	DCA OPL
	ISZ OPX		/INCREMENT EXPONENT
	NOP		/ISZ MAY SKIP
	ISZ AC0		/SHIFTED ENOUGH?
	JMP OPSR1	/NO
	RAR		/SAVE OVERFLOW BIT
	DCA AC2
	JMP I OPSR	/EXIT
