	DCA OPUS2
	TAD APUSHA
OPUSA1,	CIF CDF
	DCA I APUSP1
	TAD OPUS2
	JMS I APUSPO
	JMP I OPUSHA
/
OPOPA,	0
	DCA OPUS2
	TAD OPOPA
	DCA OPUSHA
	TAD APOPA
	JMP OPUSA1
/
RDYPC1,	CDF
	DCA PAT2
	TAD I APATCH
	JMS OPUSHA
	TAD PAT2
	CIF CDF
	JMP I AREADY
PAT2,	0
/
