DTAPE,	0		/ENTER WITH AC=1 FOR READ
	IOF		/NO INT PLEASE
	TAD DDR128
	DCA DRET	/READ/WRITE RETURN AFTER SEARCH
	TAD ENTERF	/SAVE CALLING FIELD
	RDF
