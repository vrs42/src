8165 016650  5266          JMP COL78B      /IF NO BIT SET,CHECK COL NO.
8166 016651  1760          TAD I XCRCHR    /GET THE CHAR.
8167 016652  4761          JMS I XDCBIN    /GET THE BIT POSITION(1 TO 12).
8168 016653  5263          JMP COL78A      /IF MORE THAN 1 BOX MARKED THEN
8169                                       /AN ERROR.
8170 016654  7450          SNA
8171 016655  5266          JMP COL78B
8172 016656  1347          TAD KEYCNT      /SET UP TABLE INDEX.
8173 016657  3347          DCA KEYCNT
8174 016660  1346          TAD KEYDSP      /HAS A KEYWORD BOX ALREADY
8175 016661  7650          SNA CLA         /BEEN MARKED?
8176 016662  5265          JMP COL78C      /NO.
8177 016663  2354  COL78A, ISZ KEYERR      /YES, SET ERROR SWITCH.
8178 016664  7410          SKP
8179 016665  2346  COL78C, ISZ KEYDSP      /SET KEYWORD SEEN SWITCH.
8180 016666  1346  COL78B, TAD KEYDSP      /HAS A KEYWORD BEEN SEEN?
8181 016667  7640          SZA CLA
8182 016670  5274          JMP COL78D      /YES, CHECK COL.
8183 016671  1351          TAD K14         /NO, ADD 12 TO INDEX.
8184 016672  1347          TAD KEYCNT
8185 016673  3347          DCA KEYCNT
