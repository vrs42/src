@@@@
C-FOCAL, U01

01.20 A ?X1 X2 Y1 Y2 I N ?;I (FABS(Y1)+Y2-70)1.3;S Y2=69-FABS(Y1)
01.30 S D=FABS(Y1)-3;S Y(-1)=-9;D 6;T "X-AXIS"!;S Y1=-Y1;S Y(N+1)=1E3
01.40 F X=X1,I,X2;S Y=0;D 5;T !
01.50 Q

05.10 C/\ PUT ERROR CHECK HERE (5.1-5.19)
05.20 S D=FABS(Y1)-7;D 6;T "ERROR CONDITION";R
05.21 C/\ PUT EQUATIONS HERE (5.21-5.29)
5.3F J=0,N;S Z(J)=J;S Y(J)=FITR(.5+Y(J)+Y1);I (Y(J)-69)5.4;S Y(J)=69
05.40 
05.42 F J=0,N;I (Y(J+1)-Y(J))5.45
05.44 S L=-1;I (X)5.7,5.5,5.7
05.45 S D=Y(J+1);S Y(J+1)=Y(J);S Y(J)=D;S D=Z(J+1);G 5.47
05.47 S Z(J+1)=Z(J);S Z(J)=D;G 5.42
05.50 F D=-Y1,Y2;S J=0;D 5.55
05.52 R
05.55 I (Y(J)-Y1-D)5.6,5.67,5.6
05.60 S J=J+1;I (J-N-1)5.55;S L=FABS(D/5);I (FITR(L)-L)5.65;T "+
05.65 T ".
05.67 D 7.1;I (Z(J+1))5.6
05.70 F J=0,N;S D=Y(J)-L-1;S L=Y(J);D 6;G 7.1

06.10 I (Y(J)-Y(J-1)-2)6.2;F K=1,D;T " "
06.20 

07.10 S K=Z(J);I (Y(J)-Y(J+1))7.2;S Z(J+1)=-1
07.20 I (K-8)7.3,7.7;T "^
07.30 I (K-6)7.4,7.75;T "?
07.40 I (K-4)7.5,7.8;T "%
07.50 I (K-2)7.6,7.85;T "#
07.60 I (K)7.65,7.9;T "*
07.65 T "=
07.70 T ">
07.75 T "-
07.80 T "$
07.85 T "&
07.90 T ".
*@@@@@@@@@@@@@@@@@@@@@@@