	JMS RESFLD	/RESTORE DATA FIELD

	JMP I FETCH	/EXIT

STORE, 	0		/STORE C(ACC) INTO C(PT)
	DCA TEMP5	/SAVE ACC.
	TAD FIELDD
	JMS SETFLD	/SET UP DATA FIELD
	TAD TEMP5	/GET BACK ACC.
	DCA I PT	/STORE WORD
	JMS RESFLD	/RESTORE DATA FIELD
	JMP I STORE 	/EXIT
