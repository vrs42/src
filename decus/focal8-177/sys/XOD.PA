	JMP SEAR4
	CLL CMA		/ACC.=-1, MATCH
	TAD PT
	DCA LOC		/UPDATE LOCATION AND TYPE RESULT
	DCA OREG	/MAKE REGISTER NOT OPEN
LF,	SNL		/ANYTHING TYPED
	ISZ OREG	/IS A REGISTER OPEN
