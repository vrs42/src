LLIM,	0		/LOW LIMIT FOR BLOCK OPERATIONS
HLIM,	START-1		/HIGH LIMIT FOR BLOCK OPERATIONS
MASK, 	7777

GREAT, SKP CLA
LESS,	SKP CLA

	TAD CM10	/-10, MAKES 'SZA CLA'
	TAD NUMB1	/SNA CLA
	JMS SULI	/SET UP SKIP INSTRUCTION AND SET UP LIMITS
	DCA SLASH1	/SET UP INSTRUCTION
	TAD EXPR
	AND MASK
	CIA
	DCA EXPR
SEAR1, 	JMS FETCH	/GET C(C(PT))
	AND MASK
	TAD EXPR
TEMP5,			/TEMPORARY
