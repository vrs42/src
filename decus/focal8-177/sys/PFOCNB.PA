CHKSIN,	TAD (200	/"B@" (KEEP ALL FUNCTIONS)
	JMS LOOKUP
	SZA CLA
	JMP CHKFIL
	JMS CHANGE	/KILL LOG, EXP, ATN
		LOGADD-1
	TAD (5177	/AND RESET BOTTOM
