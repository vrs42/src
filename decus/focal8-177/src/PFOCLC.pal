X133P,	XI33

TERMER,	0		/CHECK FOR TERMINATOR (;, CR, SPACE,
	SORTC
		GLIST-1
	ISZ TERMER
	CIF CDF
	JMP I TERMER

EOF,	0		/TRYING TO READ FROM A FILE AFTER END
	TAD X133P	/(SHAME ON YOU!)
	DCA INDEV	/RESET POINTER TO TTY
	TAD P277	/PRINT A '?'
