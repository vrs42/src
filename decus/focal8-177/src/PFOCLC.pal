/#5
/#4
/#3
/#2
/#1-HIGH ORDER RESULT

*DATUM-1

MULDIV,	0	/TERMINATE MULTIPLY AND DIVIDE.
	ISZ SIGNF		/CORRECT FOR SIGN
	JMS I MINSKI
	JMS I NORMF	/SHIFT LEFT
	NOP
	JMP I MULDIV	/--RETURN--
FLDV,	TAD AC1H	/4:DIVIDE
	SNA CLA
	ERROR2		/DIVISION BY ZERO
	TAD EX1		/SUBTRACT EXPONENTS+1
	CMA IAC
	IAC
