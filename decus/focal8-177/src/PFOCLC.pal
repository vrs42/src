RDIV,	CHIN
PRNTLN=JMS I .	/PRINT C(LINENO)
	XPRNT
GETLN=JMS I .	/UNPACK AND FORM A LINENUMBER
	XGETLN
FINDLN=JMS I .	/SEARCH FOR A GIVEN LINE
	XFIND
ENDLN=JMS I .	/INSERT LINE POINTERS
	XENDLN
RTL6=JMS I .	/ROTATE LEFT SIX
	XRTL6
SPNOR=JMS I .	/IGNORE SPACES AND LEADING ZEROS
	XSPNOR
TESTN=JMS I .	/PERIOD; OTHER; NUMBER
	XTESTN
TSTLPR=JMS I .	/SKIP IF 5<SORTCN<= 11 (I.E. AN L-PAR)
	LPRTST
TSTGRP=JMS I .	/SKIP IF G(AC) = G(LINENO)
	GRPTST
TESTC=JMS I .	/TERM; NUMBER; FUNCTION; LETTER- AND IGNORE SPACES.
	XTESTC
DELETE=JMS I .	/REMOVE OLD TEXT LINE
PSIN,	XDELETE
ERROR2=JMS I .	/EXCESS SOMETHING ERROR
ERROR3=JMS I .	/MISCELLANEOUS ERROR
ERROR4=JMS I .	/FORMAT ERROR
	ERR2

DPC,	PS8PC	/PC
DTHIS,	THISD	/THISLN
DPT1,	PT1D	/PT1
DXRT,	XRTD	/(TAD I XRT)
DAXIN,	AXIND	/(DCA I AXIN)
DAXOUT,	AXOUTD	/(TAD I AXOUT)
SECRTV,	STVAR	/FOR SECRET VARIABLES, OF COURSE
	TELPCH

/COMMAND/INPUT DRIVER

*177
START,	SKP CLA		/PROGRAM START FROM SELF
	JMP I 176	/FUDGE FOR ?00.00 PRINTOUT
	TAD C200	/INITIALIZE PC
	DCA PC		/FOR COMMAND MODE
	IAC		/USE ONE IN THE AC TO
	DCA DMPSW	/INIT UNPACK AND TRACE SWITCH
	DCA DEBGSW	/ENABLE TRACE FOR INPUT OF (?)
	TAD PUSHB	/OVERFLOW PROTECTION
	DCA PDLXR	/NO PATCH TEST
	TAD CSTAR	/TYPE * TO INDICATE COMMAND MODE
	JMS I ECHOP	/SHOULD WE PRINT A '*'?
IBAR,	TAD BUFR	/COMMAND INPUT BUFFER
	DCA AXIN	/FOR UNPACKING
	DCA XCTIN
	TAD BUFR	/RUBOUT PROTECTION
	DCA PACKST
IGNOR,	READC		/READ COMMAND STRING
	SORTJ
	LIST7-1	/MOVED DOWN ONE
	INLIST-LIST7
	PACKC		/SAVE STRING CHARACTER.
	JMP IGNOR

CSTAR,	252		/ACKNOWLEDGE CHARACTER
PUSHB,	RESTORE-1+13	/END FOR TEXT AND COMMAND INPUT

/COMMAND/INPUT PROCESSOR

IRETN,	PACKC		/START TO PACK C.R.
	PACKC		/FINISH C.R.
	TAD  BUFR		/INITIALIZE FOR UNPACKING
GONE,	DCA AXOUT	/SETUP CURRENT LINE
	DCA XCT
	GETC		/READ FIRST CHARACTER.
	TAD PUSHB1	/INIT STACK POINTER
	DCA PDLXR
	SPNOR		/IGNORE LEADING BLANKS
	TESTN		/DOES THE LINE BEGIN WITH 1-9?
	JMP GZERR	/PERIOD =ILLEGAL GROUP ZERO USAGE
	JMP INPUTX	/NO
	ISZ DEBGSW	/YES,DISABLE TRACE FOR REPACKING
	GETLN		/READ THIS LINE NUMBER
	TAD P4000	/TEST  FOR SINGLE LINE.
	TAD NAGSW
	SZA CLA
	ERROR3		/ILLEGAL LINE NUMBER ON INPUT
	TAD BUFR	/SET POINTERS
	DCA AXIN
	DCA XCTIN
	TAD LINENO	/SAVE LINE #
	JMS I DAXIN	/DCA I AXIN
	SPNOR		/IGNORE SPACES AFTER LINE NUMBER
	SKP
	GETC		/READ 1ST AFTER LINENO TERMINATOR.
SRETN,	PACKC		/SAVE TEXT AND RESTORE DATA FIELD
	TAD CHAR	/TEST FOR END OF INPUT STRING
	TAD MCR
	SZA CLA
	JMP .-5
	DELETE		/REMOVE OLD LINE, IF ANY.
	ENDLN		/INSERT NEW LINE
	JMP START	/POINTERS MUST BE REINITIALIZED
INPUTX,	PUSHJ		/PROCESS IMMEDIATE COMMAND.
	PROC
	JMS I DPC	/TAD I PC
	SNA		/END OF PROGRAM? 
	JMP START	/YES
	DCA PC		/SAVE NEW LINE NO.
	TAD PC		/START NEW LINE
	IAC
	JMP GONE	/PROCESS OTHER COMMANDS

/TEXT LINE BUFFER FORMAT*

/#1 : POINTER OR ZERO IN LAST
/#2 : LINENO
/#3 - #N+1 : TEXT
/#N : C.R.

/LINE NUMBER FORMATION

FL100,	7
	3100
	0
FLP5,	0
	2000
	0
	0
PTEMP,	ZBLOCK 4
XGETLN,	0	/COMPUTED LINE #'S
	SPNOR	/IGNORE SPACE
	TAD CHAR	/'A' IS SPECIAL
	TAD MINUSA
	SNA CLA
	JMP TESTA
	PUSHJ	/EVALUATE NUMBER OR EXPRESSION
		EVAL
	FENT
	FPUT PTEMP	/SAVE IT
	FEXT
	JMS I INTEGER		/GET GROUP PART
	TAD P7740	/CHECK IF TOO BIG
	SMA CLA
	ERROR2	/BAD GROUP #
	TAD FLAC+2	/GET GROUP AGAIN
	RTL6
	RAL
	DCA LINENO	/SAVE IT
	NEGATE
	FENT
	FADD PTEMP	/GET FRACTION
	FMUL FL100
	FADD FLP5	/ROUND UP
	FEXT
	JMS I INTEGER
	TAD LINENO	/ADD GROUP
TESTA,	DCA LINENO
	CLA CLL

	TAD LINENO	/CHECK FOR ERROR
	AND P7600
	SZA CLA
	CML
	TAD LINENO
	AND P177
	SNL SZA
GZERR,	ERROR2		/ILLEGAL GROUP ZERO USAGE
	SZA CLA		/AND SET NAGSW
	TAD P2000
	CML RAL
	DCA NAGSW
	JMP I XGETLN
PUSHB1,	3576+13


LCON,	DECONV
P7740,	7740
P2000,	2000

/RANGE OF ACCEPTABLE LINE NUMBERS = 1.01 TO 31.99
/NAGSW:

/GROUP=0000
/LINE=4000
/ALL=0001

/---------------------------------------------------------------------
/LIST OF FUNCTION ADDRESSES. (NAMES ARE IN "FNTABL")

FNTABF=.
	XABS	/FABS	-ABSOLUTE VALUE
	XSGN	/FSGN	-SIGN PART
	XINT	/FITR	-INTEGER PART
	FDIS	/TEK 4010 DISPLAY FUNCTION
PFRAN,	FRAN	/FRAN	-RANDOM NUMBER
	FJOY	/TEK 4010 CROSSHAIR INPUT FUNCTION
	ARTN	/FATN	-ARCTANGENT
	FEXP	/FEXP	-E^X
	FLOG	/FLOG	-LN(X)
	FSIN	/FSIN	-SINE
	FCOS	/FCOS	-COSINE
	XSQRT	/FSQT	-SQUARE ROOT
	FIN	/CHARACTER INPUT FUNCTION
	FOUT	/CHARACTER OUTPUT FUNCTION
	FIND	/FIND FUNCTION

/-----------------------------------------------------------------------
XRTL6,	0	/ROTATE AC LEFT SIX - "RTL6"
	CLL RTL
	RTL
	RTL
	JMP I XRTL6	/--RETURN--

/RECURSIVE OPERATE, EXECUTE, OR CALL 

DO,	GETLN		/EXECUTE ONE LINE, A GROUP,OR ALL
	TAD PC		/SAVE ADDRESS
	PUSHA		/OF CURRENT LINE
	PUSHF		/SAVE REST OF THIS LINE
	TEXTP		/ADDRESS OF TEXT POINTERS
DGRP,	PUSHF		/SAVE NAGSW; CHAR; AND LINENO.
	NAGSW
	TAD NAGSW	/CHECK DATA FROM GETLN.
	SPA CLA		/SKIP IF GROUP OR ALL
	JMP DOONE	/DO ONE LINE
	FINDLN		/INIT FOR GROUP AND SET THISLN
	NOP
	TAD THISLN	/TEST FOR GOOD GROUP NUMBER.
	DCA XRT
	JMS I DXRT	/TAD I XRT	/*8K*
	TSTGRP
	ERROR2		/NO SUCH GROUP NUMBER
DGRP1,	PUSHJ		/EXECUTE OBJECT LINE AND SET PC.
	PROCESS-2
	POPF		/RESTORE THE DATA
	NAGSW
	JMS I DPC
	SNA
	JMP DCONT	/ALL DONE
	IAC
	DCA PT1		/SAVE POINTER TO LINENO
	TAD NAGSW	/CHECK FOR GROUP
	SMA SZA CLA
	JMP .+4		/DO ALL
	JMS I DPT1	/TAD I PT1
	TSTGRP
	JMP DCONT	/NOT IN GROUP
	JMS I DPT1	/TAD I PT1
	DCA LINENO
	JMP DGRP	/CONTINUE THE SUBROUTINE

DOONE,	FINDLN		/FIND THE LINE
	ERROR2		/NO SUCH LINE NUMBER
	PUSHJ		/EXECUTE IT
	PROCESS
	POPF		/RESTORE CHAR
	NAGSW
DCONT,	POPF		/RESTORE TEXT POINTERS
	TEXTP
	POPA		/RESTORE ADDRESS OF CURRENT LINE.
	DCA PC
	JMP I .+1	/CONTINUE PROCESSING THIS LINE.
	PROC

/PUSHDOWN LIST CONTROLS

PD2,	0		/PUSHDOWN THE AC - "PUSHA"
	TAD I PD2
	ISZ PD2
	DCA .+3
	CIF
	JMS I .+3
	0
	JMP I PD2
	MPD2

PD3,	0
	TAD I PD3
	DCA .+4
	ISZ PD3
	CIF
	JMS I .+3
	0
	JMP I PD3
	MPD3

XPOPA,	0
	CIF
	JMS I .+2
	JMP I XPOPA
	MPOPA

ZSERCH,	TAD STARTV
	TAD Z3
	DCA PT1		/POINT TO MANTISSA
	TAD LASTV	/CHECKED ALL VARIABLES FOR 0?
	CLL CIA
	TAD PT1
	SZL CLA
	JMP ZERROR	/FAKE ERROR MESSAGE (NO CHANGE FROM FOCAL)
	TAD I PT1	/ IS THIS VARIABLE = 0?
	SNA CLA
	JMP I ZFOUND	/YES, CHANGE ITS NAME
	TAD PT1		/NO, CHECK THE NEXT
	TAD GINC
	JMP ZSERCH+2

ZERROR,	TAD Z1467	/FAKE ERROR ADDRESS (+1)
	DCA I 166	/(ERROR2-JMS I 0)
	JMP I 166	/KLUDGE

Z1467,	1467
Z3,	3
ZFOUND, ZERFND


FIND,	TAD XFIND1	/SETUP 'READC' EXIT
	DCA I RDIV
	JMS I INTEGER		/FIX ARG
	CLA
FIND1,	JMS I INDEV	/GET THE NEXT CHAR
	DCA CHAR	/SAVE IT
	TAD CHAR
	CIA		/IS IT THE ONE WE WANT?
	TAD FLAC+2
	SZA CLA
	JMP I XCHIN	/GO FINISH 'READC' (ECHO)
	JMP I EFUN3I

XFIND1,	FIND1
XCHIN,	CHIN+3


