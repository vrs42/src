P177,	177	/STEP MASK
P17,	17	/BCD MASK
P277,	277	/"?"
M2,	-2	/CONSTANT
MINUSA,	-301	/CONSTANT
C260,	260	/ASCII FOR ZERO
M240,	-240	/SPACE TEST
MPER,	-256	/PERIOD TEST
MCR,	-215	/C.R. TEST
MFLT,	-WORDS	/= -4 FOR 4-WORD
M5,	-5	/PAREN TEST
M11,	-11	/PAREN TEST
P77,	77	/RIGHT MASK
C200,	200	/CONSTANTS
P4000,	4000	/NAGSW TEST CONSTANT (FOR PDP-5)

FLARGP,	FLARG	/DATA ADDRESS
DOUBLE,	MULT2	/MULTIPLY FLAC BY 2
FOUTPUT,FLOUTP	/FLOATING OUTPUT
FINPUT,	FLINTP	/FLOATING INPUT
	COMBUF=.
LIBN,	LIBFIL	/COMMAND BUFFER START
CFRS,	LINE0	/ADDRESS OF DUMMY LINE

STARTV=.
END,	STVAR	/VARIABLE BUFFER START
ENDT,	LINE1	/TEXT BUFFER START
EFUN3I,	EFUN3	/FUNCTION RETURN
CFRSX,	FLTZER	/MOVED FOR ^L FUDGE


