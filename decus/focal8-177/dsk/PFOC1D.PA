ILIST,	IF1		/,
	PROCESS		/;
	PC1		/CR

		/ENGLISH-FRENCH
COMLST=.	/COMMAND DECODING LIST
	323	/SET 	- ORGANIZE
	306	/FOR 	- QUAND
	311	/IF 	- SI
	304	/DO 	- FAIZ
	307	/GOTO 	- VA
	303	/COMMENT- COMMENTE
	301	/ASK 	- DEMANDE
	324	/TYPE 	- TAPE
	314	/LIBRARY- ENTREPOSE
	305	/ERASE 	- BIFFE
	327	/WRITE 	- INSCRIS
	315	/MODIFY	- MODIFIE
	321	/QUIT 	- ARRETE
	322	/RETURN	- RETOURNE
	"O		/ADD 'OPEN' COMMAND

