@@
C-FOCAL,1969

01.70 S A(1)=5;S A(2)=6;S A(3)=7;T %5
01.80 A !!,"TO GO FIRST TYPE 1, OTHERWISE TYPE 0  ",AA
01.84 I (AA-1)1.86,12.1,1.88
01.86 I (AA)1.88,1.9,20.1
01.88 T !,"FOLLOW DIRECTIONS ";G 1.8
01.90 S A(3)=3;G 12.1

03.10 A !,"TYPE 1,2,OR 3 FOR THE COLUMN",C
03.15 A !,"TYPE THE NUMBER OF COINS YOU WISH TO REMOVE",N
03.16 I (N)3.18,3.18,3.17
03.17 I (N-FITR(N))3.2,3.2
03.18 T !,"ILLEGAL MOVE  ";G 3.1
03.20 I (C-3)3.3,3.6,3.5
03.30 I (C-2)3.4,3.6
03.40 I (C-1)3.5,3.6
03.50 T !,"FOLLOW DIRECTIONS ";G 3.1
03.60 I (A(C)-N)3.7,3.8,3.8
03.70 T !,"ONLY",A(C),"    COIN(S) IN COLUMN",C;G 3.1
03.80 S A(C)=A(C)-N

05.10 F B=1,1,3; DO 6.0
05.20 G 7.1

06.10 S R(B) =FITR(A(B)/4)
06.20 S RE = A(B)-(R(B)*4)
06.30 S T(B) = FITR(RE/2)
06.40 S O(B) = RE - (T(B)*2)

07.10 S S(1) = R(1) + R(2) + R(3)
07.20 S S(2) = T(1) + T(2) + T(3)
07.30 S S(3) = O(1) + O(2) + O(3)
07.40 F B = 1,1,3; D 8.0
07.50 G 9.1

08.10 I (S(B)-3)8.2,8.3
08.20 I (S(B)-1)8.4,8.3,8.4
08.30 S S(B) = 5
08.40 R

09.10 I (S(1)-5)9.2,9.4
09.20 I (S(2)-5)9.3,9.6
09.30 I (S(3)-5)11.6,9.8,11.6
09.40 F B=1,1,3;D 16.0
09.41 G 10.1
09.60 F B = 1,1,3; D 17.0
09.61 G 10.2
09.80 F B =1,1,3;D 18.0
09.81 G 11.1

10.10 I (S(2)-5)10.2,10.3
10.20 I (S(3)-5)11.1,10.4
10.30 I (T(G))20.1,10.32,10.34
10.32 S T(G)=1;G 10.2
10.34 S T(G)=0;G 10.2
10.40 I (O(G))20.1,10.42,10.44
10.42 S O(G)=1;G 11.1
10.44 S O(G)=0

11.10 F B=1,1,3;S A(B)=4*R(B)+2*T(B)+O(B)
11.20 G 11.8
11.60 F B =1,1,3;D 19.0
11.80 I (A(1)+A(2)+A(3))20.1,15.1,11.9
11.90 I (A(1)+A(2)+A(3)-1)20.1,14.1,12.1

12.10 T !,"   COL 1     COL 2     COL 3
12.20 T !,   A(1),"    ",A(2),"    ",A(3);G 3.1

14.10 T !!,"YOU WIN,  LUCKY",!!;G 15.2

15.10 T !!," I  WIN  ",!!
15.20 A !!,"  PLAY AGAIN?   ",W
15.40 I (W-0YES)15.6,1.7
15.60 Q

16.10 I (R(B))8.4,8.4,16.2
16.20 S R(B) = 0;S G = B;S B = 4;R

17.10 I (T(B))8.4,8.4,17.2
17.20 S T(B)=0;S G=B;S B=4;R

18.10 I (O(B))8.4,8.4,18.2
18.20 S O(B)=0;S B=4;R

19.10 I (A(B))8.4,8.4,19.2
19.20 S A(B)=A(B)-1;S B=5;R

20.10 T !,"HELP  HELP  "
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@