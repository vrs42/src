
C-FOCAL,1969

01.20 T !!!!!!,%6.04;E
01.22 T "PUT EQUATION IN 03.20;  OF THE FORM  '3.2 SET Y=F(X)'", !
01.24 T "THEN START AT 01.28, WITH A  'GO 1.28'",!!
01.26 Q
01.28 T !;S RC=3.14159/180
01.30 A "INITIAL X ",X0,!
01.32 A "FINAL   X ",XL,!!
01.34 T "X INCREMENT ",(XL-X0)/50
01.36 A "    X SCALE ",XI,!!
01.38 S X=XL;D 3;S YN=Y;S X=X0;D 3;S YM=Y
01.40 F I=0,50;S X=I*XI+X0;D 3;D 6
01.42 T "MAXIMUM Y ",YM,!,"MINIMUM Y ",YN,!!
01.44 A "INiTIAL Y COORDINATE ",Y0,!!
01.46 T "Y INCREMENT ",(YM-Y0)/70
01.48 A "    Y SCALE ",YI,!!
01.50 S YS=YI*70+(Y0)
01.60 T " *",%6.04,Y0,"                                        "
01.62 T "           ",YS,"*",!
01.64 D 7

02.20 F I=0,50;S X=I*XI+X0;D 3;D 4;D 5
02.22 D 7
02.30 Q

03.20 SET Y=70

04.10 S R=R+1
04.12 IF (R-10)4.14,4.16,4.16
04.14 T ".";G 4.17
04.16 T "*";S R=0
04.17 S V=FITR(FABS(Y/YI-Y0/YI))
04.18 I (V)4.2,4.22,4.2
04.20 F J=1,V;T " "
04.22 R

05.20 IF (Y)5.32,5.34,5.36
05.32 T "-",!;R
05.34 T "0",!;R
05.36 T "+",!;R

06.20 I (Y-YM)6.3,6.24,6.24
06.24 s YM=Y
06.30 I (Y-YN)6.34;
06.32 R
06.34 S YN=Y;R

07.20 T " *.........*.........*.........*.........*"
07.22 T ".........*.........*.........*",#
07.24 I (YS)7.32;
07.26 I (-Y0)7.32;
07.28 F I=Y0,YI,0;T " "
07.30 T "0"
07.32 T !;S R=10
*8x