
C-FOCAL , 8/68

01.01 T !,"GREAT CIRCLE DISTANCE BETWEEN 2 POINTS";S R=.174533E-1
01.10 A !!,"LAT OF 1ST POINT IN DEG & MIN",D,M;S L1=(90-D-M/60)*R
01.30 A !,"LON OF 1ST POINT IN DEG & MIN",D,M;S L2=D+M/60
01.50 A !,"LAT OF 2ND POINT IN DEG & MIN",D,M;S L3=(90-D-M/60)*R
01.70 A !,"LON OF 2ND POINT IN DEG & MIN",D,M;S L2=(D+M/60-L2)*R

02.10 S M=FCOS(L1)*FCOS(L3)+FSIN(L1)*FSIN(L3)*FCOS(L2)
02.20 I (M) 2.3,2.4,3.2
02.30 I (M+1) 2.33,2.33,2.36
02.33 S D=3.14159;G 3.3
02.36 S D=FATN(FSQT(1-M*M)/M)+3.14159;G 3.3
02.40 S D=1.57079;G 3.3

03.20 I (M-1) 3.26,3.23,3.23
03.23 S D=0;G 3.3
03.26 S D=FATN(FSQT(1-M*M)/M)
03.30 T !,"ANGLE",%5.02,D/R," DEGS,   DIST",%6.01,D*3960," MILES"
03.40 G 1.10
*