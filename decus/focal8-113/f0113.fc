
C-FOCAL,1969

01.10 T !"TITRATION WITH 0.1M REAGENTS. PH VERSUS FRAC. TITR."
01.20 A !"NUMBER OF REPLACEABLE HYDROGENS ="N
01.40 S A(1)=1;F I=2,N+1;D 8
01.41 T !"         0   1   2   3   4   5   6   7   8"
01.42 T "   9  10  11  12  13",!
01.60 S J=0;S Q=-.01
01.80 F P=0,.05,N+.1;D 3

03.10 I (P-Q)3.3,3.2,3.2
03.20 T %4.02,"  "P,"*",#;S Q=Q+.5;D 5
03.30 S H=FEXP(-J*2.303);S J=J+.25
03.40 S S=0;F I=1,N+1;S B(I)=A(I)*H^(N+1-I);S S=S+B(I)
03.50 F I=2,N+1;S C(I-1)=(I-1)*B(I)/S
03.60 S S=0;F I=1,N;S S=S+C(I)
03.70 S Y=S-P+(.1+P*.1)*(1.E-14/H-H)/.01
03.80 I (.26-J)3.9;S T=FSGN(Y);G 3.3
03.90 I (T+FSGN(Y))3.3,3.91,3.3
03.91 S J=J-.5;F I=0,.25,J+2;T " "
03.92 T "O",!;T "         *",#

04.10 Q

05.10 T "         *...*...*...*...*...*...*...*...*...*"
05.20 T "...*...*...*...*",#

08.10 A !"PKA"K;S K=FEXP(-K*2.303);T !
08.20 S A(I)=A(I-1)*K
*