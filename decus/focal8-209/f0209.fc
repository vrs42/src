01.20 A "NUMBER OF POINTS",NV,!
01.25 T "  X    Y"!
01.30 F I=1,NV-1;DO 2.0

02.04 A X(I),Y(I)
02.20 S SX=SX+X(I);S SY=SY+Y(I)
02.25 S XY=XY+X(I)*Y(I)
02.30 S Y2=Y2 +Y(I)*Y(I);S X2=X2+X(I)*X(I)

03.10 T !,"    X(I)        Y(I)        YC(I)        DIFF(I)",!!
03.20 S SS=SX*SX;S B=(NV*XY-SX*SY)/(NV*X2-SS);S A=(SY-B*SX)/NV
03.30 S R=(NV*XY-SX*SY)/(FSQT(NV*X2-SX*SX)*FSQT(NV*Y2-SY*SY))
03.40 S SM=0.;F I=1,NV-1;D 4.0

04.10 S YC(I)=A+B*X(I);S D(I)=YC(I)-Y(I);S SM =SM+D(I)*D(I)
04.20 T X(I),Y(I),YC(I),D(I),!

05.20 T "CORR.COEFF.",R,"   SUM SQ.RESID.",SM,!
05.30 T "SLOPE AND INTERCEPT",B,A,!!
05.40 S RR=FSQT((Y2-A*SY-B*XY)/(NV-2))
05.50 S EA=RR*FSQT(X2/(NV*X2-SX*SX))
05.60 S EB=RR*FSQT(NV/(NV*X2-SX*SX))
05.70 T "STANDARD ERROR OF SLOPE=    ",EB,!
05.80 T "STANDARD ERROR OF INTERCEPT=   ",EA,!!!
*