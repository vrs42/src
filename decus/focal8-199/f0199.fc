@@@@@@@@@@@@@@@@@@@@@@@@@@
C-FOCAL,1969

01.01 C STOCK MARKET GAME BY RON PAPA, 11/17/71,HAMDEN HIGH
01.05 T %8.02,"STOCK MARKET",!,!
01.10 T "MONEY LEFT   $10000",!,"STOCKS ARE:",!
01.13 T "BURGARD BREWERIES  20",!,"HHS INDUSTRIALS  25",!
01.15 T "RUPP RADIO  10",!!

02.01 S G=25;S H=20;S I=10;S B=10000;S P=0;S Q=0;S R=0

04.05 A !,"BUY OR SELL?",S,!
04.15 I (S-0BUY)9.01,5.05,9.01

05.05 T "NO. TO BUY(ONE STOCK,UP TO 300 SHARES)",!
05.10 A "HHS",X
05.15 I (X)13.01,5.17,5.30
05.17 A "BUR",Y
05.20 I (Y)13.01,5.22,5.35
05.22 A "RUP",Z
05.25 I (Z)13.01,4.05,5.40
05.30 I (X-300)6.01,6.01,13.01
05.35 I (Y-300)7.01,7.01,13.01
05.40 I (Z-300)8.01,8.01,13.01

06.01 S P=P+X
06.05 S BG=G;S G=G+((4*FRAN())-3)*3.5;I (G)6.05
06.10 S B=B-X*BG;I (B)13.10,13.10
06.15 T !, "BT. AT",BG,!,"SHRS",P,!,"$ LFT.",B,!,"AT",G,!;G 4.05

07.01 S Q=Q+Y
07.05 S BH=H;S H=H+((4*FRAN())-3)*3.5;I (H)7.05
07.10 S B=B-Y*BH;I (B)13.10,13.10
07.15 T !, "BT. AT",BH,!,"SHRS",Q,!,"$ LFT.",B,!,"AT",H,!;G 4.05

08.01 S R=R+Z
08.05 S BI=I;S I=I+((4*FRAN())-3)*3.5;I (I)8.05
08.10 S B=B-Z*BI;I (B)13.10,13.10
08.15 T !, "BT. AT",BI,!,"SHRS",R,!,"$ LFT.",B,!,"AT",I,!;G 4.05

09.01 T "NO. TO SELL (ONE STOCK)",!
09.05 A "HHS",L
09.10 I (L)13.01,9.12,9.25
09.12 A "BUR",M
09.15 I (M)13.01,9.17,9.30
09.17 A "RUP",N
09.20 I (N)13.01,4.05,9.35
09.25 I (P-L)13.01,10.01,10.01
09.30 I (Q-M)13.01,11.01,11.01
09.35 I (R-N)13.01,12.01,12.01

10.01 S P=P-L;D 6.05;S B=B+L*BG;I (B)13.10,13.10
10.05 T !,"SOLD AT",BG,!,"SHRS",P,!,"$ LEFT",B,!,"AT",G,!;G 4.05

11.01 S Q=Q-M;D 7.05;S B=B+M*BH;I (B)13.10,13.10
11.05 T !,"SOLD AT",BH,!,"SHRS",Q,!,"$ LEFT",B,!,"AT",H,!;G 4.05

12.01 S R=R-N;D 8.05;S B=B+(N*BI);I (B)13.10,13.10
12.05 T !,"SOLD AT",BI,!,"SHRS",R,!,"$ LEFT",B,!,"AT",I,!;G 4.05

13.01 T "NOT POSSIBLE",!;G 4.05
13.10 T !, "SORRY YOU JUST RAN OUT OF MONEY",!
13.15 A "SELL?",AA,!;I (AA-0NO)9.01,13.29,9.01
13.29 T "YOU JUST LOST YOUR SEAT ON THE STOCK EXCHANGE!",!;Q
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@p|