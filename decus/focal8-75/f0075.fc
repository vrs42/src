@@@@@@@@@@@@@@@@@@@@@@@@
C-FOCAL , 8/68

01.09 E
01.10 T !!"BLACKJACK"!,"MINIMUM BET IS $1.  
01.13 T "HOUSE LIMIT OF $1000"!!
01.20 A "YOUR BET IS"A;IF (1000-A) 1.13
01.22 S X=0;IF (A-1) 3.4
01.26 T "YOUR HAND", !
01.30 DO 2;S R=C;DO 2;T "  ";S D=R+C
01.32 IF (D-21)1.4,3.5,3.6
01.40 T !!"DEALER'S HAND";DO 2;S J=C
01.41 T !;G 4.1
01.42 T !!"WANT A HIT?";A H;IF (H-2) 1.5,1.6
01.50 DO 2;;T !;S L=D+C;S D=D+C;IF (L-21) 1.42,1.42,3.7
01.60 S L=D;T !;DO 2;S G=J+C;IF (G-21) 1.62,1.62,3.2
01.62 IF (G-16) 1.63,1.63,1.8
01.63 DO 2;S G=G+C;IF (G-21) 1.62,1.62,1.65
01.65 IF (X-1) 3.2,3.9,3.2;T !!
01.80 T %2, "     ="G,!!;IF (X-1) 1.82,4.5,1.82
01.82 IF (G-L) 3.2,3.8,3.3
01.83 IF (G-L) 3.9,3.8,3.91

02.10 S C=FITR(15*FABS(FRAN()));I (C-14)2.2,2.2,2.1
02.20 I (C-1) 2.1;I (C-11) 2.3,2.9,2.35
02.30 T %2,"  "C;R
02.35 I (C-12) 2.1,2.6,2.4
02.40 I (C-13) 2.1,2.7,2.5
02.50 I (C-14) 2.1,2.8,2.1
02.60 S C=10;T "    J";R
02.70 S C=10;T "    Q";R
02.80 S C=10;T "    K";R
02.90 T "    A";R

03.20 S B=B+A;T %7.02,!"YOU WIN. YOUR WINNINGS ARE  "B,!!;G 1.2
03.30 S B=B-A;T %7.02,!"YOU LOSE. YOUR WINNINGS ARE "B,!!;G 1.2
03.40 T "MINIMUM BET IS $1"!!;G 1.2
03.50 S B=B+(1.5*A);T "BLACKJACK!!"
03.51 T %7.02,!"YOUR WINNINGS ARE  "B,!!;G 1.2
03.60 T "IMPOSSIBLE HAND"!!;G 1.26
03.70 S B=B-A;T %7.02,!"BUST!! YOUR WINNINGS ARE  "B,!!;G 1.2
03.80 T %7.02 "THE HAND IS A TIE! YOUR WINNINGS ARE "B,!!;G 1.2
03.90 S B=B+(2*A);T %7.02,! "YOU WIN. YOUR WINNINGS ARE "B,!!;G 1.2
03.91 S B=B-(2*A);T %7.02,! "YOU LOSE. YOUR WINNINGS ARE "B,!!;G 1.2

04.10 IF (D-10) 1.42,4.3,4.2
04.20 IF (D-11) 1.42,4.3,1.42
04.30 A "DOUBLE DOWN OPTION"X;IF (2-X) 4.3,1.42,1.6
04.50 DO 2;T !;S L=D+C;IF (L-21) 1.83,4.7,3.91
04.70 G 1.83
