
C TIC-TAC-TOE GAME, PROGRAMMED BY DOUG WILSON & MARK H. LINEHAN
C AT GOVERNOR DUMMER ACADEMY, MAY 17. 1970.

C RULES: (1) POSITIONS ARE REFERENCED BY NUMBER ACCORDING TO
C    TO THIS MAP:
C    1  2  3
C    4  5  6
C    7  8  9
C        (2) I WILL SHOW MY MOVES BY X'S AND YOURS BY O'S.
C        (3) I WILL MOVE FIRST.
C        (4) EXTENDED FUNCTIONS SHOULD NOT BE IN CORE IN A
C    4K SYSTEM.


C-FOCAL,1969

02.10 F A=1,9;S B(A)=0
02.20 G 10.2

03.10 T "  I MOVE TO LOCATION",%1,A,":",!!;S B(A)=1
03.20 F A=1,9;I (B(A))3.21,3.22;T "X";G 3.23
03.21 T "O";G 3.23
03.22 T "-";G 3.23
03.23 S X=X+1;I (3-X)3.24,3.24;T "  "
03.24 T !;S X=0
03.30 A !"YOUR MOVE",A;I (A)3.42,3.42;I (A-9)3.4,3.4,3.42
03.40 I (B(A))3.5,3.41,3.5
03.41 S B(A)=-1;R
03.42 T "  WHAT DO YOU MEAN?
03.43 G 3.3
03.50 T "  THAT POSITION IS ALREADY TAKEN
03.60 G 3.3

04.10 D 3.1;D 3.2
04.20 T "I WIN AGAIN!";S W=W+1
04.22 T "     RUNNING SCORE:"!"WINS",W
04.23 T "  TIES",T,"  LOSSES=0
04.24 A "  PLAY AGAIN?",A
04.25 I (A-0YES)4.3,2.1,4.3
04.30 I (A-155)4.4,4.35,4.4
04.35 T !;E
04.36 Q
04.40 T "YES OR NO?";G 4.24

05.10 D 3.1;D 3.2
05.20 A "I'M AMAZED; YOU ACTUALLY FORCED ME TO A TIE!
05.30 S T=T+1;G 4.22

10.20 S A=1;D 3;I (A-5)13.8,10.3,13.8
10.30 S A=9;D 3;I (A-3)10.8,10.4,10.8
10.40 S A=7;D 3;I (A-8)10.5,10.6,10.5
10.50 S A=8;G 4.1
10.60 S A=4;G 4.1
10.80 I (A-7)11.3,10.9,11.3
10.90 S A=3;D 3;I (A-2)11.1,11.2,11.1

11.10 S A=2;G 4.1
11.20 S A=6;G 4.1
11.30 I (A-2)12.01,11.4,12.01
11.40 S A=8;D 3;I (A-7)11.5,11.6,11.5
11.50 S A=7;G 4.1
11.60 S A=3;D 3;I (A-6)11.2,11.8,11.2
11.80 S A=4;G 5.1

12.01 I (A-4)12.6,12.1,12.6
12.10 S A=6;D 3;I (A-3)12.2,12.3,12.2
12.20 S A=3;G 4.1
12.30 S A=7;D 3;I (A-8)10.5,12.5,10.5
12.50 S A=2;G 5.1
12.60 I (A-6)13.2,12.7,13.2
12.70 S A=4;D 3;I (A-7)11.5,12.9,11.5
12.90 S A=3;D 3;I (A-2)11.1,13.1,11.1

13.10 S A=8;G 5.1
13.20 I (A-8)10.3,13.3,10.3
13.30 S  A=2;D 3;I (A-3)12.2,13.5,12.2
13.50 S A=7;D 3;I (A-4)10.6,13.7,10.6
13.70 S A=6;G 5.1
13.80 I (A-2)13.9,14.01,13.9
13.90 I (A-3)14.5,14.01,14.5

14.01 S A=7;D 3;I (A-4)10.6,14.2,10.6
14.20 S A=9;D 3;I (A-5)14.3,10.5,14.3
14.30 S A=5;G 4.1
14.50 I (A-4)14.6,15.01,14.6
14.60 I (A-7)14.7,15.01,14.7
14.70 I (A-6)14.8,14.9,14.8
14.80 I (A-8)14.9,15.3,14.9
14.90 S A=3;D 3;I (A-2)11.1,15.5,11.1

15.01 S A=3;D 3;I (A-2)11.1,15.2,11.1
15.20 S A=9;D 3;I (A-5)14.3,11.2,14.3
15.30 S A=3;D 3;I (A-2)11.1,15.8,11.1
15.50 S A=7;D 3;I (A-4)10.2,14.3,10.6
15.60 S A=9;G 4.1
15.80 S A=5;D 3;I (A-7)11.5,15.6,11.5
