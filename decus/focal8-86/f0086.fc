@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@E A
C-FOCAL , 8/68

01.01 T "K,C,F TEMPERATURE CONVERSION TABLE"!!
01.02 T %6.01; C <<<<< DEP. 0240 IN LOC. 1261 VICE 0275
01.03 T "INDICATE [FROM] SCALE AS 1   AND [TO] SCALE AS 2"!
01.05 T "ZERO THE SCALE NOT DESIRED"!
01.07 A "3- AVAILABLE SCALES, KELVIN",K,"CELSIUS",C,"FAHRENHEIT",Q,!
01.08 A "FROM  ",START,"  TO  ",END,"  DEGREES",!
01.09 A "IN INCREMENTS OF  ",INCR,"  DEGREES",!!
01.10 I (1-K)2.11,2.11
01.11 I (1-C)3.13,3.13
01.14 GOTO 1.03

02.11 I (1-C)5.01,7.01
02.13 I (1-Q)6.01,10.01; GOTO 1.03

03.13 I (1-Q)8.01,9.01; GOTO 1.03

05.01 T "K TO C",!
05.03 F T=START,INCR,END; T !; DO 5.07
05.05 Q
05.07 T " ",T," K. DEG.......",T-273.16," C. DEG."

06.01 T "K TO F",!
06.03 F T=START,INCR,END; T !; DO 6.07
06.05 Q
06.07 T " ",T," K. DEG......",[(T-273.16)*9/5]+32," F. DEG."

07.01 T "C TO K",!
07.03 F T=START,INCR,END; T !; DO 7.07
07.05 Q
07.07 T " ",T," C.DEG.......",T+273.16," K. DEG."

08.01 T "C TO F",!
08.03 F T=START,INCR,END; T !; DO 8.07
08.05 Q
08.07 T " ",T," C. DEG.......",(T*9/5)+32," F. DEG."

09.01 T "F TO C",!
09.03 F T=START,INCR,END; T !; DO 9.07
09.05 Q
09.07 T " ",T," F. DEG.......",(T-32)*5/9," C. DEG."

10.01 T "F TO K",!
10.03 F T=START,INCR,END; T !; DO 10.07
10.05 Q
10.07 T " ",T," F. DEG.......",[(T-32)*5/9]+273.16," K. DEG."
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@