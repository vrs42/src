CURFIT

C-FOCAL,1969

01.10 T !!!!"ENTER CURFIT OPTIONS
01.20 A !"NEW(1) OR OLD(0) RUN",A
01.30 I (A)2.1,2.1
01.40 A !"LINEAR(0), LOG-LOG(1), OR SEMILOG(-1) FIT",TS
01.50 A !"WEIGHTED(0), EQUAL-WT(1), OR COUNTER(-1) DATA",WS

02.05 S N=0;S SW=0;S SX=0;S SY=0;S XX=0;S YY=0;S XY=0
02.10 T !!"ENTER DATA, THEN TYPE 'TOTAL'
02.20 S W=1;A !,?X?;I (X-0TOTAL)2.3,4.1
02.30 A ?    Y?;I (-WS)2.7,2.6
02.40 I (Y)2.5,3.9
02.50 S W=1/Y;S Y=FABS(Y);G 2.7
02.60 A ?    W?
02.70 I (W)3.1,2.2;S NN=N+1;G 3.3

03.10 S NN=N-1
03.30 I (TS)3.5,3.7,3.4
03.40 I (X)3.9,3.9;S X=FLOG(X)
03.50 I (Y)3.9,3.9;S W=W*Y*Y;S Y=FLOG(Y)
03.70 S N=NN;S SW=SW+W;S SX=SX+W*X;S SY=SY+W*Y
03.80 S XX=XX+W*X*X;S YY=YY+W*Y*Y;S XY=XY+W*X*Y;G 2.2
03.90 T "VALUE MUST BE +";G 2.2

04.10 T %4,!!,?N?
04.20 S X=SX/SW;S Y=SY/SW;S DX=SW*XX-SX^2;S DY=SW*YY-SY^2
04.30 S B=(SW*XY-SX*SY)/DX;S A=Y-B*X
04.40 S S=FSQT(FABS((DY-B*B*DX)/((N-2)*SW)))
04.50 S SA=S*FSQT(XX/DX);S SB=S*FSQT(SW/DX);T %,!,?A ?," +- ",?SA?
04.60 I (TS)4.7,4.8
04.70 T !,?FEXP(A)?
04.80 T !,?B ?," +- ",?SB?
04.90 T !,?X ?,?    Y ?

05.10 D 6;T !"R ",B*FSQT(DX/DY),?    S ?,!!"FORCED THROUGH ORIGIN:"
05.20 S B =XY/XX;S SB=FSQT((YY-B*B*XX)/((N-1)*XX))
05.30 D 4.8;D 6;G 1.1

06.10 I (SB)6.2,6.2;T !,?B/SB?
06.20 R
*8