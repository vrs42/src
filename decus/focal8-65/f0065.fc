@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
C-FOCAL , 8/68

01.10 ERASE
01.15 S N=0;S TS=0
01.20 A "NO GROUPS",KI,!;T " SS / GROUP"
01.30 FOR I=1,1,KI; A N9(I);S N=N+N9(I)
01.40 T !!!,"DATA";S CH=1
01.50 FOR J=1,1,KI;S TS=TS+N9(J);T !!,"G";T %1,J,!;DO 1.6
01.55 GOTO 2.1
01.60 FOR I=CH,1,TS;ASK A(I);S G(I)=J;DO 1.7
01.70 S CH=TS+1

02.10 S I=N-1;T !
02.15 T "WAIT PATIENTLY",!!
02.20 DO 2.3
02.30 S CH=0;DO 3; IF (CH) 5.1,5.1,2.2

03.10 FOR J=1,1,I;DO 4

04.10 S TS=A(J); S K2=G(J)
04.20 IF (TS-A(J+1))4.9,4.9,4.3
04.30 S CH=CH+1;S A(J)=A(J+1);S G(J)=G(J+1)
04.40 S A(J+1)=TS; S G(J+1)=K2
04.90 RETURN

05.10 S IT=0;S IC=0;S SM=0
05.20 S A(N+1)=999;FOR J=1,1,N;DO 6
05.30 GOTO 7.1

06.10 IF (A(J)-A(J+1)) 6.3,6.2,6.3
06.20 S IT=IT+1;S IC=IC+J;GOTO 6.9
06.30 IF (IT) 6.7,6.7,6.4
06.40 S IC=IC+J;S IT=IT+1;S SM=SM+(IT^3-IT);S CH=IC/IT
06.50 S K2=(J-IT)+1;FOR I=K2,1,J;S A(I)=CH
06.60 S IC=0;S IT=0;GOTO 6.9
06.70 S A(J)=J
06.90 RETURN

07.10 S K2=0;S IC=0;S IT=0
07.20 FOR J=1,1,KI;DO 8
07.30 GOTO 9.1

08.10 S CH=N9(J);S I=0
08.12 S I=I+1;IF (I-N)8.13,8.13,8.15
08.13 IF (G(I)-J)8.12,8.14,8.12
08.14 S IC =IC+A(I);S IT=IT+1;IF (IT-CH)8.12,8.12
08.15 S K2=K2+((IC^2)/IT);S IC=0;S IT=0
08.40 RETURN

09.10 S J=((12/(N*(N+1)))*K2)-3*(N+1)
09.20 S CH=1-(SM/((N^3)-N));S IT=J/CH;S KI=KI-1
09.40 T "H  ";T %10.4,J,!
09.50 T "C  ";T %10.6,CH,!
09.60 T "H' ";T %10.4,IT,!
09.70 T "DF ";T %3,KI,!!!
09.80 QUIT
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@g