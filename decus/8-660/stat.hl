  MAY   25    1976

CORE 16
SUBM SYS:STAT/Q

MANUAL IN HASSLE PROGRAM FILE.

.EXECUTE DEV: STAT
*INPUT FILE /6
[*/3=4	TEMP.DA</3/C]
*$		OR /L$

REQUEST


NO	PERFORMS		ARGUMENTS		NOTES
-1	LIST DATA		OPT 1-3			NEXT CARD FORMAT
							IF ARG=0
							1=F10.1;2=F10.4
							3=G   NO MISSING

0	READ NEW DATA		NONE			MUST BE FOLLOWED BY
							NO OF GR,NUMBERS
							NO OF COL,NUMBERS
1	MEANS ETC		OPTIONAL		15=CALCULATE REDUC
							1-NK,0-NK SUMS

2	T=TEST			KOL1,KOL2,TYPE		1=NORMAL
							2=SD NOT EQUAL
							3=PAIRED
3	REGRESSION LINE		K1,K2,<OPTION>		OPTION<>0 LIST LINE
4	3-GROUP REGRESSION	K1,K2,<OPTIONAL>	IOPT<>0
							NEXT CARD IOPT(<4)
							PROBABILITIES 
5	CORRELATION MATRIX	NONE
6	ANOVA ONE SIDED		NONE
7	SHEFFE			NONE			SPECIAL RULES APPLY 
8	ANOVA TWO SIDED		NONE
13	WILCOXON		K1,K2
14	MANN WHITNEY		K1,K2
15	KRUSKAL WALLIS		ARG1
16	SPEARMAN RANK		K1,K2
17	FRIEDMAN
18	NUMERICAL INT		K1,K2,<ARG>		IF ARG<>0 PRINT
							PARTIAL AREAS
19	MEDIANS			K1,K2
	RANKS			K1,K2,1
20	K1,K2<NO OF GROUPS>	CROSS TAB		DEFAULT 5 GROUPS
							MAX 10
	K1=K2  "HISTOGRAM"

21	K1,K2<NO OF LINES>10				<50  DEFAULT  25>
	SCATTER PLOT
	100+LINES=LOG X
	LINES NEG=INPUT SCALE
22			TRANSFORMATIONS
22,NK,KOL1,-1		REDUCES MATRIX FROM NK TO KOL1 COLUMNS
			IF ATT IS TRUE.
22,KOL1			SORTS DATA MATRIX BY KOL1 ASCENDING.
22,-KOL1		SORTS DESCENDING.
22,KOL1,KOL2,CODE	SETS KOL2 TO CODE(KOL1)

	1	SQUARE ROOT
	2	EXP	<E**X>
	3	NATURAL LOG
	4	BASE 10 LOG
	5	SQUARE
	6	EQUAL	<COPIED OVER>

48,<IOPT>		TAKES IOPT(DEFAULT =1)CARDS FOLLOWING AND
			WRITES THEM TO OUTPUT FILE
49			FLAGS	ATT LDEVL LDEVE NOPAGE LIST
			IF FIRST CARD -4  FROM HERE TO 0 OR 50 ALL GROUPS.
			IF FIRST CARD -1,5,8 FROM HERE TO 0 OR 50
			GROUPS 5 TO 8.
