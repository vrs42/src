10.01 C   SIN: DO 10.2     COS: DO 10
10.10 S X=1.5707963268-X
10.20 I (X^2-.01)10.3;S X=X/3;D 10.2;S X=3*X-4*X^3;R
10.30 S X=X-X^3/6+X^5/120

11.01 C   TAN: DO 11
11.10 I (X^2-.01)11.2;S X=X/2;D 11;S X=2*X/(1-X^2+1E-99);R
11.20 S X=X+X^3/3+X^5/7.5+X^7/315

12.01 C   ASIN: DO 12      ACOS: D 12.3
12.10 I (X^2-.01)12.2;S X=X/(FSQT(1+X)+FSQT(1-X));D 12;S X=2*X;R
12.20 S X=X+X^3/6+.075*X^5+X^7/22.4;R
12.30 D 12;D 10.1

13.01 C   ATAN: DO 13
13.10 I (X^2-.01)13.2;S X=X/(1+FSQT(X^2+1));D 13;S X=2*X;R
13.20 S X=X-X^3/3+X^5/5-X^7/7

14.01 C   EXP: DO 14
14.10 I (X^2-.01)14.2;S X=X/2;D 14;S X=X^2;R
14.20 S X=1+X+X^2/2+X^3/6+X^4/24+X^5/120+X^6/720

15.01 C   LOG: DO 15
15.10 I (X^2-2.04*X+1)15.2;S X=FSQT(X);D 15;S X=2*X;R
15.20 S X=(X-1)/(X+1);S X=2*(X+X^3/3+X^5/5+X^7/7)

16.01 C   SINH: DO 16      COSH: DO 16.3
16.10 I (X^2-.01)16.2;S X=X/3;D 16;S X=3*X+4*X^3;R
16.20 S X=X+X^3/6+X^5/120;R
16.30 D 16;S X=FSQT(1+X^2)
           
