@@@@C-FOCAL,1969

01.10 T "RECHTWINKLIGE KOORDINATEN IN POLARKOORDINATEN"!!
01.20 A "X" X; A "Y" Y
01.30 T %6.03 "RADIUS" FSQT(X^2+Y^2),!

02.10 I (X)2.4,2.3,2.5
02.30 I (Y)3.4,4.2,3.2
02.40 I (Y)3.6,3.3,3.6
02.50 I (Y)3.7,3.1,3.5

0.10 S W=  0 ;GOTO 4.1
03.20 S W= 90 ;GOTO 4.1
0.30 S W=180 ;GOTO 4.1
03.40 S W=270 ;GOTO 4.1
03.50 S W=    57.2958*FATN(Y/X) ; GOTO 4.1
03.60 S W=180+57.2958*FATN(Y/X) ; GOTO 4.1
0.70 S W=360+57.2958*FATN(Y/X) ; GOTO 4.1

4.10 T %6.03"WINKEL" W, " GRAD", !!;GOTO 1.2
04.20 T "KOORDINATENURSPRUNG" !!;GOTO 1.2
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@|