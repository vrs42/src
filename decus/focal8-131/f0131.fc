
C-FOCAL,1969

02.10 S X=0;S A=0;S L=0
02.20 ASK Z
02.30 S D(X)=Z;S X=X+1;IF (X-2)2.2,2.4,2.4
02.40 IF (FABS(D(0))-FABS(D(1)))2.5,3.1,3.1
02.50 S TM=D(0);S D(0)=D(1);S D(1)=TM

03.10 S Z=0;S X=0;S NC=0;S PC=0
03.20 ASK T
03.30 IF (D(X))3.31,3.32,3.33
03.31 S D(X)=FABS(D(X));IF (NC-1)3.32,3.4,3.4
03.32 S NC=NC+1;GOTO 3.35
03.33 IF (PC-1)3.34,3.4,3.4
03.34 S PC=PC+1
03.35 S X=X+1;IF (X-1)3.3,3.3,3.8
03.40 S Z=D(1)
03.41 S Z=Z+T;IF (Z-D(0))3.6,3.6,3.91
03.50 IF (X-1)3.41,3.41,3.8
03.60 S Y=(1/FSQT(6.284))*FEXP(-.5*(Z*Z))
03.70 S A=A+(Y*T);GOTO 3.5
03.80 S Z=Z+T;IF (Z-D(1))3.6,3.6,3.9
03.90 S L=A;S A=0;S X=0;GOTO 3.4
03.91 S CF=(2*L)+A
03.92 T "% CUMULATIVE FREQ",100*CF
03.93 QUIT
*G