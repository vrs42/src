@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
C-PROGRAM FOR SKETCHING TRAVELING WAVES - MOD 4 - 1/31/70 - PIKE, A L

01.05 T !,"FOCAL TRAVELING-WAVE SKETCHES";S AM=10.0
01.10 A !!!,"ENTER I OR R (INCIDENT OR REFLECTED)",K
01.15 I (K-0I)1.10,1.30
01.20 I (K-0R)1.10,1.25,1.10
01.25 S PT=-1;G 1.35
01.30 S PT=+1
01.35 A !!,"ENTER ALPHA (0<ALPHA<1)",AF
01.40 I (AF)1.35;
01.45 I (AF-1)1.50,1.50,1.35
01.50 I (PT)1.55;S AM=AM*FEXP(-4*AF)
01.55 A !!,"ENTER NEW TIME ",T
01.60 I (T-0QUIT)1.65,1.99,1.65
01.65 S K=PT*(0.00001+AF);T !!,"FOR ALPHA ",%3.02,K,"      "
01.66 I (PT)1.67;T " INCIDENT";G 1.68
01.67 T "REFLECTED"
01.68 T " WAVE AT T ",%8.03,T,!
01.69 T !,"                                  LOAD^"
01.70 F Y=0,1/3,4;D 2
01.72 T !,"                                  SOURCE"
01.75 G 1.55
01.99 T !;QUIT

02.10 S IA=AM*FEXP(PT*AF*Y)
02.20 S IB=FSIN(3.141593*(10*T+(PT*Y/2)))
02.30 S I=IA*IB
02.40 T !,%3.02,"Y ",Y,"   AMP ",I,"      "
02.50 D 3
02.60 R

03.10 S LC=FITR(21-2*I)
03.20 I (Y-0.1)3.50,3.50;
03.30 F J=1,41;D 5
03.40 R
03.50 F J=1,41;D 4
03.60 G 2.60

04.10 I (J-LC)4.20,4.30,4.20
04.20 T ".";R
04.30 T "*";R

05.10 I (J-LC)5.20,5.40;
05.20 I (J-21)5.30,5.50,5.60
05.30 T " ";R
05.40 D 4.30;R
05.50 D 4.20;R
05.60 I (J-LC)5.70,5.80,2.60
05.70 D 5.30;R
05.80 D 4.30;G 2.60

TYPE !

*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
