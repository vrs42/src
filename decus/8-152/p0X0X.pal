/NOTE LENGTHS
/
/
*0150
DURTBL=.	/ Duration table
SCALEF=20
SIXT,	0010^SCALEF
SIXT1,	0014^SCALEF
EIGHT,	0020^SCALEF
EIGHT1,	0030^SCALEF
QUART,	0040^SCALEF
QUART1,	0060^SCALEF
