C-FOCAL,1969
*
*01.01 T "MPS RADIATION PATTERN PROGRAM",!!
*01.02 S A=0
*01.03 T "THIS PROGRAM COMPUTES THE RADIATION PATTERN OF ANY",!#
*01.04 T "DIRECTIONAL RADIO ARRAY.",!!#
*01.06 A "GIVE ELEVATION ANGLE",Z;S Z=Z/57.3
*01.07 A "GIVE 1ST AZIMUTH",K
*01.09 A "TABULATION INCREMENT?",L
*01.11 A "LAST AZIMUTH?",M,!
*01.13 A "# OF TOWERS IS",N,!
*01.20 FOR A=1,N; DO 2.0
*01.24 T "AZIMUTH         MV/M",!!#
*01.30 FOR O=K,L,M;DO 4.0
*01.32 T "END",!;QUIT
*
*02.01 T %1,"TOWER #",A,!
*02.02 A "SPACING",B(A)
*02.03 A "HEIGHT",C
*02.04 A "AZIMUTH",D;S R(A)=D/57.3
*02.05 A "PHASE",E(A)
*02.06 A "RMS",G,!
*02.10 S H=FCOS((C*FSIN(Z))/57.3)-FCOS(C/57.3)
*02.11 S I=(1-FCOS(C/57.3))*FCOS(Z)
*02.13 S J(A)=G*(H/I)
*
*03.01 S X=O/57.3
*03.05 S P(A)=FCOS((B(A)*FCOS(Z)*FCOS(R(A)-X)+E(A))/57.3)
*03.10 S S(A)=J(A)*P(A)
*03.12 S T=T+S(A)
*
*04.01 FOR A=1,N; DO 3.0
*04.03 T %5.02,O
*04.08 T %5.01,"       ",T,!
*04.09 S T=0
**~8@