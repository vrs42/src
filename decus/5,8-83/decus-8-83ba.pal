FIXMRI FPUT=6000
FIXMRI FGET=5000
FEXT=0000

/ADDITIONS TO CDP FOR FLOATING EXAMINAYTION AND
/MODIFICATION. 3 WORD PACKAGE.
/JAMES ROTHMAN  JULY 27,1967
*3530                   /ADDITIONS TO ODP FOR EXAMINING AND
        OUTPUT=11       /MODIFYING FLOATING POINT NUMBERS
        INPUT=12
EX,     JMS I OCTRD     /EXAMINE INSTRUCTION
        DCA TEMP
        JMS I 7
        FPUT TEMP2      /SAVE FAC
        FGET I TEMP
        OUTPUT
        FGET TEMP2
        FEXT
        JMP I BEG
IN,     JMS I 7 /INSERT INSTRUCTION
        FPUT TEMP2
        INPUT
        FPUT I TEMP
        FGET TEMP2
        FEXT
        TAD P4
        TAD TEMP        /NEXT FLOATING NUMBER
        DCA TEMP
        JMP I BEG
NEXT,   TAD P4  /EXAMINE NEXT
        TAD TEMP
        DCA TEMP
        TAD TEMP
        JMS I OCTPNT    /PRINT ADDRESS
        JMP EX+2
IPUT,   0       /CHECK AND CALL INPUT
        JMS I 5
        TAD 60          /VALID INPUT?
        SNA CLA
        JMP .-3 /NO. TRY AGAIN.
        JMP I IPUT      /YES. EXIT.
/CONSTANTS AND POINTERS FOR ADDITIONS.
P4,     3
TEMP,   0
TEMP2,  0;0;0           /TEMP. FAC STORAGE
OCTRD,  4113
OCTPNT, 3705
BEG,    3602
*4563   /MODIFICATIONS TO ADDRESS TABLE IN ODP
        IN
        EX
        NEXT
*4550   /COMMAND TABLE IN ODP
        -305    /CHANGE O TO E
*6555   /INTERPRETATION TABLE IN PACKAGE
        7200    /FLOATING OUTPUT
        IPUT    /FLOATING INPUT
$


