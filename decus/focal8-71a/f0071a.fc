
C-8K FOCAL @1969

01.40 T !!!"THIS IS THE PDP-2/3 MEMORIAL GOLF COURSE"
01.41 T !"PAY YOUR GREEN FEES AND REMEMBER"
01.48 T !"KEEP YOUR LEFT ARM STRAIGHT"!!;G 2.05
01.50 T !"THANK YOU"!
01.51 T !"YOU LIE THROUGH YOUR TEETH"!;G 2.24
01.52 T !"AH,COMEON. NO ONE HITS A 5-IRON THAT HARD";G 2.14
01.53 D 1.5;G 2.2
01.54 T !"FIBBER! YOU CAN'T HIT THE BALL PERFECTLY STRAIGHT";G 2.2

02.05 T !!"PLEASE INDICATE THE CALIBER OF GOLFER THAT YOU ARE"
02.06 T !"BY ANSWERING THE FOLLOWING 3 QUESTIONS"
02.07 T !!"TYPE POWER WITH 5-IRON FROM THIS TABLE"
02.08 T !"DISTANCE IN YARDS     YOUR RESPONSE"!"      110               1.0"
02.09 T !"      130               2.0"!"      150               3.0"
02.10 T !"      170               4.0"!"      190               5.0"
02.11 T !!"THUS TYPE ANY DECIMAL NUMBER BETWEEN 1.0 AND 5.0"
02.12 A P;I (P-1)2.11;I (5-P)2.11;I (4.1-P)1.52;D 1.5
02.14 T !!!"TYPE NORMAL DIRECTION OF SHOTS FROM THIS TABLE"
02.15 T !"DIRECTION   YOUR RESPONSE"!"  HOOK        -2.0"
02.16 T !"  DRAW        -1.0"!"STRAIGHT       0.0"!"  FADE        +1.0"
02.17 T !" SLICE        +2.0"
02.18 T !!"THUS TYPE ANY DECIMAL NUMBER BETWEEN -2.0 AND +2.0"
02.19 A D;I (D+2)2.18;I (2-D)2.18;I (D)1.53,1.54,1.53
02.20 T !!"TYPE AVERAGE NO. PUTTS PER ROUND (18 HOLES)";A PR
02.22 I (PR-18)2.2;I (PR-30)1.51;D 1.5
02.24 T !!"NOTE:(+)OFF CENTER IS TO THE RIGHT;(-)IS TO THE LEFT"
02.25 S M=0;S TS=0;S PT=0
02.26 T !"AND EACH HOLE IS 50 YARDS WIDE,25 TO THE LEFT"
02.27 T !"AND 25 TO THE RIGHT WITH OUT OF BOUNDS BEYOND THAT"
02.30 T !!"THE FOLLOWING TABLE IS USED FOR HOLE CONFIGURATION:"
02.31 T !!!!"SYMBOL TYPED       MEANING"
02.32 T !"     O              GREEN"
02.33 T !"                   FAIRWAY"
02.34 T !"     .               SAND"
02.35 T !"     W              WATER"
02.36 T !"     T              TREES"
02.37 T !"     ,              ROUGH"
02.38 T !"     *               BALL"
02.39 T !"     +            HOLE(PIN)"!
02.40 G 2.5
02.50 T !!"AS YOU PLAY, YOU WILL BE ASKED A SERIES OF 3 QUESTIONS"
02.51 T !"FOR EACH SHOT: WHICH CLUB,HOW HARD, AND WHAT DIRECTION."
02.52 T !!!"FOR THE FIRST QUESTION (CLUB), ALWAYS TYPE A"
02.53 T !"NUMBER (INTEGER) FROM 0 TO 11"
02.54 T !"0=DRIVER,1=1-IRON OR 2-WOOD,2=2-IRON OR 3-WOOD"
02.55 T !"..... 9=9-IRON,10=PITCH (50-100 YARDS),11=CHIP (0-50 YARDS)"
02.56 T !!!"FOR THE SECOND QUESTION (SPEED),TYPE A DECIMAL NUMBER"
02.57 T !"BETWEEN 1.0 (FOR VERY SOFT) AND 5.0 (FOR VERY HARD)"
02.58 T !!!"FOR THE THIRD QUESTION (DIRECTION), YOU MUST RESPOND"
02.59 T !"WITH A SIGNED DECIMAL OR SIGNED INTEGER NUMBER"
02.60 T !"A MINUS (-) SIGN INDICATES DIRECTIONTO THE LEFT"
02.61 T !"A POSITIVE (+) SIGN [OR NO SIGN] INDICATES TO THD RIGHT AND"
02.62 T !"THE MAGNITUDE OF THE NUMBER INDICATES THE AMOUNT TO"
02.63 T !"THE LEFT OR TO TH RIGHT"!"AS A HINT "
02.64 T !"-31 IS APPROXIMATELY STRAIGHT LEFT AND +31 STRAIGHT RIGHT"
02.65 T !"NOW TO BEGIN PLAY, READ IN THE FIRST HOLE FROM THE"
02.66 T !"HOLES TAPE AND TYPE (RE-TURN),G 3.05,(RE-TURN)"
02.67 T !"GOOD LUCK,ARNIE"!;Q

03.05 S M=M+1;S S=0;S XT=0;S YT=0;T %2,!!!"YOU HAVE ARRIVED AT HOLE"M;D 10
03.10 S WS=FITR(10*FRAN());S A=FRAN();I (A-.75)3.15,3.15,3.20
03.15 S WD=WS;T !"WIND FROM LEFT";G 3.25
03.20 S WD=-1.0*WS;T !"WIND FROM RIGHT"
03.25 T " AT "WS," YDS/(100 YARDS)"!
03.30 S ST=1.;S PT=PT+PA
03.35 T !"READY FOR SHOT SELECTION"
03.36 T !"SELECT CLUB";A C;I (11-C)3.36;I (C)3.35
03.40 T "       SPEED";A SS;I (5-SS)3.4;I (SS-1)3.4
03.45 T "       DIRECTION";A DS
03.50 S B=10*FRAN()-5.;I (B-4.)3.8,3.8
03.55 I (B-6.)3.6,3.8,3.8
03.60 I (B-5.)3.7,3.7
03.65 S DS=DS+1;G 3.8
03.70 S DS=DS-1
03.80 S SS=SS-3;I (P-2)3.85,3.9,3.95
03.85 S A=(9-C)*5+90+2.5*SS;G 4.2
03.90 S A=(9-C)*7.5+100+3.75*SS;G 4.2
03.95 I (P-4)4.05,4.10,4.15

04.05 S A=(9-C)*10+110+5*SS;G 4.2
04.10 S A=(9-C)*15+110+7.5*SS;G 4.2
04.15 S A=(9-C)*20+110+10*SS
04.20 I (C-10) 4.23,4.22
04.21 S A=(SS+3)*10+(P-3)*3;G 4.23
04.22 S A=50+(SS+3)*10+(P-3)*4
04.23 S Z=A*WD/100;I (ST-2)4.55,4.25,4.3
04.25 S A=.6*A;S Z=.6*Z;G 4.4
04.30 I (ST-4)4.55,4.4,4.5
04.40 S AA=FRAN();I (AA-.6)4.45,4.45,4.55
04.45 S A=0;S Z=0;T !"ITS A SWING AND A MISS";G 4.55
04.50 S A=.8*A;S Z=.8*Z
04.55 S YS=.05*(DS+D);S YD=A*FCOS(YS);S XD=A*FSIN(YS)+Z
04.60 S XT=XT+XD;S YT=YT+YD
04.65 I (FABS(XT)-25.)4.8,4.8
04.70 S S=S+2;S XA=XT;S YA=YT;S XT=XT-XD;S YT=YT-YD
04.75 T !!!" OUT OF BOUNDS (2 PENALTY STROKES)"
04.76 T %6.02,!!"YOU LANDED ("YA," AHEAD,"XA," OFF LINE) TRY AGAIN";G 3.35
04.80 S S=S+1;T !!"YOU HAVE JUST LANDED"
04.81 I (YT-(NO/5)*30)4.85,4.85
04.82 S S=S-1;G 4.7
04.85 S RW=FITR((YT/30.0)+.01);S CL=FITR((XT-5.)/10.+.5)+3
04.90 S ST=SA(RW*5+CL);I (ST-1)4.95,5.05,5.1
04.95 T %3,!"ON THE GREEN, AT ("YT,XT,"), HOLE IS ("PY,PX,")";G 6.05

05.05 T !"IN THE FAIRWAY";G 5.3
05.10 I (ST-3)5.15,5.20,5.25
05.15 T !"IN A TRAP";G 5.3
05.20 T !"IN THE WATER (1 PENALTY STROKE)";S S=S+1;G 5.3
05.25 T !"IN THE ROUGH"
05.30 S TG=FSQT((XT-PX)^2+(YT-PY)^2)
05.35 T %3,!"YOU ARE "TG,"  YARDS FROM PIN",XT," YARDS OFF CENTER"
05.41 T %3,!"AND "YT," YARDS FROM TEE"
05.42 T !"DO YOU WISH TO SEE HOLE AGAIN?(TYPE Y OR N)";A BB
05.43 I (BB-0N)5.44,3.35
05.44 D 13;G 3.35

06.05 S TG=FSQT((XT-PX)^2+(YT-PY)^2)
06.10 T %3,!"YOU ARE "3*TG," FEET FROM THE HOLE"
06.11 I (PR-28)6.13;I (PR-35)6.14
06.12 S U1=20;S U2=7;S U3=1;G 6.15
06.13 S U1=40;S U2=15;S U3=6;G 6.15
06.14 S U1=30;S U2=10;S U3=3
06.15 I (U1-TG)6.4
06.20 I (U2-TG)6.45
06.25 I (U3-TG)6.5
06.30 S PP=1;G 7.8
06.40 S PP=4;G 7.8
06.45 S PP=3;G 7.8
06.50 S PP=2

07.80 T !%2,"YOU HAD "PP," PUTT(S)";S S=S+PP
07.82 S TS=TS+S
07.85 T %3,!"YOU HAD A "S," FOR HOLE "M," ,PRESENT TOTAL "TS
07.90 T %3,!"PAR TOTAL"PT," ,SO YOU ARE"TS-PT," TO PAR"
07.91 I (M-9)7.96,7.93;I (M-18)7.96
07.92 T !!"YOU HAVE COMPLETED 18 HOLES, DUBBER,YOU'RE THROUGH"!;D 8
07.93 T !!"YOU'VE FINISHED THE FRONT 9, GO GRAB A DRINK"
07.94 F WS=1,600;S WD=WD
07.95 T !!"NOW TO THE BACK 9"
07.96 T !!"(TO CONTINUE, READ NEXT HOLE THROUGH READER)"
07.97 T !"(THEN TYPE (RE-TURN),G 3.05,(RE-TURN))"!;Q

08.01 I (PT-TS)8.2,8.1;T %3,!!"YOU WERE "PT-TS," UNDER PAR. GREAT ROUND"!;Q
08.10 T !!"YOU WERE EVEN PAR. NICE SHOOTING"!;Q
08.20 T %3,!!"YOU WERE "TS-PT," OVER PAR. GO PRACTICE"!!
08.21 I (20-(TS-PT))8.22;Q
08.22 T !!"ON SECOND THOUGHT, QUIT"!;Q

12.01 T %2,!"PAR"PA
12.02 T !"YARDAGE                  CONFIGURATION"
12.03 D 13;R

13.01 S EN=0;S EM=0;D 20

20.01 F I=1,5,NO;S J=NO-I+1;D 30
20.02 I (EN)20.07,20.03,20.07
20.03 T %3,!0,"-<";I (-EN)20.07;F K=1,24;T " "
20.05 T "*";F K=1,25;T " "
20.06 T ">"
20.07 S E=0;S EM=0
20.09 T !!"O=GREEN,   =FAIRWAY,  .=SAND,  W=WATER,  T=TREES,  ,=ROUGH"
20.11 T !"*=BALL,  +=HOLE(PIN)"
20.13 T !"HOLE IS"PY," YARDS AWAY AND"PX," YARDS OFF CENTER"!!;R

30.01 I (-EN)30.15
30.02 S DI=((J-5)/5)*30+.001;T %3,!DI+30,"-<"
30.03 I (PY-DI)30.07;I (-EM)30.07,30.04,30.07
30.04 F K=-25,25;I (PX-K-1)30.05;T " "
30.05 T "+"#,"       ";S EM=1;G 30.07
30.07 I (YT-DI)30.11;I (-EN)30.11,30.08,30.11
30.08 F K=-25,25;I (XT-K-1)30.09;T " "
30.09 T "*"#,"       ";S EN=1;G 30.11
30.11 F K=J-4,J;D 31
30.13 T ">";R
30.15 I (-EM)30.17,30.02
30.17 R

31.01 I (SA(K)-1)31.03,31.04;I (SA(K)-3)31.05,31.06;I (SA(K)-5)31.07
31.02 T ",,,,,,,,,,";R
31.03 T "OOOOOOOOOO";R
31.04 T "          ";R
31.05 T "..........";R
31.06 T "WWWWWWWWWW";R
31.07 T "TTTTTTTTTT";R
*g