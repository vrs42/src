
C-FOCAL., 1968

01.01T %8.03;E
01.02A "R"R;A "C"C;S DF=(R-1)*(C-1);S L=R*C
01.03S I=1;S J=1;S K=1;S RP=0;S RS=0;S CS=0;S T=0;S X2=0
01.04A "S"N(K);S RP=RP+N(K);S CS(J)=CS(J)+N(K);S K=K+1
01.05S J=J+1
01.06I (C-J)1.07,1.04,1.04
01.07S RS(I)=RP;S J=1;S I=I+1;S RP=0
01.08I (R-I)1.09,1.04,1.04
01.09I (L-(K-1))1.10,2.01,2.01
01.10T !!;T "E1";T !!;G 1.01

02.01F J=1,1,R;S T=T+RS(J)
02.02S J=1;S I=1;S K=1
02.03S E(K)=(RS(I)/T)*CS(J);S J=J+1;S K=K+1
02.04I (C-J)2.05,2.03,2.03
02.05S J=1;S I=I+1
02.06I (R-I)2.07,2.03,2.03
02.07I (L-(K-1))2.08,3.01,3.01
02.08T !!;T "E2";T !!

03.01F K=1,1,L;S X2=X2+((N(K)-E(K))^2)/E(K)

04.01T !!;S K=1;S Y=1;S N=1;S I=1;D 8.0;T !
04.02F J=1,1,C;D 6.0
04.03T "*";T !;F J=1,1,C;D 5.0
04.04T "*";T "  ";T "RS"RS(N);S N=N+1;T !
04.05F J=1,1,C;D 7.0
04.06T "*";T !;D 8.0;T !;S I=I+1;I (R-I)4.07,4.02,4.02
04.07T !;F J=1,1,C;D 9.0
04.08T %;T "  T"T;T !!;T "X2"X2;T "    ";T %8.03;T "DF"DF;T !!
04.09A "M?"Z;I (Z-2)4.10,1.01,1.01
04.10Q

05.01T "*";T "              "

06.01T "*";T " ";T "O"N(K);T " ";S K=K+1

07.01T "*";T " ";T "E"E(Y);T " ";S Y=Y+1

08.01F M=1,1,(C*15+1);T "*"

09.01T " ";T "CS"CS(J);T " "
*8