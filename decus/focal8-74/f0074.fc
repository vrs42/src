
C-8K MODV 11-219

01.10 A !!!,"NUMBER OF POINTS",N;*;A X,X;*;F I=1,N;*;A X(I);A Y(I);*
01.15 S H=0;S HH=0;S V=0;S HV=0;S DD=0
01.20 F I=1,N;S H=H+X(I);S HH=HH+X(I)^2;S V=V+Y(I);S HV=HV+X(I)*Y(I)
01.30 S DN=N*HH-H*H;S SL=(N*HV-H*V)/DN;S IN=(V*HH-H*HV)/DN
01.40 F I=1,N;S DD=DD+(Y(I)-SL*X(I)-IN)^2
01.50 S DSL=N*DD/((N-2)*DN);S DIN=FSQT(DSL*HH/N);S DSL=FSQT(DSL)
01.60 T !!!,"  THE SLOPE IS ",SL," AND INTERCEPT IS ",IN
01.61 T !,"UNCERTAINTY IS ",DSL,"      AND         ",DIN,!!!
01.65 T "        I         X(I)       Y(I)",!;F I=1,N;T I,X(I),Y(I),!
*