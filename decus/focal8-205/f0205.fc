
C-FOCAL,  5/69

02.05 O X,S 160;T %2,"PLOT OF A RANDOM WALK"!"CONNECT THE DOTS IN 
02.10 T"NUMERICAL ORDER"!;S PA=1;A"DISPLACEMENTS PER PAGE "DI
02.15 T !!?PAGE?,!!;F I=1,DI;D 2.3
02.20 G 4.05
02.30 D 3;S X(I)=N;D 3;S Y(I)=N;R

03.05 S N=FABS(FITR(25.5*FRAN()));I(N-1)3.05;I(25-N)3.05;R

04.05 T!"#";F J=1,26;T" #"
04.10 F J=1,25;T!"#";F I=1,DI;D 4.2
04.15 D 4.05;T!!!!!!!!!!;S PA=PA+1;G 2.15
04.20 I(J-X(I))4.25;T &1+2*(Y(I)),I,#;S X(I)=50
04.25 R
_
_
C-FOCAL,  5/69

02.05 O X,S 160;T "PLOT OF A RANDOM WALK"!"CONNECT THE DOTS IN 
02.10 T"NUMERICAL ORDER"!;S PA=1;A"DISPLACEMENTS PER PAGE "DI
02.12 S SS=0;S X(0)=12;S Y(0)=12
02.15 T %2,!!?PAGE?,!!;S S=0;F I=1,DI;D 2.3
02.20 S X(0)=X(DI);S Y(0)=Y(DI);G 4.05
02.30 D 3;S X(I)=N;D 3;S Y(I)=N;D 2.4
02.40 S S=S+FSQT([<X(I)-X(I-1)>^2]+[<Y(I)-Y(I-1)>^2]);R

03.05 S N=FABS(FITR(25.5*FRAN());I(N-1)3.05;I(25-N)3.05;R

04.05 T!"#";F J=1,26;T" #"
04.10 F J=1,25;T!#";F I=1,DI;D 4.2
04.15 D 4.05;T %8.2!!"MEAN FREE PATH"S/(DI);D 4.3
04.17 T %8.4,!"SIGMA"1/[FSQT(2)*S],!!!!!!!!!!;S PA=PA+1;G 2.15
04.20 I(J-X(I))4.25;T &1+2*(Y(I)),I,#;S X(I)=50
04.25 R
04.30 S SS=SS+S/(DI);!"AVERAGE OF"%3,PA," PAGES"%8.2,SS/PA
_



























