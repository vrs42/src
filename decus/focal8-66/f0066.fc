
C-FOCAL , 8/68

01.01 A "K"K;S J=1
01.02 A "M"M(J);A "N"N(J)
01.03 I (K-J)1.05,1.05,1.04
01.04 S J=J+1;G 1.02
01.05 A "S"S

02.01 A "F"XF; T !!
02.02 T "GR.#"; F Z=2,1,K;T %2 "  ",Z
02.03 T !!

03.01 S J=1;S P=J+1
03.03 S C(J)=0;S C(P)=0
03.04 T %2 J;S Q=1
03.05 I (J-Q)3.08,3.08
03.06 T "     .";S Q=Q+1;G 3.05
03.08 S C(J)=1;S C(P)=-1

04.01 S H=0;S V=0;S SV=0
04.02 S Q=1
04.03 S H=H+C(Q)*M(Q);S V=V+C(Q)^2*(S/N(Q))
04.04 I (K-Q)4.06,4.06,4.05
04.05 S Q=Q+1;G 4.03
04.06 S SV=(K-1)*XF;S XX=FSQT(SV)*FSQT(V)
04.07 S U=H+XX; S L=H-XX

05.01 T "    "
05.02 I (L*U)5.03,5.03,5.04
05.03 T " N"; G 5.05
05.04 T " *"
05.05 I (K-P)5.07,5.07
05.06 S C(P)=0;S C(J)=0;S P=P+1;G 3.08
05.07 I (K-(J-1))6.01,6.01
05.08 S C(P)=0;S C(J)=0;S J=J+1;T !!;S P=J+1;I (J-K)3.04

06.01 T !!!;A "NEW F? (ANS. Y OR N)",AN
06.02 I (AN-25)6.03,2.01,2.01
06.03 T !!, "GOODBYE",!!;Q
*x`