@@@@@@@@@@@@@@@@@@@@@@@@@
C-FOCAL,1969

01.01 T !!,"MATRIX MULTIPLICATION",!!,"DO YOU WANT INTERMEDIARY "
01.02 A "RESULTS ? TYPE 'Y' FOR YES.",O,!!,"MATRIX A."
01.03 A !,"HOW MANY COLUMNS ?",IM,"   ROWS ?",JM,!!
01.04 S J=0
01.05 S I=0
01.06 A A(J+I*JM),"     "; S I=I+1; I (I-IM)1.06
01.07 T !!; S J=J+1; I (J-JM)1.05
01.10 A !!!,"FOLLOWING MATRIX :",!,"HOW MANY COLUMNS ?",U
01.11 I (U)1.12,1.19; A "   ROWS ?",LM,!!; I (IM-LM)1.12,1.14
01.12 T !!,"THE NEW MATRIX WILL NOT BE CONFORM WITH THE ACTUAL "
01.13 T "RESULT ;",!,"PLEASE ,TRY AGAIN."; G 1.10
01.14 S L=0; S KM=U
01.15 S K=0
01.16 A B(L+K*LM),"     ";S K=K+1; I (K-KM)1.16
01.17 T !!;S L=L+1; I (L-LM)1.15,2.02
01.19 S KM=IM; G 2.10

02.02 SET P=0
02.03 SET Q=0
02.04 S M=0; S L=Q+P*JM; S C(L)=0
02.05 S C(L)=C(L)+A(Q+M*JM)*B(M+P*LM)
02.06 S M=M+1; I (M-IM)2.05
02.07 S Q=Q+1; I (Q-JM)2.04
02.08 S P=P+1; I (P-KM)2.03
02.09 I (O-25)2.24,2.10,2.24
02.10 T !!,"PRODUCTMATRIX IS :"; F J=0,(JM-1); D 2.12
02.11 G 2.24
02.12 T % !!; I (4-KM)2.13; F K=0,(KM-1);T C(J+K*JM),"   "
02.13 F K=0,(KM-1); T !,C(J+K*JM),"   "
02.24 F N=0,(JM*KM-1);SET A(N)=C(N)
02.25 S IM=KM; G 1.10
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@|