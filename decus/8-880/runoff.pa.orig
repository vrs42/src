	JMP HEAD3	/YES, ILLEGAL HEADER ARGUMENT
	TAD NOFLG	/NO, WAS IT SIMPLY "NO" ?
	SZA
	DCA SWHEAD	/YES, JUST "NO", EQUIV. TO "NOHEADER"
HEAD2,	EOCGO

HEAD3,	ERRORC		/ILLEGAL HEADER ARGUMENT
	TEXT \HD\
	*.-1

HSTYLE,	TAD (7774	/JUST STYLE BITS
HDPUT,	AND HWORD	/COME HERE FROM OTHERS
	TAD SORTCN	/HAS THE STYLE CODE
	DCA HWORD	/PUT IT AWAY
	JMP HEAD1	/MAYBE ANOTHER

HPOSIT,	TAD (-4		/POSITION 4-7
	TAD SORTCN	/GET JUST THE 2 BITS
	CLL RTL		/INTO POSITION
	DCA SORTCN	/AND SAVE
	TAD (7763	/MASK FOR POSITION
	JMP HDPUT	/PUT IT IN THE HEADER

HPLACE,	SKP		/TOP OF PAGE
HPLACI,	STL CLA RAR	/BOTTOM OF PAGE
	DCA SORTCN	/SAVE IT
	CLL STA RAR	/AC3777 MASK
	JMP HDPUT

HBASE,	SKP		/ARABIC
HBASI,	STL CLA RTR	/AC2000 FOR ROMAN
	DCA SORTCN	/SAVE IT
	CLL STA RTR	/AC5777 MASK
	JMP HDPUT

HSPLIT,	TAD [" ]	/USE A SPACE FOR SPLIT CHAR
