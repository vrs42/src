	*.-1
TITLE4,	GETC		/NOW GO TO END OF COMMAND
	TAD CHAR
	SZA CLA
	JMP TITLE4
TITLE5,	DCA I AUTOX3	/ZERO TO END THE TITLE OR SUBTITLE
	CDF 0		/BACK TO FLD 0
	RETURN		/THEN RETURN

NOTITL,	STA		/TURN OF TITLE STUFF
	DCA TITFLG
	JMP NUMC2	/A GOOD WAY TO GO HOME

