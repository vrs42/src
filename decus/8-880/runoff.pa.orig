/ GENERAL LOCATIONS USED THROUGHOUT PROGRAM, NOT INITIALIZED

COUNT,	0		/GENERAL COUNTER
CTR1,	0		/OTHER COUNTERS
CTR2,	0
PTR1,	0		/TEMPORARY POINTERS
PTR2,	0
CHAR,	0		/HOLDS LAST INPUT CHAR
NUMBER,	0		/HOLDS LAST NUMBER CONVERTED (ALSO TEMP)
SIGN,	0		/SIGN OF LAST NUMBER CONVERTED
CVRTQ,	0		/INDICATES WHETHER LAST NO. WAS CONVERTED
