SWJUST,	YES		/0 = .JUSTIFY, 7777 = .NOJUSTUFY
SWFILL,	YES		/0 = .FILL, 7777 = .NOFILL
LSPACE,	-1		/ASSUME SINGLE SPACING
PARAGN,	5		/INDENT 5 SPACES ON PARAGRAPH
MODE,	7777		/7777 = \\, SET LOWER CASE MODE
			/0000 = ^^, SET UPPER CASE MODE

UNMODE,	7777		/7777 = \&, CLEAR UNDERLINE MODE
			/0000 = ^&, SET UNDERLINE MODE
