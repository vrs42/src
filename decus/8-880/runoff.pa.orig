LENOL,	0		/LENGTH OF OUTPUT LINE BETWEEN MARGS
OUTPTR,	0		/GET SET TO CURRENT POSITION IN LINE
OUTCTR,	0		/(-) NO. OF CHARS LEFT ON LINE
