SBTTLC,	TAD (SBTTLB-1)	/INIT PTR FOR SUBTITLE
	SKP		/COUNT IS SAME AS TITLE

EVEN,	TAD (EVBUFF-1)	/INIT FOR EVEN PAGE STUFF
	SKP		/DITTO ABOVE

ODD,	TAD (ODBUFF-1)	/NOW OFR ODD PAGES
