@@@@@@@
C-FOCAL,1969

01.05 E
01.10 A ?KOLUMNS ROWS?,!,?OBSERVATIONS?
01.20 F A=1,1,RO;T !;D 10.0
01.30 F A=1,1,KO; S QR=QR+SK(A)^2/OB*RO
01.40 S SV=SV^2/OB*KO*RO; S B=SB;

02.20 S SR=SR-SV; S QR=QR-SV;S SS=SS-SV;
02.25 S B=B-SV;S SV=SS-B; S X=B-SR-QR
02.30 T !!!,"ANOVA
02.40 T !, "SOURCE          SS      DF     MS            F
02.50 T !, %8.04,"ROWS       ",SR,%2.00,RO-1,%8.04,SR/(RO-1)
02.55 T RO*KO*(OB-1)*SR/SV*(RO-1),!,"KOLUMNS    ",QR,%2.00
02.60 T KO-1,%8.04,QR/(KO-1),RO*KO*(OB-1)*QR/SV*(KO-1),!
02.70 T "INTERACTION",X,%2.00,(KO-1)*(RO-1),%8.04,X/(KO-1)*(RO-1)
02.75 T X*RO*KO*(OB-1)/(KO-1)*(RO-1)*SV,!,"SUBTOTAL   ",B
02.80 T %2.00,KO*RO-1,%8.04,B/(KO*RO-1),
02.85 T B*RO*KO*(OB-1)/SV*(KO*RO-1),! ,"WHITHIN    
02.90 T SV,%2.00,KO*RO*(OB-1),%8.04,SV/KO*RO*(OB-1),!
02.95 T "TOTAL      ", SS,%2.00,KO*RO*OB-1,!!;Q

03.05 S SX=0; S XX=0
03.10 F C=1,1,OB; A X; S SX=SX+X; S XX=XX+X*X
03.20 S RR=RR+SX; S SK(B)=SK(B)+SX
03.30 S SV=SV+SX;S SS=SS+XX
03.40 S SB=SB+SX^2/OB

10.10 S RR=0;F B=1,1,KO; T !; D 3.0
10.20 S SR=SR+RR^2/OB*KO
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@