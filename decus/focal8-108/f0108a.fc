C-FOCAL,1969

01.05 E
01.10 A ?KO,RO?,!,?OB?
01.20 F A=1,1,RO; T !; F B=1,1,KO; T !; D 3.0
01.40 T !!;F A=1,1,RO,;T !,; S SR=0;S0; D 5.0
01.50 T !;F B= 1,1,KO; S SS=0; S SV=0; D 8.0
01.60 S SS=0; S SV=0; F A=1,1,KO*RO;D 9.4
01.70 S C=OB*KO*RO; T !!, "T           ";D 7.0
01.75 T %8.04
01.80 S SR=0; F A=1,1,RO; S X=0; D 10,01.90 S QR=0;F B=1,1,KO;S X=0; D 11.0

02.05 S SV=0;S SS=0;S B=0;F A=1,1,RO*KO;D 12.0
02.10 S SV=SV^
02.20 S SR=SR-SV; S QR=QR-SV;SS SS=SS-SV;
02.25 S B=B-SV;S SV=SS-B; P X=B-SR-QR
02.50 T !!!!,"R",SR,RO-1,SR/(RO-1)
02.55 T RO*KO*(OB-1)*SR/SV*(RO-1),!,"K",QR,
02.60 T KO-1,QR/(KO-1),RO*KO*(OB-1)*QR/SV*(KO-1),!
02.70 T ,"I",,X,(KO-1)*(RO-1),X/(KO-1)*(RO-1)02.75 T X*RO*KO*(OB-1)/(KO-1)*(RO-1)*SV,!,"S",B
02.80 T ,KO*RO-1,,B/(KO*RO-1),
02.85 T B*RO*KO*(OB-1)/SV*(KO*RO-1),! ,"W
02.90 T SV,KO*RO*(OB-1),SV/KO*RO*(OB-1),!
02.95 T "T",, SS,,KO*RO*OB-1,!!;Q

03.05 S D=(A-1)*KO+B
03.10 F C=1,1,OB;A X; S SV(D)=SV(D)+X; S SS(D)=SS(D)+X*X

05.10 F B=1,1,KO; D 6.0
05.20 S SV=SR; S SS=QR; S C=OB*KO; T !, "R",%2.00,A,"       "; D 7.0

06.10 D 3.05 ;S SV=SV(D); S SS=SS(D); S C=OB
06.20 S SR= SR+SV; S QR=QR+SS
06.30 T %2.00,!, A,",",B,"   ";D 7.0

07.10 T %8.04
07.30 T SV/C, FSQT((SS-SV^2/C)/C*(C-1)), %3.00,C

08.10 F A= 1,1,RO; D 9.3
08.20 S C= OB*RO; T !,"K",%2.00,B,"       "; D 7.0

09.30 D 3.05;S SS=SS+SS(D); S SV=SV+SV(D)
09.40 S SS=SS(A)+SS; S SV=SV(A)+SV

10.10 F B=1,1,KO;D 3.05;S X=X+SV(D);
10.20 S SR=SR+X*X/OB*KO

11.10 F A=1,1,RO;D 3.05; S X=X+SV(D)
11.20 S QR=QR+X*X/OB*RO

12.10 S  SV=SV+SV(A);S SS=SS+SS(A)
12.20 S B=B+SV(A)^2/OB
