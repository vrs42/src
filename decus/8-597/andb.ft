C	PROGRAM ANDB.FT
C	---------------
C
C
C
C
	SUBROUTINE ANDB(IN,IOUT,MASK)
C
C
C
C
C	PETER LEMKIN
C	NATIONAL INSTITUTES OF HEALTH
C	BETHESDA, MD 20014
C
C
C	JUNE  10 ,1971
C	REVISED DECEMBER 1, 1972
C
C
C	INTRODUCTION
C	------------
C	ANDS THE INPUT INTEGER VARIABLE WITH THE MASK TO GIVE
C	THE OUTPUT INTEGER VARIABLE.
C	ARGUMENTS
C	----------
C	1. INPUT - TO BE "AND"ED. IT IS USED BY VALUE.
C	2. IOUT - THE RESULT OF THE "AND".
C	3. MASK - THE MASK USED FOR THE LOGICAL BIT "AND".
C
C
C
C
C
S	CLA CLL
S	TAD I \IN
S	AND I \MASK
S	DCA I \IOUT
	RETURN
	END
