TP1,	FLTEMP
ONEP2,	FLTONE
X1,	X
/	LOGARITHM
FLOG,	GETSGN
	SPA SNA
	ERROR		/ZERO OR NEGATIVE ARGUMENT
	FENT
	FPT I TP1
	FSB I ONEP2
	FEXT
	GETSGN
	SNA
	JMP ZERGO	/LOG(1)=0
	SMA CLA
	JMP STARTL
	FENT		/LOG(X)=-LOG(1/X)
	FGT I ONEP2
	FDV I TP1
	FPT I TP1
	FEXT
	CMA
STARTL,	DCA SN
	CMA
	TAD I TP1
	FLOAT
	FENT
	FMY LOGE2
	FPT I X1
	FEXT
	IAC
	DCA I TP1
	FENT
	FGT I TP1
	FSB I ONEP2
	FPT I TP1
	FMY L8
	FAD L7
	FMY I TP1
	FAD L6
	FMY I TP1
	FAD L5
	FMY I TP1
	FAD L4
	FMY I TP1
	FAD L3
	FMY I TP1
	FAD L2
	FMY I TP1
	FAD L1
	FMY I TP1
	FAD I X1
	FEXT
	JMP EXIT2
ZERGO,	FLOAT
	RETURN
/CONTINUATION OF SINE ROUTINE
PALG,	FENT
	FGT I X1
	FDV PIOT
	FPT I X1
	FMY I X1
	FPT I TP1
	FMY C9
	FAD C7
	FMY I TP1
	FAD C5
	FMY I TP1
	FAD C3
	FMY I TP1
	FAD PIOT
	FMY I X1
	FEXT
	JMP EXIT2
