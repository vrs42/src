/////
/ROUTINE TO NEGATE FLAC AND RETURN WITH AC=7777
FNEG,	0
	NEGATE
	CMA
	JMP I FNEG
/VARIABLES
X,	0
	0
	0
XSQR,	0
	0
	0
/POINTERS
TP,	FLTEMP
ONEPT,	FLTONE
/	ARC TANGENT
FATN,	GETSGN		/TAKE ABSOLUTE VALUE
	SPA CLA
	JMS FNEG
	DCA SN
	FENT
	FPT X
	FGT X
	FSB I ONEPT
	FEXT
	GETSGN
	SPA CLA
	JMP GO
	FENT
	FGT I ONEPT
	FDV X
	FPT X
	FEXT
	CMA
GO,	PUSHA		/SIGN FLAG
	FENT
	FGT X
	FMY X
	FPT XSQR
	FMY BET2
	FAD BET1
	FMY XSQR
	FAD BETZ
	FPT I TP
	FGT ALF2
	FMY XSQR
	FAD ALF1
	FMY XSQR
	FAD ALFZ
	FMY X
	FDV I TP
	FEXT
	ISZ I PDLXR	/CHECK SIGN FLAG
	JMP EXIT2
	NEGATE		/SUBTRACT FROM PI/2
	FENT
	FAD PIOT
	FEXT
EXIT2,	ISZ SN		/ARC TAN(-X)=-ARC TAN(X)
	RETURN
	NEGATE
	RETURN
