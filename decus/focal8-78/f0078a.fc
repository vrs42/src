@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
C-FOCAL,1969

01.05 C RACKO
01.08 S A(0)=0
01.10 F I=1,49; D 2
01.20 GOTO 3.05

02.10 S A(I)=FITR<60*FNEW[]>
02.20 S B=I
02.30 I (A(I)-A(B-1)) 2.4,2.1,2.4
02.40 S B=B-1; I (B) 2.3,2.5,2.3
02.50 R

03.05 S L=21;S TEMP=A(L)
03.10 F I=1,10; T %2,A(I)
03.12 T !" "
03.15 F I=1,9; D 14
03.16 F I=11,19; D 15
03.20 T "THE CARD FACE UP IS: ",TEMP,!
03.25 T "WHICH CARD WOULD YOU LIKE?"; A M
03.35 I (M-21) 3.37,3.4,3.37
03.37 I (M-226) 3.7,3.4,3.7
03.40 T "IN WHICH POSITION WOULD YOU LIKE IT?"; A N
03.50 S TAMP=A(N); S A(N)=TEMP;S TEMP=TAMP
03.65 DO 9
03.66 S TEMP=TAMP; GOTO 3.1
03.70 S L=L+1
03.75 T "THE CARD IS: ",A(L),!
03.80 T "IN WHICH POSITION WOULD YOU LIKE IT?";A N
03.85 S TEMP=A(N);S A(N)=A(L);GOTO 3.65

09.10 S KEY=FITR(TEMP/5+.9)+10
09.15 I (KEY-20) 9.2,9.2;S KEY=20
09.20 I (A(KEY)-(KEY-10)*5) 9.3,9.3; S TAMP=A(KEY)
09.25 S A(KEY)=TEMP; R
09.30 I ((KEY-11)*5-A(KEY)) 9.4,9.4;S TAMP=A(KEY)
09.35 S A(KEY)=TEMP; R
09.40 S L=L+1;S KEY=FITR(A(L)/5+.9)+10
09.45 I (KEY-20) 9.5,9.5; S KEY=20
09.50 S TAMP=A(KEY); S A(KEY)=A(L); R

14.10 I (A(I+1)-A(I)) 14.21; I (9-I) 14.15,14.15; R
14.15 T ""
14.16 T !"R A C K - O , YOU WIN!!"
14.17 T !; F I=1,10; T A(I)
14.18 T !"AFTER MY NEXT TURN, MY HAND IS:"!
14.19 F I=11,20; T A(I)
14.20 T !; Q
14.21 S I=9; R

15.10 I (A(I+1)-A(I)) 15.2; I (19-I) 15.15,15.15; R
15.15 T ""
15.16 T !"R A C K - O , I WIN!!"
15.17 T !; F I=11,20; T A(I)
15.18 T !
15.19 Q
15.20 S I=19; R
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@