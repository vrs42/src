
C FOCAL-8   

01.01 C HANGMAN GAME
01.10 S WR=0; S M=N+8; S RI=0
01.20 T !"THE HANGMAN GAME"!
01.30 T %2,!"THE WORD HAS ",N,"   LETTERS. "
01.35 T "YOU ARE ENTITLED TO 8 WRONG GUESSES."!!
01.40 F K=1,M; T !!"MAKE YOUR NUMBER ",K,"     GUESS"!!; D 2

02.10 A ?LETTER?
02.20 S S=0; F J=1,N; D 3
02.21 I (S) 2.55; S WR=WR+1
02.40 T !"YOU HAVE NOT GUESSED A LETTER IN THE WORD:  ",WR,
02.41 T "     WRONG"!
02.45 I (WR-8) 2.55
02.47 T !"YOU HAVE HUNG YOUR MAN!!!!!!"!
02.48 T !"THE CORRECT ANSWER IS:  "; F I=1,N; S A(I)=B(I); D 4
02.49 T " "!!!!!
02.50 QUIT
02.55 F I=1,N; D 4
02.56 R

03.10 I (LE-B(J)) 3.20,3.30
03.20 R
03.30 S S=-1; S RI=RI+1; S A(J)=LE
03.35 I (RI-N) 3.40,3.60,3.40
03.40 R
03.60 T !"GOOD JOB, YOU HAVE SAVED YOUR MAN FROM THE GALLOWS!!"!
03.61 T "AS YOU KNOW, THE WORD WAS:"; F I=1,N; D 4
03.62 T " "!!!!!
03.63 Q

04.01 I (A(I)-1) 8.26
04.02 I (A(I)-2) 8.01; I (A(I)-3) 8.02; I (A(I)-4) 8.03
04.03 I (A(I)-5) 8.04; I (A(I)-7) 8.05; I (A(I)-8) 8.06
04.04 I (A(I)-9) 8.07; I (A(I)-10) 8.08; I (A(I)-11) 8.09
04.05 I (A(I)-12) 8.10; I (A(I)-13) 8.11; I (A(I)-14) 8.12
04.06 I (A(I)-15) 8.13; I (A(I)-16) 8.14; I (A(I)-17) 8.15
04.07 I (A(I)-18) 8.16; I (A(I)-19) 8.17; I (A(I)-20) 8.18
04.08 I (A(I)-21) 8.19; I (A(I)-22) 8.20; I (A(I)-23) 8.21
04.09 I (A(I)-24) 8.22; I (A(I)-25) 8.23; I (A(I)-26) 8.24
04.10 I (A(I)-27) 8.25
04.11 I (A(I)-29) 8.27

08.01 T "A"; R
08.02 T "B"; R
08.03 T "C"; R
08.04 T "D"; R
08.05 T "F"; R
08.06 T "G"; R
08.07 T "H"; R
08.08 T "I"; R
08.09 T "J"; R
08.10 T "K"; R
08.11 T "L"; R
08.12 T "M"; R
08.13 T "N"; R
08.14 T "O"; R
08.15 T "P"; R
08.16 T "Q"; R
08.17 T "R"; R
08.18 T "S"; R
08.19 T "T"; R
08.20 T "U"; R
08.21 T "V"; R
08.22 T "W"; R
08.23 T "X"; R
08.24 T "Y"; R
08.25 T "Z"; R
08.26 T "E"; R
08.27 T "-"; R

10.10 A N; F I=1,N; A B(I); S A(I)=28
10.11 Q
*