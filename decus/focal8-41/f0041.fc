C-FOCAL., 1968

01.01 T !"FRAN THE BARMAID OFFERS"!!
01.02 S T=3

02.01 S V=(1+FITR(11*FABS(FRAN())))/6
02.02 S T=T-V
02.03 I (T)2.04,2.05,2.06
02.04 S V=T+V
02.05 D 3.0;D 4.0
02.06 D 3.0;D 2.0

03.01 S A=-20*FABS(FRAN())
03.02 I (A+1)3.03;T %3.02,V," OZ. SCOTCH"!;R
03.03 I (A+2)3.04;T %3.02,V," OZ. CANADIAN CLUB"!;R
03.04 I (A+3)3.05;T %3.02,V," OZ. BOURBON"!;R
03.05 I (A+4)3.06;T %3.02,V," OZ. GIN"!;R
03.06 I (A+5)3.07;T %3.02,V," OZ. APPLEJACK"!;R
03.07 I (A+6)3.08;T %3.02,V," OZ. RUM"!;R
03.08 I (A+7)3.09;T %3.02,V," OZ. DRY VERMOUTH"!;R
03.09 I (A+8)3.10;T %3.02,V," OZ. LEMON JUICE"!;R
03.10 I (A+9)3.11;T %3.02,V," OZ. BENEDICTINE"!;R
03.11 I (A+10)3.12;T %3.02,V," OZ. CHERRY BRANDY"!;R
03.12 I (A+11)3.13;T %3.02,V," OZ. MARASCHINO"!;R
03.13 I (A+12)3.14;T %3.02,V," TSP. ANGOSTURA BITTERS"!;R
03.14 I (A+13)3.15;T %3.02,V," TSP. ORANGE BITTERS"!;R
03.15 I (A+14)3.16;T %3.02,V," OZ. PARFAIT AMOUR"!;R
03.16 I (A+15)3.17;T %3.02,V," OZ. COINTREAU"!;R
03.17 I (A+16)3.18;T %3.02,V," OZ. APRICOT BRANDY"!;R
03.18 I (A+17)3.19;T %3.02,V," OZ. CLUB SODA"!;R
03.19 I (A+18)3.20;T %3.02,V," OZ. BRANDY"!;R
03.20 I (A+19)3.21;T %3.02,V," OZ. CREME DE CASSIS"!;R
03.21 T %3.02,V," OZ. LIME JUICE"!

