OARG1,	0	/ OUTPUT 128-WRD PGS FROM FLD N
OARG2,	0	/ START OF TRANSFER BUFFER
OARG3,	0	/ START BLOCK FOR TRANSFER
	JMP DEVOER	/ DEVICE OUTPUT ERROR
	TAD TCNTR
	TAD BCNT
