	AND (1000
	TAD CTRLD
	SZA CLA
	JMP I (GETCD	/ GET COMMAND DECODER
	JMS GETSWS	/ GET (RT) SWITCH REGISTER
	AND BIT11
	SNA CLA		/ BIT 11 = 1 ??
	JMP MONLUP	/ NO.
	JMS I (RSTBTS	/ RESET BIT 11 = 0
	RBIT11
BIT11,	0001		/ WHICH BIT = 1.
	JMS I [TTYMSG	/ YES.  PRT PROGRAM VERSION NR.
	VERSON
	JMP MONLUP

