PHBUF0,	TAD K1777	/ RESET PHONE BUFF PTRS
	DCA DIN		/ IGNORE ALL BACKUP
	TAD DIN		/ IN THE DATAPHONE BUFFER
	DCA DOUT

MONL3,	TAD BT4FLP	/ BIT4 NOT SET NOW. 
	SZA CLA		/ SET PREVIOUSLY??
