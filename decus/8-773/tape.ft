C	TAPE ROUTINE
	COMMON NTAB,IPT
	DIMENSION NTAB(500,3),IFILE(3)
	CALL ALPHA
1200	CALL BELL(1)
	CALL READD(IFILE(1))
	IFILE(1)=IFILE(1)-8
	IFILE(2)=1560
	IFILE(3)=1560
	CALL BELL(2)
	CALL READD(ICODE)
	IF (ICODE-1184) 1203,1204,1203
1203	IF (ICODE-1504) 1410,1210,1410
1204	CALL IOPEN ('DTA0',IFILE)
	READ (4,1229) NPT
	IPT=IPT+1
	NPT2=IPT+NPT-1
	IF(NPT2-500) 1208,1208,1209
1209	NPT2=500
1208	DO 1205 M=IPT,NPT2
	READ (4,1228) (NTAB(M,N),N=1,3)
1205	CONTINUE
	IPT=NPT2
	GOTO 1410
1210	CALL BELL(3)
	CALL READD(ICODE)
	IF (ICODE-1632) 1200,1212,1200
1212	CALL OOPEN ('DTA0',IFILE)
	WRITE (4,1229) IPT
1229	FORMAT (A3)
	DO 1213 M=1,IPT
1213 	WRITE (4,1228) (NTAB(M,N),N=1,3)
1228	FORMAT (A2)
	CALL OCLOSE
1410	CALL BELL(4)
	CALL READD(ICODE)
	IF (ICODE-288) 1412,1414,1412
1412	IF (ICODE-480) 1415,1413,1415
1415	IF (ICODE-1312) 1416,1420,1416
1416	IF (ICODE-1504) 1500,1417,1500
1500	IF (ICODE-224) 1501,1510,1501
1501	IF (ICODE-416) 1410,1502,1410
1417	WRITE (1,1418)IPT,((NTAB(M,N),N=1,3),M=1,IPT)
1418	FORMAT (I3/(3(I3,2X)))
	GOTO 1410
1420	IPT=0
	GOTO 1200
1413	CALL CHAIN ('GFIC')
1414	CALL CHAIN ('DRAW')
1510	CALL CHAIN ('CHAR')
1502	CALL CHAIN ('MODIFY')
	END
