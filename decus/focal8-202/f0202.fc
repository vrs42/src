
C-FOCAL,  5/69

01.05 E
01.07 F X=1,26;S A(X)=1
01.10 F X=1,26;D 2
01.15 F X=1,26;S A(B(X)-192)=X+193
01.20 T !!;F X=1,23;T " "
01.30 T " CODING";D 5
01.40 S Z=0;F X=1,26;S Z=Z+1;D 3
01.50 F X=1,26;S C=A(X);S A(X)=B(X);S B(X)=C
01.60 D 1.2;T "DECODING";D 5
01.70 S X=1;F Z=1,26;D 4
01.80 D 1.5;D 1.15
01.90 T !!!;Q

02.10 S B(X)=FITR(26*FRAN()+1)
02.20 I (A(B(X)))2.3,2.1,2.3
02.30 S A(B(X))=0;S B(X)=B(X)+192

03.20 T !;O C;T Z+192;O I;T "/ "
03.30 F Y=X,26;O C;T B(Y);O I;T " "
03.35 I (X-1)3.4,3.5,3.4
03.40 F Y=1,X-1;O C;T B(Y);O I;T " "
03.50 R

04.10 F Y=1,26;S B(Y)=B(Y)-1;D 4.3
04.20 D 3;R
04.30 I (B(Y)-192)4.4,4.35,4.4
04.35 S B(Y)=218;R
04.40 R

05.10 T !"   ";F X=1,26;O C;T X+192," ";O I
05.20 T !"   ";F X=1,51;T "-"
_
