POP9=POP
PUSH9=PUSH
RET9, EVRET
TEST9=TEST
/TABLE OF LISP SYSTEM ROUTINES
TAB, AAND  /0  0
  AHD      /1  1
  ATL      /2  2
  ALSTIN   /3  3
  ALSTOT   /4  4
  ANULL    /5  5
  AATOM    /6  6
  APROG    /7  7
  AEQ      /8  10
