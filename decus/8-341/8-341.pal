  EVERR    /10 12
  ASET     /11 13
  ABEGIN   /12 14
  ARETURN  /13 15
  ASETHD   /14 16
  ASETTL   /15 17
  ACONS    /16 20
  AOR      /17 21
  AGO      /18 22
  AMACH    /19 23
  APLUS    /20 24
  AMINUS   /21 25
  ATIMES   /22 26
  ANUMBER  /23 27
  AGREATP  /24 30
  AIF      /25 31
  APAUSE   /26 32
