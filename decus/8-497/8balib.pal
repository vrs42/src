	CLL RAR
	CLL RAR		/DIVIDE BY 4
	DCA ENDFC1	/# OF BLOCKS IN FILE
	TAD STAR5
	DCA ENDFC
	CIF 0
	JMS I OUHP	/WRITE LAST BUFFER
	 4210
ENDFP,	 DIREC
ENDFC,	 2^4-1		/-1 TO REMOVE UNUSED QUARTER,
			/1 FOR DIREC, 1 FOR LAST BLOCK
/ABOVE IS DESTROYED AFTER IT IS USED
	 JMP ERR1
	TAD XDEV
	JMS I (USR	/RETRIEVE HANDLER
	 1
ENDF5A,	 OUHB
	 JMP ERR2
	TAD XDEV
	JMS I (USR
	 4
	 XFNME
ENDFC1,	 ZZZ
	 JMP ERR2
	CDF CIF 0
	JMP I (7605

