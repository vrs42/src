	PAGE

CRLF,	.-.
	TAD (215
	JMS TYO
	TAD (212
	JMS TYO
	JMP I CRLF

GATHER,	.-.		/COLLECT FIELD
	ISZ SCANP2
	TAD SCANP2
	DCA SCANP3
	TAD (GATHBF
	DCA GATHP1
	CMA CLL RAL
	DCA GATHBT
	DCA GATHBF
	DCA GATHBF+1
	DCA GATHBF+2
	TAD (-6
	DCA GATHC1
GATH1,	TAD I SCANP2
	JMS CCHECK
	 JMP GATH2
	TAD GATHBF
	SZA CLA
	ISZ GATHER
	JMP I GATHER

GATH2,	TAD GATHC1
	SNA CLA
	JMP GATH3
	TAD I SCANP2
	AND (77
	DCA GATHT1
	TAD I GATHP1
	CLL RTL
	RTL
	RTL
	TAD GATHT1
	DCA I GATHP1
	ISZ GATHBT
	JMP .+4
	ISZ GATHP1
	CMA CLL RAL
	DCA GATHBT
	ISZ GATHC1
GATHT1,	 ZZZ
GATH3,	ISZ SCANP2
	JMP GATH1

GATHBT, 0
GATHC1, 0
GATHP1, 0

