PRNMP1, 0


PRDATE, .-.		/PRINT DATE
	SNA		/IS THERE ONE?
	JMP I PRDATE	/NO.  RETURN WITHOUT PRINTING
	DCA PRDTT1	/SAVE
	TAD PRDTT1
	CLL RTL
	RTL
	RAL		/MONTH
	AND (17
	JMS PRDEC
	TAD ("/
	JMS TYO
	TAD PRDTT1
	CLL RTR
	RAR
	AND (37		/DAY
	JMS PRDEC
	TAD ("/
	JMS TYO
	TAD PRDTT1
	AND (7
	TAD (106	/70
	JMS PRDEC
	JMP I PRDATE

PRDEC,	.-.
	DCA PRDCT1
	DCA PRDCT2
	TAD PRDCT1
	TAD (-12
	SPA
	JMP .+3
	ISZ PRDCT2
	JMP .-4
	DCA PRDCT1
	TAD PRDCT2
	SNA
	JMP .+3
	TAD ("0
	JMS TYO
	TAD PRDCT1
	TAD (12+"0
	JMS TYO
	JMP I PRDEC

PRDCT1, 0
PRDCT2, 0
PRDTT1, 0

TYO,	.-.
	TLS
	TSF
	JMP .-1
	CLA
	JMP I TYO


/PB
