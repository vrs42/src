	PAGE

GETLIN,	.-.		/GET NEXT INPUT LINE
	TAD (LNBUF-1
	DCA XR14
	TAD XR14
	DCA LINBUF
	DCA LINCNT	/SAVE LINE INFO
	TAD LINBUF
	DCA SCANP2
	KSF
	JMP GETL1
	KRS
	TAD (-203
	SZA CLA		/^C?
	JMP GETL1	/NO
	CIF CDF 0
	JMP I (7605	/YES

GETL1,	JMS RDCHR
	TAD (-212
	SNA
	JMP GETL1	/IGNORE LF
	TAD (-214+212
	SNA
	JMP GETL1	/IGNORE FF
	TAD (-200+214
	SNA
	JMP GETL1	/IGNORE NUL
	TAD (200
	SKP
GETL2,	JMS RDCHR
	ISZ LINCNT
	TAD (-215
	SNA		/END OF LINE?
	JMP GETL3	/YES
	TAD (215	/NO
	DCA I XR14
	JMP GETL2

GETL3,	TAD (215
	DCA I XR14	/END OF LINE
	TAD LINCNT
	CIA
	DCA LINCNT
	JMP I GETLIN

CALTYI=JMS TYI

CCHECK,	.-.		/CHECK CHAR TYPE
	DCA CCHKT1
	TAD CCHKT1
	TAD (-"0
	SPA
	JMP CCHK2
	TAD ("0-"9
	SPA SNA
	JMP CCHK1
	TAD ("9-"A
	SPA
	JMP CCHK2
	TAD ("A-"Z
CCHK1,	SPA SNA CLA
	JMP I CCHECK

CCHK2,	CLA
	TAD (CCHKL1-1
	DCA XR12
CCHK3,	TAD I XR12
	SNA
	JMP CCHK4
	TAD CCHKT1
	SNA CLA
	JMP CCHK4
	ISZ XR12
	JMP CCHK3

CCHK4,	TAD I XR12
	DCA SEPCOD
	ISZ CCHECK
	JMP I CCHECK

CCHKT1, 0

TYI,	.-.
	KSF
	JMP .-1
	KRB
	TLS
	JMP I TYI

