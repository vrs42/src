
E A
C;  ANALYSIS OF VARIANCE RANDOMIZED BLOCK F TEST  
C;  OCT. 22  1969  

C-FOCAL., 1968

01.02 T !!,"ANALYSIS OF VARIANCE RANDOMIZED BLOCK F TEST",!!
01.03 E
01.04 A "HOW MANY REPLICATES",BL, !
01.05 A "HOW MANY TREATMENTS",PO, !!!
01.06 T "ENTER EACH TREATMENT BY REPLICATE", !!
01.10 F N=1,1,PO;T !;F B=1,1,BL;A A;G 1.3
01.30 S Y(N)=Y(N)+A;S YS=YS+A^2;S D(B)=D(B)+A
01.31 F N=1,1,PO;S EX=EX+Y(N)^2;S SX=SX+Y(N)
01.61 F N=1,1,BL;S EY=EY+D(N)^2
01.64 S C=SX^2/PO*BL;S ST=(EY/PO)-C;S SP=(EX/BL)-C
01.65 S SS=(YS)-C;S SE=SS-(ST+SP);S DT=ST/(BL-1)
01.66 S DP=SP/(PO-1)
01.67 S ER=SE/(PO-1)*(BL-1);S BF=DT/ER;S TF=DP/ER
01.68 T !!! "ANALYSIS OF VARIANCE TABLE", !!!
01.70 T "SOURCE      DF        SUM OF SQUARES          MEAN SQUARES"
01.71 T "         F",!!!
01.80 T "BET REP",%5,BL-1,"        ",%,ST,"        ",DT,"    "
01.81 T %4.02,BF,!!
01.90 T "BET TRE",%5,PO-1,"        ",%,SP,"        ",DP,"    "
01.91 T %4.02,TF,!!

02.10 T "ERROR  ",%5,(BL-1)*(PO-1),"        ",%,SE,"        ",ER,!!
02.20 T "TOTAL  ",%5,BL*PO-1,"        ",%,SS,!!
02.30 T "GRAND MEAN",SX/BL*PO,!!!,"END OF JOB",!!!;G 1.03
*
G
