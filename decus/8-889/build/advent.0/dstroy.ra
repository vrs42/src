	SECT	DSTROY
	EXTERN	MOVE
	JA	#ST
	TEXT	+DSTROY+
DSTXR,	SETX	XRDST
	SETB	BPDST
	JA	.+3
BPDST,	F 0.0
	F 0.0
XRDST,	F 0.0
	F 0.0
ZERO,	F 0.0
	ORG	10*3+BPDST
	FNOP
	JA	DSTXR
	0
DSTRTN,	JA	.
	BASE	0
#ST,	STARTD
	FLDA	10*3
	FSTA	DSTRTN
	FLDA	0
	SETX	XRDST
	SETB	BPDST
	BASE	BPDST
	FSTA	BPDST
	LDX	1,1
	FLDA%	BPDST,1
	FSTA	CALLPT
	STARTF
	JSR	MOVE
	JA	DSTRTN
CALLPT,	JA	.
	JA	ZERO
	END
