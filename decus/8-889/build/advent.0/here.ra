	SECT	HERE
	JA	#ST
#XR,	ORG	.+10
	TEXT	+HERE  +
#RET,	SETX	#XR
	SETB	#BASE
	JA	.+3
#BASE,	ORG	.+6
IOBJ,	ORG	.+3
	ORG	#BASE+30
	FNOP
	JA	#RET
	FNOP
#GOBAK,	0;0
#ARGS,	ORG	.+3
IPLACE,	ORG	.+0003
ONE,	F 1.0
ZERO,	F 0.0
	#LBL=.
	COMMON	MISCOM
LINUSE,	ORG	.+0003
ITRVS,	ORG	.+0003
ICLSES,	ORG	.+0003
IOLDLC,	ORG	.+0003
LOC,	ORG	.+0003
	COMMON	PLACOM
IATLOC,	ORG	.+0702
LINK,	ORG	.+1130
PLACE,	ORG	.+0454
	ORG	#LBL
#RTN,	BASE	#BASE
	JA	#GOBAK
#ST,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FSTA	#ARGS
	FLDA%	#BASE,1+
	FSTA	IOBJ
	STARTF
	FLDA%	IOBJ
	ATX	7
	FLDA	PLACE-0003,7
	FSTA	IPLACE
	FSUB	LOC
	JEQ	TRUE
	FLDA	IPLACE
	FADD	ONE
	JEQ	TRUE
	FLDA	ZERO
	JA	#RTN
TRUE,	FLDA	ONE
	JA	#RTN
	END
