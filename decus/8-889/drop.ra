	SECT	DROP
	JA	#ST
#XR,	ORG	.+10
	TEXT	+DROP  +
#RET,	SETX	#XR
	SETB	#BASE
	JA	.+3
#BASE,	ORG	.+6
OBJECT,	ORG	.+3
WHERE,	ORG	.+3
	ORG	#BASE+30
	FNOP
	JA	#RET
	FNOP
#GOBAK,	0;0
#TMP,	ORG	.+0011
ONE,	F 1.0
HUND,	F 100.0
	#LBL=.
	COMMON	PLACOM
ATLOC,	ORG	.+0702
LINK,	ORG	.+1130
PLACE,	ORG	.+0454
FIXED,	ORG	.+0454
HOLDNG,	ORG	.+0003
	ORG	#LBL
#RTN,	BASE	#BASE
	JA	#GOBAK
#ST,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FLDA%	#BASE,1+
	FSTA	OBJECT
	FLDA%	#BASE,1+
	FSTA	WHERE
	STARTF
	FLDA%	OBJECT
	FSUB	HUND
	JGT	#1
	FLDA%	OBJECT
	ATX	7
	FLDA	ONE
	FADD	PLACE-0003,7
	JNE	#G0001
	FLDA	HOLDNG
	FSUB	ONE
	FSTA	HOLDNG
#G0001,	FLDA%	WHERE
	FSTA	PLACE-0003,7
	JA	#2

#1,	FLDA%	OBJECT
	FSUB	HUND
	ATX	7
	FLDA%	WHERE
	FSTA	FIXED-0003,7

#2,	FLDA%	WHERE
	JLE	#RTN
#G0002,	FLDA%	OBJECT
	ATX	7
	FLDA%	WHERE
	ATX	6
	FLDA	ATLOC-0003,6
	FSTA	LINK-0003,7
	FLDA%	OBJECT
	FSTA	ATLOC-0003,6
	JA	#RTN
	END
