SECT	CARRY
	JA	#ST
#XR,	ORG	.+10
	TEXT	+CARRY+
#RET,	SETX	#XR
	SETB	#BASE
	JA	.+3
#BASE,	ORG	.+6
OBJECT,	ORG	.+3
WHERE,	ORG	.+3
	ORG	#BASE+30
	FNOP
	JA	#RET
	FNOP
#GOBAK,	0;0
TEMP,	ORG	.+0003
HUND,	F 100.0
ONE,	F 1.0
	#LBL=.
	COMMON	PLACOM
ATLOC,	ORG	.+0702
LINK,	ORG	.+1130
PLACE,	ORG	.+0454
FIXED,	ORG	.+0454
HOLDNG,	ORG	.+0003
	ORG	#LBL
#RTN,	BASE	#BASE
	JA	#GOBAK
#ST,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FLDA%	#BASE,1+
	FSTA	OBJECT
	FLDA%	#BASE,1+
	FSTA	WHERE
	STARTF
	FLDA%	OBJECT
	FSUB	HUND
	JGT	#5
	FLDA%	OBJECT
	ATX	7
	FLDA	ONE
	FADD	PLACE-0003,7
	JEQ	#RTN
	FLDA	ONE
	FNEG
	FSTA	PLACE-0003,7
	FLDA	HOLDNG
	FADD	ONE
	FSTA	HOLDNG

#5,	FLDA%	WHERE
	ATX	7
	FLDA	ATLOC-0003,7
	FSUB%	OBJECT
	JNE	#6
	FLDA%	OBJECT
	ATX	6
	FLDA	LINK-0003,6
	FSTA	ATLOC-0003,7
	JA	#RTN

#6,	FLDA	ATLOC-0003,7
	FSTA	TEMP
#7,	ATX	7
	FLDA	LINK-0003,7
	FSUB%	OBJECT
	JEQ	#8
	FLDA	LINK-0003,7
	FSTA	TEMP
	JA	#7

#8,	FLDA%	OBJECT
	ATX	6
	FLDA	LINK-0003,6
	FSTA	LINK-0003,7
	JA	#RTN
	END
