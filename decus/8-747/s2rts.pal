	SHL; 17	/TIMES 8 ALTOGETHER
	TAD (DSRN-1	/DEVICE SEQUENCE REFERENCE NUMBER TABLE
	DCA XR1
	TAD (ENTRYP-1
	DCA XR2
	TAD (-10
	DCA T1
	TAD I XR1
	DCA I XR2	/TRANSFER
	ISZ T1	/COUNT
	JMP .-3
NOWK,	ISZ ONDECK	/NORMAL EXIT
	JMP I ONDECK
/
/
/	OFFDECK PUT CHANEL INFO BACK IF IT IS GOOD. OFFDECK MUST NOT
/	ALTER THE MQ.
/
OFFDECK,	0
	TAD CUR
	SPA CLA	/MINUS MEANS DUMMY DATA
