	SZA CLA	/MUST BE ZERO
	JMP MOVER
	TAD RA1
	SWP MUY; RB2	/HI TIMES LOW + HI(LOW*HI)
	SZA CLA
	JMP MOVER
	TAD RC1
	SWP	/PUT IN RIGHT ORDER
	SPA
	JMP MOVER
	ISZ RESGN	/SIGN CHECK
	SKP	/REVERSE SENCE
	DPCM
	CDF CIF P
	DST
