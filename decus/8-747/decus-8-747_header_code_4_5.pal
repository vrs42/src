DLD=7663
DPSZ=7451
CAM=7621
DPIC=7573
NL0001=CLA CLL IAC
NL0002=CLA CLL IAC RAL
NL0003=CLA CLL CML IAC RAL
NL0004=CLA CLL IAC RTL
NL0006=CLA CLL CML IAC RTL
NL7777=CLA CLL CMA
NL7776=CLA CLL CMA RAL
NL7775=CLA CLL CMA RTL
FIXTAB
/
DECIMAL
        FIELD 1
*0
FLG0,   0
VAL0,   0
FLG1,   1
VAL1,   1
FLG2,   2
VAL2,   2
FLG3,   3
VAL3,   3
