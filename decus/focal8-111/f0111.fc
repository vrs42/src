
C-FOAL,1969

01.05 T "LETS PLAY BATTLE OF NUMBERS",!
01.10 S I = 5
01.11 S M=100;D 2;S G=I+14
01.15 S M = 10; D 2; S PL = I+3
01.20 T "GOAL ",G," PLAY-LIMIT ",PL
01.25 A "YOUR PLAY IS ",P; I (P) 1.26,1.26,1.27
01.26 T "PLEASE MAKE A LEGAL PLAY.",!;G 1.25
01.27 I (P-PL)1.29,1.29,1.28
01.28 G 1.26
01.29 S G=G-P; I (G-1)1.31,1.35,1.41
01.31 T "SORRY, YOU HAVE JUST LOST.",!,"NEW GAME.",!;G 1.11
01.35 T "CONGRADULATIONS. YOU WIN.",!,"NEW GAME.",!;G 1.11
01.41 S M=(G-1)/(PL+1); I (M-FITR(M))1.42,1.47,1.42
01.42 S M=(G-FITR(G/(PL+1))*(PL+1))-1;G 1.48
01.43 T "MY PLAY ",M," NEW GOAL ",G,!
01.44 I (G-1)1.25,1.31,1.25
01.47 S M=PL;S I=FRAN();S I=FABS(I);D 2;S G=G-I;S M=I;G 1.43
01.48 I (M+1) 1.50,1.49,1.50
01.49 S M=PL;
01.50 S G=G-M;G 1.43

02.01 S J=I;S I=FABS(FSIN(I))+1;S I=I*100;
02.02 S I=FITR(I); S I=I-FITR(I/M)*M+1
02.03 I (J-I)02.05,02.04,02.05
02.04 S I=I+FABS(J);G 2.2
02.05 RETURN
*