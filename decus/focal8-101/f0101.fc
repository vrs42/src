
C-FOCAL., 1968

01.02 C AUTHOR WM. GARCIA, 6/10/70,    "HORSE RACE"
01.05 A !!!, "GUN !", GUN, !
01.06 E
01.10 S HOSS=FITR(10*FABS(FRAN()))
01.11 S CNTR=CNTR+1; I (CNTR-25) 1.16, 7.1, 7.1
01.16 I (HOSS-1) 2.7, 2.7;
01.17 I (HOSS-3) 2.3, 2.9;
01.18 I (HOSS-5) 2.9, 2.1;
01.20 I (HOSS-7) 2.1 ,2.3;
01.22 I (HOSS-9) 2.5, 2.5, 1.1

02.10 S C1=C1+1; I (C1-50) 1.1, 3.1, 3.1
02.30 S C3=C3+1; I (C3-50) 1.1, 3.3, 3.3
02.50 S C5=C5+1; I (C5-50) 1.1, 3.5, 3.5
02.70 S C7=C7+1; I (C7-50) 1.1, 3.7, 3.7
02.90 S C9=C9+1; I (C9-50) 1.1, 3.9, 3.9

03.10 D 7.1; D 13; G 6.3
03.30 D 5.3; D 13; G 6.5
03.50 D 5.5; D 13; G 6.7
03.70 D 5.7; D 13; G 6.9
03.90 D 5.9; D 13; G

05.10 D 7.1
05.30 D 5.1; D 7.3
05.50 D 5.3; D 7.5
05.70 D 5.5; D 7.7
05.90 D 5.7; D 7.9

06.30 D 7.3
06.50 D 7.5
06.70 D 7.7
06.90 D 7.9; G

07.10 T !!!, "SAMI  "; F A=1,C1; T ";"
07.30 T !, "STAR  "; F B=1,C3; T "*"
07.50 T !, "QOTY  "; F D=1,C5; T "!"
07.70 T !, "AROW  "; F G=1,C7; T ">"
07.90 T !, "PERK  "; F H=1,C9; T "%"
07.95 S CNTR=0; G 1.1

13.01 T "  WINNER!!!"
13.03 RETURN
*