@@@@@@@@@@@@@@@@@@@@
C-8K FOCAL @1969

01.01 T %10.00,!!!!,"MANPOWER",!!
01.05 C- C.C.WILTON-DAVIES, RNPL, ALVERSTOKE
01.10 D 15;A "HOURS IN STANDARD DAY?",SH
01.11 D 15;A "DAYS IN STANDARD WEEK?",SD
01.20 A "HOURLY WAGE FOR MEN",RM
01.30 A "HOURLY WAGE FOR WOMEN",RW
01.35 A "OVERTIME FACTOR",OV

02.10 D 15;A "MEN DO YOU EMPLOY?",NM,"WOMEN?",NW
02.11 S N=NM+NW;T !,"YOUR TOTAL WORKFORCE IS ",N,!!
02.20 S SW=SH*SD;S HD=N*SH;S HW=N*SW;S HM=HW*4;S HY=HM*12
02.25 T "WORK DONE IS THEREFORE",!,HD,"  MAN/HOURS PER DAY",!,HW
02.30 T "  PER WEEK",!,HY,"  PER YEAR, WITHOUT OVERTIME",!!
02.40 S IM=0;S IW=0

03.20 S WH=(RM*NM)+(RW*NW)
03.30 S WD=WH*SH;S WW=WD*SD;S WM=WW*4;S WY=WM*12
03.50 T %11.02,"YOUR WAGE  BILL IS",!,WH,"  PER HOUR, OR",!
03.51 T WD,"  PER DAY, OR",!
03.52 T WW,"  PER WEEK, OR",!,WM,"  PER MONTH, OR",!
03.53 T WY,"  PER YEAR",!!

04.20 D 15;A "JOBS RUNNING?",NJ
04.50 F J=1,NJ;D 10
04.60 F J=1,NJ;D 11
04.69 S NO=0;S M=0;S W=0
04.70 F J=1,NJ;D 12
04.80 D 13;D 14;T !!!!,"SUMMMARY",!!
04.90 T "JOB     MEN   WOMEN     OVERTIME      WAGES         COMPLETE IN",!
04.92 T "NO.                     MEN   HRS    /DAY  TOTAL      WKS  DAYS",!!
04.93 F J=1,NJ;D 9
04.95 Q

09.20 T %2.00,J;T %4.00,M(J),W(J),"   ",NO(J)
09.30 T %4.02,OH(J),"  ",PD(J);T %9.02,TW(J)
09.40 T %4.00,FITR(CW(J)),(CW(J)-FITR(CW(J)))*7,!;R

10.10 T %3.00,!!"JOB NUMBER ",J,!
10.20 D 15;A "MAN/HOURS TO COMPLETE?",H(J)
10.30 A "DEADLINE IS ?? WEEKS ",DW(J)
10.40 S M(J)=0;S W(J)=0;S NO(J)=0;S OH(J)=0
10.90 R

11.10 D 10.10;T "EMPLOY ";D 15;A "MEN?",M(J)
11.20 D 15;A "WOMEN?",W(J)
11.25 S NO(J)=0;S OH(J)=0
11.30 S PD(J)=(M(J)*RM*SH)+(NO(J)*[RM*OV*OH(J)])+(W(J)*RW*SH)
11.33 T %5.03,!,"DAILY WAGES BILL ",PD(J)
11.50 S DH(J)=DW(J)*SD*SH;S WH(J)=[M(J)+W(J)]*SH+[NO(J)*OH(J)]
11.60 S CD(J)=H(J)/WH(J);S CW(J)=CD(J)/SD
11.62 T %3.00,!,"DUE TO COMPLETE IN ",FITR(CW(J))," WEEKS AND"
11.63 T [CW(J)-FITR(CW(J))]*7," DAYS",!
11.65 S PW(J)=PD(J)*SD;S TW(J)=PW(J)*CW(J)
11.66 T %11.02,"FOR A TOTAL WAGES BILL OF",TW(J)
11.70 S SF(J)=CW(J)-DW(J);I (SFJ))11.71,11.99,11.72
11.71 T -SF(J)," WEEKS EARLY",!;G 11.80
11.72 T !,"THIS IS ",SF(J)," WEEKS LATE",!;A "REALLOCATE LABOUR?",RA
11.73 I (RA-0YES)11.74,11.75,11.74
11.74 I (RA-0NO)11.72,11.76,11.72
11.75 G 11.10
11.76 A "ALLOT OVERTIME?",OA;I (OA-0YES)11.72,11.77,11.72
11.77 D 15;A "MEN ON OVERTIME?",NO(J),!,"HOURS PER DAY?",OH(J)
11.78 G 11.30
11.80 I (.15+SF(J))11.81;R
11.81 A "TOO MUCH FOR YOU?",TM;I (TM-0YES)11.82,11.83,11.82
11.82 I (TM-0NO)11.81;R
11.83 G 11.10
11.99 RETURN

12.10 S NO=NO+[NO(J)*OH(J)]
12.20 S M=M+M(J);S W=W+W(J)

13.05 S IM=0;S IW=0
13.10 S DM=NM-M;S DW=NW-W;S DN=DM+DW
13.20 I (DM)13.30,13.50,13.40
13.30 T !!,"YOU HAVE ",-DM," TOO FEW MEN",!;G 13.50
13.40 T !!,"YOU HAVE ",DM," MEN IDLE",!;S IM=IM+DM
13.50 I (DW)13.60,13.90,13.70
13.60 T !,"YOU HAVE ",-DW," TOO FEW WOMEN",!;G 13.80
13.70 T !,"YOU HAVE ",DW," WOMEN IDLE",!;S IW=IW+DW
13.80 A "REALLOCATE JOBS?",RA;I (RA-0NO)13.85,13.90,13.85
13.85 I (RA-0YES)13.80,13.95,13.80
13.90 R
13.95 G 4.20

14.10 S DB=[NM*RM*SH]+[NW*RW*SH]+[NO*OV*RM]
14.11 S WB=DB*SD;S MB=WB*4;S YB=MB*12
14.20 S DI=[IM*RM*SH]+[IW*RW*SH]
14.30 T !!!,"YOUR TOTAL WAGES BILL IS",!
14.40 T DB," PER DAY, INCLUDING ",DI," FOR IDLE HANDS",!

15.20 T "HOW MANY ";R
*@@@@@@@@@@@@@@@@PP@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@