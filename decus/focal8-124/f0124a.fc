
C-FOCAL , 8/68

01.01 E
01.02 A "G"G;S J=1
01.04 A "N"N(J);S P=1;S S=0
01.05 A "S"X(P);S S=S+X(P)
01.07 S P=P+1;I (N(J)-P)1.08,1.05,1.05
01.08 DO 2
01.09 S J=J+1;I (G-J)1.10,1.04,1.04
01.10 F J=1,G;S SZ=SZ+(N(J)*M(J))/SN
01.11 T "ANALYSIS OF VARIANCE TABLE:",!!!;G 3.01

02.01 S M(J)=S/N(J);S K=N(J)-1;S SX=0;S SN=SN+N(J)
02.02 F P=1,N(J);S SX=SX+(X(P)-M(J))^2
02.03 S V(J)=SX/K;S SD=FSQT(V(J));T !
02.04 T "GROUP   DF        MEAN          VARIANCE      STAND. DEV.",!
02.06 T %2 J,"  ",K,"  ";T %, M(J),"  ",V(J),"  ",SD,!!!

03.01 F J=1,G;S SB=SB+N(J)*(M(J)-SZ)^2;S SW=SW+(N(J)-1)*V(J)
03.02 S KB=G-1;S MB=SB/KB;S ST=SB+SW
03.03 F J=1,G;S KW=KW+(N(J)-1)
03.04 S KT=KB+KW;S MW=SW/KW
03.05 T "    VARIATION          DF           SS                MS",!!
03.06 T %4,"BETWEEN:            "KB;T %,"    "SB,"    "MB,!!
03.07 T %4,"WITHIN:             "KW;T %,"    "SW,"    "MW,!!
03.08 T %4,"TOTAL:              "KT;T %,"    "ST,!!!
03.09 T "RATIO:  BETWEEN/WITHIN",MB/MW,!!;Q
*