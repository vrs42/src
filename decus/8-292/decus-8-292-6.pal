NO. 8-292   FFT - #3 SYMBOLIC 3/7/69
            400-577

STF,	TAD I RSA / FORM DC COMPONENTS
	JMS SQUAR
	DCA I RSA
	TAD I ISA
	JMS SQUAR
	DCA I ISA
	TAD NUM
	CLL RAR
	CIA / PNTR=-N/2
	DCA PNTR
	TAD RSA
	IAC
	DCA RA / INITIALIZE DATA ARRAY
	CMA / ADDRESSES
	TAD NUM
	TAD RSA
	DCA RA2
	TAD ISA
	IAC
	DCA IA
	CMA
	TAD NUM
	TAD ISA
	DCA IA2
SOOP,	TAD I RA
	CLL IAC
	TAD I RA2
	RAR
	JMS SQUAR / FORM TRANSFORM OF REAL
	DCA MULTR / POINTS
	TAD I IA2
	CIA
	CLL IAC
	TAD I IA
	RAR
	JMS SQUAR
	TAD MULTR
	TAD ONE / TEMP STORE
	DCA MULTR
	TAD I IA
	CLL IAC
	TAD I IA2
	RAR
	JMS SQUAR / FORM TRANSFORM OF IMAG
	DCA MULTI / POINTS
	TAD I RA
	CIA
	CLL IAC
	TAD I RA2
	RAR
	JMS SQUAR
	TAD MULTI
	TAD ONE / STORE MAGNITUDE SQUARED
	DCA I IA / OF C(R)
	TAD I IA
	DCA I IA2
	TAD MULTR
	DCA I RA / STORE MAGNITUDE SQUARED
	TAD MULTR / OF B(R)
	DCA I RA2
	ISZ PNTR
	SKP / FINISHED?
	JMP I OPUT / DISPLAY SPECTRUM
	ISZ RA / INCREMENT DATA ARRAY
	ISZ IA / ADDRESSES
	CMA
	TAD RA2
	DCA RA2
	CMA
	TAD IA2
	DCA IA2
	JMP SOOP / CONTINUE
SQUAR,	0 / SQUARING ROUTINE
	CLL RAL
	SNA / IF (1+A)=1, NO MULT IS NEEDED
	JMP R1
	RAR
	MQL
	CLA MQA
	JMS MULT / SQUARE SPECTRAL COMPONENT
	SKP
R1,	RAR
	JMP I SQUAR / RETURN
OPUT,OUTPT / POINTER TO OUTPUT
