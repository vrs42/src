FIELD1	#PREVU
	ENTRY PREVU
/
/	PREVIEW A PLOT PREVIOUSLY WRITTEN TO DISK
/	ON STORAGE SCOPE.
/
/WRITTEN BY
/	R. W. PHELPS
/	DEPT. OF RAD BIOL & BIOPHYSICS
/	UNIVERSITY OF ROCHESTER MEDICAL CENTER
/	ROCHESTER, NY  14642
/
/SEE SEPARATE WRITEUP FOR USE
/
/	CALLING SEQUENCE:
/
/		EXTERNAL PREVU
/		CALL MODE8 (PREVU, UNIT, FACTOR)
/
/INITIALIZE AND START PLOTTING FROM UNIT
/
ERASE=6361	/ERASE THE SCREEN
DXL=6373	/SET NEW X AXIS LOCATION
DYL=6363	/SET NEW Y AXIS LOCATION
DIS=6371	/INTENSIFY THE POINT
/
/
K70,	70	/MUST BE FIRST LOC ON THE PAGE
PREVU,	0
	CLA IAC
	TAD PREVU
	DCA BPNTR
	ERASE		/ERASE THE SCREEN
	TAD M12
	DCA PNTR
	ISZ WKNTR
	JMP .-1
	ISZ PNTR
	JMP .-3
	RDF
	TAD #CIF
	DCA EXIT
	TAD% BPNTR	/GET UNIT
	SNA		/UNIT = 0 MEANS CONTINUE OLD FILE
	JMP PLNEXT
	CLL RTL
	RAL
	TAD% BPNTR
	TAD LDSRN
	DCA PNTR
	ISZ BPNTR
	TAD% BPNTR	/GET FACTOR
	RTR		/IMPORTANT BITS IN LINK & SIGN
	SPA SZL CLA
	IAC		/DO THIS IF EITHER ONE SET
	RTL		/MOVES TO RIGHT PLACE & SETS BIT 10
			/  IF LINK (X4) WAS SET
	TAD K7000
	DCA PLL2
/
/	MAKE SURE USER DECLARED A UNIT
/
#CDF,	CDF 0
	CLL
	TAD% PNTR	/GET ENTRY POINT
	TAD M7607
	CIF 0
	SNL CLA
	JMP% UE		/WRONG ENTRY POINT - POSSIBLY WRONG DEVICE
	CIF 10
/
INPL1,	TAD% PNTR
	DCA DISK	/SET ENTRY POINT OF HANDLER
/
	ISZ PNTR
	ISZ PNTR	/SKIP HANDLER CODE WORD
	TAD% PNTR	/GET BUFFER ADDRESS
	AND K7400
	DCA CORE
	TAD% PNTR	/GET BUFFER FIELD
K200,	AND K70
	TAD #CDF
	DCA DFLD
	TAD% PNTR
	AND K70
	TAD K200
	DCA WORD	/SET 'WORD' PARAMETER FOR DISC SR
/
	ISZ PNTR
	ISZ PNTR	/SKIP CHARACTER POINTER
	ISZ PNTR	/SKIP CHARACTER COUNTER
	TAD% PNTR	/GET STARTING BLOCK
	DCA BLOCK
/
	CMA
	DCA KNTR	/SET TO SIGNIFY NO WORDS LEFT
/
/START PLOT
/
	JMP PLNEXT
/
	DSRN=4244
LDSRN, DSRN-11
PNTR,	0
M7607,	-7607		/ENTRY POINT FOR SYS:
M12,	-12
EXTERN #UE
DISK,	ADDR #UE
UE=.-1
K7400,	7400


M125,	-125
KNTR,
#X,	ADDR X-1
BPNTR,
#PLOT,	ADDR PLOT
/
K7000,	NOP
/
PLNEXT,	CLA CMA CLL RTL	/-3 => AC
	DCA WKNTR	/WORDS TO READ EACH VECTOR
	TAD #X+1	/LOCATION OF PARAMETERS FOR DISK
	DCA BPNTR
PLL1,	ISZ KNTR	/MORE WORDS IN BUFFER?
	JMP DFLD	/YES
	IOF
	CDF 10
#CIF,	CIF 0
	JMS% DISK	/READ THEM
WORD,	  -1
CORE,	  -1
BLOCK,	  -1
	HLT		/DISK ERROR!
	ION
	ISZ BLOCK	/INCREMENT TO NEXT BLOCK
	TAD CORE
	DCA PNTR
	TAD M125	/NUMBER OF WORDS READ
	DCA KNTR
/
	JMP .+3
PLL2,	HLT		/SHIFT INSTRUCTION
	DCA% BPNTR	/STORE X OR Y
	
DFLD,	HLT		/FIELD OF BUFFER
	TAD% PNTR
	CDF 10		/RESTORE FIELD
	ISZ PNTR
	ISZ BPNTR
	ISZ WKNTR
	JMP PLL2
/
	DCA% BPNTR	/PEN
	IOF
	JMS% #PLOT+1	/OUTPUT NEXT COMMAND
X,	  -1
Y,	  -1
WKNTR,
PEN,	  -1
	ION
	SZA
	JMP .+4
	CMA
	TAD BLOCK	/BACKSPACE FILE IF 0 READ
	DCA BLOCK
	SMA SZA CLA	/AC = +1 IF NORMAL RETURN
	JMP PLNEXT	/AC =  0 IF PLOT DONE (PEN = 0)
	CMA		/AC = -1 IF END OF FRAME (PEN < 0)
	DCA KNTR
/
EXIT,	HLT		/RESET FIELDS
	JMP% PREVU
/
	ORG .-1!177+1
/PLOTTER DRIVER
/
/WRITTEN BY:
/	ROBERT PHELPS
/	COLUMBINE CONSULTANTS
/
/	SEPTEMBER, 1972
/
/	MODIFIED FOR THE PDP-12, SEPTEMBER, 1974
/	MODIFIED FOR PREVIEWING, MARCH, 1975.
/
/
/CALLING SEQUENCE:
/	JMS PLOT
/	  FINAL X COORD
/	  FINAL Y COORD
/	  PEN CONTROL -- 00 MEANS TERMINATE PLOTTING
/			 +1 MEANS RESET (X,Y) TO PARAMETERS (NO MOVE!!)
/			 +2 MEANS PEN DOWN
/			 +3 MEANS PEN UP
/			 NEG MEANS RESET (X,Y) TO (0,0) AFTER MOVE
/			 NEG ALSO MEANS NEW FRAME DEFINITION
/	(RETURN)
/
/
PLOT,	0
/
/COMPUTE DISTANCE TO MOVE IN X DIRECTION
/
	TAD PLOTX	/GET OLD X
	CLL CIA
	TAD% PLOT	/NZ LINK MEANS MOVE IN + DIR
	SNL SZA		/Z LINK MEANS MOVE IN NEG DIR
	CIA
	DCA PLOTDX	/ABSOLUTE VALUE OF UNITS TO
			/  MOVE IN X DIR.
/
/SET UP CODE FOR + OR - X MOVEMENT
/
	IAC		/DRUM DOWN (+)
	SNL		/CHECK DIRECTION
	CLA CMA		/IF NEG., MAKE IT DRUM UP (-)
	DCA PLOTQX
	TAD% PLOT	/UPDATE PEN LOCATION
	DCA PLOTX2
	ISZ PLOT	/BUMP TO Y
/
/COMPUTE DISTANCE TO MOVE IN Y DIRECTION
/
	TAD PLOTY	/GET OLD Y
	CLL CIA		/(TREAT THE SAME AS X ABOVE
	TAD% PLOT
	SNL SZA
	CIA
	DCA PLOTDY	/ABSOLUTE VALUE OF Y UNITS
/
/SET UP CODE FOR + OR - Y MOVEMENT
/
	IAC		/PEN LEFT (+)
	SNL
	CLA CMA		/IF NEG., MAKE IT PEN RIGHT(-)
	DCA PLOTQY
	TAD% PLOT	/UPDATE PEN LOCATION
	DCA PLOTY2
	ISZ PLOT	/BUMP TO PEN CONTROL
/
/FIND LARGER OF THE TWO DISTANCES.
/IT CONTROLS NUMBER OF INCREMENTS TO BE MOVED
/
	TAD KPINCX	/SET UP JMS INSTRUCTIONS TO
	DCA PLOTRX	/  AXES INCREMENTING ROUTINES
	IAC
	TAD KPINCX
	DCA PLOTRY
	TAD PLOTDX	/GET X UNITS TO MOVE
	CIA CLL
	TAD PLOTDY	/COMPARE X WITH Y
	SZL CLA
	JMP PLOT1	/X SMALLER - Y LARGER
	TAD PLOTDY	/Y SMALLER, SWITCH PARAMETERS
	DCA PLOTNA
	TAD PLOTDX	/SWITCH DISTANCES
	DCA PLOTDY
	TAD PLOTNA
	DCA PLOTDX
	ISZ PLOTRX	/SWITCH AXES
	ISZ PLOTRY
/
PLOT1,	TAD PLOTDY	/GET LARGER DISTANCE
	SNA
	JMP PLOTEXT	/RETURN IF NO MOVEMENT
	CMA
	DCA PLOTNB	/SET UP # OF MOVES
	DCA PLOTNA	/INITIATE RUNNING COUNTER
/
/SET PEN AS INDICATED
/
	TAD% PLOT	/FIX PEN - GET PEN CONTROL
	SNA
	JMP PLEXT2	/DONE IF PEN CONTROL IS ZERO
	SPA
	CIA
	CLL RAR
	SNA CLA		/WAS ORIG. BIT 10 SET?
	JMP PLOTEXT	/NO - NOT 2 OR 3, ASSUME 1, NO MOVE
	SNL
	JMP PLOT2	/PEN DOWN, DRAW LINE
	TAD PLOTX2	/PEN UP - RESET NEW X & Y
	DXL
	DCA PLOTX
	TAD PLOTY2
	DYL
	DCA PLOTY
	JMP PLOTEXT
/
/MOVEMENT CONTROL
/
PLOTINT,
PLOT2, ISZ PLOTNB	/MORE POINTS TO PLOT?
	JMP PLOT3	/YES
PLOTEXT, TAD% PLOT	/REDEFINE ORIGIN?
	SNA
	JMP PLEXT2
	SMA CLA
	JMP #DONE
	DCA PLOTX
	DCA PLOTY
	DXL
	DYL
	CMA		/INDICATE END OF FRAME
PLEXT2,	ISZ PLOT	/NO - BUMP TO EXIT
	JMP% PLOT
PLOT3,	TAD PLOTDX	/DECREMENT RUNNING COUNTER
	CLL CIA
	TAD PLOTNA
	DCA PLOTNA
	SZL CLA		/OVERFLOW?
	JMP .+5		/NO
	TAD PLOTDY
	TAD PLOTNA
	DCA PLOTNA
PLOTRX,	HLT		/YES - MOVE SHORT DIRECTION
PLOTRY,	HLT		/ALWAYS MOVE LONG DIRECTION
	DIS
	JMP PLOTINT
/
PLOTX, -1	/CURRENT POSN COORDINATES
PLOTY, -1	/  -1 IS IMPOSSIBLE LOCATION TO FORCE
		/  INITIAL SETTING OF D/A
PLOTNA, 0
PLOTNB, -1	/COUNTS TOTAL # OF MOVES
PLOTX2,	0
PLOTY2,	0
KPINCX,	JMS% INCX
PLOTQX,	0
PLOTQY,	0
/
PLOTDX,	0
PLOTDY,	0
INCX,	0
	ADDR QINCX
   ORG .-3
	ADDR QINCY
   ORG .-3
	ADDR QINCX
   ORG .+2
/
#DONE,	IAC		/END OF THIS CALL
	JMP PLEXT2
/
QINCX,	0		/INCREMENT X AXIS
	TAD PLOTX
	TAD PLOTQX	/+1 OR -1
	DXL
	DCA PLOTX
	JMP% QINCX
/
QINCY,	0		/INCREMENT Y AXIS
	TAD PLOTY
	TAD PLOTQY
	DYL
	DCA PLOTY
	JMP% QINCY
/
