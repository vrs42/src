05.20 D 2.2;I (FITR((P-1)/8)-(P-1)/8)5.3;T !
05.30 I (P-65)5.4;G 10.3
05.40 D 8;I (-G)5.5;T "  ";G 5.2
05.50 D 7;G 5.2

06.10 S T1=FRAN()*1000;S T1=1+FABS(FITR((T1-FITR(T1))*(T-1)))
06.20 I (M(T1))0,6.1;S T=T1;D 3.8
06.30 D 4.65;D 4.7;T %2,H,"TO",N,!;G 5.1

07.10 I (A(P)-1)7.3,7.2;T "Q ";R
07.20 T "C ";R
07.30 I (A(P)+1)7.4,7.5;T "# ";R
07.40 T "K ";R
07.50 T "O "

08.20 S T1=(N/2-FITR(N/2))*2
08.30 S T1=T1+FITR((N-1)/8)-FITR((N-1)/16)*2
08.40 I (T1-1)8.8,8.5,8.8
08.50 I (65-N)8.8;S G=1;R
08.80 S G=0;R
08.90 

10.30 A "YOUR MOVE"!"FROM",H,!"TO",N,!;I (FABS(H-N)-19)10.4;Q
10.40 I (A(H))10.45;Q
10.45 D 4.7;I (8-N)10.5;S A(N)=-2
10.50 I (-(N+H)/2+FITR((N+H)/2))2.1;D 4.75;G

11.10 F T=1,D-1;D 12

12.10 D 4.65;D 3.8;S N=2*H-N;D 8
12.20 I (G)12.5;I (A(N))12.5,12.5;S Q=1;R
12.50 I (-Q)12.6;R
12.60 S M(T)=0

13.10 T "YOU WIN"!!
