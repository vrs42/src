@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@E A
C[FOCAL-'69@WMRHS]

01.02 T "MULTICHANNEL ANALYZER [SPECTRUM ANALYSIS]"!
01.04 T "THIS PROGRAM WILL ACCEPT YOUR RAW DATA, AVERAGE THEM"!
01.06 T "GIVE SOME STATISTICAL INFORMATION, AND THEN PLOT A"!
01.08 T "VARIETY OF HISTOGRAMS FOR YOUR INTERPRETATION"!!
01.10 T "<GO> AGAIN FOR THE PROGRAM"!!;E 1

02.10 A "HOW MANY SETS",N,"DATA/SET",M,!
02.20 S X=0;S U=0;F I=1,N;T !!,%3,"SET NO. ",I;D 3
02.30 S M=X/N;F I=1,N;S U=U+[A(I)-M]^2
02.40 S P=U/N;T !!"MEAN ",M,!"VARIANCE ",P,!"STAND. DEV. "
02.50 T FSQT(P)," FOR 'NORMAL' DISTRIBUTION"!!
02.60 S P=A(1);F I=2,N;I (P-A(I))2.61;S P=A(I)
02.61 C
02.65 A !!!"HISTOGRAM SPACING",U;S K=0;S Q=P+U;T !
02.70 S J=0;F I=1,N;D 8
02.72 G 6.02
02.75 I (K-N)2.9,2.8;T !"ERRORS",K-N
02.80 G 2.60
02.90 S P=P+U;S Q=Q+U;G 2.7

03.10 S P=0;S Q=0;T " DATA:"!;F J=1,M;A K;S P=P+1;S Q=Q+K;D 3.4
03.30 S A(I)=Q/M;S X=X+A(I);T %3.01,!"AVERAGE ",A(I);R
03.40 I (P-11)8.5;S P=0;T !;R

06.02 T %5.01,P,Q;D 7;I (J)6.04,6.04;T %3,"     ",J
06.04 T !;G 2.75

07.06 T "  :";I (J)8.5,8.5;F D=1,J;T "H"

08.10 I (A(I)-P)8.5;I (A(I)-Q)8.3;R
08.30 S J=J+1;S K=K+1
08.50 R;C 9.1 FOR LATE ENTRY D SETS OF M DATA EACH

09.10 A ?D M?;S U=0;F I=N+1,N+D;S N=N+1;T %3,!!"LATE NO. ",N;D 3
09.20 G 2.3
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@