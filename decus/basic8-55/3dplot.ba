10 DEF FNA(Z)=30*(COS(Z/16))^2
50 REMARKABLY TRANSLATED TO OS8 BASIC BY KAY R. FISHER ...DEC
100 PRINT
110 FOR X=-30 TO 30
120 L=0
130 Y1=5*INT(SQR(900-X*X)/5)\IF Y1=0 GOTO 210
140 FOR Y=Y1 TO -Y1 STEP -5
150 Z=INT(25+FNA(SQR(X*X+Y*Y))-.7*Y)
160 IF Z<=L THEN 190
170 L=Z
180 PRINT TAB(Z);"*";
190 NEXT Y
200 PRINT
210 NEXT X
300 END
