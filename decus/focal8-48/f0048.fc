C-FOCAL,1969

01.10 SET PI=3.1415927
01.20 TYPE !"   MECHANICAL PROPERTIES OF LOUDSPEAKERS"!
01.30 SET V1=11.2*8.65*22.5
01.40 TYPE !"THE VOLUME OF OUR TEST BOX IS "V1," CU.IN."!
01.50 SET V1=V1*.0254^3 ; DO 4
01.70 ASK SS,D1,X0,X1,X2,X3,D3,D4,M4,I2,!

02.10 SET Q=X0/(X2-X3)
02.20 SET C4=.0254*(D3-D4)/9.8*M4
02.30 SET B1=9.8*M4/I2
02.40 SET C1=V1*(1.15*((X1/X0)^2)-1)/.14E6
02.50 SET D2=2*FSQT(FSQT(FABS<(C1/C4)>)/PI)/.0254
02.60 SET M3=1/C4*2*PI*X0^2
02.70 SET M2=M3-3.15*((D2/2)^3)*(.0254^3)
02.80 SET V2=.14E6*C1/1.44*.0254^3

03.10 TYPE !%5,SS, %6.02,D2, "   ",B1, %5.04,"    "M2
03.20 TYPE "  "%7.06,C4,%6.02,V2,Q,!
03.30 GOTO 1.7

04.10 T !" MODEL  EFF. CONE    BL PROD.   MASS   COMPLIANCE
04.20 T " OPT. VOL.    Q
04.30 T !"         DIA. IN.    WEB-MT.     KG        M/N
04.40 T "     CU.IN.
