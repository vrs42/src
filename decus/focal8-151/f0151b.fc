C:FOCAL-11,TEST

  1.05 ERASE
  1.10 A !"FAST MATRIX INVERSION.  SIZE OF MATRIX? "N,!"ENTER ELEMENTS.

  1.20 S LAST=N*N
  1.40 FOR J=1,N;T !;F I=J,N,LAST-N+J;A A(I)
  1.50 T !"ORIGINAL:"!;D 4
  1.60 DO 2
  1.70 T !"INVERSE:"!;D 4
  1.80 DO 2
  1.90 T !"INVERSE(INVERSE):"!;D 4
  1.95 QUIT

  2.10 F J=1,N;D 6

  4.60 F Z=1,N;T %2,!"ROW "Z;S NC=0;F I=Z,N,LA-N+Z;DO 5
  4.70 T !!

  5.10 T "  "%7.06,,A(I)
  5.20 S NC=NC+1;IF (NC-4)5.7;T !;S NC=0
  5.70 R

  6.10 F I=1,N;S A(LA+I)=0
  6.20 S A(LA+J)=1
  6.50 F KP=J+N,N,LA+J;S A(KP)=A(KP)/A(J)
  6.70 F KR=1,N;D 7
  6.90 F I=1,LA;S A(I)=A(I+N)

  7.10 I (KR-J)7.4,5.7;
  7.40 S KP=J;S RW=A(KR)
  7.60 F Q=KR+N,N,LA+KR;S KP=KP+N;S A(Q)=A(Q)-RW*A(KP)
* K
?