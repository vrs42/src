

C FOCAL V3A
01.01C JAMES H. CHRISTENSEN
01.02C SCHOOL OF CHEM.ENG.&MATLS.SCI.
01.03C UNIV. OF OKLA.
01.04C 202 W. BOYD #23
01.05C NORMAN, OK. 73069
01.10 T !!!, "PROGRAM TO INVERT A MATRIX USING PRODUCT FORM",!
01.20 A "DIMENSION OF MATRIX" N
01.30 F I=1,N*N;S B(I)=0
01.35 F I=1,N;S B(I+N*I-N)=1
01.40 A "COLUMN" R; I (R) 1.5,1.5;D 2.0;G 1.4
01.50 T !!,"INVERSE IS:"
01.60F I=1,N;T !;F J=1,N;T %7.06,"  ",B(N*J-N+I)
01.70 T !!;G 1.4
02.10 F J=1,N;S Y(J)=0
02.20 S ISB=-N;F J=1,N;D 6.3
02.30 I (FABS(Y(R))-1.E-10) 6.2;S YR1=1/Y(R)
02.40 S ISB=-N;F J=1,N;S ISB=ISB+N;S BRJ=YR1*B(ISB+R);D 3.0
03.10 F I=1,N;S B(ISB+I)=B(ISB+I)-Y(I)*BRJ
03.20 S B(ISB+R)=BRJ
06.20 T !,"MATRIX IS SINGULAR",!!;R
06.30 S ISB=ISB+N;A X;I (X)6.4,6.5,6.4
06.40 F I=1,N;S Y(I)=Y(I)+X*B(ISB+I)
06.50 RETURN

*;
*