/FLOATING ARCTANGENT
*5400
ARTN,     0
          TAD 45
          SMA CLA
          JMP ATN1
          JMS I NEG           /NEGATIVE INPUT
          CLA CMA
ATN1,     DCA FLAG3
          JMS I 7
          FPUT FPAC
          FSUB I AONE
          FEXT
          TAD 45
          SPA CLA
          JMP ATN2
          JMS I 7             /INPUT G.T. ONE
          FGET I AONE           /TAKE RECIPROCAL
          FDIV FPAC
          FPUT FPAC
          FEXT
          CLA CMA
ATN2,     DCA FLAG2
          JMS I 7             /EVALUATE SERIES
          FGET FPAC
          FMPY FPAC
          FPUT I ARG2
          FMPY K23
          FADD K21
          FMPY I ARG2
          FADD MK19
          FMPY I ARG2
          FADD K17
          FMPY I ARG2
          FADD MK15
          FMPY I ARG2
          FADD K13
          FMPY I ARG2
          FADD MK11
          FMPY I ARG2
          FADD K9
          FMPY I ARG2
          FADD MK7
          FMPY I ARG2
          FADD K5
          FMPY I ARG2
          FADD MK3
          FMPY I ARG2
          FADD K1
          FMPY FPAC
          FEXT                /SERIES EVALUATED
          ISZ FLAG2
          JMP ATN3
          JMS I NEG
          JMS I 7
          FADD I PI2            /ARTN(F)=PIBY2 - ARTN(1/F)
          FEXT                  /FOR F G.T. ONE.
ATN3,     ISZ FLAG3
          JMP I ARTN
          JMS I NEG
          JMP I ARTN

FLAG2,    0                   /INPUT G.T. ONE FLAG
FLAG3,    0                   /NEGATION FLAG
PI2,      PIOT
ARG2,     ITER
AONE,     ONE

