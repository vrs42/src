
-FOCAL., 1968

01.10 C ACID - BASE EQUILIBRIA
01.11 E
01.13 S KW=1/10^14
01.14 T "TASKS ARE:"!!"1 KNOWN [H+]"!"2 KNOWN [OH-]"!"3 KNOWN PH"!
01.15 T "4 KNOWN POH"!"5 KNOWN M & KA"!"6 KNOWN M & KB"!
01.16 T "7 KNOWN M ACID & M SALT BUFFER"!"8 KNOWN M BASE & M SALT BUFFER"!!
01.18 A "TASK  ",R;I (R-1)1.1,1.21;I (R-3)1.31,1.41;I (R-5)1.51,1.61
01.19 I (R-7)1.65,1.71,1.81
01.21 A "[H+]  ",H," /10^",P,!!;S H=H/10^P
01.22 S OH=KW/H
01.23 S PH=(-FLOG(H))*.4343;S POH=(-FLOG(OH))*.4343;G 1.9
01.31 A "[OH-] ",OH," /10^",P,!!;S OH=OH/10^P
01.32 S H=KW/OH;G 1.23
01.41 A "PH  ",PH,!!
01.42 S POH=14-PH
01.43 S H=FEXP(-2.30258*PH);S OH=FEXP(-2.30258*POH);G 1.9
01.51 A "POH   ",POH,!!
01.52 S PH=14-POH;G 1.43
01.61 A "M  ",M,"  KA  ",KA," /10^",P,!!;S KA=KA/10^P
01.62 S H=FSQT(M*KA);G 1.22
01.65 A "M  ",M,"  KB  ",KB," /10^",P,!!;S KB=KB/10^P
01.66 S OH=FSQT(M*KB);G 1.32
01.71 A "M OF ACID  ",MA,"  KA  ",KA," /10^",P;S KA=KA/10^P
01.72 A "  M OF BUFFERING SALT  ",MS,!!
01.73 S H=KA*(MA/MS);G 1.22
01.81 A "M OF BASE  ",MB,"  KB  ",KB," /10^",P;S KB=KB/10^P;D 1.72
01.82 S OH=KB*(MB/MS);G 1.32
01.90 C OUTPUT SECTION
01.91 T %,"[H+]  =",H,!
01.92 T "[OH-] =",OH,!
01.93 T %11.02,"PH    =",PH,!
01.94 T "POH   =",POH,!!!
01.99 G 1.18
*`xpx