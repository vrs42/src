01.05 O X,S 160;A!"CHEMS LAB 5"!"DID YOU DO 1 OR 2 ? "A,"NOW FILL IN
01.12 T %6.1," THE DATA AS OUTLINED IN MANUAL.";I(A-2)2.08;
01.14 D 8;A"TEST TUBE AND WAX? "A;D 6;A B," G.
01.16 D 8;A"EMPTY TEST TUBE? "C;D 6;A D," G.";S A=A-C;S B=B+D
01.18 D 8;A"BEAKER PLUS WATER? "G;D 6;A H," G.
01.20 D 8;A"EMPTY BEAKER? "I;D 6;A J," G.";S K=G-I;S L=H+J;S C=K+L
01.22 S D=K-L;D 9;A"WATER BEFORE? "G;D 6;A H," DEG.C.
01.24 D 9;A"WATER AFTER? "I;D 6;A J," DEG.C.";S G=I-G;S H=H+J
01.26 S I=G+H;S G=G-H;S C=C*I;S D=D*G;S C=(C-D)/2;S D=C+D
01.30 S H=(C+D)/(A-B);S I=(D-C)/(A+B);S H=(H-I)/2;S I=I+H;D 7
01.32 D 8;T"WAX"A;D 6;T B," G.";D 8;T"WATER"K;D 6;T L," G.
01.34 T!!"TEMP. CHANGE OF WATER"G;D 6;T H," DEG.C."!!"QUANTITY OF 
01.36 T"HEAT"D;D 6;T C," CAL."!!"HEAT OF SOLIDIFICATION OF WAX"I
01.38 D 6;T H," CAL./G.";D 7;Q

02.08 D 8;A"CANDLE BEFORE BURNING? "A;D 6;A B," G.
02.10 D 8;A"CANDLE AFTER BURNING? "C;D 6;A D," G.";S A=A-C;S B=B+D
02.12 D 8;A"CAN AND WATER? "G;D 6;A H," G.
02.14 D 8;A"EMPTY CAN? "I;D 6;A J," G.";S C=G-I;S D=H+J
02.16 D 9;A"WATER BEFORE HEATING? "G;D 6;A H," DEG.C.
02.18 D 9;A"WATER AFTER HEATING? "I;D 6;A J," DEG.C.";S G=I-G;S H=J+H
02.22 S I=(C+D)*(G+H);S J=(C-D)*(G-H);S K=(I-J)/2;S L=J+K;S I=I/(A-B)
02.28 S J=J/(A+B);S I=(I-J)/2;S J=J+I;D 7;D 8;T"CANDLE BURNED"A;D 6
02.30 T B," G.";D 8;T"WATER HEATED"C;D 6;T D," G."!!"TEMP. CHANGE OF 
02.34 T"WATER"G;D 6;T H," DEG.C."!!"QUANTITY OF HEAT TO WARM WATER"L
02.36 D 6;T K," CAL."!!"HEAT OF COMBUSTION OF CANDLE WAX"J;D 6;T I
02.38 T" CAL./G.";D 7;Q

