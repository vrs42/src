
C-8K FOCAL @1969

01.01 T !"T TEST";E
01.02 A !!"ARE PARAMETERS KNOWN",J;I (J-0NO)1.2,1.03,1.2
01.03 A !"GROUPED DATA",J;I (J-0YES)1.05,1.04,1.05
01.04 S N1=1;T "TYPE MIDPOINT, FREQUENCY;"
01.05 T "  END LIST WITH -9999"
01.06 F J=1,2;T !!"DATA IN SAMPLE"%2,J,!;D 3
01.11 S S1=X2(1);S S2=X2(2);S N1=N(1);S N2=N(2);G 1.45
01.20 A !!"N1",N1," N2",N2," S1",S1," S2",S2;S S1=S1^2;S S2=S2^2
01.30 A !!"MEAN 1",X1(1),"MEAN 2",X1(2)
01.45 S P1=FSQT(((N1*S1)+(N2*S2))/(N1+N2-2));T %8.04!!"F RATIO"
01.46 S P1=P1*FSQT((N1+N2)/(N1*N2));I (S1-S2)1.48;T S1/S2;G 1.52
01.48 T S2/S1
01.52 S J=S1/(N1-1);S D2=S2/(N2-1);S C=J+D2
01.55 S D2=((C^2)/(((J^2)*(1/(N1+1)))+((D2^2)*(1/(N2+1)))))-2
01.80 T !"T",(X1(1)-X1(2))/P1,"  WITH",%8,N1+N2-2
01.83 T " D.O.F.  (ASSUME S1=S2, STD.ERR."%6.03,P1,")"!
01.85 T "T",%8.04,(X1(1)-X1(2))/FSQT(C),"  WITH",%7.03,D2," D.O.F.
01.87 T "  (ASSUME NOT =, STD.ERR."%6.03,FSQT(C),")"!;Q

03.10 I (N1)3.2,3.3,3.2
03.20 A !,P2;I (P2+9999)3.21,3.55,3.21
03.21 A N2;G 3.5
03.30 S N2=1;A P2;I (P2+9999)3.5,3.55,3.5
03.50 S N(J)=N(J)+N2;S X1(J)=X1(J)+P2*N2;S X2(J)=X2(J)+P2^2*N2;G 3.1
03.55 S C=X1(J);S X1(J)=C/N(J);T !"  N",N(J),%6.02" MEAN",X1(J)
03.65 S X2(J)=(X2(J)-(C^2/N(J)))/(N(J)-1);T "  S.D.",FSQT(X2(J))
*}