@@@@@@@@@@@@@@@@
C-FOCAL, U01

01.02 T !"MOVING AVERAGES"!!
01.03 T "AFTER ENOUGH CASES HAVE BEEN ENTERED, CALCULATION OF"!
01.05 T "AVERAGES WILL BEGIN. TYPING -9999 INDICATES END-OF"
01.06 T "-DATA"!;E
01.20 T !,"HOW MANY OBSERVATIONS PER AVERAGE";A M;S M1=M-1;S N=M1
01.22 I (M) 1.24,1.24,1.3
01.24 T !"SORRY - THE NUMBER MUST BE GREATER THAN 0"!;G 1.2
01.30 T !!"TYPE IN THE FIRST"%3.00,M," DATA VALUES"!!
01.40 A D;S JC=JC+1;I (M-JC) 0.8,1.8,1.5
01.50 F J=1,1,JC;S DT(J)=DT(J)+D;S TS(J)=TS(J)+D^2
01.60 S GT=GT+D;S GS=GS+D^2;G 1.4
01.80 T !!"****MEAN******STD.DEV.****DATA**";G 2.2

02.10 A D;I (D+9999) 2.2,3.1,2.2
02.20 S N=N+1;F J=1,1,M;S DT(J)=DT(J)+D;S TS(J)=TS(J)+D^2
02.40 T !, %8.02,DT(1)/M,FSQT(((TS(1))/M)-((DT(1)/M)^2)),"  "
02.50 F J=1,1,M1;S DT(J)=DT(J+1);S TS(J)=TS(J+1)
02.60 S GT=GT+D;S GS=GS+D^2;S DT(M)=0;S TS(M)=0;G 2.1

03.10 T "  (END-OF-DATA)"!!"SUM SCORES",GT,"   SUM SQUARES",GS
03.11 T !"GRAND MEAN",GT/N,"   STND. DEV. ",FSQT((GS/N)-((GT/N)^2))
03.12 T "   N",%5.00,N,!!"GOODBYE"!!
