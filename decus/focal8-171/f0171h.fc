C-FOCAL, U01

01.05 T !!"PEARSON'S R   TYPE -9999 AFTER LAST DATA PAIR"!;E
01.40 A A;I (A+9999) 1.43,1.75,1.43
01.43 A B,!
01.45 S X1=X1+A;S N=N+1;S X2=X2+A*A;S Y1=Y1+B;S Y2=Y2+B*B
01.64 S C=C+A*B;G 1.4
01.75 S A1=X1/N;S A2=Y1/N;S P=C/N-A1*A2;S V1=X2/N-A1^2
01.95 S V2=Y2/N-A2^2;S S1=V1*V2;I (S1) 4.6,4.6,1.96
01.96 S R=P/FSQT(S1)

02.01 T !!"PEARSON'S R"%8.03,R,"   R*R"R*R
02.05 T !!"X MEAN"A1,"   S.D. X"FSQT(V1),%5,"   N",N,%8.03
02.10 T !"Y MEAN"A2,"   S.D. Y"FSQT(V2)
02.11 T !"COV XY",R*FSQT(V1)*FSQT(V2)
02.21 S B1=R*FRPT(V1)/FSQT(V2);S B2=R*FSQT(V2)/FSQT(V1)
02.25 S I1=A1-(B1*A2);S I2=@0-(B2*A1)
02.40 T !!"B X.Y"B1,"   A X.Y"I1,!
02.41 T "B Y.X"B2,"   A Y.X"I2,"   SUM X*Y"C,!
02.50 T !!"S Y.X"FSQT(V2)*FSQT(1-R*R),"   SUM X"X1,"   SUM X*X",X2
02.60 T !"S X.Y"FSQT(V1)*FSQT(1-R*R),"   SUM Y"Y1,"   SUM Y*Y",Y2

03.10 T !!"HIT '1' TO PREDICT Y GIVEN X, OR"!"    '2' TO"
03.11 A " PREDICT X GIVEN Y, OR"!"    '3' TO RUN MORE DATA",A
03.16 I (2-A) 1.05; T !!"TYPE -9999 TO QUIT"!!"GIVEN   PREDICTED"
03.20 I (A-2) 3.8,3.35,3.8
03.35 A !,N; I (N+9999) 3.36,3.1,3.36
03.36 T N*B1+I1;G 3.35
03.80 A !,N;I (N+9999)3.82,3.1,3.82
03.82 T N*B2+I2;G 3.80

04.50 Q
04.60 T !"MUST QUIT, STD DEV = 0"!
