@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
C-FOCAL, U01

01.05 T !"LAMBDA"!!;E
01.10 A "# ROWS?",NR,"# COLS?",NC
01.20 F J=1,NR;T !;F K=1,NC;D 6.5;A M(X);S T=T+M(X)
01.30 T !!!"     LAMBDA     LAMBDA"!"       RC         CR"!"   "
01.50 F J=1,NR;S RO=0;D 6.1;S S1=S1+RO;D 7.1
01.60 S R=0;F K=1,NC;S RO=0;D 6.3;S S2=S2+RO;D 7.2
01.70 T %5.05,(S1-CM)/(T-CM),"    ",(S2-RM)/(T-RM),!

06.10 S R=0;F K=1,NC;D 7.3
06.20 S RM=R;R
06.30 S R=0;F J=1,NR;D 7.3
06.40 S CM=R;R
06.50 S X=J+NR*(K-1)
06.60 S RO=M(X);R

07.10 I (R-RM),,6.2
07.20 I (R-CM),,6.4
07.30 D 6.5;S R=R+M(X);I (M(X)-RO),,6.6
