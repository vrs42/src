@@@@@@@@@@@
C-FoCAL, U01

01.05 T !!"STD. %S"!!;E
01.06 A "# TABLES",T,"# ROWS",R,"# COLS",C;S C1=R*C;S C2=C1*T
01.20 F J=0,T-1;T !;F K=J*C1+1,J*C1+C1;D 11
01.50 F J=0,T-1;S S(J+1)=S(J+1)/G;F K=C1*J+1,1,C1*J+C;S M=M+1;D 12
01.55 F J=1,C;F K=J,C,C*T;S R(C*T+J)=R(C*T+J)+R(K)
01.60 S M=0;F J=0,T-1;F K=C1*J+1,1,C1*J+C;S M=M+1;D 13
01.90 F J=1,C1;F K=1,T;S A(C2+J)=A(C2+J)+A(((K-1)*C1)+J)*S(K)
01.92 S L=0;F J=C2+1,1,C2+C;S L=L+1;S O=J;F K=1,R;D 14
01.95 T !!"  CELL    STD.%     FREQ"!
01.96 F J=1,C1;T %4,J,%6.02,A(J+C2)*100,A(J),!
01.99 Q

11.05 A A(K);S G=G+A(K);S S(J+1)=S(J+1)+A(K)

12.05 S O=K;F L=1,R;S R(M)=R(M)+A(O);S O=O+C

13.05 S O=K;F L=1,R;S A(O)=A(O)/R(M);S O=O+C

14.05 S A(O-C2)=A(O)*R(L+C*T);S O=O+C
*@@@@@@@@@@@@@@@@@@@@@@@@@@