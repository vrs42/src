@@@@@@@@@@@@@
C-FOCAL, U01

01.05 T %5.03 "TABLE";E
01.07 A " # ROWS"R," # COLS"C
01.10 F J=1,R;T !;F K=1,C;D 5
01.12 T !!"    R"(NT*N-X*Y)/FSQT((NT*S-X^2)*(NT*D-Y^2))
01.20 S Y=0;S D=0;S S=0;F I=1,R-1;F J=1,C-1;D 9
01.40 F I=1,R-1;F N=2,C;D 10
01.50 F J=1,C;F K=1,R-1;D 11
01.55 S X=0;F J=1,R;F K=1,C-1;D 12
01.80 S L=S-D;S K=S+D;T !"GAMMA"L/K,"     TAU"L/((NT*(NT-1))/2)
01.91 T "    TAU'",L/FSQT((K+X)*(K+Y))
01.92 T !"D Y.X"L/(K+Y),"   D X.Y"L/(K+X),!;Q

05.05 A L;S A(J+R*(K-1))=L;S NT=NT+L;S X=X+L*K;S Y=Y+L*J
05.10 S S=S+K^2*L;S D=D+J^2*L;S N=N+J*K*L

09.05 S X=0;F K=I+1,R;F L=J+1,C;S X=X+A(K+R*(L-1))
09.10 S S=S+A(I+R*(J-1))*X

10.05 S X=0;S J=C-N+2;F K=I+1,R;F L=1,J-1;S X=X+A(K+R*(J-L-1))
10.10 S D=D+A(I+R*(J-1))*X

11.05 S N=0;F L=K+1,R;S N=N+A(J+R*(L-1))
11.10 S Y=Y+N*A(J+R*(K-1))

12.05 S N=0;F L=K+1,C;S N=N+A(L+R*(J-1))
12.10 S X=X+N*A(K+R*(J-1))
