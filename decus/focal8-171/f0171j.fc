@@@@@@@@@
C-FOCAL, U01

01.10 T !"RANDOMIZATION TEST -- HOW MANY IN GROUP 1";E
01.15 A N1," AND GROUP 2",N2,!;S NT=N1+N2;S I=NT-1;S C=4
01.20 F J=1,1,NT;A A(J);S GT=GT+A(J)
01.25 T !!"HERE ARE ALL THE POSSIBLE MEAN SCORE DIFFERENCES";D 6
01.30 F J=1,1,I;D 2
01.34 S I=I-1;I (I) 3.1,3.1,1.3

02.10 I (A(J)-A(J+1)) 2.16,2.16,2.12
02.12 S T=A(J);S A(J)=A(J+1);S A(J+1)=T
02.16 R

03.10 F J=1,N1;S MR(J)=J;S MX(J)=J+N2
03.30 D 9;S I=N1
03.35 S MR(I)=MR(I)+1
03.40 I (MR(I)-MX(I)) 3.45,3.45,3.6
03.45 D 9;G 3.35
03.60 S I=I-1; I (I) 5.05,5.05,3.7
03.70 I (MR(I)-MX(I)) 3.72,3.72,3.6
03.72 S MR(I)=MR(I)+1;F J=I+1,N1;S MR(J)=MR(J-1)+1
03.80 S I=N1;G 3.4

05.05 D 6;T !!"OVERALL MEAN",GT/NT,"  # OF OUTCOMES",%5,OU,!;Q

06.05 T !%6.03;F J=1,24;T "+-"

09.05 S C=C+1;S T=0;S OU=OU+1;F J=1,N1;S T=T+A(MR(J))
09.10 I (C-5) 9.3,9.2,9.2
09.20 T !;S C=0
09.30 T (T/N1)-((GT-T)/N2)
