C-FOCAL, U01

01.20 T !"UNIVARIATE STATISTICS"!!;E
01.25 A "GROUPED DATA",Q;I (Q-0YES)1.4,1.3,1.4
01.30 T !"TYPE CLASS MIDPOINT, THEN NUMBER OF CASES
01.33 S X=1
01.40 T !"TO SIGNAL END OF DATA, TYPE -9999"!

02.10 I (X) 2.3,2.3,2.2
02.20 A MP;I (MP+9999) 2.21,5.1,2.21
02.21 A NF,!;I (NF) 7.2,2.5,2.5
02.30 S NF=1;A MP;I (MP+9999) 2.5,5.1,2.5
02.50 S NS=NS+NF;S X1=X1+MP*NF;S X2=X2+MP^2*NF
02.52 S X3=X3+(MP^3)*NF;S X4=X4+(MP^4)*NF;G 2.1

05.10 S U1=X1/NS;S U2=(X2-(X1^2/NS))/NS;I (U2) 6.5,6.5,5.12
05.12 S UR=FSQT(U2);S U3=(X3/NS)-(3*(X2/NS)*U1)+2*(U1^3)
05.14 S U4=(X4/NS)-(4*(X3/NS)*U1)+(6*(X2/NS)*U1^2)-(3*U1^4)
05.16 S Q=FSQT(6/NS);S SW=(U3/(U2*UR))/Q
05.17 S SK=(U4/U2^2-3)*((1/Q)*2);S B1=0; I (U3) 5.18,5.2,5.18
05.18 S B1=(U3^2)/U2^3*(U3/FABS(U3))
05.20 S B2=U4/U2^2

06.20 T !!,%8.03,"MEAN"U1,"  STD DEV"UR,"  VARIANCE"U2
06.24 T !"        UNBIASED STD DEV",FSQT((X2-(X1^2/NS))/(NS-1))
06.30 T !!"CRITICAL RATIO-SKEWNESS"SW,"  BETA-1"B1
06.40 T !"CRITICAL RATIO-KURTOSIS"SK,"  BETA-2"B2
06.45 T !!%8.00 "N OBS"NS,"  SUM SCORES" %8.03,X1
06.46 T "  SUM SQUARES",X2,!;
