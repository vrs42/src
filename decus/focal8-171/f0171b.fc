@@@@@@@@@@@@@@@@@@@@@
C-FOCAL, U03

01.05 T !"TABLE %S";E
01.10 A "  # ROWS"R," # COLS",C;I (C-7)1.2;T " TOO BIG";Q
01.20 F J=1,R;T !;F K=1,C;D 5
01.40 T !;F J=1,R;D 6
01.43 D 7;T !,%5"MARG TOT ";F K=1,C;T C(K)," "
01.44 T N,!%4.01"MARG PCT ";F K=1,C;T C(K)*100/N," "
01.50 T !!"CHI SQUARE",%6.02,X,"  D.O.F.",%4,(R-1)*(C-1),!;Q

05.10 A L;S N=N+L;S A(J+R*(K-1))=L;S C(K)=C(K)+L;S R(J)=R(J)+L

06.05 F K=1,C;S L=R(J)*C(K)/N;S X=X+(A(J+R*(K-1))-L)^2/L
06.10 D 7;T !"OBSERVED ";F K=1,C;T %5,A(J+R*(K-1))," "
06.15 T R(J),%4.01
06.20 T !"ROW  PCT ";F K=1,C;T 100*A(J+R*(K-1))/R(J)," "
06.25 T "="!"COL  PCT ";F K=1,C;T 100*A(J+R*(K-1))/C(K)," "
06.30 T "="!"TOT  PCT ";F K=1,C;T 100*A(J+R*(K-1))/N," "
06.33 T 100*R(J)/N

07.10 T !;F K=1,8+C*4;T ":="
