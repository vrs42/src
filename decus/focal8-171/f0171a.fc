@@@@@@@@@@@@@@
C-FOCAL, U01

01.10 T !!"BINOMIAL PROBABILITIES"!!;E
01.20 A "WHAT IS THE SAMPLE SIZE",N
01.22 A !"WHAT IS THE PROPORTION OF 'SUCCESSES'",P
01.25 I (P) 1.50,1.50; I (1-P) 1.5,1.5,1.3
01.30 T !!"  NO. OF  CUMULATIVE  PROBABILITY
01.32 T !"SCCESSES   PROB.    OF X SUCCESSES",!
01.34 F J=1,35;T "*"
01.40 F J=O,N;D 3
01.45 I (LF-1) 1.49;T !!"(PROBABILITIES LESS THAN .0000001"
01.46 T !" WERE NOT PRINTED)"
01.49 T !!;Q
01.50 T !!"PROPORTION MUST BE GREATER THAN 0.00, AND LESS THAN 1.00"
01.51 G 1.22

03.05 S NT=1;S ND=1;S MX=J;S MN=N-J
03.10 I (MX-(N-J)) 3.20;S MX=N-J;S MN=J
03.20 F K=MX+1,N;S NT=NT*K
03.30 F K=1,MN;S ND=ND*K
03.50 S PR=(NT/ND)*((P^J)*((1-P)^(N-J)))
03.55 S CP=CP+PR
03.57 I (PR-0.0000001) 3.7,3.G,3.6
03.60 T !%4,J,%9.06,CP,PR;R
03.70 S LF=1;R
*@@@@@@@@@@@@@@@@@@@@@@@@