C-FOCAL, U01

01/10 T !"FISHER'S EXACT PROBABILITY TEST"!;E
01.13 T !"PROBABILITIES FOR TABLES MORE AND LESS EXTREME THAN"
01.14 T !"THE ORIGINAL 2 X 2 ARE CALCULATED"
01.15 T !!"TYPE IN THE CELL FREQUENCIES, ROW BY ROW"!!
01.20 F J=1,4;A A(J);S A(5)=A(5)+A(J)
01.25 T !!"  CELL A    CUMULATIVE     EXACT"
01.26 T !"   FREQ ";F J=1,2;T "   PROBABILITY"
01.30 S A(6)=A(1)+A(2);S A(7)=A(3)+A(4);S N=A(1)
01.31 S A(8)=A(1)+A(3);S A(9)=A(2)+A(4);F J=1,4;S M(J)=A(J+5)
01.35 F J=1,3;F K=6,9-J;D 10
01.41 S MX=M(3);I (M(1)-M(3)) 1.42,1.5,1.5
01.42 S MX=M(1)
01.50 S A(1)=L;S A(2)=M(1)-L;S A(3)=M(3)-L;S A(4)=M(4)-A(2)
01.60 I (M(4)-A(2)) 1.92;I (M(3)-A(1)) 1.92;F J=1,4;F K=1,5-J;D 10
01.70 S NT=1;S DT=1;F J=1,4;D 11
01.75 S S=1;F K=1,A(5);S S=S*K
01.80 S DT=DT+S;S P=P+NT/DT;T !%5,L,%10.06,P,NT/DT
01.85 I (L-N) 1.92,1.86,1.92
01.86 T "  (ORIGINAL TABLE)"
01.92 S L=L+1;I (L-MX) 1.5,1.5,1.99
01.99 T !!"SAMPLE SIZE"%4,A(5),!!;Q

10.10 I (A(K)-A(K+1));S T=A(K);S A(K)=A(K+1);S A(K+1)=T

11.05 S S=1;I (A(J+5)-A(J)) 11.5,11.9,11.4
11.40 F K=A(J)+1,A(J+5);S S=S*K
11.45 S NT=NT*S;G 11.9
11.50 F K=A(J+5)+1,A(J);S S=S*K
11.55 S DT=DT*S
11.90 R
