@@@@@@@@@@@@@@@@@@@
C-FOCAL, U01

01.05 T !"ETA/ANOVA"!!;E
01.15 A "NO. SAMPLES",NC,!"GROUPED DATA",B;I (B-0YES)1.4,1.3,1.4
01.30 T "TYPE MIDPOINT, FREQUENCY;";S TO=1
01.40 T " END LIST WITH -9999";F J=1,NC;D 5
01.63 S TO=S-((Y^2)/N);T !!"TOTAL MEAN "Y/N,"  STD.DEV.
01.75 T FSQT(TO/N);S A=S-N*((Y/N)^2);I (A)1.76,1.76,1.8
01.76 T !!"BAD DATA"!;Q
01.80 T "  ETA",FSQT(1-(S-L)/A),!!;S BT=BT-Y^2/N
01.85 T "ANOVA",!"SOURCE  SUM SQUARES  D.O.F.  EST.VAR.     F
01.86 T !"TOTAL  ",TO,%5,N-1,!"BETWEEN",%8.02,BT,%5,NC-1
01.90 T %8.02,BT/(NC-1),!"WITHIN "TO-BT,%5,N-NC,%8.02
01.92 T (TO-BT)/(N-NC),(BT/(NC-1))/((TO-BT)/(N-NC)),!;Q

05.05 T !!"DATA IN SAMPLE"%3,J,!
05.10 I (TO)5.4,5.4;A A;I (A+9999)5.3,5.6,5.3
05.30 A B,!;I (B)1.76,5.5,5.5
05.40 S B=1;A A;I (A+9999)5.5,5.6,5.5
05.50 S N(J)=N(J)+B;S X(J)=X(J)+B*A;S S(J)=S(J)+B*A^2;G 5.1
05.60 T %5,!"  N",N(J),"  MEAN"%8.02,X(J)/N(J),"  STD.DEV.
05.65 T FSQT((S(J)-(X(J)^2/N(J)))/N(J))
05.75 S Y=Y+X(J);S N=N+N(J);S S=S+S(J)
05.80 S L=L+N(J)*((X(J)/N(J))^2);S BT=BT+(X(J)^2)/N(J)
