@@@@@@@@@@@
C-FOCAL, U01

01.10 T !!"KOLMOGOROV-SMIRNOV TESTS"!!;E
01.15 A "ONE OR TWO SAMPLES (TYPE '1' OR '2')",NS,!
01.20 A "HOW MANY CATEGORIES",NC,!!
01.30 T "TYPE IN THE OBSERVED FREQUENCIES";I (NS-1) 1.31,1.31,1.4
01.31 F J=1,NC;A A(J);S A(NC+J)=1
01.35 T !!"        ";F K=1,2;T "OBSERVED  UNIFORM   "
01.38 G 1.5
01.40 F K=1,2;T !"FOR SAMPLE"%2,K;F J=1,NC;A A(J+((K-1)*NC))
01.45 T !!"        ";F K=1,2;T "SAMPLE 1  SAMPLE 2  "
01.50 F J=1,NC;S N1=N1+A(J);S N2=N2+A(NC+J)
01.51 I (NS-2) 1.54;S K=FSQT((N1+N2)/(N1*N2));G 1.55
01.54 S K=1/FSQT(N1)
01.55 T !"    CELL   FREQ    FREQ     CUM PROP  CUM PROP   DIFFERENCE
01.60 F J=1,NC;D 3
01.65 T !!"THE LARGEST DIFFERENCE (D) IS",D,!!
01.70 T "2-TAILED CRITICAL D VALUES FOR LARGE N",!!
01.72 T %4.03,"P=   .10  P=   .05  P=   .01",!
01.75 T "D"1.22*K,"  D"1.36*K,"  D"1.63*K,!;I (1-NS) 1.8;Q
01.80 T !"1-TAILED CHI SQUARE"%5.02,4*D^2*((N1*N2)/(N1+N2))
01.85 T "  D.O.F.=2",!;Q

03.10 S C1=C1+A(J)/N1;S C2=C2+A(J+NC)/N2;S ND=FABS(C1-C2)
03.12 I (ND-D) 3.16;S D=ND
03.16 T !%5,J,A(J);I (NS-2) 3.2;T A(NC+J),%9.03,C1,C2,C1-C2;R
03.20 T %6.01,N1/NC,%8.03,C1,C2,C1-C2
