C-FOCAL , 8/68

01.20 ASK ! "NO. OF SETS DESIRED", SQ
01.25 T !; F NQ=1,70; T " "
01.30 FOR NQ=1,SQ; DO 3
01.40 T %6.00, 99999, ":";D 1.25;Q

02.10 S HI=67*HI+FRAN(); S HI=HI-FITR(HI); S LO=1-HI
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@