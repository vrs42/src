PROGRAM VARIATIONEN(INPUT,OUTPUT);

  VAR   I,K,N: INTEGER;
        Z: ARRAY[0..9] OF INTEGER;

  PROCEDURE PRINT;
    VAR I: INTEGER;
    BEGIN
        FOR I := 1 TO K DO WRITE(Z[I]:1); WRITELN
    END;


  PROCEDURE VARIA(N,K: INTEGER);
    VAR I: INTEGER;
    BEGIN
        IF K>0 THEN FOR I:= 1 TO N DO
                            BEGIN  Z[K] := I; VARIA(N,K-1)  END
               ELSE PRINT
    END;


BEGIN
        READ(N,K);
        VARIA(N,K)
END.
