PROGRAM ASCIICODE(OUTPUT);
    VAR I: INTEGER;
BEGIN
    WRITE("DIE VORVEREINBARTE PROZEDUR   A S C I I ( N )");
    ASCII(13);
    FOR I := 1 TO 45 DO ASCII(95);
    ASCII(13,10,10,10);

    FOR I := 65 TO 90 DO ASCII(I,I+32,32);
    WRITELN;

    WRITE(" ":40);
    FOR I := 1 TO 10 DO ASCII(8,10,64);
    WRITELN;

    FOR I := 0 TO 127 DO
      BEGIN
        WRITE(I,"""":5);
        ASCII(I);
        WRITELN("""")
      END;
    FOR I := 1 TO 50 DO ASCII(7)
END.
