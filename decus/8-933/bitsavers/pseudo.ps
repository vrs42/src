PROGRAM PSEUDOZUFALL(OUTPUT);
  VAR I,N: INTEGER;
        R: REAL;
        Z: ARRAY[0..9] OF INTEGER;

BEGIN
    FOR I := 0 TO 9 DO Z[I] := 0;
    FOR N := 1 TO 1000 DO
        BEGIN
            R := RANDOM; I := TRUNC(10*R);
            WRITE(R:16:10); Z[I] := Z[I] + 1;
            IF N MOD 5 = 0 THEN WRITELN
        END;
    WRITELN; WRITELN("KLASSENHAEUFIGKEITEN":50);
    FOR I := 0 TO 9 DO WRITE(Z[I]:8);
    WRITELN
END.
