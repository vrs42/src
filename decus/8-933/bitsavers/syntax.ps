PROGRAM SYNTAXERROR(OUTPUT);
  CONST M = 10, N := 20
  TYPE T = ARRAY 1..10 OF REAL;
    R := RECORD X: REAL
         B,C : BOOLEAN
         END
  VAR I: INTEGER;
      P,Q: BOOLEAN; X,Y: REAL;;
      I: INTEGER, CH: CHAR
      A: ARRAY (1..M) OF INTEGER;
  CONST Y = 3.14159;
BEGIN I := X  M := I
  IF B DO P = (P OR Q;
  WHILE J < 10
    BEGIN K := .5+(X-Y; Y := X)
    END
  IF P THEN P = 1; ELSE I := 2;
  REPEAT X := P + I*(X>Y);
    FOR X := 1 TO Q
      BEGIN I := A[2
  UNTIL I=J
  FOR J := 1 TO N WHILE X > 0 DO
      BEGIN A(I] := A[J+1); READ(I)
END .
