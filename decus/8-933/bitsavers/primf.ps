PROGRAM PRIM(INPUT,OUTPUT);
VAR N,P: INTEGER;
BEGIN
READ(N);
WRITE(N," =");
P:=2;
WHILE P*P<N DO
      BEGIN
      WHILE N MOD P<>0 DO
            P:=P+1;
      REPEAT N:=N DIV P;
             WRITE(P:3);
             IF N>1
             THEN WRITE(" *")
      UNTIL N MOD P<>0
      END;
IF N>1
THEN WRITE(N:3)
END.
