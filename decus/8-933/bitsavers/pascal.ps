PROGRAM PASCAL(OUTPUT);
CONST   N = 13;
VAR     I,J: INTEGER;
        A: ARRAY[1..N] OF INTEGER;
BEGIN
FOR I := 1 TO N DO
        BEGIN A[I] := 1;
        FOR J := I-1 DOWNTO 2 DO
                A[J] := A[J-1] + A[J];
        WRITE(" ":2*(N-I)+1);
        FOR J := 1 TO I DO WRITE(A[J]:4);
        WRITELN
        END
END.
