PROGRAM DIVISION(INPUT,OUTPUT);
VAR A,I,B,N:INTEGER;
BEGIN
READ(A,B,   N);
WRITE(A:5," :",B:5," =", A   DIV  B:5,".");
FOR  I:=1  TO  N  DO
     BEGIN
     A:=(A  MOD  B)*10;
     WRITE(A  DIV  B:1);
     IF I MOD 50=0
     THEN BEGIN
          WRITELN;
          WRITE(" ":20)
          END
     END
END.
