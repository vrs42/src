PROGRAM PARTITIONEN(INPUT,OUTPUT);

  VAR I,K,X: INTEGER;
      Z: ARRAY[1..9] OF CHAR;

  PROCEDURE P(N:INTEGER);
     BEGIN IF N>1 THEN
       BEGIN K:=K+1;
       Z[K]:="."; P(N-1);
       Z[K]:="-"; P(N-2);
       K:=K-1
       END ELSE
       BEGIN WRITE(" ");
       FOR I:=1 TO K DO WRITE(Z[I]);
       IF N=1 THEN WRITE(".");
       WRITELN
       END
     END;
BEGIN K:=0; WRITE("LAENGE"); READ(X); P(X) END.
