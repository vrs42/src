PROGRAM QUAGL(INPUT,OUTPUT);

  VAR   A,B,C,DISKR,X1,X2,RE,IM: REAL;

BEGIN
    READ(A,B,C);
    DISKR := B*B - 4*A*C;
    IF DISKR>=0 THEN
                    BEGIN
                        X1 := (-B + SQRT(DISKR))/(2*A);
                        X2 := (-B - SQRT(DISKR))/(2*A);
                        WRITELN("X1=", X1:10:5);
                        WRITELN("X2=", X2:10:5)
                    END
                ELSE
                    BEGIN
                        RE := -B/(2*A);
                        IM := SQRT(-DISKR)/(2*A);
                        WRITELN("X1=", RE:10:5, "     +", IM:10:5, " *J");
                        WRITELN("X2=", RE:10:5, "     -", IM:10:5, " *J")
                    END
END.
