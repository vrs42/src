	CDF 60		/FOR HANDLER OF SOURCE FILE
	DCA I F0T6
	ISZ F0T6
	ISZ C400
	JMP .-6
	CDF 10
	TAD I (7617
	SNA		/SOURCE FILE SPECIFIED?
	JMP CDERR
	CDF 0
	CIF 10
	JMS I (USR	/FETCH HANDLER OF SOURCE FILE
	1
SHEP,	IDEVBUF+1
	JMP CDERR
	TAD SHEP	/GET ENTRY POINT
	DCA IDEVH
	CDF 10
	TAD I (7620
	CDF 0
	DCA I (IBLOCK
	JMP STARTC

F0T6,	IDEVBUF
C400,	-400

	PAGE
