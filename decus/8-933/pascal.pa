	POPVAL
	TAD H1
	PUSHVAL
	ISZ H1
	ISZ H2
	ISZ H3
	JMP .-7
	L7776
	BUMP
	CONTINUE

I24,	BUMP		/LITERAL (ADDRESSES ONLY!)
