/INSTRUCTIONS OF STACK COMPUTER (E)

I48,	POPNUM		/ARITHMETIC:
	JMS ENTR		/INTEGER:
	L7777			/ +    48,1
	BUMP			/ -    48,2
	POPNUM			/ *    48,3
	TAD (MRITABL		/ DIV  48,4
	TAD IRY			/ MOD  48,5
	DCA H1
	TAD I H1		/REAL:
	DCA H1			/ +    48,10
	JMS I H1		/ -    48,11
	PUSHNUM			/ *    48,12
	CONTINUE		/ /    48,13

I49,	TAD (ISUB-RSUB	/COMPARE (INTEGER)
I50,	TAD (RSUB	/COMPARE (REAL)
	DCA H1			/ =    50,7440
	POPNUM			/ <>   50,7450
	JMS ENTR		/ <    50,7500
	L7777			/ <=   50,7540
	BUMP			/ >    50,7550
	POPNUM			/ >=   50,7510
	JMS I H1	/SUBTRACT
	TAD IRY
	JMS BOOL
