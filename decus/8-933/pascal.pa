	TAD AC3
	SZL
	CIA
	TAD H1
	CLL
	TAD H2
	DCA RELADR
	SNL
ERRORB,	HALT		/INDEX OUT OF BOUNDS!
INDEX1,	NOP		/OR  JMS MULTY
	L7777
	BUMP
	POPONE
	TAD RELADR
	PUSHONE
	CONTINUE

RELADR=H4

MULTY,	0
	TAD IRY
	OFATAB;ELSIZE
	CLL RAR
	MQL
	TAD (-14	/-12 (BITS)
	DCA H3
MBIT,	SNL
	JMP .+3
	CLL
	TAD RELADR
	RAR
	SWP
	RAR
	SWP
	ISZ H3
	JMP MBIT
	SWP
	DCA RELADR
	JMP I MULTY

I22,	POPONE		/LOAD BLOCK
	DCA H1
	L7777
	BUMP
	TAD IRY
	CMA
	DCA H2
	JMP .+6
	BUMP
	TAD H1
	POPVAL
	PUSHVAL
	ISZ H1
	ISZ H2
