1735            /R E A L   N U M B E R   I N P U T
1736            /
1737            /ACCEPTS A DECIMAL NUMBER IN ANY FORMAT,
1738            /CONVERTS IT TO INTERNAL BYNARY FLOATING POINT NOTATION
1739            /AND LEAVES IT IN THE AC-REGISTER.
1740            /LEADING BLANKS ARE IGNORED; THE FIRST
1741            /NON ACCEPTABLE CHARACTER TERMINATES THE NUMBER.
1742            
1743            DC=MQ2          /DIGIT COUNTER
1744            OC=MQ3          /DIGIT EXCESS COUNTER
1745 02400 0000 DP,     0       /DECIMAL POINT POSITION
1746            
1747 02401 7045 RINP,   RETNUM  /RETURN ADDR. SINCE COMPILER ENTERS AT 'FRACTN'
1748 02402 7610         SKP CLA
1749 02403 4470         READC           /PASS OVER LEADING BLANKS
1750 02404 1033         TAD CHAR
1751 02405 1377         TAD (-240
1752 02406 7650         SNA CLA
1753 02407 5203         JMP .-4
1754 02410 4254         JMS PMXXX       /PROCESS  + - I N T E G E R  PART
1755 02411 1047         TAD OC          /COUNT LOOSEN DIGITS (IF THE INTERNAL
