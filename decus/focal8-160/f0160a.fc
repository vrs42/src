
C-FOCAL , 8/68

01.10 ERASE
01.20 T "SS/GROUP"
01.30 A N1,N2;IF (20-N1)1.36;IF (20-N2)1.36;IF (N2-N1)1.34,1.4,1.4
01.34 T "N1 MUST BE LESS THAN N2",!!;GOTO 1.1
01.36 T "NOT WITHIN LIMITS",!!;GOTO 1.1
01.40 T !!!,"DATA",!!,"GRP 1",!
01.50 FOR J=1,1,N1;ASK A(J);S G(J)=1
01.55 T !!,"GRP 2",!;S I=N1+1;S N=N1+N2
01.60 FOR J=I,1,N;ASK A(J);S G(J)=2
01.70 S I=N-1;T !!,"WAIT",!!
01.71 DO 1.72
01.72 S CH=0;DO 1.73;IF (CH)2.1,2.1,1.71
01.73 FOR J=1,1,I;DO 2

02.01 S IT=A(J);S K2=G(J)
02.02 IF (IT-A(J+1))2.05,2.05,2.03
02.03 S CH=CH+1;S A(J)=A(J+1);S G(J)=G(J+1)
02.04 S A(J+1)=T;S G(J+1)=K2
02.05 RETURN
02.10 S IT=0;S IC=0;S A(N+1)=999
02.11 FOR J=1,1,N;DO 3
02.12 GOTO 3.1

03.01 IF (A(J)-A(J+1))3.03,3.02,3.03
03.02 S IT=IT+1;S IC=IC+J;GOTO 3.08
03.03 IF (IT)3.07,3.07,3.04
03.04 S IC=IC+J;S IT=IT+1;S CH=IC/IT
03.05 S K2=(J-IT)+1;FOR I=K2,1,J;S A(I)=CH
03.06 S IC=0;S IT=0;GOTO 3.08
03.07 S A(J)=J
03.08 RETURN
03.10 S I=0;S IT=0;S IC=0
03.12 S I=I+1;IF (I-N)3.13,3.13,3.15
03.13 IF (G(I)-1)3.12,3.14,3.12
03.14 S IC=IC+A(I);S IT=IT+1;IF (IT-N1)3.12,3.12
03.15 S I=N1*N2;S IT=((N1+1)*N1)/2
03.16 S CH=(I+IT)-IC;S K2=I-CH
03.17 IF (CH-K2)3.18,3.19,3.19
03.18 T "U ";T %10.4,CH,!;GOTO 3.2
03.19 T "U'";T %10.4,K2,!
03.20 T "N1";T %3,N1;T "   N2";T %3,N2,!!
03.21 QUIT
*8|~