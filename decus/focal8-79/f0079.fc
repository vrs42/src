
C-FOCAL , 8/68

01.10 T !!,"WELCOME TO THE CARNIVAL GAME!  AFTER YOU MAKE A",!
01.20 T "BET, SELECT A NUMBER BETWEEN 1 AND 6.  THREE",!
01.30 T "IMAGINARY DICE WILL BE ROLLED.  IF YOUR NUMBER COMES",!
01.40 T "UP ON ONE DIE, YOU WILL WIN THE AMOUNT YOU BET.  IF",!
01.50 T "IT COMES UP ON TWO, OR ALL THREE DICE, YOU WILL WIN",!
01.60 T "DOUBLE OR TRIPLE YOUR BET RESPECTIVELY.  IF IT DOES",!
01.70 T "NOT COME UP AT ALL, YOU LOSE.  FOLLOW YOUR ANSWERS BY",!
01.80 T "TYPING 'RETURN'.  YOU ARE STARTING WITH 1000 DOLLARS.",!

02.10 SET T=1000
02.20 ASK !,"HOW MUCH OF IT DO YOU WANT TO BET?", B
02.21 IF (B)2.22,2.22,2.3
02.22 T "NOW, NOW.  THAT'S NOT FAIR.",!; GOTO 2.20
02.30 IF (T-B)2.4,2.5,2.5
02.40 T %7.02, "YOU ONLY HAVE ",T," DOLLARS",!;GOTO 2.2
02.50 ASK "PICK A NUMBER" L
02.60 IF (L-FITR(L))2.7,2.8,2.7
02.70 T "NO SUCH NUMBER ON A DIE",!;GOTO 2.5
02.80 IF (L-1)2.7,2.9,2.9
02.90 IF (L-6)3.1,3.1,2.7

03.10 SET Q=0; FOR N=1,1,3; DO 4.0
03.20 GOTO 5.1

04.10 SET R=FABS(FITR(10*FRAN()))
04.20 IF (R-1)4.1,4.3,4.3
04.30 IF (R-6)4.4,4.4,4.1
04.40 SET X(N)=R
04.50 IF (R-L)4.6,4.7,4.6
04.60 SET Q=Q+0; GOTO 4.8
04.70 SET Q=Q+B
04.80 SET R=0-B

05.10 T %1.0,!,"THESE NUMBERS CAME UP ",X(1)," ",X(2)," ",X(3),!
05.20 IF (Q)6.1,6.1,7.1

06.10 SET T=T-B; IF (T)6.3,6.3,6.2
06.20 T %7.02,"YOU LOSE.  YOU HAVE ",T," DOLLARS LEFT",!;GOTO 2.2
06.30 T "YOU LOSE - THE GAME'S OVER",!;QUIT

07.10 SET T=T+Q; T %7.02,"YOU WIN ",Q," DOLLARS",!
07.20 IF (T-10000)7.3,8.1,8.1
07.30 T "YOU NOW HAVE ",T," DOLLARS.",!;GOTO 2.2

08.10 T "YOU HAVE ",T," DOLLARS.",!
08.20 T "I QUIT",!!;QUIT
?