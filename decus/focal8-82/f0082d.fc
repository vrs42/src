C-FOCAL , 8/68

01.01 T "SIMPLE SINE MAN"!
01.02 S PI=3.14159; A "OMEGA",W,"T0",T0,"AMPLITUDE",A,!
01.04 A "PLOT EVERY [ ? ] DEGREES",DG,"FOR [ ? ] CYCLES",CY,!
01.06 F K=0,[35-(A+1)];T " "
01.07 T "A"; F L=0,2*A-2;T ":"
01.08 S Z=0;T "A",!
01.10 F T=0,DG*PI/180,CY*2*PI; DO 2; DO 4; T "*"; DO 1.3; T !
01.30 S Z=Z+1; T #,%3,Z,%2,Y-35

02.01 F Y=0,34; T " "
02.02 T ":",#
02.03 R

04.02 I ([W*T-T0]-PI)4.05,4.05,4.04
04.04 F Y=0,35+A*FSIN(W*T-T0); T " "; R
04.05 F Y=0,34+A*FSIN(W*T-T0); T " "; R
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@