@@@@@@@@@@@E A
C-FOCAL , 8/68

01.01 T "SUM SHADED SINES"!!
01.02 C DOCUMENTED SUM OF 1,2 ISO-AMPLITUDE WAVES W/DAMPING
01.03 A "GIVE PHASE ANGLE (DEG.& TENTHS)",THETA,!; DO 5
01.04 S Z=0
01.05 A "SINE WAVE AMPLITUDE",AMPL,!
01.06 A "DELTA T / TT LINE [0<=?=>+1]",SCALE,!
01.07 A "DAMPING FACTOR COEFFICIENT",T,!
01.08 A "APPROX. NUMBER OF TT LINES IN THIS PLOT [+-1]",N,!
01.09 F K=0,34;T "-"; C MARKS CONVENTIONAL 'Y'- AXIS
01.10 T ":"; F K=0,33; T "+"
01.11 T !; F I=0,SCALE,[SCALE*N]; DO 1.15; T "X"; DO 3
01.13 T "GIVE ME A 'GO' TO PLOT ANOTHER"!
01.14 T "WHILE YOU DRAW THE CURVE ON THE ONE ABOVE"!!!!!; DO 4
01.15 F J=0,34+AMPL*[FSIN(I)+FSIN(I*THETA)]*FEXP(-T*I); DO 2
01.16 C FINDS DATUM

02.01 I (J-35)2.03,2.05,2.07
02.03 T " "; R
02.05 T ":"; R
02.07 T "+"; R
02.08 C FINDS X- AXIS IF BEFORE DATUM

03.01 I (34-J)3.03,3.02; F K=J,33; T "-"
03.02 T ":"
03.03 S Z=Z+1 ; T #,%3,Z,%2,J-35,!; R
03.04 C FINDS X- AXIS IF AFTER DATUM

04.01 QUIT

05.01 S PI=3.14159; THETA=[THETA*PI]/180; R
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@