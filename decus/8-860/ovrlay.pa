	INS=	.	/THIS IS WHERE THEY START
	HOOK=	.+2	/HOOK LINK GOES INTO 564
	RELOC	1	/THESE THREE GO DOWN ON TO PAGE ZERO
VTRANS,	JMP I	VPOINT	/CONTROL TRANSFERS TO HERE
VPOINT,	SERVE		/AND IT COMES OUT HERE
	RELOC	564	/
LINK,	STOP
	RELOC
