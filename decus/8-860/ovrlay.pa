	CKRD		/READ DATE WORD
	SNA CLA		/IF NO CLOCK WE WILL GET 0
	JMP	NODATE	/NO CLOCK
	JMS I	P1SWAP	/SWAP MONITOR INTO WORKING POSITION
	JMS	CWAIT	/FIRST DATE WORD COULD BE HASH SO WE WAIT
	CKRD		/AND READ AGAIN
	CDF	10	/DATE WORD IS IN FIELD 1
	DCA I	(DATWD	/PUT DATE WORD AWAY
	CDF		/BACK TO FIELD 0
	JMS I	P1SWAP	/AND RETURN MONITOR TO MOTHBALLS
	JMS I	STHRST	/SET HALFWORD STORE TO FIELD 0
	TAD	(SAC	/GET LOCATION OF SAC
	CLL		/LINK=0 => LEFT HALF FIRST
	JMS I	STHINL	/SET UP STH FOR SAC
	JMS	CWAIT	/WAIT FOR CLOCK TO BE READY
	CKRH		/GET HOURS & AM/PM
