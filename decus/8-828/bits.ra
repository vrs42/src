/BGET & BPUT RUTINES GETS/PUTS BITS IN A 36 BIT WORD
/CALL BGET/BPUT/(A,N,L)
/A=WORD   N=BIT(1-36)  L=VALUE TO INSERT OR GET
/L= 0  OR NON0
	ENTRY BGET
	ENTRY BPUT
	SECT8 #BITS8
	BASE BTBASE
BGET,	JSA BTSET
	TRAP4 BGET8
	XTA 2	/0 OR 1 
	FSTA% BTOPER
	STARTF
	JA BTRTN
BPUT,	JSA BTSET
	TRAP4 BPUT8
	FLDA BWORD
	FSTA% BTBASE /RETURN THE WORD
	JA BTRTN
BGET8,	0	/GET THE BIT
	JMS SUB8
	TAD% INDX0	/INPUT 0 OR 1
GETLP,	CLL RAR	/PUT THE REQUIRED BIT INTO LINK
	ISZ INDX1
	JMP GETLP
	CLA RAL
	DCA INDX2
	CDF CIF 0
	JMP% BGET8
BPUT8,	0
	JMS SUB8
	STL
PUTLP,	RAL
	ISZ INDX1	/PUT A 1 IN PUSITION IN AC
	JMP PUTLP
	DCA BTINDX
	TAD BTINDX
	CMA	/COMPLEMENT
	DCA BTINDX+1
	TAD INDX2
	RAR	/0 OR 1 IN LINK
	TAD% INDX0
	AND BTINDX+1	/AND THE BIT
	SZL	/SHOULD IT BE SET ?
	TAD BTINDX	/YES
	DCA% INDX0
	CDF CIF 0
	JMP% BPUT8
SUB8,	0
	CLA CLL
	TAD BADDR+1
	TAD INDX0
	DCA INDX0	/NOW POINTS TO RELEVANT 12 BIT WORD
	JMP% SUB8
BTBASE,	F 0.
BTINDX,	F 0.
BTOPER,	F 0.
F3,	F 2.95	/NEVER COMPARE FOR EXACT FLOATING
BWORD,	F 0.
F12,	F 12.
BITOP,	TEXT +BITS  +
INDX0,	0	/INDEX  ALSO WORD NO(0,1,2);CHANGED TO ADRESS
INDX1,	0	/NEG OF BIT NO
INDX2,	0	/0/1
	ORG 18*3+BTBASE
fNOqM.IKEtK~UzxoT_yO^S5^w^_dN_4{On~w?woyV^_(o|ow{{^usb_\P\FEA O AER CXOFTIALNTW
GDOBF,R. 	F0,1
 	2.1FB2OI
	PTXT,+TETB  SI
+ DI,XN		0N/0XDIA EOL O S RW(ND10O),,H;2GAC EN TDRAOSEDISE
	SETX INDX0
	FSTA BTBASE
	LDX 1,1
	FLDA% BTBASE,1
/	FSTA BWORD	/ADRESS OF A
	FSTA BTBASE+15
	FLDA% BTBASE,1+
	FSTA BTINDX	/ADRESS OF N
	FLDA% BTBASE,1+
	FSTA BTOPER	/ADRESS OF L
	FLDA BTBASE+15
	FSTA BTBASE	/FOR RETURNING ARGUMENT
	STARTF
	FLDA% BTINDX
	FSTA BTINDX
	JLE BAD	/LESS EQ 0
	FSUB F1	/N-1
	FDIV F12	/(N-1)/12
	ATX 0	/WORD NO(N/12-1)
	FSUB F3
	JGT BAD	/INDX0>3
	XTA 0
	FMUL F12	/=I/12*12
	FSUB BTINDX	/N=A-A/12*12
	ATX 1	/BIT NO
	FLDA% BWORD	/A
	FSTA BWORD
	FLDA% BTOPER	/L
	JEQ ZERO
	FLDA F1	/JUST TO GUARD AGAINST NON-NORMALIZATION
ZERO,	ATX 2
	JA BTSET
EXTERN #ARGERR
BAD,	TRAP4 #ARGERR
END
