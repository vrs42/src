/^  MAY   31    1976
/             AUGUST   27    1974
/	REGIST.RA
/ DIGIO RUTINES
/FOR FORTRAN IV

DBCI=6503
DBRI=6504
DBCO=6505
DBSO=6506
DBRO=6507
DBTD=6574	/8A DIG IO BOARD OUT
/THE FOLLOWING ARE IMPLEMENTED
/
/CALL DBI(I,A)	READS(AND CLEARS)DIGITAL INPUT BIT  I INTO A
/CALL DBOC(I)	CLEARS OUTPUT BIT 1
/CALL DBOS(I)	SETS OUTPUT BIT I
/CALL DBCLR	CLEARS IN AND OUT REGISTERS
/CALL CMDOPT(I,A)	BIT I FROM 7400 IS READ INTO A
/	7400 IS SET BY FRTS AFTER LAST CALL


/OTHER IOTS CAN BE ISSUED VIA IOT OR IOTB SE COMMENTS BELOW
/
/INSTRUCTION	OCTAL	DECIMAL
/DBRI		6504	3396
/DBRO		6507	3399
/DBTD(8A)	6574	3452
/MQL		7421	3857
/MQA	7501	3905
/SWP		7521	3921
/LAS		7604	3972
/DBSS(8A)	6577	3455
/DBRD(8A)	6572	3453
 	SECT8 DBCLR
	BASE 0
	INDEX INST
	JSA SETUP
	TRAP4 CLEAR
GOBAK,	FLDA 30
	JAC
CLEAR,	0
	CLA CMA
	DBCI
	DBCO
	CLA CLL
	DBTD
	CDF CIF
	JMP% CLEAR
	ENTRY DBI
DBI,	JSA SETUP
	TRAP4 INREAD
	JA CONT
	
/*** NB WE MUST BE PAST INDEX REGISTERS NOW ***
PDP,	0
	TAD AC
INST,	HLT
	DCA AC
	CIF CDF 0
	JMP% PDP
XR4,	0	/USED TO INDEX IF IOT OR IOTB
AC,	  0
ONE,	  1
TWO,	  2
OPDBO,	DBCO;CDF CIF
OPDBO2,	DBSO;CDF CIF
/
OUTPUT,	0
	CLA CMA
	JMS SETBIT
OUTOP,	0;0
	JMP% OUTPUT
	
P7400,	7400
MQ,	0
	CDF 0
	TAD% P7400	/***NOTE WE DO NOT KNOW THE FIELD WE ARE
/IN BUT IT IS RESET AT THE EXIT FROM MQ***
	JMS SETBIT
	SZA CLA
	ISZ INST
	CDF CIF
	JMP% MQ
SETBIT,0
	DCA CLEAR
	TAD INST
	CMA CLL CML
	DCA INST
	RAR
	ISZ INST
	JMP .-2
	AND CLEAR
	JMP% SETBIT
INREAD,	0
	DBRI
	JMS SETBIT
	DBCI
	SZA CLA
	ISZ INST
	CIF CDF
	JMP% INREAD
	
CONT,	STARTD
	FLDA% 0,TWO
	FSTA 3
	STARTF
	XTA INST
	FSTA% 3
	JA GOBAK

	ENTRY DBOC
DBOC,	STARTD
	FLDA OPDBO
DBOC2,	FSTA OUTOP
	JSA SETUP
	TRAP4 OUTPUT
	JA GOBAK
	ENTRY DBOS
DBOS,	STARTD
	FLDA OPDBO2
	JA DBOC2
	
	ENTRY CMDOPT
CMDOPT,	JSA SETUP
	TRAP4 MQ
	JA CONT

SETUP,	0;0
	STARTD
	SETX INST
	FLDA% 0,ONE
	FSTA 3
	STARTF
	FLDA% 3
	ATX INST
	JA SETUP

/	SUBROUTINE IOT (INST, AC)
/
/CALLING SEQUENCE:
/
/	CALL IOT (INST, AC)
/		<INST> THE 8-MODE INSTRUCTION TO BE
/			EXECUTED (NORMALLY AN IOT INST.)
/		<AC> THE VALUE OF THE AC WHEN THE
/			INSTRUCTION IS EXECUTED.
/
/		THE VARIABLE <AC> IS CHANGED TO BE
/		EQUAL TO THE VALUE OF THE AC AFTER THE
/		INSTRUCTION IS EXECUTED.  THIS FEATURE
/		MAY BE USED, FOR EXAMPLE, TO READ THE
/		SWITCH REGISTER WITH THE INSTRUCTION 'LAS'.
/
	BASE 0
/	SECT8 IOT
/TO OPTIMISE CORE USAGE LET THE REST FLOAT
	SECT IOT
	JSA SETUP
	LDX 0,XR4
IOT1,	STARTD
	FLDA% 0,TWO
	FSTA 3
	JXN IOT2,XR4
	STARTF
IOT2,	FLDA% 3		/GET THE VALUE OF THE AC
	ATX AC		/PUT IT IN 8-MODE VARIABLE
	TRAP4 PDP
	JXN IOT3,XR4+	/SKIPS REVERSED AS TO LAST TEST !
	STARTD
	FLDA AC
	JA IOT3A
IOT3,	XTA AC		/GET VALUE OF AC
IOT3A,	FSTA% 3		/RETURN IT TO CALLING PROG
	STARTF
	JA GOBAK
/
/
/IOTB IS CALLED AS IOT BUT BITS OF FORTRAN WORD ARE USED
/123456789012 345678901234 567890123456     36 BIT FORTRAN WORD
/RETURNED       SENT
/TO SET BIT 3 OF MQ:
/A=0        CALL BPUT(A,12-3+12,1)   CALL IOTB(3857,A)
/
/TO READ BIT 3 OF MQ:
/CALL IOTB(3905,A)     CALL BGET(A,12-3,I)
/REMEMBER THAT THE BITNUMBERING OF THE PDP8 IS FROM 0 BEING THE
/MOAT AIGNIFICANT BIT
	ENTRY IOTB
IOTB,	JSA SETUP
	LDX -1,XR4
	JA IOT1
END
