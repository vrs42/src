C	FILE TSTBIT.FT

C TEST OS/8 FORTRAN IV SUBROUTINES BGET & BPUT (DECUS 8-828)

	INTEGER BITSTR,FLAGS(12)

	DATA FLAGS /'A','B','C','D','E','F','G','H','I',
     *	  'J','K','L'

	BITSTR=0

C	SET ODD FLAGS
	DO 10 I=1,12,2
	CALL BPUT(BITSTR,I,1)
   10	CONTINUE

C CHECK IF JOB WAS DONE.  (PRINTS A,C, ETC. IF SO.)
	DO 20 I=1,12
	CALL BGET (BITSTR,I,L)
	IF (L.NE.0)  WRITE (3,100) I,FLAGS(I)
100	FORMAT(I5,IX,A1)
   20	CONTINUE
	STOP
	END
