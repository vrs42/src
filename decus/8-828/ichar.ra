/^   JUNE   02    1976
/ICHAR FETCHA CHARACTER FROM KEYBOARD UNECHOED -ASO ALLOWS
/FOR FETCHING CONTROLS
/CONDITIONALS:
/	IF NFILL IS ZERO OR UNDEFINED THE FILLER-CHAR
/	RUTINES ARE NOT ASSEMBLED
/	SET NFILL TO NO OF REQUIRED FILLERS
/	IF ET IS SET TO 1 THE ENTRY POINT ETOS
/	IS ADDED  CALLING(L=ETOS(0))CHECKS FOR AN
/	ETOS ENVIROMENT AND THEN DISSABLES THE
/	ION/IOF LOGIC, ALSO L IS TRUE IF ETOS 0 ELSE

/CALLING CALL ICHAR(A,B)
/ON RETURN A=7-BIT OF CHAR FROM KEYBOARD
/B=A1 FORMAT
/TSTCHR IS CALLED THE SAME WAY BUT PICKS UP THE 
/PENDING CHAR IN FRTS BUFFER
/IT ALLOWS A PROGRAM TO SWITCH DURING EXECUTION IF A CHAR IS
/TYPED ON KEYBOARD
/NOT USABLE UNDER ETOS(OR RTS8 FOR THAT)
	IFREF NFILL <IFPOS NFILL <NFILL=-NFILL>>
	IFNDEF NFILL <NFILL=0
		/NO OF FILLERS REQUIRED ON FUNCTIONS
	>
	IFNDEF ET <ET=0>
	SECT8 #CHAR8
	ENTRY TSTCHR
	ENTRY ICHAR
	ENTRY OCHAR
IFNZRO ET <ENTRY ETOS>
	INDEX XR0
	BASE 0
#ICHAR,	0
IO1,	IOF	/VERY IMPORTANT
	KSF
	JMP .-1
	KRS	/LEAVE A POSSIBLE ^C ^B
	AND P177
	TAD M01	/=1?
	SNA	/NO
	JMP .+4	/YES
	TAD M02	/>4 ?
	SPA SNA CLA
	JMP CNTRL	/NO
	KRB	/YES REMOVE IT
	AND P177
	DCA XR0
	TAD XR0
	AND P77
	STL
	RTL
	RTL
	RTL
	DCA XR7
CNTRL,	CIF CDF 0	/IF THERE IS A CHAR <03 LET FRTS TAKE CARE OF IT
IO2,	ION
	JMP% #ICHAR
P177,	177
M02,	-2
M01,	-1
M37,	-37
P100,	100
P77,	77
#TSTC,	0
	CDF 0
	TAD% KPOINT
	DCA XR0
	TAD XR0
	AND P77
	STL
	RTL
	RTL
	RTL
	DCA XR7
	DCA% KPOINT	/REMOVE FROM FRTS
	CDF CIF 0
	JMP% #TSTC
KPOINT,	5
/WAIT FOR NORMAL TTY IO TO STOP
#TTYWT,	0
L1,	CDF 0
	TAD% M4
	SZA CLA
	JMP L1
	CIF 0
	JMP% #TTYWT
M4,	4
#OCHAR,	0
	CLA
IO3,	IOF
	TAD XR0
	SZA
	JMP NUMER
	TAD XR1
	IFNZRO NFILL <
	SNA
	JMP NUMER
	>
	RTR
	RTR
	RTR
	AND P77
	DCA XR0
	TAD XR0
	TAD M37
	RAL
	CLA
	TAD XR0
	SZL	/ADD IN 100 IF < 40
	TAD P100
NUMER,	TLS
	TSF
	JMP .-1
IO4,	ION
	CDF CIF 0
	JMP% #OCHAR
	IFNZRO ET <
	ENTRY #TST
#TST,	0
	6107
/	SKIP ON ETOS
	JMP TSTOUT
	CLA CLL
	DCA% IOP1+1
	DCA% IOP2+1
	DCA% IOP3+1
	DCA% IOP4+1
	IAC
	DCA ETO
	CLA CLL CML RTR	/2000
	DCA ETO+1
TSTOUT,	CDF CIF
	JMP% #TST
ETO,	F 0.0
	>
