R/IE ESG RTIESS
	FCLA
	FSTA XR1
	TRAP4 #OCHAR
	JA ENDLP
	INDEX XR0
	ENTRY FOCHAR
FOCHAR,	SETX XR0
	LDX NFILL,XR6
	JA NEXT
	>
IFNZRO ET <
ETOS,	TRAP4 #TST
	FLDA 30
	FSTA XR0	/SAVE TEMP
	FLDA ETO
	JA XR0
	>
IFNZRO NFILL <
CRLF,	LDX NFILL,XR6	/THE LF NEEDS FILLERS
	>
IFZERO NFILL <
CRLF,
>	LDX 15,XR0	/CR
	TRAP4 #OCHAR
	LDX 12,XR0	/LF
	JA LF
	INDEX XR0
	BASE 0
ICHAR,	TRAP4 #TTYWT
	TRAP4 #ICHAR
ICHAR2,	SETX XR0
	STARTD
	FLDA% 0,XR4	/BASE OF OLD +INDEX !
	FSTA 3
	STARTF
	XTA XR0
	FNORM
	FSTA% 3
	STARTD
	FLDA% 0,XR5
	FSTA 3
	STARTF
	FLDA XR7
	FSTA% 3
	FLDA 30
	JAC
/********** OCHAR******
/CALLING:
/CALL OCHAR (I,J)
/	I IS IN ASCII
/	J IS IN A6 FORMAT(A1)
/IF I=0 USE J
/IF I&J=0 OUTPUT CR/LF
OCHAR,	INDEX XR0
	SETX XR0
	LDX -1,XR6
NEXT,	TRAP4 #TTYWT
	STARTD
	FLDA% 0,XR4
	FSTA 3
	STARTF
	FLDA% 3
	ATX XR0
	STARTD
	FLDA% 0,XR5
	FSTA 3
	STARTF
	FLDA% 3
	FSTA XR1
	XTA XR0
	FADD XR1
/	ARE BOTH ARGUMENTS =0 ?
	JEQ CRLF	/YES OUTPUT CR LF
LF,	TRAP4 #OCHAR
	IFNZRO NFILL <
ENDLP,	JXN LOOP,XR6+
	>
	FLDA 30
	JAC

TSTCHR,	TRAP4 #TSTC
	JA ICHAR2
END
