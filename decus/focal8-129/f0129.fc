01.02 T !"THIS PROGRAM WILL PUNCH FULL HEIGHT READABLE CHARACTERS
01.03 T !"AND BOOTSTRAP ITSELF TO CONTAIN ANY FONT"!,"USE ONLY ALPHA
01.04 T "-NUMERICS AND ^[]!@-*\+/ BELL QUOTES BACK^";D 3.05;CG 3.05
01.05 A N;D +N/100+.5;G 1.05
01.85 T 96,96,76,66,66,193,66,66,76,96,96,0,0
03.05 O C;O X;O N;T !"TURN ON PUNCH AND SPACE
03.10 A Z;O S 160;W 1,3,4,5;O I
03.20 F L=160,223;T %3.2,L/100+.5;T " T";D 4;T !
04.10 A NU;I(NU-378)4.15;R
04.15 S A=0;F I=0,2;D 5
04.20 T %3,A,",";G 4.1
05.05 S D=FITR(NU/10^(2-I));S NU=NU-D*10^(2-I);S A=A+D*8^(2-I)























































