
C-FOCAL., 1968

01.01 A !!"-1)EXPONENTIAL  0)POWER  1)LINEAR"!,A
01.02 A !"HOW MANY X VALUES?"!,P
01.03 T !"X VALUES?"!;F I=1,P;A X(I)
01.04 T !"Y VALUES?"!;F I=1,P;A Y(I)
01.05 I (P/2-FITR(P/2))1.06,1.07,1.06
01.06 S M=(P-1)/2;S N=P;G 1.08
01.07 S M=P/2;S N=P
01.08 I (A)1.09,1.11,1.13
01.09F I=1,P;S Y(I)=FLOG(Y(I))
01.10 D 3; D 9; T !"Y ",FEXP(AN(2)),"*(E^",AN(1),"X ";G 1.01
01.11 F I=1,P;S X(I)=FLOG(X(I)); S Y(I)=FLOG(Y(I))
01.12 D 3 ;D 9;T !"Y ",FEXP(AN(2)),"X^ ",AN(1);G 1.01
01.13 D 3;D 9;T !"Y  ",AN(1),"X+ ",AN(2);G 1.01

03.01 S X1(1)=0;S X1(3)=0;S X1(2)=M;F I=1,M;D 3.10
03.02 G 3.45
03.10 S X1(1)=X1(1)+X(I);S X1(3)=X1(3)+Y(I)
03.45 S Y1(1)=0;S Y1(3)=0;S Y1(2)=P-M;F I=M+1,N;D 3.56
03.48 RETURN
03.56 S Y1(1)=Y1(1)+X(I);S Y1(3)=Y1(3)+Y(I)

09.01 D 14;S AN(1)=U;S AN(2)=V;R

14.01S W=X1(1)*Y1(2)-X1(2)*Y1(1)
14.02 S U=X1(3)*Y1(2)-X1(2)*Y1(3);S U=U/W
14.03S V=X1(1)*Y1(3)-X1(3)*Y1(1);S V=V/W
*