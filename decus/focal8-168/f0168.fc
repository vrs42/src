20.16 S R=0
20.17 A "  BET ONE DOLLAR?" ANS, !, !
20.18 I (ANS-0YES) 20.19,20.20
20.19 T "O-K PIKER" ; Q
20.20 T "YOU SPUN  " ; F N=1,3; D 21.0
20.21 D 22.0
20.22 I (R) 20.23,20.23,20.24
20.23 T "YOU OWE ME" %4, 0-R; T "DOLLARS-" ; G 20.17
20.24 T " I OWE YOU" %4, R; T "DOLLARS" ; G 20.17

21.01 S D=FRAN( )
21.02 S A(N)=FITR(8*(100*D-FITR(100*D)))
21.03 I (A(N)-1) 21.07,21.08,21.04
21.04 I (A(N)-3) 21.09,21.10,21.05
21.05 I (A(N)-5) 21.11,21.12,21.06
21.06 I (A(N)-7) 21.13,21.14
21.07 T "  BAR   "; R
21.08 T "  BELL  "; R
21.09 T "  PLUM  "; R
21.10 T " ORANGE "; R
21.11 T " LEMON  "; R
21.12 T " CHERRY "; R
21.13 T " APPLE  "; R
21.14 T " GRAPEF "; R

22.01 I (A(1)-A(2)) 22.11,22.02,22.11
22.02 I (A(3)-A(2)) 22.07,22.03,22.07
22.03 I (A(1)-1) 22.12,22.13,22.04
22.04 I (A(1)-3) 22.14,22.15,22.05
22.05 I (A(1)-5) 22.17,22.22,22.06
