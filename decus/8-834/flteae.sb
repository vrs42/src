/ FLOATING POINT STORE ROUTINE

STO,	6440		/ENTRY
	0006
	JMS GETADD	/GET ADDRESS
STOX,
	TAD ACH		/MOVE FAC TO THIS
	DCA OPH		/FIELD TEMPORARILY
	TAD ACM
	DCA OPL
	TAD ACL
	MQL
	TAD GETAF2	/MOVE THE CDF INSTRUCTION
	DCA STOAF2
STOAF2,	  HLT		/GETS A CDF
	TAD OPH		/NOW STORE WITH AUTO INDEX
	DCAI PNT2
	TAD OPL
	DCAI PNT2
	MQA
	DCAI PNT2
STOX1,	DCA ACH		/CLEAR THE FAC
	DCA ACM
	DCA ACL
/FLOATING POINT SUBROUTINE RETURN

FRETF,	  HLT		/CHANGED TO CIF CDF
	JMPI PNT


