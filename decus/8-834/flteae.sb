/ NEGATE FAC

FFNEG,	0
	TAD ACM
	CLL CIA
	DCA ACM
	CML RAL
	TAD ACH
	CLL CIA
	DCA ACH
	JMPI FFNEG

/ CHANGE SIGN OF FAC

CHS,	6440		/ENTRY
	0005
	JMS FFNEG	/NEGATE FAC
	AC0002
	TAD CHS		/MAKE CIF CDF
	DCA CHS1
