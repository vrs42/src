/FLOAT A FIXED INTEGER IN AC
/LEAVE RESULT IN FAC

SIGN,
FLOT,	6440		/ENTRY
	0006
	MQL		/SAVE THE AC
	AC0002
	TAD FLOT	/MAKE CIF CDF TO FROM FIELD
	DCA FRETF
	TAD FLOT#	/SET UP RETURN POINTER
	DCA PNT
	MQA		/GET INTEGER BACK
FLOTX,	SNA		/IS INTEGER ZERO?
	JMP STOX1	/YES -- CLEAR FAC
	CLL RAL		/SIGN TO LINK
	MQL		/PUT IN MQ
	SZL		/IS SIGN ON?
	CMA		/YES -- EXTEND IT
	NMI
	DCA ACH		/SAVE HIGH
	MQA
	DCA ACM		/SAVE LOW
	SCA		/GET STEP COUNT
	CIA
	TAD (26
	DCA ACL		/SAVE EXPONENT
	JMP FRETF

