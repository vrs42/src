@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
C-FOCAL , 8/68

01.09 ERASE
01.10 A "N-SAMPLE 1",N1;A "N-SAMPLE 2"N2
01.15 T !!!,"SAMPLE 1",!!
01.20 F I=1,N1;DO 1.85
01.25 T !, "SAMPLE 2",!!
01.30 F J=1,N2;DO 1.90
01.35 S S1=[(B)-(A^2/N1)]/N1
01.36 S S2=[(D)-(C^2/N2)]/N2
01.40 T %8.03,!!!, "MEAN-SAMPLE 1",A/N1,!;S M1=A/N1
01.41 T %8.03, "MEAN-SAMPLE 2",C/N2,!;S M2=C/N2
01.42 T "VAR-SAMPLE 1 ",S1,!
01.43 T "VAR-SAMPLE 2 ",S2,!
01.50 S H=FSQT(<(N1*S1+N2*S2)/(N1+N2-2)>*<(N1+N2)/(N1*N2)>)
01.52 T "SD-DIFF      ",H,!!
01.59 IF (M1-M2) 1.7,1.7,1.6
01.60 T "T",(M1-M2)/H;T %3,"    WITH DF",(N1+N2-2),!!;GOTO 1.8
01.70 T "T",(M2-M1)/H;T %3,"    WITH DF",N1+N2-2,!!
01.80 QUIT
01.85 A X;S A=X+A;S B=X^2+B
01.90 A Y;S C=Y+C;S D=Y^2+D
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@x|