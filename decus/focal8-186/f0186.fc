C-8K FOCAL @1969

01.10 S P=95;S S=2800;S H=3000;S E=200;S Y=3;S A=1000;S I=5;S Q=1
01.20 T %5 !"SALUT A TOI"!"GOUFFRE INSONDABLE DE TOUTE SAGESSE"!
01.30 T "PAR MOI, ROI DES AMORRITES, DE SUMER ET D'ACCAD,"!
01.40 T "SOIS MON FEAL SUR LE TRONE DE LARSA"!

02.10 S D=0;T !!!
02.20 D 6;I (D)7.20,2.25;T "OUVRES LES PORTES DE TES LARMES,"
02.21 T "LA FAIM FIT"D,"  MORTS"!
02.25 T "TA CITE S'ACCRUT DE"I,"  SUJETS,";S P=P+I;I (Q)2.3,2.27,2.3
02.27 S P=FITR(P/2);T !"LA PESTE ROUGE DECIMA LA MOITIE DE TES FEAUX,"!
02.30 T !"ET TU VEILLES SUR "P," AMES."!!"LARSA POSSEDE"
02.35 T A," ACRES DE BONNES TERRES."!!
02.40 S C=1;T "LA RECOLTE FUT"H," BOISSEAUX"!
02.50 I (E) 7.20,2.60;T "MAIS LES RATS EN DETRUISIRENT"E,!
02.60 T !"ET LES RESERVES CONTIENNENT"S," BOISSEAUX"!!!

03.10 D 8;S Y=C+17;T " LA TERRE SE TROQUE A
03.20 T Y," BOISSEAUX L'ACRE ,";S C=1
03.30 A !"COMBIEN D'ACRES LA CITE DOIT ELLE ACQUERIR ?"!Q;I (Q)7.2,3.8
03.40 I (Y*Q-S)3.9,3.6;D 4.6;G 3.3
03.50 D 4.5;G 3.3
03.60 D 3.9;G 4.8
03.80 A !"VENDRE?"!Q;I (Q)7.2,3.9;S Q=-Q;I (A+Q)3.5
03.90 S A=A+Q;S S=S-Y*Q;S C=0

04.10 T !"AVEC COMBIEN DE BOISSEAUX NOURIRAS TU"
04.11 A " TES SUJETS?"!Q;I (Q)7.2;I (Q-S)4.2,4.7;D 4.6;G 4.1
04.20 S S=S-Q;S C=1
04.30 A !"COMBIEN D'ACRES DE TERRE PENSES TU PLANTER?"!D
04.40 I (D)7.2;I (A-D)4.45;I (FITR(D/2)-S-1)4.65;D 4.6;G 4.3
04.45 D 4.5;G 4.3
04.50 D 7;T A," ACRES."!
04.60 D 7;T S," BOISSEAUX EN RESERVE."!
04.65 I (D-10*P-1)5.1;D 7;T P," SUJETS."!;G 4.3
04.70 S S=S-Q;S C=1
04.80 D 6;T "TU AS VIDE LES SILOTS !"!;S D=0

05.10 S S=S-FITR(D/2);D 8;S Y=C;S H=D*Y
05.20 D 8;S E=0;I (FITR(C/2)-C/2)5.3;S E=S/C
05.30 S S=S-E+H;D 8;S I=FITR(C*(20*A+S)/P/100+1);S C=FITR(Q/20)
05.40 S Q=FITR(16*FRAN()-12);I (P-C)2.1;S D=P-C;S P=C;G 2.2

06.10 T !!"HAMMOURABI:"!!"O  ROI DE LARSA"!!

07.10 I (C)7.2;S C=C-1;D 6;D 7.11;R
07.11 T "CRAINS LA COLERE DU DIEU DAGGAN"!;D 7.12;R
07.12 T "TU AS SEULEMENT";R
07.20 D 6;T "VIL FEAL"!"TU ES CONDAMNE A LA VINDICTE DU DIEU DAGGAN"
07.40 T !" GARDES,  QUE L'ON PREPARE LES ETRIVIERES"!!!
07.50 T "MON CROC A PHYNANCES "!!!"ET LE BUCHER !"!;QUIT

08.10 S C=FITR(10*FRAN())-4
*