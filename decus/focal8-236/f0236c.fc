@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
C-FOCAL,1969

01.04 A N,M;S P=3.14159;A X,D;F I=1,N;A Y(I)
01.16 S M=M+1;F I=1,M;S A(M+1-I)=FCOS(P*(I-.5)/M)
01.24 S V(1)=-1;F I=1,N-1;S V(I+1)=V(I)+2/(N-1)
01.28 S I=1;F L=1,N;D 3
01.30 F I=1,M;D 4;S C(I)=2*S/M
01.48 S C(1)=C(1)/2;S W(1)=C(1);S W(2)=C(2);I (M-3)1.64
01.56 F K=1,M;S V(K)=0;S A(K)=0
01.60 S V(2)=1;F K=3,M;S W(K)=0;D 6
01.64 S A(1)=W(1);F K=2,M;S A(K)=0
01.68 F K=2,M;D 8
01.72 F K=1,M;T !,%2,K-1,%17.15,A(K)
01.76 S S=0;F J=1,N;D 10
01.80 T !,FSQT(S/(N-1)),!;G 1.16

03.04 I (V(L)-A(I))3.4
03.08 S U=(A(I)-V(L-1))/(V(L)-V(L-1));I (L-2)3.1,3.1;I (L-N)3.2
03.10 S W(I)=U*Y(L)+Y(L-1)*(1-U);G 3.3
03.20 S W(I)=-U*(U-2)*((U-1)*Y(L-2)/3+(U+1)*Y(L))/2
03.28 S W(I)=W(I)+(U*U-1)*((U-2)*Y(L-1)+U*Y(L+1)/3)/2
03.30 S I=I+1;I (I-M-1)3.04;S L=N+1
03.40 R

04.04 S S=0;I (2-I)4.24,4.16;F J=1,M;S S=S+W(J)
04.12 R
04.16 F J=1,M;S S=S+A(J)*W(J)
04.20 R
04.24 S V(1)=1;F J=1,M;S V(2)=A(J);D 5;S S=S+W(J)*V(I)

05.04 F K=3,I;S V(K)=2*A(J)*V(K-1)-V(K-2)

06.04 S A(1)=FCOS(P*(K-1)/2);F J=2,K;S A(J)=2*V(J-1)-A(J)
06.12 F J=1,K;S W(J)=W(J)+C(K)*A(J);S U=V(J);S V(J)=A(J);S A(J)=U

08.04 S L=K-1;S C(1)=X+(N-1)*D/2;S C(2)=(N-1)*D/2;S S=1; S U=1
08.08 S A(K)=A(K)+W(K)/C(2)^L;F J=1,L;S S=S*J;S U=U*(K-J);D 9

09.08 S A(K-J)=A(K-J)+U*C(1)^J*(-1)^J*W(K)/S/C(2)^L

10.04 S K=A(1);S U=X+(J-1)*D;F I=2,M;S K=K+A(I)*U^(I-1)
10.08 T %8.05,!,U,Y(J),K,Y(J)-K;S S=S+(Y(J)-K)^2
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@Xx