@@@@@@@@@@@@@@@
C-FOCAL,1969

01.06 A N,M;F I=1,N;A X(I),Y(I)
01.14 S L=0;S K=0;F I=0,M*M+M-1;S A(I)=0
01.30 F I=L,M-1+L;F J=1,N;S A(K+I)=A(K+I)+X(J)^(I+2)
01.34 S L=L+1;S K=K+M-1;I (L-M)1.3
01.46 F I=1,M;F J=1,N;S A(M^2+I-1)=A(M^2+I-1)+Y(J)*X(J)^I
01.58 S L=M-1;S I=-1;F K=0,L;S R(K)=K+1
01.60 S B=1E-6;F J=0,L;F K=0,L;D 6
01.76 S R(P)=0;F K=0,M;S A(P+M*K)=A(P+M*K)/B
01.80 F J=0,L;D 5
01.84 S I=I+1;I (I-L)1.6,1.9,1.6
01.90 F J=0,L;F K=0,L;D 7
01.94 S P=0;F J=1,N;S D=0;D 9
01.97 T FSQT(P/(N-1)),!;S M=M+1;G 1.14

05.10 I (J-P)5.3,5.4
05.30 S D=A(J+M*Q);F K=0,M;S A(J+M*K)=A(J+M*K)-A(P+M*K)*D
05.40 R

06.10 I (R(J))0,6.3;I (FABS(A(J+M*K))-FABS(B))6.3
06.20 S B=A(J+M*K);S P=J;S Q=K
06.30 R

07.10 I (1E-6-FABS(A(J+M*K)))7.2;R
07.20 S R(K)=A(J+M*M);T %2,K+1,%16.16,R(K),!

09.02 F I=1,M;S D=D+R(I-1)*X(J)^I
09.04 T %6.03,X(J),Y(J),D,Y(J)-D,!;S P=P+(Y(J)-D)^2
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@Xx