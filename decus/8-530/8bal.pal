	CIA CLL
	TAD AC
	SZL
	DCA AC
	CLA
	TAD MQ
	RAL
	DCA MQ
	TAD AC
	RAL
	DCA AC
	ISZ EAESC
	JMP DVI1
	TAD AC
	RAR		/CORRECTION FOR REMAINDER
DVI2,	ISZ DVI
	JMP I DVI


