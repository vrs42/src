/	PS/8 INPUT ROUTINE
/
/***************************************************
/	USER EQUATES
/***************************************************
/
	INTPAG=0	/1 IF 2-PAGEHANDLER IS ALLOWED
	BUFIN=6200	/STARTADDRESS OF INPUTBUFFER
	BLOKIN=1	/NUMBER OF INPUT BLOCKS
	HANDIN=7000	/STARTADDRESS OF DEVICE HANDLER
	PSEXT=0123	/EXTENSION BY DEFAULT
			/ .AS=0123
			/ .PA=2001
			/ .LS=1423
			/ .DA=0401
/
/********************************************************
/	PROGRAM EQUATES
/******************************************************
/
	PSFLD=10	/FIELD OF PROGRAM IS 1
	BUFIFD=10	/FIELD OF INPUTBUFFER
/
/****************************************************
/
	FIELD 1
*7400			/USER DEFINED STARTINGADDRESS
/
/
/**************************************************
/	MAIN FRAME OF PS8-INPUT ROUTINE
/**************************************************
/
PS8IN,	0		/ENTRYPOINT
PSIMON,	7600		/CLEAR AC
	RDF		/GET FIELD OF USER PROGRAM
	TAD PSICIF	/SET UP FOR EXIT
	DCA PSIEXT+1
/
PSINST,	JMP PSIJOB	/INITIALIZE, ONCE ONLY CODE
			/ AFTER INIT. CDF PSFLD
			/ IS STORED HERE
/
/***************************************************
/	 GETCH, WRITTEN AS A SUBROUTINE,
/	    NOW PART OF MAIN FRAME
/***************************************************
/       ROUTINE TO GET A CHARACTER FROM A STRING
/            PACKED IN A BUFFER
/       POINTERS ARE:
/           INPTR: ADDRESSPOINTER
/           INPKSW=0 : 8 LEAST SIGN. BITS OF [POINTER]
/                 =-2: 4 MOST SIGN.BITS OF [POINTER-1]
/                         AND [POINTER]
/
/       UPON EXIT FROM GETCH, INPTR AND INPKSW
/               POINT TO NEXT CHARACTER
/
/	WHEN BUFFER END IS DETECTED, A BUFFER
/	   READ IS PERFORMED
/	GETCH TESTS  THE NUMBER OF BLOCKS TO BE READ
/	WHEN NO MORE BLOCKS ARE AVAILABLE
/	A JUMP IS PERFORMED TO INITIALIZE NEXT FILE
/*****************************************************
/
        TAD INPKSW      /TEST PACKSWITCH
        SZA CLA
        JMP INPKON      /JUMP IF -2
/
        TAD I INPTR     /GET INFO.WORD
        AND PSI377      /KILL BIT 0-3
        DCA INCHAR      /SAVE TEMP
/
        TAD INPTR       /IS POINTER EVEN?
        CLL RAR
        SNL CLA         /SKIP IF NO
        JMP .+4         /YES, JUMP
/
        CLL CLA CMA RAL /SET PACKSWITCH TO -2
        DCA INPKSW
/
        SKP             /NO INCREMENT
        ISZ INPTR       /INCREMENT POINTER
        JMP GETEX       /EXIT
/
INPKON, DCA INCHAR      /MAKE TEMP.LOC ZERO
        TAD I INPTR     /GET WORD
PSI377,	AND PS7400	/KILL BIT 4-11
	TAD INCHAR
        CLL RTR
        RTR
        DCA INCHAR      /SAVE TEMP
/
        CLA CMA
        TAD INPTR       /DECREMENT POINTER
        DCA INPTR
/
        ISZ INPKSW      /INCR.PACKSWITCH
        JMP INPKON+1    /AGAIN IF NONZERO
        CLA CLL CML IAC RAL
        TAD INPTR       /SET POINTER TO NEXT WORD
        DCA INPTR
/
	ISZ PTR2	/INCREMENT WORDPOINTER
	JMP GETEX	/NOT ZERO, EXIT
	TAD PSIMON	/RESTORE POINTER
	DCA PTR2
/
	ISZ PSINUM	/INCR.NEG.BLOCKCOUNT
	SKP		/NOT ZERO, MORE BLOCKS AVAILABLE
	JMP PSCTRZ	/INITIALIZE NEXT FILE
/
        TAD INLIM       /TEST ON BUFFER END
        TAD INPTR
        SMA CLA         /SKIP IF BUFFER END
	JMS PSREAD	/READ NEXT PART OF INPUT FILE
/
/
/****************************************************
/	LAST PART OF MAINFRAME
/****************************************************
/	TEST ON CONTROL/Z
/
GETEX,	TAD INCHAR
	TAD PSI232	/WAS IT CTRL/Z?
	SNA CLA		/SKIP IF NO
	JMP PSCTRZ	/YES, GET NEW DEVICE OR FILE
PSIEXT,	TAD INCHAR	/CHAR IN AC
	0		/RESTORE FIELD
	JMP I PS8IN	/RETURN
/
PSIEND,	TAD PS232	/END OF ALL FILES,GET CTRL/Z
	JMP PSIEXT+1	/ AND RETURN
/
PSICIF,	CIF CDF 0
/
/************************************************
/	INITIALIZATION PART
/************************************************
/	ONCE ONLY CODING
/	    SOME LOCATIONS ARE OVERWRITTEN
/	    BY POINTERS AND SAVE LOCATIONS.
/************************************************
/
PSIJOB,	CDF 0
	TAD I PS7746	/GET JOB STATUS WORD
	AND PSREAD	/MASK OUT BIT 2
	TAD PSIRD	/SET BIT 2: NOT RESTARTABLE
PTR2,	DCA I PS7746	/AND SAVE
/
INPTR,	CDF PSFLD	/SET TO PROGRAM FIELD
INPKSW,	TAD .-1		/GET PREVIOUS INSTRUCTION
PSINUM,	DCA PSINST	/AND STORE IN MAINPART
/
PSCD,	JMS I PSIUSR	/CALL COMMAND DECODER
	5		/FUNCTION CODE
	PSEXT		/EXTENSION BY DEFAULT
INCHAR,	0
/
/
/**********************************************
/	ROUTINE TO LOAD DEVICE HANDLER
/**********************************************
/
PSCTRZ,	ISZ PSINDV	/SET TO NEXT INPUT FILE
	TAD HANDAD	/SET UP STARTING ADDR.
	DCA PSIHND	/  OF DEVICE HANDLER
	TAD I PSINDV	/GET DEVICE NUMBER
	SNA		/ZERO?
	JMP PSIEND	/YES, INPUT END
/
	JMS I PSIUSR	/LOAD DEVICE HANDLER
	1		/FUNCTION CODE
PSIHND,	0		/ENTRYPOINT
	JMP INER1	/ERROR RETURN
/
	TAD I PSINDV	/GET NEGATIVE BLOCKCOUNT
	AND PSIRD+2	/KILL BIT 8-11
	SNA		/SKIP IF FILEORIENTED
	CLA IAC RTL	/NO FILE,CREATE A VERY LONG ONE
	RTR CLL
	RTR		/SHIFT 4 POS. TO RIGHT
	SMA		/SKIP IF NOT FILE-ORIENTED
	TAD PS7400	/INSERT BIT 0-3
	DCA PSINUM	/SAVE NUMBER OF BLOCKS
/
	ISZ PSINDV	/SET POINTER TO START.BLOCKNR.
	TAD I PSINDV	/GET START.BLOCKNUMBER
	DCA PSIRD	/STORE AT READ ROUTINE
	JMS PSREAD	/READ NEXT PART IN BUFFER
	JMP PSINST+1	/RETURN TO MAINFRAME
/
HANDAD,	HANDIN+INTPAG
/
/************************************************
/	ERROR PART
/************************************************
/
INER2,	CLA IAC		/READ ERROR
INER1,	TAD PSCD+1	/DEVICE HANDLER ERROR
	DCA PSCD+2
	ISZ PSCD+1
	ISZ PSCD+1
	JMP PSCD	/GIVE ERROR MESSAGE
/
/
/***********************************************
/	ROUTINE TO READ FROM DEVICE
/************************************************
/
	BLOKIN
PSREAD,	6777
	CIF 0		/DEV.HANDLER IN FIELD 0!
	JMS I PSIHND	/CALL DEVICE HANDLER
	BLOKIN^200+BUFIFD
PSIBUF,	BUFIN		/BUFFER ADDRESS
PSIRD,	1000		/STARTING BLOCKADDRESS
PSIUSR,	SMA CLA		/ERROR RETURN, SKIP IF FATAL
	7760		/SKIP IF AC 0 AND CONSTANT
	JMP INER2	/FATAL ERROR, DO NOT RETURN
/
	TAD PSREAD-1	/UPDATE STARTING BLOCKNUMBER
	TAD PSIRD
	DCA PSIRD
/
	TAD PSIBUF	/RESET INPUT POINTER
	DCA INPTR
	DCA INPKSW	/RESET PACKSWITCH
	TAD PSIMON	/RESET BLOCKPOINTER
	DCA PTR2
/
	JMP I PSREAD	/RETURN
/
/
/***********************************************
/	CONSTANTS AND VARIABLES
/************************************************
/
PS232,	232
PSI232,	-232
PS7746,	7746
PSINDV,	7616
/
INLIM,	-BLOKINN^400-BUFIN
/
*PS8IN+177
PS7400,	7400	/DON'T MOVE THIS CONSTANT!!
