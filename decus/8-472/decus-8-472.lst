 275               /**************************************************
 276               /       MAIN-FRAME OF PS8OUT ROUTINE
 277               /**************************************************
 278               /
 279 017200  0000  PS8OUT, 0               /ENTRYPOINT
 280 017201  3371          DCA CHAR        /SAVE CHAR.
 281 017202  6214          RDF             /GET FIELD OF USER PROGRAM
 282 017203  1223          TAD PSOCIF      /SET UP FOR EXIT
 283 017204  3225          DCA PSORET
 284 017205  6211          CDF PFIELD
 285 017206  5312  PSINIT, JMP PSOBEG      /INITIALIZE,ONCE ONLY CODING;
 286                                       /AFTER INIT., JMS PACKB 
 287                                       /IS STORED HERE
 288 017207  4342          JMS PSWRIT      /BUFFER FULL, WRITE BUFFER
 289 017210  1371          TAD CHAR
 290 017211  1376          TAD PSM232      /WAS IT CTRL/Z?
 291 017212  7640          SZA CLA
 292 017213  5225          JMP PSORET      /NO, EXIT
 293 017214  3371          DCA CHAR        /SET CHAR TO ZERO
 294 017215  4230  PSPACK, JMS PACKB       /ZERO REST OF BUFFER
 295 017216  7410          SKP             /BUFFER END
 296 017217  5215          JMP .-2         /AGAIN
 297 017220  4342          JMS PSWRIT      /WRITE BUFFER TO OUTPUTDEVICE
 298 017221  7307          CLA CLL IAC RTL /+4 IN AC
 299 017222  4275          JMS PSOUSR      /CLOSE FILE
 300 017223  6203  PSOCIF, CIF CDF 0       /YES, GO TO MONITOR
 301 017224  5666          JMP I PS7600    /  IN FIELD 0
 302 017225  0000  PSORET, 0               /RESTORE DATA AND INSTR.FIELD
 303 017226  5600          JMP I PS8OUT
 304               /
 305               /*************************************************
 306               /       SUBROUTINE PACKB
 307               /*************************************************
 308               /       ROUTINE PACKS A STRING IN A BUFFER
 309               /       POINTERS ARE OUPTR AND OUPKSW
 310               /               OUPTR POINTS TO ADDRESS
 311               /               OUPKSW=0:  LAST 8 BITS
 312               /               OUPKSW=-2: FIRST 4 BITS OF 2 WORDS
 313               /       AFTER STORING IN BUFFER OUPTR AND OUPKSW
 314               /               POINT TO NEXT BUFFERADDRESS
 315               /       NORMAL EXIT AT JMS +2
 316               /       BUFFER END EXIT AT JMS +1
 317               /*************************************************
 318 017227  7400          7400
 319 017230  0000  PACKB,  0
 320 017231  1372          TAD OUPKSW      /TEST PACKSWITCH
 321 017232  7440          SZA
 322 017233  5247          JMP PACKON      /JUMP IF -2
 323 017234  1371          TAD CHAR        /GET CHARACTER
 324 017235  3773          DCA I OUPTR     /INSERT IN BUFFER
 325 017236  1373          TAD OUPTR
 326 017237  7110          CLL RAR         /IS POINTER ODD?
 327 017240  7620          SNL CLA         /SKIP IF YES
 328 017241  5245          JMP .+4
 329 017242  7344          CLL CLA CMA RAL /SET PACKSWITCH TO -2
 330 017243  3372          DCA OUPKSW
 331 017244  7410          SKP             /NO INCREMENT
 332 017245  2373          ISZ OUPTR       /INCREMENT POINTER IF EVEN
 333 017246  5272          JMP PACKEX      /GO TO EXIT
 334 017247  7240  PACKON, CLA CMA
 335 017250  1373          TAD OUPTR       /DECREMENT POINTER
 336 017251  3373          DCA OUPTR
 337 017252  1371          TAD CHAR                /GET CHARACTER
 338 017253  7006          RTL
 339 017254  7006          RTL             /SHIFT 4 POS. TO LEFT
 340 017255  3317          DCA PSOBL-1     /SAVE TEMP
 341 017256  1317          TAD PSOBL-1
 342 017257  0227          AND PACKB-1     /KILL BITS 4-11
 343 017260  1773          TAD I OUPTR
 344 017261  3773          DCA I OUPTR     /INSERT IN BUFFER
 345 017262  2373          ISZ OUPTR       /INCREMENT ADDRESSPOINTER
 346 017263  1317          TAD PSOBL-1
 347 017264  2372          ISZ OUPKSW      /INCREMENT PACKSWITCH
 348 017265  5253          JMP PACKON+4    /AGAIN IF PACKSWITCH NONZERO
 349 017266  7600  PS7600, 7600            /CLEAR AC
 350 017267  1374          TAD LIMIT       /TEST ON BUFFER END
 351 017270  1373          TAD OUPTR
 352 017271  7710          SPA CLA         /SKIP IF BUFFER END
 353 017272  2230  PACKEX, ISZ PACKB       /SET UP FOR NORMAL RETURN
 354 017273  5630          JMP I PACKB     /RETURN
