 236               /       CONSTANTS AND VARIABLES
 237               /************************************************
 238               /
 239 017567  0232  PS232,  232
 240 017570  7546  PSI232, -232
 241 017571  7746  PS7746, 7746
 242 017572  7616  PSINDV, 7616
 243               /
 244 017573  1200  INLIM,  -BLOKINN^400-BUFIN
