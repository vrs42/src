
C-FOCAL,1969

01.05 T !! "ROOTS OF POLYNOMIAL - PART III - COMPLEX ROOTS
01.30 A ! "ORDER OF POLYNOMIAL  ",N
01.40 T !! "TYPE POLYNOMIAL COEFFS",!
01.45 F I=1,N+1;A AM(I)
01.55 T !! "POLYNOMIAL COEFFS",!
01.60 F I=1,N+1;T %,AM(I),!

02.10 S B(1)=1;S B(2)=0;S B(3)=0;S M=2
02.20 F I=1,N+1;S G(I)=AM(I)
02.30 D 12
02.35 F I=1,N-1;S QM(I)=Q(I)
02.37 F I=1,2;S RM(I)=R(I)
02.40 I (RM(1)) 2.45,2.95,2.45
02.45 S QM(N)=RM(1);S QM(N+1)=RM(2)
02.50 F I=1,N+1;S G(I)=QM(I)
02.55 D 12
02.57 F I=1,N-1;S C(I)=Q(I)
02.58 F I=1,2;S T(I)=R(I)
02.60 S D=C(N-1)*(C(N-1)-B(2)*C(N-2))
02.65 S D=D-C(N-2)*(T(1)-RM(1)-B(2)*C(N-1))
02.70 IF (D) 2.75,2.72,2.75
02.72 S B(2)=B(2)+.1;S B(3)=B(3)+.1;G 2.85
02.75 S D2=(RM(1)*(C(N-1)+B(2)*C(N-2))-RM(2)*C(N-2))/D
02.77 S D3=(C(N-1)*RM(2)-RM(1)*(T(1)-RM(1)+B(2)*C(N-1)))/D
02.80 S B(2)=B(2)+D2;S B(3)=B(3)+D3
02.81 S X=FABS(D2)+FABS(D3);S Y=FABS(B(2))+FABS(B(3))
02.82 I (X/Y-.0001)2.95,2.95,2.2
02.95 S P=B(2);S U=B(3)

03.10 S RP=-P/2;S IM=FSQT(U-P^2/4)
03.25 T !! "ROOTS ARE - REAL PART  ",RP
03.26 T ! "IMAGINARY PART  ",IM
03.28 I (2-N)3.3;Q
03.30 F I=1,N+1; S G(I)=AM(I)
03.40 D 12
03.50 S N=N-2;I (N-2)3.8,3.8,3.55
03.55 F I=1,N+1;S AM(I)=Q(I)
03.57 G 2.1
03.80 S P=Q(2);S U=Q(3);G 3.1

12.30 S LL=N-M+1
12.40 F I=1,LL;D 13
12.50 F I=1,M;S R(I)=G(N-M+I+1)
12.60 S L=M-1
12.70 IF (R(1)) 12.9,12.75,12.9
12.75 IF (L) 12.9,12.9,12.77
12.77 F I=1,L;S R(I)=R(I+1)
12.80 S L=L-1;G 12.7
12.90 R

13.10 S Q(I)=G(I)/B(1)
13.20 F J=1,M;D 14
13.30 R

14.10 S W=Q(I)*B(J+1)
14.20 S G(I+J)=G(I+J)-W
14.30 IF (FABS(G(I+J))-.0001*FABS(W)) 14.4,14.4,14.5
14.40 S G(I+J)=0
14.50 R
*