
C-FOCAL, U04

01.05 T !%5"XPON"!;E
01.10 A "BASE"B,"EXPONENT"E,!;S K=1E5;S X(1)=1;S N=1
01.30 F I=1,E;S C=;D 2
01.35 T !" THE ANSWER=";S K=2
01.40 F I=-N,-1;D 3
01.50 T !!!;Q

02.10 F L=1,N;S X(L)=X(L)*B;D 2.2
02.20 S X(L)=X(L)+C;S C=FITR(X(L)/K);S X(L)=X(L)-C*K
02.30 I (C),2.5;S L=L+1;G 2.2
02.50 S N=L;R

03.10 I (X(-I))3.8,3.8
03.20 D 4;S :=-1;R
03.80 I (:)3.2

04.01 T " "
04.10 F J=-4,;D 5

05.10 S Q=FITR(X(-I)/10^(-J));S X(-I)=X(-I)-10^(-J)*Q
05.20 I (Q-1)6.1,6.2;I (Q-3)6.3,6.4;I (Q-5)6.5,6.6;I (Q-7)6.7,6.8
05.30 I (Q-9)6.9;T "9";R

06.10 T "0
06.20 T "1
06.30 T "2
06.40 T "3
06.50 T "4
06.60 T "5
06.70 T "6
06.80 T "7
06.90 T "8
8~