@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@E A
*W
C-FOCAL , 8/68

01.10 T "CURVE FITTING BY LEAST SQUARE REGRESSION",!!
01.20 T "N=NUMBER OF DATUM POINTS",!
01.30 T "X=ABSCISSA,  Y=0RDINATE",!

03.10 S SX=0;S SY=0;S SM=0;S SE=0;S A1=0;S A0=0
03.20 A ?N?,!;F K=1,N;A ?X,Y?,!;D 6

04.10 S A1=[N*SM-SX*SY]/[N*SE-SX^2]
04.20 S A0=[SY-A1*SX]/N

05.10 T "A1",A1,"    A0",A0,!!!,"          Y",A1,"*X+",A0,!;Q

06.10 S SX=SX+X
06.20 S SY=SY+Y
06.30 S SM=SM+X*Y
06.40 S SE=SE+X^2
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@