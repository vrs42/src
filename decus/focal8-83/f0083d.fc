@@@@@@@@@@@@@@@@@@@@@@@E A
C-FOCAL , 8/68

01.02 T "REAL GAS VOLUME VS TEMPERATURE"!
01.05 T "TEMP REDUCED STARTING AT DATA AVERG. TEMP"!
01.08 T "GIVE    NO. OF SETS OF 'T' AND 'V' DATA"!
01.11 T "        EACH DATUM TEMP C."!
01.14 T "        EACH DATUM VOLUME IN ARBITRARY UNITS"!
01.17 T "        TEMP INCR FOR PLOT AND TABLE"!
01.18 T "'GO' AGAIN"!!;E 1

02.01 T "'CHARLES LAW' PLOT OF EXP. DATA TO DETERM ABS. ZERO"!
02.02 S SX=0;S SY=0;S SZ=0;S SM=0
02.05 A "NUMBER OF DATUM POINTS",N,"PLOT INCR",IT,!
02.08 F K=1,N;A "T",X,"V",Y,!;D 3.02
02.11 G 3.05

03.02 S SX=SX+X;S SY=SY+Y;S SZ=SZ+(X*Y);S SM=SM+X^2
03.05 S M=[N*SZ-SX*SY]/[N*SM-SX^2];S B=[SY-M*SX]/N
03.20 T "M",M,"    B",B,!" EXP. PLOT IS:   V",M,"*T+",B,!!!

04.02 S T=SX/N;S QV=SY/N;S MP=70/(T+<B/M>)
04.05 T "";C BELL LINE
04.08 T !"T"!"E"!"M"!"P"!!"A"!"X"!"I"!"S"!;DO 6.9;S V=68
04.11 F Z=0,[T+<B/M>]/IT;D 6
04.19 T "SINCE NEG VOLUMES HAVE NO PHYSICAL MEANING, "!;G 4.2
04.20 T "NEITHER WOULD TEMPERATURES RELATED TO THEM"!;G 4.21
04.21 T "AND OUR ZERO VOLUME INTERCEPT MUST BE "!,% 4.01;G 4.22
04.22 T "WITHIN THE PLOT INCR OF AN ABSOLUTE ZERO ";G 4.23
04.23 T "TEMPERATURE"!"WHICH I CALCULATE TO BE:  ", -B/M;D 7;Q

06.08 T ":",%5.02 T," C.  V ",QV,#
06.11 F K=0,V;T " "
06.14 T "(X)"!;S V=V-[IT*MP];S QV=QV-[IT*M]
06.17 S T=T-IT;R
06.90 T ":    I WILL PLOT FIRST VOLUME AT FULL SCALE"!

07.10 T " WITH ",([FABS(<B/M>-273.16)]/273.16)*100, "% DEVIATION"!;R
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@o