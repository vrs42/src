@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@E A
C-FOCAL , 8/68

01.01 T "IDEAL GAS IN QUADRANT ONE",!
01.02 T "PLOT OF PRESSURE VS VOLUME",!
01.03 T "GIVE POSITIVE VALUES FOR:",!
01.04 T "  LOWEST PRESSURE"!"  INCREMENT"!"  HI PRESSURE"!
01.05 T "  		K  IN PV=K",!,"  		SLOPE OF RECIPROCAL PLOT",!
01.06 C ARBITRARY VALUES AND UNITS USED FOR PARAMETERS
01.10 C ERASE 1 LEAVES ESSENTIALS OF PROGRAM

02.02 A ?LPRESS,IPRESS,UPRESS,K,SLOPE?,!
02.04 I (LP)1.03,6.01,2.06
02.06 DO 8;F P=2,IP,LP;T ":"!

06.01 F P=LP,IP,UP;DO 7

07.01 I (P)7.02,7.15,7.02
07.02 T ":",#
07.05 F V=0,(K/P);T " "
07.08 T "*",#
07.11 F V=0,(P/K)*SLOPE;T " "
07.14 T "O",!;R
07.15 DO 8;R

08.01 T "   ",#
08.02 T !"P"!"R"!"E"!"S"!"S"!"U"!"R"!"E"!!"A"!"X"!"I"!"S"!!
08.03 T "===VOLUME AXIS========DATUM OUT THERE SOMEWHERE====(*)"!;R
