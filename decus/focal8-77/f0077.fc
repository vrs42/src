
01.10 A "NO. OF STUDENTS"NS,!"NO. OF GRADES PER STUDENT"GS,!
01.20 T "SCALE OF GRADES"!;F I=1,GS;A S(I)
01.30 F I=1,GS;S D=D+S(I)
01.40 T !!!;F I=1,NS;D 2
01.50 S CA=CA/NS;T !!!"NUMBER        RANK          AVERAGE        "
01.60 T "+OR- CLASS AVG."!!;F I=1,NS;T %2,I,"          ";S R=1;D 1.99
01.70 T !!!"CLASS AVERAGE ",CA;S L=95;T !!!"PERCENTAGE DISTRIBUTION OF 
01.80 T "MARKS"!!;S ZZ=100;F I=1,7;D 7
01.90 F I=1,NS;D 6
01.95 T "FLUNK                 "100*(TT/NS),"%",!!!!!;Q
01.99 D 3;T %6.03,"          "AV(I),"      "AV(I)-CA,!

02.10 T %2,!"STUDENT NO. "I," "
02.20 F O=1,GS;A G;S AV(I)=AV(I)+G*S(O)
02.30 S AV(I)=AV(I)/D;S CA=CA+AV(I)

03.10 F O=1,NS;D 4
03.20 T R

04.10 I (AV(O)-AV(I))4.2,4.2;S R=R+1
04.20 R

05.10 I (AV(O)-L)5.2;S CT=CT+1;S AV(O)=0
05.20 R

06.10 I (AV(I))6.2,6.2;S TT=TT+1
06.20 R

07.10 S L=L-5;T %3,ZZ," TO "L,"        ";F O=1,NS;D 5
07.20 T FITR(100*(CT/NS)),"%",!;S ZZ=L;S CT=0
