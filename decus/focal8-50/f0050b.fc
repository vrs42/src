@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
C     RC ACTIVE FILTER PROGRAM BY KINCAID AND SHIRLEY
C     MODIFIED FOR FOCAL BY TOM BEAN & WILLIAM ROMANS
C         T: TYPE OF FILTER (ENTER L FOR LOWPASS;H FOR HIGHPASS)
C         N: NUMBER OF POLES (MUST BE EVEN NUMBER)
C         H: CUTOFF FREQUENCY IN KHZ
C         R: ALLOWABLE RIPPLE IN PASSBAND(0 FOR BUTTERWORTH DESIGN)
C         C: MAXIMUM CAPACITANCE VALUE IN NANOFARADS
C     R1,R2 GIVEN IN KOHMS

C-FOCAL,1969

01.02 A !? T N H R C1 ? ,!!;S PI=3.14159;S C(6)=1;S C(0)=10
01.04 S C(1)=6.8;S C(2)=4.7;S C(3)=3.3;S C(4)=2.2;S C(5)=1.5
01.06 F I=1,N/2;D 3

03.08 I (-R)3.16;S X1=1;S X2=1;G 3.28
03.16 S E=FSQT(FEXP(R*2.30259/10)-1)
03.18 S D=FEXP(FLOG(1/E+FSQT(1/E^2+1))/N)
03.20 S X1=(D-1/D)/2;S X2=(D+1/D)/2
03.28 S S=X1*FCOS(PI/2+PI*(2*I-1)/2*N)
03.30 S W=X2*FSIN(PI/2+PI*(2*I-1)/2*N)
03.32 S A=S^2+W^2
03.34 S X3=2*PI*H*C1
03.36 I (1-12/T)7.04;F N1=-1,9;D 4

04.04 S P=FITR(FLOG(C1)/2.30259)-N1;F K=1,6;D 5

05.02 I (-P)5.08
05.04 S C2=C(K)/10^(-P);S C3=C(K-1)/10^(-P);G 5.12
05.08 S C2=C(K)*10^P;S C3=C(K-1)*10^P
05.12 S M=C1/C2;I (M-A/S^2)5.16;D 6
05.16 R

06.04 S R1=(-S*10^3/(X3))*(M/A)*(1+FSQT(1-A/(S^2*M)))
06.06 S R2=(-S*10^3/(X3))*(M/A)*(1-FSQT(1-A/(S^2*M)))
06.08 I (A/S^2-C1/C3)6.10;D 8
06.10 R

07.04 S C2=C1;S R1=-S*10^3/(X3);S R2=(-S*10^3/(X3))*A/S^2;D 8
07.06 S R2=(-S*10^3/(X3))*A/S^2;D 8

08.08 T "SEC.";T %2,I,!
08.10 T   "C1,C2,R1,R2";T %8.05,C1,C2,R1,R2,!!
08.14 I (N/2-I)9.01,9.01,8.16
08.16 R

09.01 Q
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@