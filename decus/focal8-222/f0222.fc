_
C-FOCAL,  5/69

01.10 C CENTER OF GRAVITY CALCULATIONS         AUTHOR: JOEL D. SCHERAGA
01.40 T !"      CENTER OF GRAVITY CALCULATIONS"!!!,"REQUIRED DATA:"!!
01.50 T %4;A "NUMBER OF INDIVIDUAL ROCKET COMPONENTS"A
01.60 F B=1,A;T !"WEIGHT OF COMPONENT "B;A W(B)
01.61 A !"ENGINE WEIGHT"E ;A !"PROPELLANT WEIGHT"P
01.70 F B=1,A;D 4
01.72 A !"DISTANCE OF THE CG OF THE ENGINE FROM THE REFERENCE LINE"G
01.73 T !"DISTANCE OF THE CG OF THE ENGINE FROM THE REFERENCE LINE"!
01.74 A "AT BURNOUT"N
01.80 T !"NO FURTHER DATA IS REQUIRED."!!!!!;S T=0

02.20 F B=1,A;S T=T+W(B);S Z=0
02.30 S Z=T+E;F B=1,A;S M(B)=W(B)*D(B)
02.50 S H=E*G;S I=0;F B=1,A;S I=I+M(B)
02.51 S X=I+H;S C=X/Z;S S=I/T;S Y=Z-P;S U=I+((E-P)*N);S V=U/Y

03.10 T %8.4,"TOTAL WEIGHT OF THE ROCKET, MINUS THE ENGINE "T
03.20 T !!"CG OF THE ROCKET, MINUS THE ENGINE "S
03.30 T !!"TOTAL WEIGHT OF THE ROCKET, INCLUDING THE ENGINE "Z
03.40 T !!"CG LOCATION OF THE ROCKET, INCLUDING THE ENGINE "C
03.50 T !!"WEIGHT OF THE ROCKET AT BURNOUT "Y
03.60 T !!"CG LOCATION OF THE ROCKET AT BURNOUT "V,!;Q

04.10 T !"DISTANCE THE CG OF COMPONENT "B," IS FROM THE REFERENCE LINE"
04.20 A D(B)
_x