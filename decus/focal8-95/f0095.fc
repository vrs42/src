
C-FOCAL,1969

01.05 T "JJW & LAO"!!!
01.10 T "HELLO, I AM A SLOT MACHINE. TO PLAY GIVE THE OPERATOR"!
01.20 T "ONE SILVER DOLLAR AND DEPRESS THE RETURN KEY."!!!
01.30 S V=15
01.40 T " JACKPOTS ARE- LEMONS-$20--PEARS-$2--"!
01.50 T "BARS-$10--CHERRIES-$15--BELLS-$5"!!!!
01.55 T "YOUR BANK ACCOUNT IS LIMITED TO $15"!
01.60 T "HAPPY POVERTY"!!!!

02.10 A M;S R=0
02.20 S R=R+1
02.30 I (R-2)2.5,2.6,2.4
02.40 I (R-3)2.3,2.7,2.1
02.50 D 5;G 4.2
02.60 D 8;G 4.3
02.70 D 9;G 4.4

03.10 I (C-4)3.2,3.6,3.7
03.20 I (C-2)3.3,3.4,3.5
03.30 T "CHERRY--";G 3.8
03.40 T "BELL--";G 3.8
03.50 T "PEAR--";G 3.8
03.60 T "BAR--";G 3.8
03.70 T "LEMON--";G 3.8
03.80 I (R-3)2.2,4.5,2.2

04.20 S D=C;G 3.1
04.30 S E=C;G 3.1
04.40 S Z=C;G 3.1
04.50 I (D-E)6.1,4.6,6.1
04.60 I (D-Z)6.1,6.3,6.1

05.10 S C=FITR(7*(FRAN()+FRAN()-1)+1);I (C-5)5.2,5.2,5.1
05.20 I (C-1)5.1;RETURN

06.10 S V=V-1
06.20 T %7,!"SORRY YOU LOSE,YOU STAND AT $  "V,!!;G 7.2
06.30 I (D-4)6.4,6.8,6.9
06.40 I (D-2)6.5,6.6,6.7
06.50 S A=15;S V=V+A;G 7.1
06.60 S A05;S V=V+A;G 7.1
06.70 S A=2;S V=V+A;G 7.1
06.80 S A=10;S V=V+A;G 7.1
06.90 S A=20;S V=V+A;G 7.1

07.10 T %7,!"JACKPOT! YOUR TOTAL WINNINGS ARE $  "V,!!;G 2.1
07.20 I (V)7.3,7.3,2.1
07.30 T "YOU HAVE EXHUSTED ALL YOUR FUNDS. MAYBE YOU COULD GET"!
07.40 T "A LOAN FROM THE BANK.GOOD LUCK!"!
07.50 T !!"TRY AGAIN?"!
07.60 A "(ANS. YES OR NO)"P;I (P-0NO)7.7,7.8
07.70 I (P-0YES)7.6,1.1,7.6
07.80 QUIT

08.10 S C=FITR(7*(FRAN()+FRAN()-1)+1);I (C-5)8.2,8.2,8.1
08.20 I (C-1)8.1;RETURN

09.10 S C=FITR(7*(FRAN()+FRAN()-1)+1);I (C-5)9.2,9.2,9.1
09.20 I (C-1)9.1;RETURN
*'