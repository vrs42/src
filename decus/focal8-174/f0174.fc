C SYNDIV 5  23 SEP 70 DAMOON ^R

C-FOCAL, U04

08.05 A "DIVIDEND'S DEGREE"N1,"DIVISOR'S"N2,!!"THE POLYNOMIAL"!
08.10 F I=-N1,;A D1(-I);S E=-I;D 11
08.15 T !,"DIVIDED BY THE POLYNOMIAL"!
08.20 F I=-N2,;A D2(-I);S E=-I;D 11
08.25 T !"EQUALS"!;S X=N2;F I=-N1,-N2;F J=-I;D 9;D 10
08.30 T !,"PLUS THE REMAINDER"!
08.35 S X=;F I=-N2+1,;S J=-I;D 9.1;D 10

09.10 F Q(J)=D1(J);F K=1,N2;S Q(J)=Q(J)+P(10*K+J)
09.15 S Q(J)=Q(J)/D2(N2)
09.20 F L=1,N2;FF  K=N2-L;S P(10*L+J-L)=-Q(J)*D2(K)

10.30 I (Q(J))10.4;T "+
10.40 T %3.3,Q(J);S E=J-X;D 11

11.10 I (E-1)11.9,11.7;T "*X^",%1,E;R
11.20 R
11.70 T "*X
11.90 R
8|?