CALLCD,	JMS I (200		/CALL THE COMMAND DECODER
	5
	0
	JMS I (IOPEN		/SETUP INPUT POINTERS
	JMS I (OOPEN		/PEN OUTPUT FILE
	SMA CLA			/ERROR. IF AC<0, IT WAS FATAL.
	JMP OK			/NON FILE-STRUCTURED OUTPUT
	JMS TERR
	TEXT /OPEN FAILED/
OK,	JMS I (ICHAR		/READ A CHARACTER
	JMP TSTEOF		/ERROR, SEE IF EOF
	SNA			/IGNORE BLANKS
	JMP OK
	JMS I (OCHAR		/AND OUTPUT THE CHARACTER
	JMP OUTERR
	JMP OK			/CONTINUE TILL EOF
TSTEOF,	SMA CLA			/WAS IT FATAL?
	JMP CLOSE		/NO..EOF.. CLOSE OUTPUT
	JMS TERR
	TEXT /READ ERROR/
CLOSE,	JMS I (OCLOSE
	JMP CLERR		/FILE CLOSE FAILED
	JMP CALLCD		/NEW INPUT
OUTERR,	JMS TERR
	TEXT /OUTPUT ERROR/
CLERR,	JMS TERR		/CLOSE FAILURE
	TEXT /CLOSE FAILED/
TERR,	0			/ROUTINE TO PRINT ERROR MESSAGES
	TAD I TERR
