/READABLE PUNCH AND COPY PROGRAM
/
/BASED ON DECUDS 8-382 BUT HEAVILY MODIFIED.
/
*200
START,	CLA CLL 	/INITIALIZE
	TLS
	PLS
	RFC
	KCC
	JMS LDR
NEXT,	KSF		/GET A CHARACTER
	JMP .-1
	KRB
	TLS
	DCA CHAR	/STORE IT
	TAD CHAR
	TAD M215	/IS IT CR
	SNA CLA 
	JMP NEXT	/YES GET NEXT CHAR
	TAD CHAR	/NO, IS IT LINEFEED
	TAD M212
	SNA CLA 
	JMP NEXT	/YES GET NEXT CHAR
	TAD CHAR
	TAD MODE	/NO IS IT ALTMODE
	SNA CLA 
	JMP GO		/YES PRODUCE LEADER
	TAD C3
	DCA VCNT	/INITIALIZE COUNTER
	TAD CHAR
	AND MASK77	/STRIP CHARACTER
	DCA MKAD
	TAD MKAD
	CLL RAL 
	TAD MKAD
	TAD SOC
	DCA PUND
PUCH,	CLA CLL
	TAD I PUND	/GET FIRST TWO CHARS
	DCA CHAR
	TAD CHAR
	RTR 
	RTR 
	RTR 
	AND MASK77	/REMOVE 2ND VECTOR
	CLL RAL 	/COLS 2-7 ONLY
	JMS PUNCH	/PUNCH 1ST VECTOR
	TAD CHAR
	AND MASK77
	CLL RAL 
	JMS PUNCH	/PUNCH 2ND VECTOR
	ISZ PUND
	ISZ VCNT
	JMP PUCH
	JMP NEXT
/
PUNCH,	0		/PUNCH ROUTINE
	PSF
	JMP .-1
	PLS
	CLA 
	JMP I PUNCH
/
LDR,	0		/PRODUCE LEADER
	CLA CLL 
	TAD LDRCNT
	DCA VCNT
	JMS PUNCH
	ISZ VCNT
	JMP .-2
	JMP I LDR
/
GO,	JMS LDR
	JMS READ
	JMS PUNCH
	JMP .-2
/
READ,	0
	DCA VCNT	/FOR TIMEOUT LOOP
	RSF 
	SKP 
	JMP .+4
	ISZ VCNT
	JMP .-4
	JMP NEXT-1
	RRB RFC 
	JMP I READ
/
