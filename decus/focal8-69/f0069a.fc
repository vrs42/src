@@@@@@
C-FOCAL , 8/68

01.10 ERASE
01.20 A "N     "P;A "NO. OF ROWS     "H
01.21 A "NO. OF COLUMNS  "V,!!
01.30 F N=1,H;DO 4

02.10 F B=1,H;DO 7
02.20 F BB=1,V;S SS=BB-V;DO 9
02.25 F B=1,H;S J1=E(B)+J1
02.30 S C=J1^2/(H*V*P)
02.35 F B=1,H;S JJ=E(B)^2+JJ
02.40 S V1=[JJ/(V*P)]-C
02.45 F BB=1,V;S J2=EE(BB)^2+J2
02.50 S V2=[J2/(H*P)]-C
02.65 F U=1,H*V;S L=A(U)^2+L
02.70 S V3=[L/P]-C-V1-V2
02.75 F J=1,R;S J3=G(J)+J3
02.81 S T=J3-C
02.90 S ER=T-V1-V2-V3

03.10 T !!!!,"ANALYSIS OF VARIANCE TABLE",!!!
03.20 T "SOURCE        SS        DF        MS        F",!!
03.30 T %7.02 "TOTAL     "T, (H*V*P)-1,!!
03.40 T "ROWS      ",V1, H-1,  V1/(H-1),  (V1/(H-1))/<ER/[H*V*(P-1)]>,!!
03.50 T "COLUMNS   ",V2, V-1,  V2/(V-1),  (V2/(V-1))/<ER/[H*V*(P-1)]>,!!
03.60 T "R X C     ",V3, (H-1)*(V-1), V3/<(H-1)*(V-1)>
03.65 T (V3/<(H-1)*(V-1)>)/<ER/[H*V*(P-1)]>,!!
03.70 T "ERROR VAR ",ER, [H*V*(P-1)], ER/<H*V*(P-1)>,!!
03.80 QUIT

04.10 F O=1,V;S R=R+1;DO 5

05.10 T %1, "SAMPLE ("N,",",O,")",!
05.20 F Q=1,P;DO 6

06.10 A X(R);S A(R)=X(R)+A(R);S G(R)=X(R)^2+G(R)

07.10 F D=1,V;S S=S+1;S E(B)=A(S)+E(B)

09.10 F DD=1,H;S SS=SS+V;S EE(BB)=A(SS)+EE(BB)
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@x|w