
C-FOCAL., 1968

01.10 C FOCAL-SLOT     FRJ     5/20/70
01.20 T "FOCAL-SLOT"!!"YOU CAN PLAY FOR "!!;E
01.30 T "NICKELS"!"DIMES"!"QUATERS"!"HALFS"!!
01.40 A "BET IS  ",X;C MUST BE INTERGER VALUE  DIMES=10 NOT .10
01.50 I (50-X)1.6,1.7;I (50-X*2)1.6,1.7;
01.51 I (50-X*5)1.6,1.7;I (50-X*10)1.6,1.7;
01.60 T "YOU MUST PLAY FOR"!; G 1.3
01.70 S X=X*.01;S JP=X*1000;T "  JACKPOT = ",%10.02,JP,!!
01.71 T "TO SPIN THE WHEELS PRESS 'RETURN' WITH VIGOR"
01.80 A START

02.10 F I=1,3;S W(I)=FITR(10*FABS(FRAN()))
02.20 F I=1,3;D 3.0
02.30 I (W(1)-W(2))2.6,2.31,2.6
02.31 I (W(2)-W(3))2.4,2.32,2.4
02.32 I (W(2)-9)2.7,2.33,2.7
02.33 T "  JACKPOT"!"       ********"!;G 2.5
02.40 S Y=W(3)*X+X;S TW=TW+Y;S JP=JP-Y;G 2.8
02.50 S Y=JP;S TW=TW+Y;T Y,TW;QUIT
02.60 S Y=-X;S JP=JP-Y;S TW=TW+Y;G 1.8
02.70 S Y=(W(1)*X*10)+2*X;S TW=TW+Y;S JP=JP-Y;
02.80 T %10.02,Y,"     ",TW;G 1.8

03.10 I (W(I)-1)3.40,3.41;I (W(I)-3)3.42,3.43;I (W(I)-5)3.44,3.45;
03.20 I (W(I)-7)3.46,3.47;I (W(I)-9)3.48,3.49;
03.40 T "* ";R
03.41 T "? ";R
03.42 T "# ";R
03.43 T "& ";R
03.44 T "= ";R
03.45 T ": ";R
03.46 T "^ ";R
03.47 T "+ ";R
03.48 T "% ";R
03.49 T "$ ";R
*
o