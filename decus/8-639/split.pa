/MAIN ROUTINE

	*2000
SORT,	JMS	GETONE
	JMS	GETONE
	TAD	CHAR3
	AND	(300
	SZA CLA
	JMP	SPEC
	DCA	STFLAG
	TAD	CHAR3
	JMS	PAKBYT
	TAD	CHAR2
	JMS	PAKBYT
	ISZ	ADDRES
	TAD	ADDRES
	AND	(177
	SZA CLA
	JMP	SORT
	TAD	CHAR1
	AND	(300
	SZA CLA
	JMP	SORT	/CHANGE COMING
	TAD	ADDRES
	STL RTR
	RTR
	RTR
	DCA	CHAR3
	DCA	CHAR2
	JMP	FCLOSE

SETADR,	0
	TAD	CHAR3
	CLL RTL
	RTL
	RTL
	TAD	CHAR2
	DCA	ADDRES
	TAD	CHAR3
	JMS	PAKBYT
	TAD	CHAR2
	JMS	PAKBYT
	JMP I	SETADR
/FIELD AND ORIGIN SETTINGS

SPEC,	TAD	CHAR3
	TAD	[-200
	SMA
	JMP	TFIELD
	AND	(76
	CIA
	TAD	ORIGIN
	SZA CLA
	JMP	.+3
SAMFIL,	JMS	SETADR
	JMP	SORT
	TAD	CHAR3
	TAD	[-200
	AND	(76
	DCA	ORIGIN
	TAD	STFLAG
	SZA CLA
	JMP	SAMFIL
FCLOSE,	JMS	OCLOSE
	JMS	OOPEN
	JMP	SPEC

TFIELD,	ISZ	STFLAG
	JMP	.+7
	DCA	FIELDX
	TAD	CHAR3
	JMS	PAKBYT
	STA
	DCA	STFLAG
	JMP	SORT+1
	CLA
	JMP	FCLOSE
/OPEN A FILE

OOPEN,	0
	ISZ	TENCNT
