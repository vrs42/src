/GET ONE NEW CHARACTER FOR STACK

GETONE,	0
	TAD	CHAR2
	DCA	CHAR3
	TAD	CHAR1
	DCA	CHAR2
	JMS I	[GETBYT
	DCA	CHAR1
	TAD	CHAR1
	TAD	[-200
	SNA CLA
	JMP	.+10
	TAD	CHAR2
	TAD	[-200
	SPA CLA		 /exclude FIELD
	TAD	CHAR2
	TAD	INCHEK
	DCA	INCHEK
	JMP I	GETONE
	TAD	CHAR3
	CLL RTL
	RTL
	RTL
	TAD	CHAR2
	TAD	CHAR3	 /in INCHEK
	CIA
	TAD	INCHEK
	SZA CLA
	JMP	CHEKER
GETDON,	CDF 10
	NOP	/DCA I	(60	/spec. dir. switch
	CDF 0
