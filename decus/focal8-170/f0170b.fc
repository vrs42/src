
C-FOCAL,1969

01.90 C PROF. R.W. CARTER         MARCH 1971

02.10 C   FOCAL ROUTINE TO COMPUTE 
02.11 C   BINOMIAL PROBABILITIES
02.20 S K=0;A !!!"# OF TRIALS ?",N
02.21 S DV=N;DO 4.0;S NF=AF
02.30 A !!"PROB. OF 1ST TYPE OF OUTCOME",P
02.40 A !!"FULL DIST ? (1=YES, 2=NO)",Q
02.50 I (Q-1)2.4,2.9,2.6
02.60 I (Q-2)2.4,2.7,2.4
02.70 A !!"VALUE OF K",K;DO 3.0;G 2.2
02.90 DO 3.0;S K=K+1
02.91 I (K-N)2.9,2.9,2.2

03.10 S PQ=(K*FLOG(P))+((N-K)*FLOG(1-P))
03.11 C   AF=OUTPUT OF LOG(FACTORIAL)
03.12 C   DV=INPUT FOR LOG(F)
03.20 S DV=K;DO 4.0;S KF=AF
03.30 S DV=N-K;DO 4.0; S NK=AF
03.40 S PQ=(PQ+NF)-(KF+NK)
03.50 S PR=FEXP(PQ)
03.60 T %8.4,!!!"FOR X ",K," P(X) "PR

04.10 S AF=0
04.20 F I=1,1,DV;S AF=AF+FLOG(I)
04.30 R
*8|~