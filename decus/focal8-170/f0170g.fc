
C-FOCAL,1969

01.90 C PEARSON R AND LINEAR REGRESSION

02.10 T !!"AFTER DATA FIN & C/C, RET TO 3.1
02.11 S SX=0;S SY=0;S Y2=0;S X2=0;S XY=0;S N=0
02.20 A !"X"X,"  Y"Y;S N=N+1
02.30 S SX=SX+X;S SY=SY+Y;S X2=X2+X^2;S Y2=Y2+Y^2
02.40 S XY=XY+X*Y;G 2.2

03.10 T !!"# PTS"N,!!,"X BAR"SX/N,!!"Y BAR"SY/N,!!
03.20 S CU=XY-((SX*SY)/N);T !"COVAR"CU
03.30 S NX=X2-((SX^2)/N);S BY=CU/NX
03.40 S NY=Y2-((SY^2)/N);S BX=CU/NY
03.50 T !!"PEARSON R"CU/(FSQT(NX)*FSQT(NY))
03.60 T !!"B(YX)"BY,!!"B(XY)"BX
03.70 T !!,"Y  ",BY,"X + (",(SY/N)-((SX/N)*BY),")",!!
03.80 T !!,"X  ",BX,"Y + (",(SX/N)-((SY/N)*BX),")",!!
03.90 G 2.1
*8~