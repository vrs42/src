
C-FOCAL,1969

01.20 C   T COMPUTATION; HO= ORIG UNCER.; HR=RESID. UNC.
01.21 S HO=0;S HR=0;DO 2.1;S CX=0
01.22 A !!"# OF X COL'S= ",XC
01.30 A !!"TOT. FREQ (Y)= ",TY
01.31 T !!"ENTER ROW(Y) FREQ. SUMS &"
01.40 T !!"RET TO 1.5 AFTER  C/C";S SF=TY;G 2.4
01.50 S HO=H;T !"ST. X COL'S & RET. AFTER EACH (INCL. LAST) TO 1.7"
01.60 G 2.1
01.70 DO 3.0;S CP=SF/TY;S HR=HR+(CP*H);T ?HR?," ", ?CP?;S CX=CX+1
01.80 T !!"RET. TO 1.9 IF COL'S FIN";G 2.1
01.90 I (XC-CX)4.1,1.91,4.1
01.91 T !!"H ORIG.",HO,"  BITS  ",!,"H RESID.",HR,"  BITS  ",!
01.92 T "T", (HO-HR),"  BITS"
01.93 G 1.21

02.10 S H=0;S CS=0
02.20 A !!!"TOTAL SUM FREQ=",SF
02.30 C SF=TOTAL SUM FREQ;H= AVER # BIN QUES.; AF=SCORE FREQ.
02.40 A !"F= ",AF
02.50 S CS=CS+AF;S PR=AF/SF;I (PR)4.1,2.52,2.51
02.51 S LP=FLOG(PR)/FLOG(2);G 2.6
02.52 S LP=0
02.60 S PL=(-PR)*(LP);S H=H+PL;G 2.4

03.10 I (CS-SF)4.1,3.2,4.1
03.20 T !!"AVER. # BIN. QUES. (H)",H,"  BITS "

04.10 T !!!!"FREQ. INPUT ERR";Q
*8|~