
C-FOCAL,1969

01.80 C FOCAL ROUTINE TO COMPUTE QUARTILES & MEDIAN
01.90 C IM=MAX PTER FOR CELLS;SF=COMPUTED SUM(FREQ.

02.10 S I=1;S IM=1;;S SF=0
02.20 A !!"SUM FREQ "N,!"cELL WIDTH"CW,!"MP MAX "MA,!
02.30 S AF(I)=0
02.31 T !"RET. TO 3.1 AFTER DATA & C/C "!!
02.40 C TIGHT LP ST.
02.50 A "X "X," F "RQ,!;S SF=SF+RQ
02.60 I (X-(MA+(CW*(1.5-I))))2.7,2.7,9.1
02.70 I ((MA+(CW*(0.5-I)))-X)2.8,2.8,2.9
02.80 S AF(I)=AF(I)+RQ;S I=1;G 2.5
02.90 S I=I+1;I (I-IM)2.6,2.6,2.91
02.91 S AF(I)=0;S IM=IM+1;G 2.6
02.92 C DISPLAY ST.

03.10 S IM=IM+1;S AF(IM)=0
03.11 I (SF-N)8.1,3.2,8.1
03.20 S I=1;S BC=0
03.30 T !"MP"MA-((I-1)*CW)," F"AF(I)
03.31 T " CF"N-BC," %CF"((N-BC)/N)*100
03.40 S T=N-BC;I (I-IM)3.5,3.61,9.1
03.50 S BC=BC+AF(I);S I=I+1;S AF(I-1)=T;G 3.3
03.60 C CUM F'S NOW IN AF;DO Q1,Q2,Q3
03.61 S I=1;S QC=3
03.62 S LK=QC*N/4
03.70 I (LK-(AF(I)+0.5))3.8,3.8,9.1
03.80 I ((AF(I+1)+0.5)-LK)3.91,3.91,3.9
03.90 S I=I+1;I (I-IM)3.7,3.7,9.1
03.91 D 4;S QC=QC-1;I (QC)9.1,2.1,3.62

04.10 S T=AF(I+1)+0.5
04.20 S Q=MA+CW*(0.5-I)+(CW*(LK-T))/(AF(I)-T)
04.30 T !!"Q("QC,")"Q,!;R

08.10 T !!!"C SUM ERR ";Q

09.10 T !!!"FREQ OUT";Q
*8~