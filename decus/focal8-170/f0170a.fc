
*
C-FOCAL,1969

01.01 C                 FLGPLT                PROF. R.W.CARTER
01.10 C FOCAL ROUTINE TO COMPUTE & PLOT GROUPED FREQUENCIES

02.10 S I=1;S IM=1;;S CK=0
02.20 A !!"SUM FREQ "N,!"cELL WIDTH"CW,!"MP MAX "MA,!
02.30 S Q(I)=0
02.31 T !"RET. TO 3.1 AFTER DATA & C/C "!!
02.40 C TIGHT LP ST.
02.50 A "X "X," F "RQ,!;S CK=CK+RQ
02.60 I (X-(MA+(CW*(1.5-I))))2.7,2.7,12.1
02.70 I ((MA+(CW*(0.5-I)))-X)2.8,2.8,2.9
02.80 S Q(I)=Q(I)+RQ;S I=1;G 2.5
02.90 S I=I+1;I (I-IM)2.6,2.6,2.91
02.91 S Q(I)=0;S IM=IM+1;G 2.6
02.92 C DISPLAY ST.

03.10 S IM=IM+1;S Q(IM)=0
03.11 I (CK-N)11.1,4.19,11.1

04.19 S TX=Q(0);S J=1;G 9.11
04.20 S J=J+1;IF (J-IM)9.11,4.21,4.21
04.21 IF (TX-50)4.37,4.37,4.31
04.31 S SF=TX/50;S SF=FITR(SF);S X=1
04.33 IF (SF-10^X)4.35,4.35,4.34
04.34 S X=X+1;GOTO 4.33
04.35 S X=X-1;S SF=SF+10^X;G 4.38
04.37 S SF=1

07.10 T !!;T "    X VALUE (MP)          "
07.30 S L=21;D 9.1
07.40 T "FREQ.",!!!;D 7.3;T "0";S L=18;D 9.1
07.60 T %3.0,20*SF;S L=14;D 9.1;T 40*SF,!
07.70 D 7.3;T "^"
07.80 S L=19;D 9.1;T "^"
07.90 D 7.8;T !;F M=1,1,72;T "."

08.10 F I=1,1,IM-1;S K=IM-I;D 10.0
08.11 T !!;F I=1,1,72;T "."
08.20 T !!!!!;Q

09.10 F M=1,1,L;T " "
09.11 IF (Q(J)-TX)4.2,4.2,9.2
09.20 S TX=Q(J);G 4.2

10.10 T !!,((I-1)*CW),"                .",#
10.20 S L=FITR(Q(K)/SF)+21;D 9.1;T "*~"

11.10 T !!!"CK SUM ERR";Q

12.10 T !!!"FREQ. OUT";Q
*8|