
CTRL/T
C/ APOLLO V62 LOAD-AND-GO TAPE (14 MAY 1971) D.A.MOON

CTRL/R

E A

01.01 C.XQ
01.10 I (FCOM())5.2,3.1,5.3

02.10 L D XQ62
02.20 L S XQ62
02.30 L C AP62

03.10 S T=;S I=;S D=5;S R=5E4;S H=1E4;S VV=;S HV=750;S A=1.57
03.13 S W=;S M=3500
03.20 D 5
03.30 D 4;D 9;I (H)8.1;I (-M)3.2;G 7.1

04.20 A "  "K,V;I ((35-K)*(4-K))4.8,4.8;I (K)4.3,4.8
04.30 T "?"!;F K=,49;T " 
04.40 G 4.2
04.80 I ((1-FABS(V))*(.1-FABS(V))),;I (V)4.3,,4.3

05.10 T !%4,T;I (0*FCOM(,-1)*FCOM(1,R)*FCOM(2,H))
05.13 I (0*FCOM(3,HV)*FCOM(4,-VV));D 2
05.20 I (0*FCOM(,1)*FCOM(1,A*57)*FCOM(2,W*57)*FCOM(3,M));D 2
05.30 I (I)8.1,3.3;S K=FCOM(,)-FCOM(1,HV)-FCOM(2,VV)-FCOM(3,R)
05.33 S K=FCOM(4,1);D 2.3

07.10 S D=M/(K+FABS(V));D 9;S I=-1;S K=;S V=;D 5

08.10 F I=,9;S D=-H/VV;D 9
08.20 I (M)7.1;S H=;S I=1;D 5

09.10 D 11;S L=D*6E3/(M+16500);S HV=HV-K*L*FSIN(A)
09.20 S VV=VV-5.4*D+K*L*FCOS(A);S T=T+D;S W=W+V*L/6;D 11

11.10 S M=M-D*(K+FABS(V))/2;S H=H+VV*D/2;S R=R-HV*D/2
11.20 S A=A+W*D/2;I (3.14-FABS(A))11.3;R
11.30 S A=A-6.28*FSGN(A)
L S XQ62
E A
T #"AP62"!!

01.01 C.AP
01.10 I (FCOM())5.1,6.1,5.2

02.30 L C XQ62

03.10 T !!"RADAR LOCKED IN"!!"COMMENCE LANDING PROCEDURE
03.15 T !!;F I=,13;T " 
03.16 T "INSTRUMENTS";F I=,24;T " 
03.17 T "THROTTLES
03.20 T !" TIME  RANGE ALT  VELOC,(FPS)  ATT    ANGVEL  FUEL
03.25 T "  MAIN VERNIER"!" (SEC) (FT)  (FT)  HOR, VERT  
03.30 T "(DEG)    (D/S)  (LB)  (LB/SEC)

04.20 T FCOM(I)*(1-(.75-T/16)*S(I+4*(FCOM()+1)))
04.10 S T=;F J=,15;S T=T+FRAN()

05.10 T %5;F I=1,3;D 4
05.15 T %4;D 4;D 2
05.20 F I=1;D 4;T %5;S I=2;D 4;T %7;S I=3;D 4;D 2

06.10 I (-FCOM(4))6.2
06.15 T !!!!!!!!!!!!
06.16 F I=,999;
06.17 D 6.15;T "APOLLO.FCL V62 EX PROGRAMIBUS DAMOON 22AUG70
06.18 D 3;D 2
06.20 S I=FABS(FCOM(1)*FCOM(2));S D=;I (I-75)6.3;S D=-1
06.30 T !!!"YOU ";I (D)6.4;T "LANDED";G 6.5
06.40 T "CRASHED
06.50 S R=FABS(FCOM(3));I (1E3-R)6.6;S D=D-1
06.60 T " ON THE MOON",R," FEET FROM THE LANDING SITE
06.63 T !"CONGRATULATIONS ON A
06.70 I (25-I)6.8;S D=D+1
06.80 I (D+1)7.1;I (D)7.2,7.3
06.90 T "N EXCELLENT";G 7.5

07.10 T " **LOUSY**";G 7.5
07.20 T " POOR";G 7.5
07.30 T " GOOD
07.50 T " LANDING!"!;I (I-75)7.6;T !"THERE WERE NO SURVIVORS.
07.60 A !!"WANT TO TRY IT AGAIN?"T;I (0YUO-T)6.15;D 6.15;Q

S S[ 1]= 0.160000E-01
S S[ 2]= 0.192000E-01
S S[ 3]= 0.160000E-01
S S[ 4]= 0.192000E-01
S S[  9]= 0.224000E-01
S S[ 10]= 0.102400E-01
S S[ 11]= 0.320000E-02
L S AP62
E A

C-FOCAL, U01

01.10 F I=,4;S Z=FCOM(I,)
01.20 T !!"ENTERING AP62.  STAND BY TO RIP OFF PAPER."!
01.30 L C AP62
01.40 THEN GO
GO8|~