
C-FOCAL,1969

01.01 SET X=0
01.05 SET PI=3.1416
01.10 FOR V=0,.1,.9; DO 2.0
01.20 QUIT

02.10 SET SUM=0;SET N=0
02.20 SET K=[(N^2+1)^2]/2
02.30 SET CE=K*V^2*PI^2
02.40 SET TE=[(-1)^N]*FEXP(-CE)
02.50 SET SUM=SUM+TE
02.60 SET N=N+1
02.70 IF (N-4)2.2,2.2,2.8
02.80 TYPE %8.04, "M(M,T)",(4/PI)*SUM,#
02.90 DO 3.0

03.10 IF (V)3.14,3.11,3.14
03.11 FOR YS=0,30;TYPE " "
03.12 FOR YS=0,40;TYPE "."
03.13 TYPE #
03.14 FOR YS=0,31;TYPE " "
03.15 TYPE %2.02,"V",X/10;SET X=X+1;TYPE #
03.20 FOR Y=0,29+40*(SUM);TYPE " "
03.30 TYPE "*",!
03.40 FOR YS=0,29;TYPE " "
03.50 TYPE " .",!
*