
C=FOCAL<1969

01.10 T !,!,"PRECISION TSS/8 H-PARAMETER CONVERSION",!;GOTO 2.25
01.18 T !"SURE BEATS USING A SLIDE RULE, HUH?!",!
01.20 T !,"WOULD YOU APPRECIATE CIRCUIT GAIN COMPUTATIONS ?",!
01.21 A "TYPE YES OR NO",ANS,!;IF (ANS-0YES) 2.2,1.3,2.2
01.30 T "DO YOU HAVE A VALUE FOR RL ?",!
01.31 A "TYPE YES OR NO",Z,!;IF (Z-0YES) 1.8,1.34,1.8
01.34 A "WHAT IS RL'S VALUE?",RL,!;S AV=(-Q*RL)/(I+DH*RL)
01.60 S AI=Q/(1+O*RL);S AP=AV*AI;T%,"AV",AV,!,"AI",AI,!,"AP",AP,!
01.65 GOTO 2.2
01.80 T "WHATAYA MEAN NO, YOUR NOT IN HIGH SCHOOL ANYMORE  BUNKIE",!
01.81 T "THIS IS THE TSS/8 BIGTIME, AND DON'T YOU FORGET IT ",!
01.82 T !,"I'LL HIT YOU WITH THAT ONCE MORE",!;GOTO 1.3

02.20 A "TO STOP, TYPE A 0",X;IF (X) 3.08,9.1,3.08
02.25 T !,"ANSWER THE NEXT TWO QUESTIONS WITH -1,0,+1"!
02.26 T "CE=-1, CB=0, CC=1"!

03.08 A "(1) CONVERT (CE,CB,CC) H-PARAMETERS",C2
03.11 A "(2) TO (CE,CB,CC) H-PARAMETERS",C1
03.12 IF (C1-C2) 3.20, 2.20,3.20
03.20 IF (C2) 4.10,5.10,6.10

04.10 A "WHAT IS HIE?",IE;A "WHAT IS HRE?",RE;A "WHAT IS HFE?",QE
04.13 A "WHAT IS HOE?",OE;IF (C1) 3.15,4.3,4.6
04.30 S I=IE/(1+QE);S R=((IE*OE)/(1+QE))-RE;S Q=-QE/(1+QE)
04.35 S O=OE/(1+QE);T !,%,"HIB",I,!,"HRB",R,!,"HFB",Q,!,"HOB",O,!
04.36 GOTO 1.18
04.60 S I=IE;S R=1-RE;S Q=-(1+QE);S O=OE
04.64 T !,%,"HIC",I,!,"HRC",R,!,"HFC",Q,!,"HOC",O,!;GOTO 1.18

05.10 A "WHAT IS HIB?", IB;A "WHAT IS HRB?",RB;A "WHAT IS HFB?",QB
05.13 A "WHAT IS HOB?",OB;IF (C1) 5.3,7.15,5.6
05.30 S I=IB/(1+QB);S R=((IB*OB)/(1+QB))-RB;S Q=(-QB)/(1+QB)
05.35 S O=OB/(1+QB);T !,%,"HIE",I,!,"HRE",R,!,"HFE",Q,!,"HOE",O,!
05.36 GOTO 1.18
05.60 S I=IB/(1+QB);S R=(1+QB)/(((1+QB)*(1-RB))+(OB*IB))
05.61 S Q=-1/(1+QB);S O=OB/(1+QB)
05.64 T !,%, "HIC",I,!,"HRC",R,!,"HFC",Q,!,"HOC",O,!;GOTO 1.18

06.10 A "WHAT IS HIC?",IC;A "WHAT IS HRC?",RC;A "WHAT IS HFC?",QC
06.13 A "WHAT IS HOC?",OC;IF (C1) 6.3,6.6,3.15
06.30 S I=IC;S R=1-RC;S Q=-(1+QC);S O=OC
06.34 T !,%, "HIE",I,!,"HRE",R,!,"HFE",Q,!,"HOE",O,!;GOTO 1.18
06.60 S I=-IC/QC;S R=((QC*(1-RC))+(IC*OC))/((IC*OC)-(QC*RC))
06.64 S Q=-(1+QC)/QC;S O=-OC/QC;T !,%,"HIB",I,!,"HRB",R,!,"HFB",Q,!
06.65 T "HOB",O,!;GOTO 1.18

09.10 QUIT
*