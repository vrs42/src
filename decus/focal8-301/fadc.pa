/FOCAL FUNCTION FADC(N)   -JVZ

/THIS FUNCTION CONTROLS THE STANDARD AD8-E/AM8-E MULTIPLEXED
/ANALOG-TO-DIGITAL CONVERTER. THE FUNCTION ARGUMENT CONTROLS
/WHICH CHANNEL IS READ.  THUS N SHOULD BE IN THE RANGE 0-7.

/SYSTEM SYMBOLS:

	ADLM=6531
	ADST=6532
	ADRB=6533
	ADSK=6534
	FIXTAB

/FOCAL SYMBOLS:

	FNTABF=355
	FADC=1343
	FNTABL=2155
	FIXIT=4453
	FLOAT=5512

	FIELD 1

	*FNTABF+17
	FADC		/ENTRY POINT

	*FNTABL+17
	"A^2+"D^2+"C	/CODE FOR 'FADC'

	*FADC		/STANDARD LOCATION
FADC,	FIXIT
	ADLM		/SET CHANNEL
	ADST		/START CONVERTER
	ADSK
	JMP .-1		/WAIT 'TILL DONE
	ADRB		/READ RESULT
	FLOAT		/CONVERT TO F.P.
	$
