/LIBRARY AND FILE COMMAND PROCESSOR:


	/****** STORAGE ALLOCATION MAP ******
	/*****				*****
	/*	3600	(OUTPUT,RESTORE,CLOSE,ABORT)
	/*	4000	INPUT BUFFER (PAGE 1)
	/*	4200	INPUT BUFFER (PAGE 2)
	/*	4400	OUTPUT BUFFER (PAGE 1)
	/*	4600	OUTPUT BUFFER (PAGE 2)
	/*	5000	INPUT HANDLER
	/*	5200	OUTPUT HANDLER
	/*	5400	FILES (INPUT,OPEN,AND LIST)
	/*
	/*	5600	PUSHDOWN LIST CONTROLS
	/*	6000	NAME, GTMON, DISMISS, IOWAIT
	/*	6200	HANDLR, PUTDEV, & TABULATE
	/*	6400	DECODER, NAMER, DATER, SAVER
