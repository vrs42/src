	TAD M11		/WITHOUT M271

	*1553
ZINITL,	STL RTL
	TAD END		/INITIALIZE X-REGISTER
	JMP ZSERCH

ZFOUND,	TAD M4		/POINT TO NAME
	TAD XRT
	DCA XRT
	TAD EFOP
	DCA I XRT	/REPLACE THE NAME
	JMP SET20-2	/AND THE SUBSCRIPT

XINC,	WORDS+1
GECALL,	ECALL
LOOK42,	TEST42
