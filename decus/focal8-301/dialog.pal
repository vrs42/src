	CMA
	OPENUP		/CALL THAT AMAZING
	    INBLK-1	/GENERAL-PURPOSE SUBROUTINE
	    2		/MONITOR 'LOOKUP'
	JMP TTYIN	/'OPEN INPUT TTY:'
	ERROR1		/WHOOPS - FILE NOT FOUND
	DISMISS		/BOOT THE USR OUT
	CLA CMA
	DCA INFLG	/CHARACTER COUNTER
	TAD STBLK	/FIRST BLOCK NO.
	DCA I .+2
	JMP IRST+3
	IBLK
IRST,	TAD INFLG	/'OPEN RESTORE INPUT' COMMAND
	SNA CLA		/CHECK CHARACTER COUNT
	ERROR1		/NO INPUT FILE TO RESTORE
	TAD TTYIN-1	/SET I/O POINTERS
	CDF 10
	DCA I [INDEV
	TAD ATEM-1	/'ION'
