	ISZ ZERSW	/OTHER DIGITS HAVE BEEN NON-ZERO,
	SZA		/PRINT A SPACE INSTEAD
	JMP NPRNT
	TAD [240
	JMS I (PRINT
	JMP ZLUP

NPRNT,	TAD [260	/CHANGE TO ASCII
	JMS I (PRINT
TABLE,	CMA STL		/SET ZERO SWITCH
	JMP ZLUP

NEND,	TAD [215	/DONE WITH THIS LINE (WHEW!)
	JMS I (PRINT
	JMP LOOP3

