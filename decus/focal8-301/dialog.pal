TTYTXT,	DEVICE TTY	/FOR COMPARISON PURPOSES
	*CIF		/'PRINTC' TAB COUNTER
	0
	SZA		/TEST FOR CR
	JMP .+4
	ISZ CIF		/ADVANCE RETURN POINT
	ISZ CIF
	DCA I [ERR2	/RESET COUNTER
	TAD (215-240
	SMA		/NON-PRINTING CHARACTERS
	ISZ I [ERR2	/ADD 1 TO TAB COUNT (FIELD 1)
	NOP		/MIGHT SKIP AFTER 4095 TIMES
	TAD [240	/WITHOUT INTERVENING CR'S
	CIF 10
	JMP I CIF

TSP,	TASK
DHT,	7646

NOTEQ,	ISZ SLOT	/BUMP POINTER TO SAVE NAME
	TAD NEWDEV	/MOVE NEW DEVICE NAME TO TABLE
	DCA I SLOT
	ISZ SLOT
	TAD NEWDEV+1
	DCA I SLOT
	ISZ SLOT
	GETMON		/NEED USR, MIGHT AS WELL LOCK IT IN
RETRY,	TAD NEWDEV	/MOVE DEVICE NAME FOR MONITOR CALL
	DCA DEVC
	TAD NEWDEV+1
	DCA DEVC+1
	TAD I SLOT	/MOVE LOAD POINT
