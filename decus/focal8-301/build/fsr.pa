/FOCAL FUNCTION FSR()      -JVZ

/THIS FUNCTION RETURNS THE VALUE SET IN THE SWITCH REGISTER
/INTERPRETED AS A SIGNED TWO'S COMPLEMENT NUMBER. THE RANGE
/IS THUS -2048 TO +2047.  USE OF THIS FUNCTION PERMITS PRO-
/GRAM OPTIONS TO BE CONVENIENTLY CONTROLLED BY THE CONSOLE
/SWITCHES.  THE FUNCTION HAS NO ARGUMENTS.

/FOCAL SYMBOLS:

	FNTABF=355
	FNTABL=2155
	FLOAT=5512

	FIELD 1

	*FNTABF+24
	FSR		/ENTRY POINT

	*FNTABL+24
	"S^2+"R

	*1352		/AFTER 'FADC'
FSR,	LAS
	FLOAT		/CONVERT TO F.P.
	$
