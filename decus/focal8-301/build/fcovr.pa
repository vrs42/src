	TAD I T1	/YES
	DCA T1
	ISZ FPNT	/BUMP TO NEXT INSTRUCTION
	CMA
	TAD T1
	DCA FLTXR2	/SET UP TRANSFER
	TAD JUMP	/GET OP CODE
	CLL RTL
	RTL
	AND P17
	SNA
	JMP FLGT	/0 = "FGET"
	TAD OPTABL	/POINT TO OPERATION
	DCA JUMP
	TAD I JUMP
