COMMA,	",		/'SORTA USEFUL'
FLEX=.			/"^" ENTRY POINT CHANGED
	*6537
	DCA T1
	NOP		/PATCH FOR 3-WORD VERSION

	*6545
	FLTONE		/MOVED DOWN ONE

	*6550
