	TAD FPNT	/NO, GET PAGE #
	AND P7600
	DCA T1		/AND SAVE IT ('MQL')
	TAD JUMP	/NOW GET RELATIVE LOCATION
	AND P177
	TAD T1		/MERGE PAGE ADDRESS ('MQA')
	DCA T1
	SNL		/WAS IT INDIRECT ?
