	DCA I FLTXR2
	TAD I FLTXR
	DCA I FLTXR2
	TAD I FLTXR
	DCA I FLTXR2
	TAD I FLTXR	/'JMP FPNT+1' FOR 3 WORDS
	DCA I FLTXR2
	JMP FPNT+1

FIND,	FIXIT		/CHARACTER SEARCH FUNCTION
	CIA
	DCA FPNT
	JMP FINDER

