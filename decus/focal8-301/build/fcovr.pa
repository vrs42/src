/CHANGES TO 'GETC' TO TURN "@" INTO A "SPACE".

	*2276
UTRA=.-2
UTE,	SPA		/DON'T CLEAR AC
	TAD C100	/300-377 & 340-376
	TAD M77		/240-276 & 200-236
	SNA
	JMP UTX		/"?" FOUND
UTQ,	TAD P337
	DCA CHAR
	TAD DEBGSW
	TAD DMPSW
	SNA CLA		/PRINT ONLY IF BOTH ARE ZERO
	PRINTC
	JMP I UTRA	/RETURN
EXTR,	JMS GET1
	SMA		/REVERSE TESTING AT 'UTE'
	JMP UTE+1
	JMP UTE+2
UTX=.
	*2326
	TAD M40
	JMP UTQ
GET1,	0		/UNPACK 6 BITS
	ISZ XCT		/WHICH HALF ?
	JMP GET3
GEND=.+1
	*2341
	JMP EXTR
	TAD CHAR	/BITS 6-11 ONLY
