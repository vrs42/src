   1               /FOCAL FUNCTION FSR()      -JVZ
   2               
   3               /THIS FUNCTION RETURNS THE VALUE SET IN THE SWITCH REGISTER
   4               /INTERPRETED AS A SIGNED TWO'S COMPLEMENT NUMBER. THE RANGE
   5               /IS THUS -2048 TO +2047.  USE OF THIS FUNCTION PERMITS PRO-
   6               /GRAM OPTIONS TO BE CONVENIENTLY CONTROLLED BY THE CONSOLE
   7               /SWITCHES.  THE FUNCTION HAS NO ARGUMENTS.
   8               
   9               /FOCAL SYMBOLS:
  10               
  11                       FNTABF=355
  12                       FNTABL=2155
  13                       FLOAT=5512
  14               
  15                       FIELD 1
  16               
  17                       *FNTABF+24
  18 010401  1352          FSR             /ENTRY POINT
  19               
  20                       *FNTABL+24
  21 012201  1170          "S^2+"R
  22               
  23                       *1352           /AFTER 'FADC'
  24 011352  7604  FSR,    LAS
  25 011353  5512          FLOAT           /CONVERT TO F.P.
  26                       $

FLOAT   5512
FNTABF  0355
FNTABL  2155
FSR     1352
