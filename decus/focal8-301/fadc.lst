   1               /FOCAL FUNCTION FADC(N)   -JVZ
   2               
   3               /THIS FUNCTION CONTROLS THE STANDARD AD8-E/AM8-E MULTIPLEXED
   4               /ANALOG-TO-DIGITAL CONVERTER. THE FUNCTION ARGUMENT CONTROLS
   5               /WHICH CHANNEL IS READ.  THUS N SHOULD BE IN THE RANGE 0-7.
   6               
   7               /SYSTEM SYMBOLS:
   8               
   9                       ADLM=6531
  10                       ADST=6532
  11                       ADRB=6533
  12                       ADSK=6534
  13                       FIXTAB
  14               
  15               /FOCAL SYMBOLS:
  16               
  17                       FNTABF=355
  18                       FADC=1343
  19                       FNTABL=2155
  20                       FIXIT=4453
  21                       FLOAT=5512
  22               
  23                       FIELD 1
  24               
  25                       *FNTABF+17
  26 010374  1343          FADC            /ENTRY POINT
  27               
  28                       *FNTABL+17
  29 012174  2517          "A^2+"D^2+"C    /CODE FOR 'FADC'
  30               
  31                       *FADC           /STANDARD LOCATION
  32 011343  4453  FADC,   FIXIT
  33 011344  6531          ADLM            /SET CHANNEL
  34 011345  6532          ADST            /START CONVERTER
  35 011346  6534          ADSK
  36 011347  5346          JMP .-1         /WAIT 'TILL DONE
  37 011350  6533          ADRB            /READ RESULT
  38 011351  5512          FLOAT           /CONVERT TO F.P.
  39                       $

ADLM    6531
ADRB    6533
ADSK    6534
ADST    6532
FADC    1343
FIXIT   4453
FLOAT   5512
FNTABF  0355
FNTABL  2155
