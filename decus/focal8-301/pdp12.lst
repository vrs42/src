  47 012177  2565          "D^2+"I^2+"S
  48               
  49                       *FNTABL+32
  50 012207  2671          "R^2+"L^2+"Y
  51                      *1142
  52 011142  4453  FDIS,   FIXIT           /CONVERT X TO AN INTEGER
  53 011143  3016          DCA 16          /BETA REGISTER
  54 011144  4540          PUSHJ
  55 011145  1612              EVAL-1      /SKIP COMMA, GET Y
  56 011146  4453          FIXIT           /CONVERT Y TO AN INTEGER
  57 011147  6002          IOF             /PREVENT LINC MODE INTERRUPTS
  58 011150  6141          LINC
  59 011151  0156          DIS 16          /PLOT A POINT AT (X,Y)
  60 011152  0002          PDP
  61 011153  6001          ION
  62 011154  5536          RETURN
