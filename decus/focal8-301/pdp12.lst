  70 011343  4453  FADC,   FIXIT           /PUT CHANNEL NUMBER IN AC
  71 011344  1111          TAD C100        /'SAM'=0100
  72 011345  3350          DCA SAM
  73 011346  6002          IOF
  74 011347  6141          LINC
  75 011350  0000  SAM,    0               /READ CHANNEL N
