/SUBROUTINE FOR BRANCHING ON MATCH OF AC AGAINST TABLE:  BRAN
/BRAN
/ADDRESS OF TABLE
/RETURN HERE IF FIRST ENTRY MEETS MATCH
/ETC.
/NONE MATCH
/TABLE,FIRST ENTRY
/SECOND ENTRY
/-LAST ENTRY
/TEMPORARY STORAGE ALLOCATION
	BPNT=TEMP01
	BSAVE=TEMP02
BRANS,	0
	DCA BSAVE
	TAD I BRANS	/GET ADDRESS OF FIRST ENTRY OF MATCH LIST
	DCA BPNT
BRLOOP,	TAD I BPNT	/LOOK AT ENTRY
	SMA		/GET MAGNITUDE
	CMA IAC
	ISZ BRANS	/INDEX RETURN ADDRESS
	TAD BSAVE	/MATCH FOUND?
	SNA CLA
	JMP I BRANS	/YES-EXIT TO RETURN AS CALCULATED
	TAD I BPNT	/NO-TEST FOR LAST ENTRY.
	ISZ BPNT	/INDEX ENTRY POINTER
	SMA CLA		/-INDICATES THIS WAS LAST ENTRY
	JMP BRLOOP	/NOT LAST-CONTINUE
	ISZ BRANS	/EXIT, NOT IN LIST, NONE MATCH
	JMP I BRANS
