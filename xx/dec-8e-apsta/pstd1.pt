	CLL CLA
	TAD DBLAC+1
	TAD DBLARG+1
	DCA DBLARG+1
	RAL		/CARRY
	TAD DBLAC	/ADD HI-ORDER
	TAD DBLARG
	DCA DBLARG	/LEAVE IN ARITH4-5.
	CLL
	JMP I DADDS
