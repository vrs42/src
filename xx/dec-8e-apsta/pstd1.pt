	TAD (2001
	DCA I (7746	/SET JOB CONTROL WORD 0
	CDF CIF 10
	JMS I (7700		/CALL COMMAND DECODER.
	5
	0
	0


	TAD (7601	/SET FILE NAME LOC.
	DCA MSTR2
	TAD I (7600	/CREATE FILE.
