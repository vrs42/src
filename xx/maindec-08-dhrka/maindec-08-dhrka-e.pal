T73R3,	TAD M12
	DCA TCNTR3		/FOR EACH 12 BIT WORD
	TAD K0100		/ENABLE BITS TO SHIFT SILO
	LDMAN			/LOAD MAINTENANCE
	ISZ TCNTR3		/SKIP ON EVERY "12 BIT WORD"
	JMP .-2
	RDBUF			/THIS SHOULD PREVENT A "DRL"
