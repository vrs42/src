/SUBROUTINE TO SET UP FIELD 0
/
SETUP,	0
	TAD I THSFLD		/GET HOME DF
	DCA BAKFLD
	TAD KRMF		/GET RMF FOR INT. RETURN
	CDF 0			/SWITCH TO FIELD 0
	DCA I K0001
	TAD K5403		/JMP I 3 FOR LOC. 2
	DCA I K0002
	TAD INTRQ		/GET ADDRESS RETURN
	DCA I K0003
BAKFLD,	HLT			/HOME DF
	JMP I SETUP
/
K5403,	5403
