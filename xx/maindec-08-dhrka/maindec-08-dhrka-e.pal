	CLRALL			/DCLR "CLR ALL"
	TAD STCON
	TAD K0004
	DCA GDREG2		/SETUP COMPARE REGISTER
	ENMAN1			/ENTER MAINTENANCE MODE
	TAD K1000		/ENABLE
	LDMAN			/SET "DRL" DMAN
	CLA CLL
	TAD REG2
	RDSTAT			/READ STATUS REGISTER
