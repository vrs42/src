	RDSTAT			/READ STATUS REGISTER
	ACCMP1			/CHECK RESULTS
	NERROR			/AC O.K. 4096 LOOPS
	ERROR			/ERROR "INITIALIZE" CLEAR STATUS
				/REGISTER FAILED
	TST0			/SCOPE LOOP POINTER
	5000			/TEXT POINTER
/
/VERIFY THAT SKIP CONDITIONS WERE CLEARED
/BY "INITIALIZE" ON START OF TEST.
/
