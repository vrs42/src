	NERROR			/DSKP O.K. 4096 LOOPS
	ERROR			/ERROR, "INITIALIZE" CLEAR
				/SKIP CONDITIONS
	TST1			/SCOPE LOOP POINTER
	0006			/TEXT POINTER
