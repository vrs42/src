TST3,	RDCMD			/READ COMMAND REGISTER
	SNA CLA			/AC SHOULD BE 0
	NERROR			/AC O.K. 4096 LOOPS
	ERROR			/ERROR, "INITIALIZE" CLEAR
				/COMMAND REGISTER
	TST3			/SCOPE LOOK POINTER
	4201			/TEXT POINTER
/
/VERIFY THAT ALL DRIVES ON CONTROL ARE OFF.
/THE STATUS SHOULD BE 2200 WHEN DRIVES ARE SELECTED.
/
TST4,	TAD STCON		/EXPECTED STATUS
	DCA GDREG2		/SETUP COMPARE REGISTER
	CLA CLL IAC		/ENABLE CLEAR CONTROL
	CLRALL			/DCLR "CLR ALL"
	TAD REG1		/GET AC VALUE
	LDCMD			/LOAD COMMAND
	RDSTAT			/READ STATUS
	ACCMP1			/CHECK RESULTS
	NERROR			/O.K. 4096 LOOPS
	ERROR			/ERROR, STATUS
	TST4			/SCOPE LOOP POINTER
	5000			/TEXT POINTER
