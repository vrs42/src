	CLRALL			/CLEAR SKIP
	DSKSKP			/DSKP
	NERROR			/O.K. 4096 LOOPS
T59E,	ERROR			/ERROR, "DSKP SKIP"
	TST59			/SCOPE LOOP POINTER
	0006			/TEXT POINTER
/
