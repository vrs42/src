	APT8A			/NOP CONSOLE IF ON APT8A
	CLASIC			/CHECK FOR CONSOLE CLASSIC
	C8SWIT			/CHECK FOR SWITCH SR=.
	NOP
	LAS
	AND K0007		/MASK 9-11
