/ROUTINE TO CHANGE PROGRAM DEVICE CODES
/
CHANG,	CLASIC			/CHECK FOR CLASSIC.
	C8SWIT			/ROUTINE TO EXECUTE.
	NOP
	LAS
	AND A0770
	DCA TOTST		/SAVE DESIRED
	TAD CHNPOT
	DCA UPPER
	TAD CCNTR1
	DCA SNERRO		/A FEW POINTERS
CHANGR,	TAD I UPPER		/GET ADDRESS POINTER
	DCA SETUP		/SAVE IT
	TAD I SETUP		/GET OLD IOT CODE
	AND A7007
	TAD TOTST		/ADD IN DESIRED
	DCA I SETUP		/CHANGE CODE
	ISZ UPPER		/UPDATE POINTER
	ISZ SNERRO		/UPDATE CHANGE COUNTER
	JMP CHANGR
	CLASIC			/CHECK FOR CLASSIC.
	C8ERR			/ROUTINE TO EXECUTE.
CHNHLT,	HLT			/DEVICE CODES CHANGED. PRESS
	JMP I XBGN		/CONTINUE PR IF ON CONSOLE 
				/PACKAGE HIT CONTROL E.
/
