	NERROR			/INT. O.K. 4096 LOOPS
	ERROR			/ERROR "INITIALIZE" CLEAR
				/INT. CONDITION
	TST2			/SCOPE LOOP POINTER
	0007			/TEXT POINTER
/
/VERIFY THAT COMMAND REGISTER WAS CLEARED
