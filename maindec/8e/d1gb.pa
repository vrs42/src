/PDP 8E MEMORY POWER ON OFF TEST
*0200
	JMP START
	JMP COMPAR
*0
	0
	JMP 1
	2
	3
	0
	0
	0
UPPER,	0
LOWER,	0
LOWM,	0
HIGH,	0
START,	CLA CLL		/START INITIAL
	TAD K0201
	DCA LOWM
	TAD K4001
	DCA HIGH
WRKON,	TAD UPREG
	DCA I LOWM
	TAD LOREG
	DCA I HIGH
	TAD LOWM
	CIA
	TAD K4001
	SZA CLA
	JMP WRKON
STEND,	HLT		/TURN POWER ON OFF
COMPAR,	CLA CLL
	TAD K0201
	DCA LOWM
	TAD K4001
	DCA HIGH
	TAD I LOWM	/LOWM=UPPER ADDRESS 202-4001
	DCA UPPER
	TAD I HIGH	/HIGH=LOWER ADDRESS 4002-7601
	DCA LOWER
	TAD UPPER
	TAD LOWER
	CMA
	SZA
E1,	HLT		/ERROR,DOES NOT COMPARE
	TAD LOWM
	CIA
	TAD K4001
	SZA CLA
	JMP COMPAR+5	/RETURN TO CHECK MEMORY
	JMP COMPAR	/END OF TEST AREA GO TO SETUP
K0201,	0201
K4001,	4001
UPREG,	2525		/ERROR WORD 2525
LOREG,	5252		/ERROR WORD 5252
$
