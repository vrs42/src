	TAD I XK67X5A
	DCA K67X5B		/DUPLICATE IOT CODE 67X5
	TAD I XK67X6A
	DCA K67X6B		/DUPLICATE IOT CODE 67X6
	TAD I XK67X6A
	DCA K67X6C		/DUPLICATE IOT CODE 67X6
	TAD I XK67X7A
	DCA K67X7B		/DUPLICATE IOT CODE 67X7
	JMP I CHNDEV		/EXIT AND RUN PROGRAM.
