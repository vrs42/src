/
/		OD, ID, FIRST, AND LAST
/
/WHICH ARE VARIABLE BY THE USER ARE WITHIN SELECTABLE LIMITS
/
/ 0 <= OD <= 114
/
	TAD OD
	SMA CLA 
	JMP .+3
	TAD (52)
	DCA OD
	TAD (-114)
	TAD OD
	SMA SZA CLA
	JMP .-5
	PRINT
	MOD
	TY4OCT
	OD
