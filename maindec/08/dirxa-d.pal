	CIA
	TAD XXTAB
	SPA SNA
	JMP XTABD
	CIA
	DCA XXTAB
	ISZ XTAB
	TAD (240)
	TYPEIT
	ISZ XXTAB
	JMP .-3
	JMP THENEXIT
XXTAB,	0
