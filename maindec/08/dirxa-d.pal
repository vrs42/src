/ROUTINE TO CHECK IF ^S IS ACTIVE
/
CKSFLG,	0
	IAC			/AC=1
	CDF 10
	TAD C8SFLG		/GO GET FLAG (7777 IF SET)
	CDF 0
	SZA CLA 		/IS FLAG SET?
	JMP I CKSFLG		/NO - RETURN
	CIF 10			/CHANGE INSTR FIELD TO CONSOLE PACKAGE
