TY1ASC,	.
	IOF
	DCA A14
	CHEK22
	JMP PNTEXT
	JMS CKSFLG		/GO CHECK IF ^S IS ACTIVE
	TAD A14
	TLS
	CLA 
	TAD TTYBUSY
	SZA CLA 
