SKON=6000		/SKIP IF INTERRUPT ON AND TURN INTERRUPT OFF
SRQ=6003		/SKIP IF INTERRUPT REQUEST
GTF=6004		/GET INTERRUPT FLAGS
RTF=6005		/RESTORE INTERRUPT FLAGS AND TURN INTERRUPT ON
CAF=6007		/CLEAR ALL FLAGS, AC, LINK, AND ENABLE TTY INTERRUPT F.F.
SPF=6040		/SET PRINTER FLAG
KIE=6035		/ENABLE TTY INTERRUPT F.F., WHEN AC EQUALS A 1
BSW=7002		/SWAP BYTES IN AC

