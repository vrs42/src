#!/usr/bin/perl

# Compare PDF files, ignoring the embedded file creation date.

open(I1, $ARGV[0]) || die "$ARGV[0]: $!";
open(I2, $ARGV[1]) || die "$ARGV[1]: $!";
while ($i1 = <I1>) {
  die "$ARGV[1]: eof\n" unless ($i2 = <I2>);
  next if $i1 =~ /^\/CreationDate/ && $i2 =~ /^\/CreationDate/;
  die "$ARGV[0] and $ARGV[1] differ\n" unless $i1 eq $i2;
}
die "$ARGV[0]: eof\n" if <I2>;
exit 0;
