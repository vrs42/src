  27               /A TWELVE BIT INTEGER AND LEAVE RESULT IN EXP (LOC 44)
  28               
  29 005500  0000  FFIX,   0
  30 005501  7200          CLA
  31 005502  1044          TAD EXP         /FETCH EXPONENT
  32 005503  7540          SZA SMA         /IS NUMBER <1?
  33 005504  5307           JMP .+3        /NO-CONTINUE ON
  34 005505  7200  FTRPRT, CLA
  35 005506  5326          JMP FIXDNE+1    /YES-FIX IT TO ZERO
  36 005507  1330          TAD M13         /SET BINARY POINT AT 11
