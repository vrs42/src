8107               /
8108               / THIS ROUTINE INTERPRETS THE MARK SENSE CARDS ON A COLUMN
8109               /BY COLUMN BASIS. COL. 1 IS ONLY USED FOR A CTRL/C AND 
8110               /AND OTHER CONTROL MARKS AND
8111               /IS TRAPPED IN THE READ ROUTINE. COLS. 2-6 CONTAIN
8112               /KEYWORD BOXES IN THE UPPER 2 ROWS AND LINE NO. BOXES
8113               /IN THE LOWER 10 ROWS.  COLS 7 & 8 EACH HAVE 12 KEYWORD
8114               /BOXES. COLS 9-40 CONTAIN BOXES TO MARK INDIVIDUAL
8115               /CHARACTERS. RUBOUT AND CONTINUATION CHARS ARE TRAPPED IN
8116               /THE READ ROUTINE.
8117               /
8118 016600  7200  COL2,   CLA
8119 016601  3347          DCA KEYCNT
8120 016602  3354          DCA KEYERR
8121 016603  4757  COL26,  JMS I XXCRRE
8122 016604  5235          JMP COL26A      /IF BLANK, GO CHECK COL COUNT.
8123 016605  1760          TAD I XCRCHR    /GET THE CHAR.
8124 016606  0355          AND K6000       /ISOLATE THE KEYWORD BOX BITS.
8125 016607  4761          JMS I XDCBIN    /GET THE DECIMAL BIT POSITION(1 OR 2).
8126 016610  5220          JMP COL26B      /IF MORE THAN ONE BIT SET, GO HAN-
8127                                       /DLE THE ERROR.
8128 016611  7450          SNA             /WERE ANY BITS SET?
8129 016612  5223          JMP COL26C      /NO, GO CHECK FOR LINE NO.
8130 016613  1347          TAD KEYCNT      /YES, SET UP KEYWORD TABLE INDEX.
8131 016614  3347          DCA KEYCNT
8132 016615  1346          TAD KEYDSP      /HAD A KEYWORD BOX ALREADY BEEN SEEN?
8133 016616  7650          SNA CLA
8134 016617  5222          JMP COL26D      /NO.
8135 016620  2354  COL26B, ISZ KEYERR      /SET KEYWORD ERROR SWITCH.
8136 016621  7410          SKP             /GO CHECK FOR LINE NO.
8137 016622  2346  COL26D, ISZ KEYDSP      /SET KEYWORD SEEN SWITCH.
8138 016623  1760  COL26C, TAD I XCRCHR
8139 016624  0356          AND K1777       /IS A LINE NO. BOX MARKED?
8140 016625  7450          SNA
8141 016626  5235          JMP COL26A      /NO.
8142 016627  7106          CLL RTL         /YES, GET ITS BIT POSITION
8143 016630  4761          JMS I XDCBIN    /WITHIN ROWS 0 TO 9.
8144 016631  5340          JMP LNOERR      /MULTI-MARKS IN ROWS 0-9.
8145 016632  1353          TAD K17         /CONVERT TO INTERNAL CODE.
8146 016633  4762          JMS I XXCRPC    /PACK THE CHAR.
8147 016634  2345          ISZ LINFLG      /SET THE LINE NO. SEEN FLAG.
8148 016635  1346  COL26A, TAD KEYDSP      /HAS A KEYWORD BEEN SEEN?
8149 016636  7640          SZA CLA
8150 016637  5243          JMP COL26E      /YES.
8151 016640  7326          STL CLA RTL     /NO, ADD 2 TO KEYWORD TABLE INDEX.
8152 016641  1347          TAD KEYCNT
8153 016642  3347          DCA KEYCNT
8154 016643  1763  COL26E, TAD I XCLCNT    /IS THIS COL 6?
8155 016644  1352          TAD MK6
8156 016645  7640          SZA CLA
8157 016646  5203          JMP COL26       /NO.
8158 016647  4757  COL78,  JMS I XXCRRE    /YES, GET NEXT COL.
8159 016650  5266          JMP COL78B      /IF NO BIT SET,CHECK COL NO.
8160 016651  1760          TAD I XCRCHR    /GET THE CHAR.
8161 016652  4761          JMS I XDCBIN    /GET THE BIT POSITION(1 TO 12).
8162 016653  5263          JMP COL78A      /IF MORE THAN 1 BOX MARKED THEN
8163                                       /AN ERROR.
8164 016654  7450          SNA
8165 016655  5266          JMP COL78B
8166 016656  1347          TAD KEYCNT      /SET UP TABLE INDEX.
8167 016657  3347          DCA KEYCNT
8168 016660  1346          TAD KEYDSP      /HAS A KEYWORD BOX ALREADY
8169 016661  7650          SNA CLA         /BEEN MARKED?
8170 016662  5265          JMP COL78C      /NO.
8171 016663  2354  COL78A, ISZ KEYERR      /YES, SET ERROR SWITCH.
8172 016664  7410          SKP
8173 016665  2346  COL78C, ISZ KEYDSP      /SET KEYWORD SEEN SWITCH.
8174 016666  1346  COL78B, TAD KEYDSP      /HAS A KEYWORD BEEN SEEN?
8175 016667  7640          SZA CLA
8176 016670  5274          JMP COL78D      /YES, CHECK COL.
8177 016671  1351          TAD K14         /NO, ADD 12 TO INDEX.
8178 016672  1347          TAD KEYCNT
8179 016673  3347          DCA KEYCNT
8180 016674  1763  COL78D, TAD I XCLCNT    /IS THIS COL 8?
8181 016675  1350          TAD MK8
8182 016676  7640          SZA CLA
8183 016677  5247          JMP COL78       /NOT YET.
8184 016700  1345          TAD LINFLG      /YES, WAS THERE A LINE NO.
8185 016701  7640          SZA CLA
8186 016702  4762          JMS I XXCRPC    /YES, PACK A BLANK.
8187 016703  1354          TAD KEYERR      /WAS THERE A KEYWORD ERROR?
8188 016704  7640          SZA CLA
8189 016705  5335          JMP CLKYER      /YES.
8190 016706  1346          TAD KEYDSP      /NO.
8191 016707  7650          SNA CLA         /WAS ONE KEYWORD BOX CHECKED?
8192 016710  5313          JMP COL9        /NO.
8193 016711  1347          TAD KEYCNT      /YES.
8194 016712  4764          JMS I XMSGEN    /OUTPUT THE KEYWORD.
8195 016713  3344  COL9,   DCA BLANKS      /INITIALIZE BLANK COUNTER TO ZERO
