/	ARCTANGENT FUNCTION   VERSION ATAN.V05 (JANUARY 9,1969)
/
	ENTRY	ATAN
/
/	CONSTANTS AND COEFFICIENTS
/
II,	BLOCK	1
	CPAGE	3
SIGN,	BLOCK	1
SUM,	BLOCK	1
SUMM,	BLOCK	1
SUML,	BLOCK	1
TEM,	BLOCK	3
TEM1,	BLOCK	3
X,	BLOCK	3
	CPAGE	3
ONE,	2014		/1.000
	0000
	0000
	CPAGE	3
PI4,	2006		/PI/4
	2207
	7325
AVEC,	VEC
	CPAGE	30	/COEFFICIENT VECTOR
VEC,	2007		/.99999 93329
	7777
	7647
	5775		/-.33329 85605
	2523
	0336
	1766		/.19946 53599
	3040
	2454
	5764		/-.13908 53351
	3466
	1426
	1756		/.09642 00441
	1273
	7372
	5747		/-.05590 98861
	1200
	7036
	1735		/.02186 12288
	4613
	1216
	5714		/-.00405 40580
	1153
	7471
	CPAGE	4
ATER,	0124		/"ATAN" ERROR AT LOC XXXXX
	0116
ATAN,	BLOCK	2	/ENTRY POINT
	CLA
	DCA	SIGN	/SET SIGN SWITCH
	TAD I	ATAN	/CDF TO ARG
	DCA	L4
	INC	ATAN#
	TAD I	ATAN	/ADDRESS OF ARGUMENT
	DCA	L4#
	INC	ATAN#	/INDEX FOR EXIT
	CALL	1,FAD	/PLACE ARGUMENT IN FLOATING AC
L4,	ARG	0
	TAD	ACH	/HIGH ORDER AC
	SNA		/IS IT ZERO
	JMP	EXIT	/YES ... DONT BOTHER COMPUTING
	SMA CLA		/IS IT NEGATIVE
	JMP	L1	/NO ... OK
	TAD	ACH	/YES ... CHANGE ITS SIGN
	TAD	(4000
	DCA	ACH
	INC	SIGN	/SET SIGN SWITCH
L1,	CALL	1,SETERR
	ARG	ATER
	CALL	1,STO	/SAVE ARG
	ARG	X
	CALL	1,FAD
	ARG	X
	CALL	1,FAD
	ARG	ONE
	CALL	1,STO
	ARG	TEM1	/TEM1=X+1.0
	CALL	1,FAD
	ARG	X
	CALL	1,FSB
	ARG	ONE
	CALL	1,FDV	/(X-1)/(X+1)
	ARG	TEM1
	CALL	1,STO	/TEM=(X-1)/(X+1)
	ARG	TEM
	CALL	1,FAD
	ARG	TEM
	CALL	1,FMP
	ARG	TEM
	CALL	1,STO	/TEM1=((X-1)/(X+1))**2
	ARG	TEM1
	DCA	SUM	/ZERO SUM
	DCA	SUMM
	DCA	SUML
	TAD	(-10	/INITIALIZE COUNTER
	DCA	II
	TAD	AVEC	/PLACE COEFFICIENT VECTOR ADDRESS
	DCA	L2#	/IN MULTIPLY ROUTINE
/
/	SUMMATION LOOP
/
L3,	CALL	1,FAD	/((X-1)/(X+1)**2I+1
	ARG	TEM
	CALL	1,FMP	/MULTIPLY BY PROPER COEFFICIENT
L2,	ARG	VEC	/ADDRESS STORED HERE
	CALL	1,FAD	/ADD TO PARTIAL SUM
	ARG	SUM
	CALL	1,STO	/SAVE PARTIAL SUM
	ARG	SUM
	CALL	1,FAD
	ARG	TEM
	CALL	1,FMP
	ARG	TEM1
	CALL	1,STO	/INCREASE POWER OF TERM BY 2
	ARG	TEM
	TAD	L2#	/MOVE ADDRESS TO NEXT COEFFICIENT
	TAD	(3
	DCA	L2#
	ISZ	II	/OVER YET
	JMP	L3	/NO ... MORE
	CALL	1,FAD	/RESULTING SUM
	ARG	SUM
	CALL	1,FAD	/ADD PI/4
	ARG	PI4
	CALL	0,CLRERR
	TAD	SIGN	/SIGN SWITCH
	SNA CLA		/WAS ARG NEGATIVE
	JMP	EXIT	/NO ... OK
	TAD	ACH	/YES ... CHANGE SIGN OF RESULT
	TAD	(4000
	DCA	ACH
EXIT,	RETRN	ATAN	/EXIT WITH RESULT IN FLOATING AC
	END
