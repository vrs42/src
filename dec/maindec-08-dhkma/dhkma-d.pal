FSSET,	0
	CLA 
	DCA FCNT	/CLEAR FIELD COUNT
	3077
	TAD NOTTY
	SMA CLA 	/SKIP IF NO TTY AVAILABLE
	JMP .+10
	TAD HCW1
	SPA CLA 	/SKIP IF NO HARDWARE SWITCHES
	JMP .+5
	TAD PSR		/GET PSEUDO SWITCH REGISTER
	AND (37
	DCA ENDF	/SET UP LAST FIELD TO DO
	JMP .+15	/BYPASS SETUP
	C8CAL
	HLT
	GETSR		/GET NEW SWITCH VALUE
	AND (37		/ISOLATE FIELD MIN
	DCA ENDF	/SAVE THE STARTINNG FIELD
	GETSR		/GET NEW SWITCH VALUE
	BSW 
	AND (37
	DCA STARTF	/SAVE END FIELD LIMIT
	JMS SETPAR	/PRINT "SELECT TEST PARAMETER"
	C8CAL
	HLT
