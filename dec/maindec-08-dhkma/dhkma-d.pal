/
/KEYBOARD INTERRUPT OCCURRED
/
KBINT,	0
	TAD NOTTY	/GET THE TELETYPE FLAG
	SMA CLA 	/IS THERE A TELETYPE AVAILABLE
	JMP .+3		/YES, GO PRINT THE ERROR
	HLT		/NO, HLT - INTERRUPTED FROM THE KEYBOARD
	JMP KBINTC	/GO CLEAR FLAG AND CONTINUE
	JMS MES
	TEXT	"%#INT FROM KB"
KBINTC,	KCC
	STA
	DCA HEAD1
