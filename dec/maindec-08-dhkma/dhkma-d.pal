/APT/	THIS ROUTINE INITIALIZES PROGRAM FOR APT
/
APTIZ,	0
	IOF		/MAKE SURE INTERRUPT IS OFF
	TAD HCW2	/GET APT CONTROL WORD
	SMA CLA 	/SKIP IF APT ENABLED.
	JMP NOTAPT
	STA		/AC=-1
	DCA NOTTY	/NOP CONSOLE TERMINAL
	TAD (37		/SET UP FOR AUTO SIZE
