/
/
/
/
/THIS ROUTINE DETERMINES IF A VALID FIELD IS SELECTED.
/A VALID SELECTION RETURNS+2
/NON-VALID SELECTION RETURNS+1
/
NUFLD,	0
	TAD FLDCNT	/GET FIELD TO TEST
	AND SR911	/ISOLATE FIELD
	TAD (TFSTAB	/GET TO POINTER OF FIELD STATUS
	DCA TFS		/SAVE THE VALUE
	TAD I TFS	/GET ROUTINE TO EXECUTE
	DCA TFS		/AND SAVE IT
	JMS I TFS	/GO TEST FOR VALID FIELD SELECTION
	JMP I NUFLD	/NOT A VALID FIELD
	TAD EMMFLG
	SNA CLA 	/SKIP IF EXPANDED MODE ENABLED
	JMP NOEMM
	TAD FLDCNT
	RACB		/REARRANGE AC INTO PROPER FORMAT
SETFLD,	DCA TSTFLD
	JMS SAME	/PROFLD=TSTFLD
	SKP 
	ISZ NUFLD
	JMP I NUFLD	/GOT A VALID FIELD
/
NOEMM,	TAD FLDCNT
	AND SR911	/ISOLATE FIELD TO DO
	CLL RTL 
	RAL 		/MOVE INTO BITS 6-8
	JMP SETFLD	/GO TEST FOR FIELD SELECTION
/
TFS,	0
/
TFSTAB,	TFS0
	TFS1
	TFS2
	TFS3
	TFS4
	TFS5
	TFS6
	TFS7
/
