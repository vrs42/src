RDB2,	CDF 0		/TEST DF
	TAD [-100
	DCA P2		/READ AND TEST 2 PAGES
RDFLDB,	TAD [-4
	DCA W4		/READ AND TEST 4 WORDS
RDBC,	DCA CS		/NO COMPLEMENT
	JMS READ
	CIA
	TAD B
