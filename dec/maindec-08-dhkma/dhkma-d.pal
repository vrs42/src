C8ENTR,	0
	DCA C8TEMP	/SAVE AC
	RDF		/READ PROGRAM FIELD
	TAD C8CDI	/ADD CDI INSTRUCTION
	DCA C8CNTR	/SAVE SCI TO PROGRAM FIELD TEMPORARILY
	RIF		/READ CONSOLE FIELD
	TAD C8CDF	/ADD CDF INSTRUCTION
	DCA C8FLD	/SAVE CDF TO CONSOLE FIELD
	TAD I (HCW1	/GET HCW1 FROM PROGRAM FIELD
	SPA CLA 	/SKIP IF USING PSEUDO SWR
	SKP CLA OSR 	/GET HARDWARE SWR AND SKIP
	TAD I (PSR	/GET PSEUDO SWR
	DCA C8SWR	/SAVE SWITCH REGISTER
	TAD I (INMODE	/GET MESSAGE ACTIVE FLAG
	DCA C8MODE	/SAVE MESSAGE ACTIVE FLAG
C8FLD,	HLT		/MODIFIED CDF TO CONSOLE DATA FIELD
	TAD C8ENTR	/GET RETURN ADDRESS
	DCA C8RTN	/SAVE FOR EXIT
	TAD C8CNTR	/GET CDI TO PROGRAM FIELD
	DCA C8PFLD	/SAVE CDI TO PROGRAM FIELD FOR EXIT
