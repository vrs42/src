	TAD I T2	/"ADD" IS FULL.
	AND P77
	TAD M77
	SZA CLA		/TEST FOR EXTEND
	JMP RUB4
RUB3,	CMA		/SET SWITCH
	DCA XCTIN
	CMA		/BACKUP POINTER
	TAD AXIN
	DCA AXIN
	TAD I T2	/RESET ADD
	AND P7700
RUB4,	DCA ADD
	JMP I RUB5
RUB5,	PACX
RUB2,	TAD I T2	/CHECK FOR EXTENDED
	AND P7700
	TAD C100
	SZA CLA
	JMP RUB3
	DCA I T2	/SAVE CORRECTION
	JMP RUB3+1
