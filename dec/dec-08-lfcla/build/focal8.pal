	SZA 
	DCA I AXIN
	TAD AXIN	/COMPUTE NEW END OF BUFFER
	IAC
	DCA BUFR
	TAD STARTV	/RESET VARIABLE LIST	/*8K*
	DCA LASTV			/*8K*
	JMP I XENDLN	/--RETURN--
/---------------------------------------------------------------------



TLIST3=.	/LITERAL TERMINATORS
	TASK4	/"
	PC1	/C.R. = AUTOMATIC QUOTE MATCH


INFIX=.		/DATA CONTROL CHARACTERS
