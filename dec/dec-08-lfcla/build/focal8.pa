	JMS PCK1
	JMP PA1
PCK1,	0
	ISZ XCTIN	/=0 TO START
	JMP ROT
	TAD ADD
	DCA I AXIN			/*8K*
	DCA ADD		/CLEAR PACKING WORD	/*8K*
	TAD PDLXR	/CHECK FOR OVERFLOW	/*8K*
	CMA IAC CLL			/*8K*
	TAD P13		/RESERVATIONS FOR PUSH-DOWN LIST/*8K*
