/0$		PAPER TAPE I/O TO/FROM OS/8 FILES
	/E	DON'T PUNCH EOT
	/H	SET HIGH BIT=N
	/L	LOW SPEED
	/P	PUNCH PATCH
	/Z	REL BLOCK=0
	=N	REL BLOCK TO PATCH
  NO OUT FILE IS READ

FILE</1$	EDIT 'FILE'
	C	CURRENT STATUS
	E	EXIT TO CD
	O,N	OPEN BLOCK N
	R,N	READ BLOCK N
	S,N,M	SEARCH FOR N WITH MASK M
	W	WRITE

FILE1<FILE2/2$	COMPARE FILE AND FILE2
	/A	ABORT
	/B	BAD BLOCKS ONLY
