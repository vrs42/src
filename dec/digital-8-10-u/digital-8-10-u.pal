
/BINARY-CODED-DECIMAL TO BINARY CONVERSION SUBROUTINE
*263

BCDBIN,	0
	DCA TEMPH		/STORE INPUT
	TAD TEMPH
	AND LDIGIT
	CLL RTR
	DCA COUNT
	TAD COUNT
	RAR
	TAD COUNT
	CMA IAC
	TAD TEMPH		/160 H + 16 M + L
	DCA TEMPH
	TAD TEMPH
	AND MDIGIT
	CLL RTR
	DCA COUNT
	TAD COUNT
	RAR
	TAD COUNT		/60 H + 6 M
	CMA IAC
	TAD TEMPH
	JMP I BCDBIN	/EXIT
LDIGIT,	7400
MDIGIT,	7760
COUNT,	0
TEMPH,	0

$
*U*-