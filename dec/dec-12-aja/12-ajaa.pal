FNTABF=.
	XABS	/ABS	-ABSOLUTE VALUE
	XSGN	/SGN	-SIGN PART
	XINT	/INT	-INTEGER PART
	XDISP	/DIS	/********
	XRAN	/RAN	-RANDOM NUMBER
	XADC	/ADC	-READ ANALOG TO DIGITAL CONVERTER
	ARTN	/ATN	-ARCTANGENT
	FEXP	/EXP	-EXPONENTIAL
	FLOG	/LOG	-LOGARITHM
	FSIN	/SIN	-TRIG FUNCTIONS
	FCOS	/COS	-
	XSQRT	/SQT	-SQUARE ROOT
