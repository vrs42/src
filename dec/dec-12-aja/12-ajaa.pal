	FGET I PT1
	FEXT
	TAD T3		/TEST DECIMAL EXPONENT
	SNA 
	JMP I FLINTP	/FINISHED
	SMA CLA 
	JMP FIG04
	FINT		/. IS TO THE LEFT
	FMUL PTEN	/TIMES .1000
	FPUT I PT1
	FEXT
	IAC
	JMP .+6
