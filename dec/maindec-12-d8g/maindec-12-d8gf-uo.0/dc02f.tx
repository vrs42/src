*20
	12-D8FB
	 
	DC02-F OPTION TEST
	 
	ST PROC
	 
	8 MODE
	I-O PRES
	ST LSW
	 
	TST 1
	LSW = 0200
	RSW = 00XX
	1) RSW 06 = 0 CTRL TST
	2) RSW 06 = 1 CTRL TST AN M850 DATA TST
	3) RSW 07-11 NUM DC02-G > 1
	 
	TST 2
	LSW = 2000
	RSW = 00XX
	1) RSW 7-11 = NUM DC02G LNS TSTED
	 
	TST 3
	LSW = 3000
	RSW = XXXX
	 1) RSW 00 = 1 TST STN 0
	    RSW 01 = 1 TST STN 1
	 2) RSW 10-11 GRP NUM > 0
	 
	TST 4
	LSW = 4000
	RSW = XXXX
	 1) LSW 00 = 1 TST STN 0
	    LSW 01 = 1 TST STN 1
	 2) RSW 10-11 1
