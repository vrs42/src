*20
	12-D2AA
	 
	VT06 (DATA POINT 3300)
	 
	ST ADD
	0200=CHAR OUT ROUT
	0201=OCTAL CONV ROUT
	0202=ECHO ROUT VT06 KYBD TO SCREEN AND PTR
	0203=ECHO ROUT FROM KYBD TO PTR AND SCREEN
	0204=FOCUS ADJ
	0205=OUT 1 CHAR
	0206=MARGAIN OUT
	0207=ECHO ROUT USING DCO2 INT
	0210=OCTAL CONV USING DC02 INT
	 
	SW SET
	SR00=1 INH DELAY
	SR01=1 LOOP CUR TST
	SR02=0 USE ONLY ONE DCO2 LINE
	SR09-11=LINE NUMBER IF TESTED VIA A DC02
	 
	8-MODE
	SEL SW SET
	I-O PRESET
	ST LOC 200 NORMALLY
