*20
	08-D4DA-D
	 
	INCREMENTAL TAPE DATA RELIABILITY TEST
	 
	ST ADD
	LOC 200 TO SPECIFY TYPE OF TAPE DRIVES UNDER TEST AND TO SELECT THE TESTS
	 
	SW SET
	SR0  = 1 PRINT ACCUMULATED ERRORS ONLY (AT COMPLETION OF TEST CYCLE)
	SR0  = 0 PRINT ERRORS AS THEY OCCURE
	SR1  = 1 INHIBIT ALL PRINTOUT
	SR1  = 0 RESUME PRINTOUT
	SR11 = 1 AT COMPLETION OF CURRENT OPERATION RETURN TO TEST SELECTION ROUTINE
	SR11 = 0 RUN NORMAL TEST SEQUENCE CYCLE TESTS AS SELECTED
