  64 005537  1331          TAD C13         /11(10) INTO EXPONENT
  65 005540  3044          DCA EXP
  66 005541  4743          JMS I FNORL     /NORMALIZE
  67 005542  5733          JMP I FFLOAT    /RETURN
  68 005543  7265  FNORL,  FFNOR           /LINK TO NORMALIZE ROUTINE
  69               *5000
