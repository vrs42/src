 152               /ROUTINE TO SEPERATE THE INTEGER AND FRACTIONAL PARTS OF FAC
 153               /ORIGINAL FAC IS SAVED IN TEMP1,THE INTEGER PORTION OF FAC IS
 154               /SAVED AT NUM,AND THE FRACTIONAL FORTION OF THE FAC IS LEFT IN THE FAC
 155               
 156 005106  0000  FRACT,  0
 157 005107  4663          JMS I FPUTL     /SAVE X
 158 005110  5075            TEMP1
 159 005111  4671          JMS I FIXL      /INTEGER PORTION OF X
 160 005112  1044          TAD EXP
 161 005113  3330          DCA NUM         /SAVE FIXED FORTION OF X
 162 005114  4672          JMS I FLOATL    /FAC=FLOAT(FIX(X))
 163 005115  4665          JMS I FSUB1L    /FAC=X-INT(X)=FRACTION (X)
 164 005116  5075            TEMP1
 165 005117  5706          JMP I FRACT     /RETURN
