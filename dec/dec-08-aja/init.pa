/	INITIAL DIALOGUE FOR FOCAL, 1969

/	OPTIONAL INITIAL DIALOGUE TO BE LOADED OVER FOCAL, 1969 BEFORE STARTUP.

/	USED TO CUSTOMIZE TRIGONOMETRIC FUNCTIONS RETAINED IN MEMORY.

/	DISASSEMBLED FROM THE FOCAL, 1969 SECOND BINARY SECTION (INIT) IN THE STANDARD
/	BINARY PAPER-TAPE RELEASE: DEC-08-AJAE-PB FOCAL, 1969 + INIT 09-JUL-1969 BY
/	CHARLES LASNER P?S NY.

/	LAST EDIT:	03-JUN-2015	CJL.

/	EQUATED SYMBOLS FROM FOCAL, 1969.

	BUFBEG=	3217			/START OF AVAILABLE TEXT BUFFER
	BUFR=	0060			/BUFFER POINTER [LAST LOCATION OF TEXT]
	FRST=	3206			/FIRST [PERMANENT] TEXT LINE HERE
	LASTV=	0031			/TOP OF VARIABLES POINTER [FOR TEXT]
	SPARROW=" -200^100+37		/<SP><LEFT-ARROW> OUTPUT FOR CERTAIN TERMINALS

/	ASSEMBLY INSTRUCTIONS.

/	MUST BE ASSEMBLED WITHOUT /J (PAL8 /F) SET (TEXT CAN GENERATE 0000 FILL WORD).

/	TOPS-10 PAL10 (THE ORIGINAL FOCAL DEVELOPMENT UTILITY) CAN ASSEMBLE THIS
/	FILE; PAL10 DOES NOT SUPPORT THE FEATURE OF DISABLING THE TEXT 0000 FILL.

	FIELD	0			/ENSURE FIELD 0 LOADING

	*LASTV				/OVER TEXT POINTER

	ENDTXT				/FIRST FREE LOCATION

	*BUFR				/OVER BUFFER POINTER

	ENDTXT				/FIRST FREE LOCATION

	*FRST				/OVER FIRST TEXT LINE'S TEXT POINTER

	BUFBEG				/POINT TO ADDED INITIAL DIALOGUE TEXT

	*BUFBEG				/INITIAL DIALOGUE STATEMENTS LOAD HERE

/	INTERNAL FORMAT OF FOCAL STATEMENTS.

/	WORD [0]	POINTER TO NEXT LINE (0000 IF LAST LINE).

/	WORD [1]	BITS[0-4] GROUP NUMBER, BITS[5-11] RELATIVE LINE NUMBER.

/	WORD [2-LAST]	STATEMENT TEXT.  CHARACTERS ARE STORED IN SIXBIT BYTE FORMAT
/			PACKED TWO PER 12-BIT WORD; LINE IS TERMINATED BY <CR> STORED
/			AS 7715.  NOTE: CONTROL CHARACTERS ARE STORED AS 77XX WHERE XX
/			IS THE CONTROL CHARACTER CODE; ? (CODE 77) IS NOT ALLOWED.
/	INITIAL DIALOGUE FOCAL STATEMENTS.

	LN0110=	.			/BEGINNING OF LINE 01.10

	LN0120				/POINTER TO NEXT LINE

	DECIMAL				/MAKE IT EASIER

	01^128+10			/LINE 01.10

	OCTAL				/BACK TO NORMAL

	TEXT	\T !"CONGRATULATIONS!!"\

	*.-1				/OVER AUTOMATICALLY GENERATED TEXT TERMINATOR

	"?^100+"M-300			/<CR>

	LN0120=	.			/BEGINNING OF LINE 01.20

	LN0125				/POINTER TO NEXT LINE

	DECIMAL				/MAKE IT EASIER

	01^128+20			/LINE 01.20

	OCTAL				/BACK TO NORMAL
	TEXT	\T  !"YOU HAVE SUCCESSFULLY LOADED 'FOCAL,1969' ON A \

