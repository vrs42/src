   4               /*******************************************************************************
   5               /ASSEMBLY INSTRUCTIONS:
   6               /1. IF ASSEMBLING 2K VERSION, INSERT THE FOLLOWING: TWOK=0
   7               /2. IF ASSEMBLING THE FIRST 1K SEGMENT, INSERT THE FOLLOWING: ONEKP1=0
   8               /3. IF ASSEMBLING THE SECOND 1K SEGMENT, INSERT THE FOLLOWING: ONEKP2=0
   9               / ONE AND ONLY ONE OF THE ABOVE THREE DEFINIYIONS MUST 8E INSERTED IN
  10               / THIS SOURCE BEFORE ANY OTHER ASSEMBLY CODE.
  11               /4. IF ASSEMBLING ANY OF THE ABOVE 3 VERSIONS FOR USE ON THE ACT-8/A LINE,
  12               / INSERT ONE OF THE ABOVE DEFINITIONS ANO THE FOLLOWING: ACT8A=0
  13               /5. IF ASSEMBLING THE ACT-8/E VERSION, DEFINE ACT8E=0 ANO ACT8A=0,
  14               / THE ACT-8/E VERSION MUST BE A 2K VERSION, 1K VERSIONS AHE NOT
  15               / SUPPORTED ON THE ACT-8/E LINE.
  16               /*******************************************************************************
  17               
  18               TWOK=0
  19               /INSTRUCTION EQUALITIES
  20               
  21               HLT=7402        /HALT
  22               BSW=7002        /BYTE SWAP
  23               MUL=7421        /AC TO MQ, 0 TO AC
  24               MQA=750l        /MQ + AC TO AC
  25               CAM=7621        /CLEAR AC ANO MQ
  26               SWP=7521        /SWAP AC AND MQ
  27               AOL=7701        /MQ TO AC
  28               RDF=6214        /READ DATA FIELD
  29               RIF=6224        /READ INSTRUCTION FIELD
  30               SKON=6000       /SKIP IF INTERRUPT ON, TURN INTERRUPT OFF
  31               ION=6001        /TURN INTERRUPT ON
  32               I0F=6002        /TURN INTERRUPT OFF
  33               SRQ=6003        /SKIP ON INTERRUPT REQUEST
  34               GTF=6004        /GET FLAGS
  35               RTF=6005        /RESTORE FLAGS
  36               SGT=6006        /SKIP ON "GREATER THAN" FLAG.NOTE: THE "GT" FLAG
  37                               /IS NOT IMPLEMENTED IN THE PDP-8/A
  38               CAF=6007        /CLEAR ALL FLAGS, AND CLEAR AC AND LINK
  39               SPL=6102        /SKIP ON POWER LOW
  40               
  41               /*******************************************************************************
  42               
  43               /XOR INSTRUCTIONS
  44               XRON=6170       /TURN XOR ON
  45               SKXR=6171       /SKIP ON XOR ERROR 1
  46               XRC1=6172       /TURN OFF XOR INTERRUPT
  47               STIP=6173       /SKIP IF MUT ON AND FIRST XMON DONE
  48               XRS1=6174       /SET XOR INTERRUPT ENABLE
  49               SXRC=6175       /SKIP ON XOR ERROR 2
  50               XRTO=6176       /SET TIME OUT FLOP
