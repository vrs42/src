/	4-WORD OVERLAY FOR FOCAL, 1969

/	4-WORD FLOATING POINT PACKAGE OVERLAY FOR FOCAL, 1969

/	FROM DEC-08-AJ1E-PB.BIN

/	HISTORY:

/	AT ONE POINT, THE AUTHENTIC SOURCE CODE WAS AVAILABLE FROM CHARLES LASNER,
/	WHO MODIFIED IT INTO THE P?S/8 FOCAL AUTOMATED PATCH, WHICH IMPLEMENTS THE
/	SAME FOCAL MODIFICATIONS VIA THE MECHANISM DEMANDED BY P?S/8 FOCAL.

/	THIS IS THE RECONSTRUCTION OF THE ORIGINAL FILE FROM THE P?S/8 FOCAL VERSION.

/	LAST EDIT:	11-OCT-2026 00:00:00	VRS

/	FIXED "*PIOT+2", WAS "*PIOT".

/	LAST EDIT:	16-SEP-2017 00:00:00	CJL

/	MAY BE ASSEMBLED WITH '/J' (PAL8 '/F') SWITCH SET.

/	MODIFICATIONS TO FOCAL, 1969 TO USE 4-WORD ACCURATE FLOATING POINT.

/	MUST BE LOADED BEFORE OTHER BINARY PATCHES TO FOCAL (OTHER THAN THE 8K PATCH).

/	IT IS RECOMMENDED THAT THE 8K OVERLAY (IF USED) BE LOADED FIRST.
/	DEFINITIONS FROM FOCAL, 1969 (ORIGINAL PAPER-TAPE VERSION).

	AC1H=	0041			/HIGH-ORDER OPERAND
	AC1L=	0042			/LOW-ORDER OPERAND
	DATUM=	7102			/DATA AREA IN FPP
	DCOUNT=	6143			/OUTPUT DIGIT COUNTER
	DMDONE=	7063			/MULTIPLE PRECISION MULTIPLY ADDRESS
	DMULT4=	7036			/MULTIPLE PRECISION MULTIPLY ADDRESS
	DNORM=	7335			/NORMALIZE ROUTINE
	DV3=	7267			/DIVIDE ROUTINE ADDRESS
	FISW=	0052			/FLOATING POINT FORMAT SWITCH
	FPNT=	6400			/FLOATING POINT INTERPRETER
	FRST=	3206			/FIRST (DUMMY) LINE ADDESS
	GINC=	0070			/VARIABLE UPDATE FACTOR
	HORD=	0045			/HIGH-ORDER FLAC
	LORD=	0046			/LOW-ORDER FLAC
	MD=	5526			/-(DIGITS) STORED HERE
	MFLT=	0117			/FLOATING LENGTH FACTOR
	MIF=	7260			/DIVIDE SHIFT COUNTER
	MP1=	7254			/QUOTIENT WORD
	MP2=	7256			/MULTIPLICAND WORD
	MP4=	7200			/MULTIPLY ROUTINE
	MP5=	7253			/QUOTIENT WORD
	MULDIV=	7101			/COMMON MULTIPLY/DIVIDE ROUTINE
	OVER1=	0043			/EXTRA OPERAND WORD
	OVER2=	0047			/EXTRA FLAC WORD
	PI=	5312			/PI CONSTANT FOR SINE ROUTINE
	PIOT=	5316			/PI/2 CONSTANT FOR SINE ROUTINE
	PTEN=	6275			/CONSTANT .1000000000
	RND2=	5527			/(DIGITS+1) STORED HERE
	TEST2=	6736			/ALIGNMENT CONSTANT HERE
	TWOPI=	5306			/PI*2 CONSTANT FOR SINE ROUTINE
	ZERO=	6520			/INTERPRETIVE POWER ADDRESS

/	MISCELLANEOUS DEFINITIONS.

	DIGITS=	12			/10 DIGIT VERSION
	WORDS=	4			/FOUR WORD VERSION
/	DIRECT PATCHES TO 4K OR 8K FOCAL.

	FIELD	0			/ENSURE FIELD ZERO

	*FISW				/OVER FORMAT SWITCH

FISW,	0				/USE FLOATING OUTPUT FORMAT BY DEFAULT

	*GINC				/OVER VARIABLE INCREMENT

GINC,	WORDS+2				/WE USE LONGER VARIABLES

	*MFLT				/OVER FLOATING LENGTH FACTOR

MFLT,	-WORDS				/INDICATE -(FOUR) WORDS

/	FOUR-WORD (4K) DUMMY LINE TEXT.

	*FRST+2				/OVER EXISTING DUMMY LINE

	TEXT	"C-4WORD"

/	FOUR-WORD TRIG COMPONENTS FOR MORE ACCURACY.

	*TWOPI+2			/OVER TWO PI CONSTANT

	3755				/FOUR-WORD CONSTANT VALUE

	*PI+2				/OVER PI CONSTANT

	3755				/FOUR-WORD CONSTANT VALUE

	*PIOT+2				/OVER PI/2 CONSTANT

	3755				/FOUR-WORD CONSTANT VALUE

/	CHANGE DIGITS-ORIENTED CONSTANTS.

	*MD				/OVER -(DIGITS)

MD,	-DIGITS				/SET NEW AMOUNT
RND2,	DIGITS+1			/SET NEW ROUNDING CONSTANT

	*DCOUNT				/OVER OUTPUT DIGIT COUNT

	-DIGITS-1			/USE 10 DIGIT VALUE

/	CORRECT FLOATING CONSTANT.

	*PTEN+2				/OVER CONSTANT .100000000

	3146				/USE FOUR WORD VALUE
/	CHANGES TO THE FLOATING POINT PACKAGE (FPP).

	*FPNT+2				/OVER DCA OVER2

	SKP				/DON'T CLEAR OVERFLOW WORDS

	*ZERO+20			/OVER DCA OVER1

	NOP				/DON'T CLEAR OVERFLOW WORD

	*TEST2				/OVER 0027

TEST2,	0043				/USE FOUR WORD CONSTANT INSTEAD

	*DMULT4				/OVER JMP DMDONE

DMULT4,	DCA	DATUM-5			/STORE RESULT WORD

	*DMDONE+7			/OVER DCA OVER2

	NOP				/DON'T CLEAR OVERFLOW WORD

	*MULDIV+4			/OVER ISZ OVER2

	NOP				/DON'T ROUND IN FOUR-WORD VERSION

	*MIF				/OVER DIVIDE SHIFT COUNTER

MIF,	-43				/USE FOUR WORD SHIFT VALUE
	*DV3+2				/OVER DIVIDE ROUTINE

	TAD	OVER1			/GET THE
	TAD	OVER2			/OVERFLOW WORDS
	DCA	MP5			/SAVE RESULT
	RAL				/GET CARRY
	TAD	AC1L			/ADD ON LOW-ORDER
	TAD	LORD			/WORDS
	DCA	MP2			/SAVE RESULT
	RAL				/GET CARRY
	TAD	HORD			/ADD ON HIGH-ORDER
	TAD	AC1H			/WORDS
	SNL				/CARRY?
	JMP	.+6			/NO
	DCA	HORD			/YES, UPDATE THE FLAC
	TAD	MP5			/GET OVERFLOW
	DCA	OVER2			/UPDATE IT
	TAD	MP2			/GET LOW-ORDER
	DCA	LORD			/UPDATE IT
	CLA				/CLEAN UP
	TAD	MP1			/GET QUOTIENT
	RAL				/MOVE UP
	DCA	MP1			/STORE BACK
	TAD	MP4			/GET NEXT
	RAL				/MOVE UP
	DCA	MP4			/STORE BACK
	TAD	DNORM			/GET LOWEST

	$				/THAT'S ALL FOLK!
