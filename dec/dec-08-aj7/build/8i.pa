/PATCH TO FOCAL-8 FOR USE ON:
/	PDP-8/I
/	PDP-8/L
/	PDP-8/S
/	PDP-8

/ASSEMBLY INSTRUCTIONS:
/.R PAL8 OR .R PAL10
/*8I,8I_8I


XINT=1160
P177=106
C200=123
EXIT=2646
SIN=2662
MBREAK=2602
RECOVR=2740
INBUF=34
ERROR2=4566
XI33=2666
XOUTL=2676
XDYS=1142
WTEST2=654


/PATCH TO WRITE COMMAND HANDLER
/TO INSERT 2 NULL CHARACTERS AFTER EACH
/CARRIAGE RETURN

*652
	JMP I .+1
	XDYS
	XDYS+5
*670
	JMP I WTEST2+1

/PATCH TO INTERRUPT PROCESOR

*2627
	KRB		/READ BUFFER AND CLEAR FLAG
	AND P177	/IGNORE CHANNEL 8
	SNA		/BLANK?
	JMP EXIT	/YES
	TAD C200
	DCA SIN
	TAD SIN
	TAD MBREAK	/CTRL/C?
	SNA CLA
	JMP I RECOVR	/YES
	TAD INBUF	/ROOM IN BUFFER?
	SZA CLA
	ERROR2		/NO-WAIT FOR OUTPUT BUFFER
	TAD SIN
	DCA INBUF

*2673
	DCA INBUF
	TAD XOUTL
	JMP I XI33	/--RETURN--
*2414
I33,	0		/NO INTERRUPT INPUT ROUTINE
	KSF
	JMP .-1
	KRB
	AND P177
	SNA		/BLANK?
	JMP .-5		/YES--FETCH ANOTHER
	TAD C200
	JMP I I33	/--RETURN--

*2741
	NOP

$

