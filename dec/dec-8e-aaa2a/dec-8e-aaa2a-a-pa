	CLA			/L=1 FOR B. 0 FOR A
	TAD I AXPNTR		/GET D1: DX(8),YS(4)
	SNA
	JMP I SDISS		/EOL IF D1=0
	DCA ARITH2
	TAD ARITH2
	AND K0017A		/HAVE Y SCALE ARITH0TOR
	DCA I YS
