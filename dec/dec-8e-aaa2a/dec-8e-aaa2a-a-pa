KC7746,	7746

CALEND,	ISZ NSWPS		/DONE WITH SWEEPS?- PUT NOP (7000) HERE TO NEVER END
	JMP I SWSTAX		/NO - GET NEXT SWEEP
	CLA CMA			/PUT NOP HERE TO LEAVE BUFFER RUNNING
	CLZE
	TAD K0277		/TYPE ">"
	DCA KBDBUF
	DCA VSW			/SET VIEW MODE TO "AVERAGES"
	JMP I .+1
	SWSTAR-2

