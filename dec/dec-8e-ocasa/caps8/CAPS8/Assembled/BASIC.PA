	JMP	FALT	/YES-RETN TO EDIT MODE
	TAD	[36	/NO-IS IT BACKARROW?
	SZA
	JMP	DQUOTE	/NO-SEE IF DOUBLE QUOTE
	CMA		/YES-DELETE LAST CHAR.
	TAD	CCNTR	/BUT DON'T GO BACK PAST BUFF. STRT.
	SPA
	CLA		/CCNTR CAN'T BE LESS THAN 0
	JMP	FIL1
DQUOTE,	TAD	[75	/IS IT DOUBLE QUOTE(242)?
	SNA
	JMP	NAMCHK	/YES-TREAT AS CAR. RETN.
	TAD	(122-75	/NO-IS IS CARRETN?
	SNA
	JMP	NAMCHK	/YES-CHECK NAME VALIDITY
	TAD	[7715
	AND	(140
	SZA		/PRINTING CHAR?
	TAD	P7640
	SZA	CLA	
