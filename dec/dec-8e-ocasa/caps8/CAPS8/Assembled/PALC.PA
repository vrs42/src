/TEST NUMERIC ROUTINE
/CALL WITH CHARACTER TO TEST IN "CHAR"
/SKIPS IF THE CHARACTER IS NOT NUMERIC

TSTNUM,	0
	TAD CHAR	/GET THE CHARACTER
	TAD [-"0
	SPA		/SKIPS IF >= 0
	JMP TSTNU1	/NOT A NUMBER
	TAD ("0-"9
	SMA SZA CLA	/SKIPS IF <=9
TSTNU1,	ISZ TSTNUM	/2ND EXIT - NOT A NUMBER
	CLA
