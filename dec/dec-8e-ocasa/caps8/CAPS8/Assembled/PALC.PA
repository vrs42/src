	JMP .+3		/NO
	TAD (-140	/YES - ARE BIT 5 AND 6 SET?
	SNA CLA
	ISZ TEXT1	/YES - NON-PRINTING CHARACTER
	JMP I TEXT1	/--RETURN--

/SKIP ON PRINTING CHARACTER
TEXT1A,	0
