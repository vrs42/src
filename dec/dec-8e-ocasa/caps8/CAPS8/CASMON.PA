QUTIL,	CLA
	JMS BACK
	JMP INERR
	JMS PATCH1
HZERO,	CALL (CLOSE
	JMP OUTERR
	JMP MON
GETUNIT,0
	TAD I LNPTR
	TAD M70
	CLL
	TAD L10
	SNL
	JMP DEF
	INCR LNPTR
	SKP
DEF,	CLA
	TAD (60
