	LV
	TAD WCDF
	DCA BFIELD
	TAD WCDF
	DCA BFLD
	TAD RWO
	DCA RW
	INCR HANDLER	/POINT TO GOOD RETURN
	STA CLL RTL	/TAD (-3
	DCA ERKNT
	JMS SETUP	/SET UP READ OR WRITE
LV,	HLT
	ION
	EXIT HANDLER
RW,	0		/1 IF WRITE
ERKNT,	-3

RWO,
SETUP,	0
	TAD RW
	TAD (WRITEX
	DCA CRET	/SET RETURN ADDRESS
	TAD BUFFER
	DCA BPTR
	TAD I (BSIZE
	CMA		/WANT TO READ ONE MORE
	TAD RW
	DCA BKNT
	TAD RW
	CLL RTL
	RTL		/WRITE FN CODE=20
	TAD (201	/SELECT AND INTERRUPT ENABLE
	JMS LOADA
WCDF,	HLT
	TAD RW
	SZA CLA
	TAD I BPTR
	JMS GO
	JMP I	SETUP	/BE CAREFUL ABOUT DATA FIELDS

/HANDLER IS ALL SCREWED UP IF YOU MAKE TWO SUCCESSIVE
/CALLS TO IT WITH NO WAIT IN BETWEEN AND THE FIRST
/CALL GETS AN ERROR.
/NAMELY LOCATIONS  RWO  BUFFER  AND WCDF
/ARE IMPROPERLY SET UP.
/UNFORTUNATELY, THERE'S NO ROOM ON THIS PAGE...
/OR ANY OTHER PAGE FOR THAT MATTER.

READX,	JMS CHK
	AND (374
	SZA
	JMP ERRX
IOT6C,	KGOA		/GET CHAR JUST READ
	ISZ BKNT
	SKP
	JMP RWCRC
BFLD,	HLT
	DCA I BPTR
