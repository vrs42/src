	SINCH
	JMP ERET	/CASSETTE NOT READY
	CALL (WAIT
	JMP ERET	/ERROR WHILE WRITING
	TAD (200
	DCA I (BSIZE
	INCR ENTER
ERET,	HLT
	EXIT ENTER

RDOR,	0
	AND (374
	TAD MM200
	SZA CLA 		/WAS ERROR JUST CRC?
	EXIT BACK	/NO
	EXIT RDOR	/YES, OK CONTINUE

BAKFIX,	CALL (UTIL
	BACKFIL		/GO BACK TO FILE GAP
	EXIT BACK
	CALL (WAIT
	EXIT BACK
	CALL (UTIL
	BACKBLOCK	/BACK TO LAST RECORD
