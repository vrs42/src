	JMP CRET+1

WRITEX,	JMP READX
	JMS CHK
	SZA
	JMP ERRR	/ERROR WHILE WRITING
	ISZ BKNT
	SKP
	JMP WCRC
BFIELD,	HLT
	INCR BPTR
L70,	70
	TAD I BPTR
	JMS GO
	JMP CRET+1


WCRC,	TAD L261
	JMS LOADA
	JMP CRCMN
			/0 MEANS BYTE MODE (CHAR MODE)
BKNT,	0		/NUMBER OF CHARS EXPECTED
BPTR,	0		/NEXT LOCATION IN BUFFER TO STORE INTO
BUFFER,	0
DMON,	115;117;116;124;117;122;102;111;116	/ MONTOR.BIN
