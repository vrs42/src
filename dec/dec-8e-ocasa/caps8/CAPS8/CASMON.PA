	DCA LDRFLG
	PCE		/CLEAR INTERRUPT ENABLE FOR RDR PUNCH
	RCF		/INITIATE I/O
	TAD (RBUFR
	DCA RPTR
	TAD (-202
	DCA RKNT
RLOOP,	RSF
	JMP .-1
	RCC		/FETCH CHAR READ AND READ NEXT CHAR
	DCA I RPTR
	TAD I RPTR
	AND (200
	SNA CLA
	TAD I RPTR
	TAD TSUM
	DCA TSUM
	TAD I RPTR
	TAD (-200
	SNA CLA
	JMS I (LDR		/ON LEADER
	DCA LDRFLG
	INCR RPTR
	ISZ RKNT
	JMP RLOOP
	JMS I (SEND
	TAD (RBUFR
	DCA RPTR
	TAD (-200
	DCA RKNT
	TAD I (RBUFR+200
	DCA I RPTR
	INCR RPTR
	TAD I (RBUFR+201
	DCA I RPTR
	INCR RPTR
	JMP RLOOP

