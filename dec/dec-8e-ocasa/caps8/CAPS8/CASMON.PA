	INCR P1
	INCR P2
	ISZ SCNT
	JMP SLOOP
	INCR LOOKUP	/SKIP NOT FOUND RETURN
NFNDRET,INCR LOOKUP	/SKIP ERROR RETURN
ERRIT,	CLA
	TAD Q200
	DCA I (BSIZE	/BE NICE TO USER
LRET,	HLT		/RETURN TO USER'S FIELD
	EXIT LOOKUP	/BYE-BYE

PNAME,	0		/POINTER TO USER'S NAME

/END OF CASSETTE IS SIGNALLED BY SENTINEL ONLY.


P1,	0
P2,	0
SCNT,	0
