L261,	261
	JMP CRET+1	/CRET ALREADY SET UP

RWCRC,	CLA
	TAD L261	/ENABLE, ENABLE INTER, READ CRC
	JMS LOADA
	JMS GO
	JMS CRET
	JMS CHK
CRCMN,	JMS GO
	JMS CRET
	JMS CHECKB
	AND (7775	/IGNORE WLO
	TAD (-1
ERRX,	SNA CLA		/ERRORS?
