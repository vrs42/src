WAIT,	TB
	RDF
	TAD (CIF CDF
	DCA WAITEND
CWAIT,	TAD CINUSE
	SNA
	JMP WLV		/ZERO MEANS READY
	SMA CLA
	JMP CWAIT	/1 MEANS IN USE
	DCA CINUSE	/-1 MEANS HAD ERROR
	STL RAR		/4000
	TAD BSTATE	/LEAVE WITH STATUS B REGISTER IN AC
	SKP		/TAKE ERROR RETURN
WLV,	INCR WAIT
WAITEND,CDF 10
