DATE,	JMS SPACE
	TAD (DATWD-1
	DCA X0
	JMS GETNUM	/GET MONTH
	JMS GETSLS	/CHECK FOR SLASH
	JMS GETNUM	/GET DAY
	JMS GETSLS	/CHECK FOR SLASH
	JMS GETNUM	/GET YEAR
