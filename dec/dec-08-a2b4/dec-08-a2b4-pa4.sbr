
/INTEGER.V02
/8K FORTRAN LIBRARY
/COPYRIGHT 1968
/DIGITAL EQUIPMENT CORP., MAYNARD, MASS.
/
/	INTEGER MULTIPLY AND DIVIDE PACKAGE
/	FOR 8K ALICS FORTRAN SYSTEM
/
	ENTRY	IREM
	ENTRY	ABS
	ENTRY	IABS
	ENTRY	DIV
	ENTRY	MPY
	ENTRY	IRDSW
	DUMMY	LOC
	DUMMY	TEM

MPY,	BLOCK	2	/INTEGER MULTIPLY SUBROUTINE
	DCA	MQ
	TAD I	MPY
	INC	MPY#
	DCA	LOC
	TAD I	MPY
	INC	MPY#
	DCA	LOC#
	TAD	(-14
	DCA	CTR
BACK,	CLL RAL
	DCA	AC
	TAD	MQ
	CLL RAL
	DCA	MQ
	SNL
	JMP	NAD
	TAD I	LOC
NAD,	TAD	AC
	ISZ	CTR
	JMP	BACK
	RETRN	MPY
/
	CPAGE	4
DVERR,	0411			/"DIVZ" ERROR
	2632


DIV,	BLOCK	2
	SMA
	JMP	AD1
	INC	SIGN
	CIA
AD1,	DCA	MQ
	TAD I	DIV
	INC	DIV#
	DCA	LOC
	TAD I	DIV
	INC	DIV#
	DCA	LOC#
	TAD I	LOC
	SNA
	JMP	DIVZ	     /ATTEMPTING TO DIVIDE BY ZERO
	SMA
	JMP	LOOP1
	INC	SIGN
	CIA
LOOP1,	CLL RAL
	INC	CTR
	SMA
	JMP	LOOP1
	CLL RAR
	DCA	LOC
	TAD	LOC
	CIA
	DCA	MPY
	TAD	CTR
	CMA
	DCA	CTR
	TAD	CTR
	DCA	SAV
	DCA	AC
	TAD	MQ
LOOP2,	TAD	MPY
LOOP3,	ISZ	CTR
	SKP
	JMP	DONE
	STL
	SPA
	CLL
	DCA	MQ
	TAD	AC
	RAL
       DCA     AC
	TAD	MQ
	CLL RAL
	SNL
	JMP	LOOP2
	TAD	LOC
	JMP	LOOP3
DONE,	CLA
	TAD	SIGN
	RAR
	CLA
	DCA	SIGN
	TAD	AC
	SZL
	CIA
	RETRN	DIV

DIVZ,	CALL	1,SETERR
	ARG	DVERR
	CALL	0,ERROR
	RETRN	DIV
SIGN,	0
CTR,	0
AC,	0
LOC,	BLOCK	2
MQ,	0
/
IREM,	BLOCK	2
	CLA
	INC	IREM#
	INC	IREM#
	INC	SAV
	TAD	MQ
	SPA
	TAD	LOC
	SKP
LOP,	CLL RAR
	ISZ	SAV
	JMP	LOP
	RETRN	IREM
SAV,	0
/
ABS,	BLOCK	2
	TAD I	ABS
	INC	ABS#
	DCA	TEM
	TAD I	ABS
	INC	ABS#
	DCA	TEM#
	CALL	0,CLEAR
	CALL	1,IFAD
	ARG	TEM
	TAD	ACH
	AND	(3777
	DCA	ACH
	RETRN	ABS
TEM,	BLOCK	2
/
IABS,	BLOCK	2
	TAD I	IABS
	INC	IABS#
	DCA	TEM
	TAD I	IABS
	INC	IABS#
	DCA	TEM#
	TAD I	TEM
	SPA
	CIA
	RETRN	IABS
/
IRDSW,	BLOCK	2
	CLA OSR
	INC	IRDSW#
	INC	IRDSW#
	RETRN	IRDSW
	END