	JMP I	PR	     /GO BACK TO FORMAT SCANNER
NM,	0
NU,	0		     /ROUTINE TO FETCH THE ACCUM NUMB
	TAD	NM
	SPA		     /IF IT IS NEG, SET IT TO 1
	CLA IAC 	     /IT IS AND WE DO
	JMP I	NU	     /GO HOME
BB,	0
	JMS	MR	     /MORE?
	JMS	CK	     /IF ARG ' 0, END RECORD AND RETURN
	TAD	IO	     /TEST IN OUT SWITCH
	SZA CLA 	     /OUTPUT
	INC	BB	     /INPUT
	JMP I	BB
AX,	JMS	GLST
AA,	TAD	N2
	CMA
	DCA	CX
	JMSKP	BB
JX,	JMP	AN
	JMP	AO


AS,	TAD I	ARGUMT
	RTR		     /SHIFT RIGHT 6
	RTR
	RTR
