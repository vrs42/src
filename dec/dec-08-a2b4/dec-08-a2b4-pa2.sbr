GFRM,	0		     /GET THE NEXT CHARACTER IN THE FORMAT
	TAD	SW	     /ARE WE ON LEFT HALF OR RIGHT
	SZA CLA
	JMP	OD
	ISZ	SW	     /LEFT SET THE SWITCH
	TAD I	FPNT	     /GET THE WORD
	RTR		     /ONLY WANT THE LEFT HALF
	RTR		     /*
	RTR		     /*
