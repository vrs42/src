	STL		     /MAKE RH CHR A BLANK
	RTL		     /SHIFT LEFT 6
	RTL
	RTL
	DCA I	ARGUMT
	ISZ	CX	     /DONE?
	SKP
	JMP	AX	     /YES
	JMS	GCHR	     /NO, GET RIGHT CHAR
	TAD I	ARGUMT
	TAD	(7740
	DCA I	ARGUMT	     /PUT THE WORD PACK
	ISZ	ARGUMT#	     /POINT TO THE NEXT WORD
AN,	ISZ	CX	     /INPUT , TEST COUNT
	JMP	AR
	JMP	AX
CX,	0
	CPAGE	3
TN,	2045		     /THIS IS A FLOATING POINT 10.0
	0		     /*
	0		     /*
PSGN,	0		     /IF THE SIGN IS
	CLA
	TAD	SN
	SNA CLA
	JMP I	PSGN	     /IF POSITIVE, FORGET IT
	TAD	(55
	JMS	PRMNT
	JMP I	PSGN	     /GO BACK


HH,	JMS	MR	     /THE H FIELD PROCESSOR
	JMS	GFRM	     /SAME AS XXX, BUT PRINT NEXT
	JMS	PRINT	     /----- FORMAT CHARACTER
	JMP	HH	     /OUTPUT ONLY
DH,	0
	DCA	CX	     /DIVIDE FPAC BY TEN CX TIMES
	JMP	DTA
DTB,	CALL	1,FDV
	ARG	TN
DTA,	ISZ	CX
	JMP	DTB
	JMP I	DH
