	JMS	PRINT
	ISZ	CX	     /TEST FOR DONE
	SKP
	JMP	AX	     /DONE, MORE?
	TAD I	ARGUMT
	AND	(77
	JMS	PRINT
	ISZ	ARGUMT#
AO,	ISZCX	     /OUTPUT, TEST COUNT
	JMP	AS
	JMP	AX
