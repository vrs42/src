	TAD	N3	     /GET FIELD SIZE, E OR F
	JMP	XRLM
AS2,	CLA
	TAD	N2	     /GET FIELD SIZE, I
XRLM,	CMA
	DCA	CX	     /-COUNT
	JMP	QQ
QQA,	TAD	(52	     /PRINT CX ASTERISKS
	JMS	PRINT
QQ,	ISZ	CX	     /INDEX COUNT
