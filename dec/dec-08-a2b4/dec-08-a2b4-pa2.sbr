	JMP I	EJ
E1,	JMS	PRINT
	JMP I	EJ
N1,	0			/REPETITION COUNT
MR,	0		     /MORE?
	ISZ	N1	     /SEE IF IT GOES TO ZERO
	JMP I	MR
