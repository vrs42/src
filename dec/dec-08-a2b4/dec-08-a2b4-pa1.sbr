/	VERSION IOH.V08 (FEBRUARY 15, 1969)
/
/	INPUT OUTPUT CONVERSION SUBROUTINE
/	FOR 8K ALICS-FORTRAN SYSTEM
/
	ABSYM SACH 23		/SAVE FPAC FOR MANIPULATION OF AC
	ABSYM SACM 24
	ABSYM SACL 25
	ABSYM N2 175		/LAST ACCUMULATED NUMBER
	ABSYM ARGUMT 176
	DUMMY	ARGUMT
	DUMMY	FPNT
	ENTRY	READ
	ENTRY	WRITE
	ENTRY	IOH
/
/	THE FOLLOWING IS NECESSARY BECAUSE CERTAIN SUBROUTINES SKIP
/
	SKPDF JMSKP 4000
/
A2,	BLOCK	14
/
/	IOH ERROR ROUTINES
/
ERRNO,	BLOCK	1
ERR5,	ISZ	ERRNO
ERR4,	ISZ	ERRNO
ERR3,	ISZ	ERRNO
ERR2,	ISZ	ERRNO
ERR1,	ISZ	ERRNO
	CLA
	TAD	ERRNO		/IOH ERROR NUMBER
	TAD	(2460		/MAKE INTO BCD
	DCA	ERRZ#		/TO ERROR COMMENT
	CALL	1,SETERR
	ARG	ERRZ
	CALL	0,ERROR
/
/	DEVICE TRANSFER TABLE EACH ENTRY MUST TAKE
/	EXACTLY 3 LOCATIONS.	THAT IMPLIES THAT THE
/	ENTIRE TABLE MUST RESIDE IN ONE PAGE
/	THE TABLE MAY BE EXPANDED TO HANDLE NEW DEVICES
/	BY SIMILAR ENTRYS (GOOD LUCK)
/
	CPAGE	14
JXXX,	CALL	0,TTYOUT	/OUTPUT DEVICE 1
	JMP	BZZZ
	CALL	0,HSOUT		/OUTPUT DEVICE 3
	JMP	BZZZ
JWWW,	CALL	0,TTYIN		/INPUT DEVICE 1
	JMP	JFFF
	CALL	0,HSIN		/INPUT DEVICE 2
	JMP	JFFF
BZZZ,	JMP	BZ
JFFF,	JMP	JF
DV,	0			/SAVE DEVICE CODE
CS,	A2			/INITIAL PUSH POINTER
PARN,	0
	TAD I	WRITE
	JMP I	PARN
IO,	0			/1=OUTPUT, 0=INPUT
CH,	0
TW,	12
S1,	0		/SAVE RESTART POINT IN THE FORMAT
SW,	0			/LEFT OR RIGHT HALF OF FORMAT
READ,	BLOCK	2		/ENTRY POINT FOR READ
	TAD	READ		/SNEAK IN
	DCA	WRITE
	TAD	READ#
	DCA	WRITE#		/SAVE SECOND RETURN WORD
	JMP	ET
	CPAGE	4
ERRZ,	0615			/"FMT " ERROR FROM LOC XXXXX
	2460


WRITE,	BLOCK	2		/ENTRY POINT
	CLA IAC 		/INITIALIZE SWITCH
ET,	DCA	IO
	DCA	CH		/CLEAR CHARACTER
	DCA	ERRNO		/ZERO ERROR NUMBER IN CASE ERROR RESTART
	DCA	PARN
	TAD I	WRITE		/PICK UP BANK OF DEVICE
	DCA	ARGUMT
	INC	WRITE#		/INCREMENT POINTER TO ADDRESS
	TAD I	WRITE		/PICK UP ADDRESS OF DEVICE
	DCA	ARGUMT#
	TAD I	ARGUMT		/PICK UP ACTUAL DEVICE NUMBER
	DCA	DV
	TAD	CS		/INITIALIZE PUSH STACK
	DCA	PUSH		/-
	CLA CMA
	DCA	S2		/---WE HAVE TO RESTART
	INC	WRITE#		/POINT TO BANK OF FORMAT
	TAD I	WRITE		/GET BANK
	DCA	FPNT
	INC	WRITE#		/POINT TO FORMAT
	TAD I	WRITE		/POINTER, ADDRESS
	DCA	FPNT#
	TAD	FPNT#
	DCA	S1
	DCA	SW		/FORMAT FROM LEFT CHAR
	TAD	WRITE		/SET IOH EXIT TO WRITE
	DCA	IOH
	TAD	WRITE#		/MOVE SECOND WORD
	DCA	IOH#
	JMS	GLST		/SET ARGUMENT RETURN AND RETURN TO CALL
	PAGE

RETN,	TAD	(4000
	DCA	NM		/SET NM TO ONLY A - SIGN
RTUR,	JMS	GFRM		/GET NEXT CHAR IN FORMAT


GO,	TAD	(7706		/FIRST--IS IT A DIGIT
	CLL
	TAD	(12
	SZL
	JMP	DG		/YES--GO ACCUMULATE IT
	IAC
	SNA			/IS IT A SLASH
	JMP	SL		/YES
	IAC
	SNA			/IS IT A PERIOD
	JMP	PER		/YES
	TAD	(2		/NO
	SNA			/IS IT A COMMA
	JMP	CM		/YES
	TAD	(3		/NO
	SNA			/IS IT A RIGHT PAREN
	JMP	RPAR		/YES
	IAC			/NO
	SNA			/IS IT LEFT PAREN
	JMP	LP		/YES
	IAC
	SNA			/SINGLE QUOTE?
	JMP	QT
	TAD	(7
	SNA			/IS IT A BLANK, YES IGNORE
	JMP	RTUR		/AC IS T ASCII IF LE 57
	TAD	(40		/T ASCII -1 IF GE 71
	DCA	CH		/SAVEIT
	JMS	NU		/GET THE ACCUMULATED NUMBER
	CMA			/KRONK IT
	DCA	N1		/AND SAVE	COUNT FOR ALL CONVERSIONS
	TAD	CH
	AND	(7757
	TAD	(7770		/THIS TESTS IF CH IS AN ,X, OR ,H,
	SNA CLA
	JMS	PR		/IT WAS	, PROCESS IT
	JMP	RETN		/NOT X OR H, KILL NUMBER AND TRY AGAIN
CM,	JMS	NU		/GOT A COMMA, MUST BE END OF --
	DCA	N2		/ITEM BETTER PROC(SS
	TAD	CH
	SZA CLA
	JMS	PR		/PROCESS
	JMP	RETN		/NO CHARACTER OR PROCESSED

SL,	TAD	CH		/END OF THE CURRENT LINE//IS THERE
	SNA CLA 		/--A FORMAT ITEM WAINING---
	JMP	GA		/NO---BYPASS PROCESSING
	JMS	NU		/ESS, GET THE NUMBER LIKE COMMA
	DCA	N2		/SAVE	]W FOR I+A, D FOR E+F[
	JMS	PR		/GO PROCESS IT
GA,	JMS	EJ
	JMP	RETN
QT,	JMS	NU		/FOUND QUOTE
	DCA	N2
	TAD	CH
	SZA CLA			/ANYTHING?
	JMS	PR		/YES
QT1,	JMS	GFRM
	TAD	(-47
	SNA			/ANOTHER QUOTE?
	JMP	RETN
	TAD	(47
	JMS	PRINT		/PRINT CHAR
	JMP	QT1
DG,	DCA	READ		/DIGIT IS IN AC
	TAD	NM		/PREVIOUS NUMBER
	RAL CLL
	RAL CLL 		/TIMES 4
	TAD	NM		/PLUS PREVIOUS NUMBER
	RAL			/TIMES 2
	TAD	READ		/PLUS NUMBER
	DCA	NM		/' NEW NUMBER
	JMP	RTUR		/TRY ANOTHER CHARACTER
LP,	ISZ	PUSH		/LEFT PAREN
	CLA CMA 		/COUNT NESTING DEPTH, NEGATIVE
	TAD	PARN
	DCA	PARN
	TAD	FPNT#		/PICK UP THE FORMAT POINTER
	DCA I	PUSH		/CRAM IT INTO THE LIST
	ISZ	PUSH		/KICK AGAIN
	JMS	NU		/THERE MAY BE AN ACCUMULATED NUMBER
	CIA			/SAVE NUMBER.LS.1.V.SW
	CLL RAL 		/FOR THIS PAREN, SAVE IT AND THE
	TAD	SW		/FORMAT SWITCH IN THE LIST
	DCA I	PUSH		/*
	TAD	PARN		/HERE WE SEE IF THIS IS A POSSIBLE
	TAD	(2		/RESTART POINT
	SZA CLA 		/IF FIRST SAVE FPNT IN S1
	JMP	RETN		/NOPE- FORGET IT
	TAD	FPNT#		/YES--FIRST CRAM FORMAT---
	DCA	S1		/---INTO SAVE1
	TAD I	PUSH		/AND THAT STUFF IN THE LIST---
	DCA	S2		/---GOES INTO SAVE 2
	JMP	RETN		/READY FOR ANYTHING, HERE WE GO


RPAR,	TAD	CH		/RIGHT PAREN TIME--- IS THERE--
	SNA CLA 		/---ANYTHING THAT NEEDS PROCESSING
	JMP	GB		/NO-- SKIP IT
	JMS	NU		/GO GET THE NUMBER, IF ANY
	DCA	N2		/*
	JMS	PR		/DO IT	RPAR WAS FORMAT SPEC TERMINATOR
GB,	ISZ I	PUSH
	JMP	TR
	ISZ I	PUSH		/THIS ONE CANNOT SKIP
LB,	CLA
	TAD	(7776		/-2
	TAD	PUSH		/DELETE THIS ITEM FORM THE LIST
	DCA	PUSH		/PUSH = PUSH-2
	ISZ	PARN		/PARN = PARN +1 ]-1[ SINCE MINUS COUNT
	JMP	RETN
	JMS	WH		/THIS PAREN WAS THE BALANCING PAREN
	TAD	S1		/GET THE FORMAT POINTER OF THE--
	DCA	FPNT#		/RESTART POINT AND CRAM IT
	TAD	S2		/GET SWITCH AND THE COUNT
	STL
	RAR			/FIRST JUST THE COUNT
	CIA			/RESTORE COUNT, SWITCH IN LINK
	DCA	NM
	CLA RAL			/NOW THE SWITCH
	DCA	SW		/CRAM
	TAD	S1
	CIA			/TEST TO SEE IF S1 IS ORIGINAL POINTER
	JMS	PARN
	SNA			/YES, FAKE A RESTART
	JMP	L2		/NO, PUSH ORIGINAL POINTER
	ISZ	PUSH
	JMS	PARN
	DCA I	PUSH
	ISZ	PUSH
	CLA CMA 		/SET COUNT = 1, SWITCH = 1
	DCA I	PUSH
	CMA
L2,	DCA	PARN		/PARNRN = -1
	JMP	LP


TR,	ISZ I	PUSH
	SKP CLA
	JMP	LB		/IF SKIP, TIME TO REMOVE FROM LIST
	TAD I	PUSH		/GET LEFT-RIGHT SWITCH
	AND	(1
	DCA	SW		/*
	CLA CMA 		/GET OUT THE FORMAT POINTER--
	TAD	PUSH		/*
	DCA	SE
	TAD I	SE
	DCA	FPNT#		/HAA-- IT IS NOW RESTORED
	JMP	RETN		/AWAY WE GO
N3,	0			/W FOR E AND F CONVER
PER,	JMS	NU		/GOT A PERIOD, MUST BE	OR F TYPE
	DCA	N3
	JMP	RETN
S2,	0			/SAVE THE COUNT AND SWITCH
PUSH,	0			/PAREN PUSH DOWN LIST POINTER
C,	0			/COUNTER FOR DEC. EXP.


SE,	0			/DIVIDE BY 10 UNTIL N < 1.0
XR,	TAD	ACH		/TEST NUMBER FOR .GE. 1
	TAD	(5764
	SPA CLA
	JMP I	SE		/NUMBER IS IN RANGE, RETURN
	CALL	1,FDV
	ARG	TN
	CLA CMA 		/REDUCE COUNT
	TAD	C
	DCA	C
	JMP	XR


VZ,	DCA	SE		/EXPONENT ACCUMULATED
	CALL	0,CLEAR		/CLEAR FLOATING AC
	CALL	1,IFAD		/FLOATING ADD INDIRECT THE ARG
	ARG	ARGUMT
	TAD	SE		/TEST EXPONENT
	SMA
	JMP	VZB		/POSITIVE, MULTIPLY SE TIMES
	JMS	DH
	JMP	VZA
VZB,	CMA
	DCA	SE		/SAVE COUNT
	JMP	VZD
VZC,	CALL	1,FMP
	ARG	TN
VZD,	ISZ	SE		/INDEX COUNT
	JMP	VZC


VZA,	CALL	1,ISTO		/STORE IN PLACE
	ARG	ARGUMT
FX,	CLA
	JMS	GLST		/THIS IS F	FORMAT CONVERSION
FF,	JMSKP	BB		/TEST I-O, MORE, ETC
	JMP	FN		/INPUT -- BY-BY
	JMS	NR		/NUMBER IS IN FPAC, NO EXP, 200 IMPLIED
	TAD	C		/C CONTAINS NUMBER OF MULTS TO RANGE NUMBER
	SMA
	CLA			/0 MULTS NEEDED OR ALREADY THERE
	TAD	N3		/NUM3 IS THE FIELD WIDTH	SUM IS DADP+DP SPA
	CIA			/MINUS SPACE FOR DADP+DP
	JMS	SA		/PUT OUT REQUIRED BLANKS + SIGN
	CLA CMA
	TAD	C		/PUT OUT THE FIRST @C@ SIGNIFI--
	SMA
	JMP	PS		/NO LEADING BLANKS
	DCA	CR
	JMS	DT		/PUT OUT THAT DIGIT PUT OUT -CR DIGITS
PS,	CLA			/PUT OUT DECIMAL POINT
	TAD	(56
	JMS	PRINT
	TAD	C		/GET MULTIPLY COUNT
	SPA SNA
	JMP	PAS2
	CMA			/THEY WERE MULTIPLIES, 0 TO N OF THEM
	DCA	CR
	TAD	N2		/DIGITS AFTER DEC POINT, DADP
	CMA
	DCA	NR
	JMP	PASA		/TEST FOR 0 MULTIPLIES
RETR,	TAD	(60		/PUT OUT A ZERO
	JMS	PRINT		/ALL MULTIPLIES REPRESENTED
PASA,	ISZ	CR		/NO, TRY RUN OFF FIELD
	SKP
	JMP	PASS		/YES
	ISZ	NR		/ALL WIDTH ACCOUNTED FOR%
	JMP	RETR		/NO, TRY NEXT POSITION


PASS,	TAD	C		/YES, GET MULT COUNT
	CIA			/-MULT COUNT
	SKP
PAS2,	CLA
	TAD	N2		/N2-MULT COUNT
	CMA			/MULT COUNT - N2
	SMA
	JMP	FX		/MULT COUNT .GE. N2
	DCA	CR		/N. .G. MULT COUNT
	JMS	DT		/OUTPUT DIGITS
	JMP	FX		/RETURN

SA,	0
	TAD	N2		/NUM OF DIGITS TO RIGHT OF DECIMAL
	TAD	SN
	SMA			/THIS IS -(NUM OF BLANKS)
	JMP	AS3		/POSITIVE, NUMBER TOO BIG FOR FIELD
	DCA	CR
	SKP CLA
RETC,	JMS	PRINT		/HERE WE PUT OUT THAT MANY BLANKS
	TAD	(40
	ISZ	CR
	JMP	RETC		/YES
	JMS	PSGN		/PUT OUT THE SIGN, IF IT IS MINUS
	JMP I	SA

WH,	0
	JMS	EJ	     /END THE RECORD
	TAD	ARGUMT#
	SNA CLA 	     /TEST PARAMETER FOR 0
	JMS	GLST	     /RETURN TO MAIN PROGRAM ON 0 PAR
	JMP I	WH	     /MORE AGRUMENTS RETURN


XX,	JMS     MR		/TEST FOR MORE
	TAD     IO		/TEST FOR INPUT-OUTPUT
	SNA CLA
	JMP     XX1		/INPUT, PSEUDO-JUMP
	TAD     (40		/OUTPUT A BLANK
	JMS     PRINT
	JMP     XX		/CYCLE
XX1,	JMS	GCHR		/IGNORE SPACES ON INPUT
	CLA
	JMP	XX

	PAGE
FN,	TAD	N3		/GET WIDTH, INPUT FOR E OR F FORMAT
	CMA			/1'S COMPLEMENT
	DCA	CR		/TO COUNTER
	DCA	MR		/0 TO MR
	DCA	D1		/0 TO D1
	CMA			/-0 TO SGN FLAG
	DCA	SN
	DCA	ACH
	DCA	ACM
	DCA	ACL
	CMA
	DCA	D2		/-1 TO DECIMAL POINT SWITCH
RRT,	CLA
	ISZ	CR		/INDEX TO SEE IF WIDTH EXCEEDED
	SKP
	JMP	FP		/GET AN INPUT CHARACTER AND TEST IT

/
/	CPAGE	5	/SC SUBROUTINE SKIPS SO WE MUST PLAY GAMES
	JMS	SC	/NOTE THAT PREVIOUS ISZ FORCES DATA FIELD
	JMP	PUNT		/ '.'
	JMP	RRT		/SIGN OR BLANK
	JMP	EPRO		/ 'E'
	AND	(17		/ DIGIT
	DCA	IS		/SAVE IN TENMP
	CALL	1,FMP
	ARG	TN
	CALL	1,STO		/SAVE FLOATING POINT ACCUMULATOR
	ARG	SV
	TAD	IS
	CALL	0,FLOT		/FLOAT NEW DIGIT
	CALL	1,FAD
	ARG	SV
	INC	D1		/COUNT OF DIGITS
	JMP	RRT
PUNT,	ISZ	D2		/TST DP SWITCH
	JMP	ERR1		/***** TWO DECIMAL POINTS *****
	DCA	D1
	JMP	RRT
EPRO,	CLA CMA 		/AN E
FP,	DCA	IS		/-1 TO IS IF E, 0 TO IS IF END OF FIELD
	ISZ	D2		/TEST DP SWITCH
	JMP	FA		/ONE HAS OCCURRED
	TAD	N2		/ONE HAS NOT OCCURRED, GET NDP
	SKP
FA,	TAD	D1		/COUNT OF DIGITS AFTER EXPLICIT DP
	CMA			/-COUNT
	JMS	DH		/DIVIDE FPAC BY TEN COUNT TIMES
	ISZ	SN		/TEST SIGN
	SKP			/-
	JMP	FD		/<
	TAD	ACH
	TAD	(4000
	DCA	ACH
FD,	CALL	1,ISTO
	ARG	ARGUMT
	ISZ	IS		/TEST FOR AN E
	JMP	FX		/NO E
	JMP	VQ		/E


D1,	0
D2,	0
IS,	0
CR,	0			/MISC COUNTS


EX,	JMS	GLST		/THIS IS E FORMAT CONVERSION
EE,	JMSKP	BB
	JMP	FN		/INPUT
	JMS	NR		/GET NUM INTO .1 .LE. X .L.1. RANGE, SIGN SN
	TAD	N3
	CMA			/WE ARE COMPUTIN THE NUM OF LEADING
	TAD	(5		/@E@ + EXPON + DECIMAL POINT
	JMS	SA		/PUT OUT
	TAD	(56
	JMS	PRINT		/PRINT IT
	TAD	N2		//NOW PUT OUT NUM2 MORE SIGNIFICANT
	CMA			/--DIGITS
	DCA	CR
	JMS	DT
	TAD	(5		/PUT OUT THE E
	JMS	PRINT


/	NOW PRINT 'C' DIGITS UNDER I3 FORMAT
	TAD	C
	SMA SZA CLA
	TAD	(2
	TAD	(53		/C IS MINUS OR ZERO, I.E. EXP	0
	JMS	PRINT		/PRINT A MINUS OR BLANK
	TAD	C
	SPA
	CIA
	CALL	1,DIV
	ARG	TW
	TAD	(60
	JMS	PRINT		/PRINT
	CALL	1,IREM		/IREM NEEDS AN ARGUMENT TO IGNORE
	ARG	0
	TAD	(60
	JMS	PRINT		/PRINT SECOND DIGIT
	JMP	EX		/DONE, DO NEXT


	CPAGE	3
HF,	2004			/0.50000
	0000
	0000
BZ,	JMP I	PRINT


PAUSE
