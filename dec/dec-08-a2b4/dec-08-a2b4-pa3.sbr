/
/	FLOATING POINT ARITHMETIC PACKAGE
/		VERSION FLOAT.V05 (JANUARY 7, 1969)
/
/
/		ENTRIES
/
	ENTRY	FAD
	ENTRY	FSB
	ENTRY	FMP
	ENTRY	FDV
	ENTRY	STO
	ENTRY	FLOT
	ENTRY	FLOAT
	ENTRY	FIX
	ENTRY	IFIX
	ENTRY	IFAD
	ENTRY	ISTO
	ENTRY	CHS
	ENTRY	CLEAR
/
/THE FOLLOWING REDEFINES JMS TO BE A SKIP INSTRUCTION
/	IT IS NECESSARY BECAUSE OF THE WAY THIS ROUTINE WAS CODED
/
SKPDF	JMS	4000
	DUMMY	DUM
/
/
ABSYM	HAC	20
ABSYM	MAC	21
ABSYM	LAC	22
ABSYM	SRH	23
ABSYM	SRM	24
ABSYM	SRL	25
ABSYM	ACS	26
ABSYM	ACX	27
ABSYM	SRS	30
ABSYM	SRX	31
ABSYM	MQH	30
ABSYM	MQM	31
ABSYM	MQL	32

/
/	ADDITION AND SUBTRACTION ROUTINE
/
/
FSB,	BLOCK	2
	TAD	FSB
	DCA	FAD
	TAD	FSB#
	DCA	FAD#
	JMP	ED1
/
ER1,	FAD
FAD,	BLOCK	2
	CLA CMA
ED1,	DCA	FSB
	TAD	ER1
	DCA	ER0
	TAD I	FAD
	INC	FAD#
	DCA	DUM
	TAD I	FAD
	INC	FAD#
	JMS	GTSPLT
	JMP	FADEND
	TAD	SRS
	ISZ	FSB
	TAD	(4000
	DCA	SRS
	TAD	ACX
	SNA
	JMP	SHFAC
	CIA
	TAD	SRX
	SMA
	JMP	SHFAC
	DCA	FSB
SHFSR,	TAD	SRH
	CLL RAR
	DCA	SRH
	TAD	SRM
	RAR
	DCA	SRM
	TAD	SRL
	RAR
	DCA	SRL
	ISZ	FSB
	JMP	SHFSR
	JMP	JD1
/
SHFAC,	CMA
	DCA	FSB
	TAD	SRX
	DCA	ACX
	SKP
ED3,	JMS	ARS
	ISZ	FSB
	JMP	ED3
/
JD1,	TAD	ACS
	SMA CLA
	JMP	ED4
	TAD	(22
	JMS	COM
ED4,	TAD	SRS
	SPA CLA
	JMS	COM
	JMS	ADSRAC
/
	TAD	HAC
	SMA CLA
	JMP	ED5
	TAD	(22
	JMS	COM
	TAD	(4000
ED5,	DCA	ACS
	DCA	RSW
FADEND, JMS	NORMAC
	RETRN	FAD
/
/	ROUTINE TO GET OPERAND INTO SR AND SEPARATE OFF SIGNS AND
/	EXPONENTS OF BOTH AC AND SR.  ALSO MOVE GLOBAL AC TO LOCAL AC.
/
GTSPLT, 0
	DCA	DUM#
	TAD I	DUM
	JMS	SPLIT
	DCA	SRH
	TAD	ACX
	SZA
	ISZ	GTSPLT
	DCA	SRX
	TAD	ACS
	INC	DUM#
	DCA	SRS
	TAD I	DUM
	INC	DUM#
	DCA	SRM
	TAD I	DUM
	DCA	SRL
	TAD	ACH
	JMS	SPLIT
	DCA	HAC
	DCA	RSW
	TAD	ACM
	DCA	MAC
	TAD	ACL
	DCA	LAC
	JMP I	GTSPLT
DUM,	BLOCK	2
/
SPLIT,	0
	DCA	TMP
	TAD	TMP
	RAR
	RTR
	AND	(377
	DCA	ACX
	TAD	TMP
	AND	(4000
	DCA	ACS
	TAD	TMP
	AND	(7
	JMP I	SPLIT
TMP,	0
/
ARS,	0
	TAD	HAC
	CLL RAR
	DCA	HAC
	TAD	MAC
	RAR
	DCA	MAC
	TAD	LAC
	RAR
	DCA	LAC
	CLA RAL
	DCA	RSW
	JMP I	ARS
/
ALS,	0
	TAD	LAC
	CLL RAL
	DCA	LAC
	TAD	MAC
	RAL
	DCA	MAC
	TAD	HAC
	RAL
	DCA	HAC
	JMP I	ALS
/
/	ADD SR TO AC
/
ADSRAC, 0
	CLL
	TAD	LAC
	TAD	SRL
	DCA	LAC
	CLA RAL
	TAD	MAC
	TAD	SRM
	DCA	MAC
	CLA RAL
	TAD	HAC
	TAD	SRH
	DCA	HAC
	JMP I	ADSRAC
/
/	ROUTINE TO NORMALIZE AND RECOMBINE ACCUMULATOR,
/	  AND PLACE LOCAL ACC. IN GLOBAL ACC.
/
NORMAC, 0
ED6,	TAD	HAC
	TAD	(7770
	SPA CLA
	JMP	RUND
	JMS	ARS
	ISZ	ACX
	JMP	ED6
/
/		ROUNDOFF ROUTINE
/
RUND,	TAD	RSW
	SNA CLA
	JMP	LEFTST
	ISZ	LAC
	JMP	LEFTST
	ISZ	MAC
	JMP	LEFTST
	ISZ	HAC
	DCA	RSW
	JMP	ED6
/
LEFTST, TAD	ACX
	SNA SPA
	JMP	ZEROUT
	DCA	ACX
LEFSH,	TAD	HAC
	TAD	(-3
	SMA SZA CLA
	JMP	COMBIN
	JMS	ALS
	CLA CMA
	JMP	LEFTST
/
COMBIN, TAD	ACX
	CLL RAL
	RTL
	SPA
	JMP	ERR
	TAD	HAC
	TAD	ACS
	DCA	ACH
	TAD	MAC
	DCA	ACM
	TAD	LAC
ED7,	DCA	ACL
	JMP I	NORMAC
ZEROUT, CLA
	DCA	ACH
	DCA	ACM
	JMP	ED7
RSW,	0
/
/	ROUTINE TO GET TWOS COMPLEMENT OV  TRIPLE WORD NUMBER
/	IF NO ADDRESS IN ACC UPON ENTRY, SR IS ASSUMEND TO BE THE NO.
/
	CPAGE	24
COM,	0
	SNA
	TAD	(25		/ADDRESS OF SRL
	DCA	PTR2
	TAD	(-3
	DCA	CTR2
	STL
ED8,	TAD I 	PTR2
	CMA
	SZL
	CLL IAC
	DCA I	PTR2
	CLA CMA CML
	TAD	PTR2
	DCA	PTR2
	ISZ	CTR2
	JMP	ED8
	JMP I	COM
PTR2,	0
CTR2,	0
/
/
/	ROUTINE TO STORE CONTENTS OF FL. PT. ACC AND CLEAR IT
/
STO,	BLOCK	2
	TAD I	STO
	INC	STO#
	DCA	FIX
	TAD I	STO
	DCA	FIX#
	TAD	ACH
	DCA I	FIX
	DCA	ACH
	INC	FIX#
	TAD	ACM
	DCA I	FIX
	DCA	ACM
	INC	FIX#
	INC	STO#
	TAD	ACL
	DCA I	FIX
	DCA	ACL
	RETRN	STO
/
/	FLOATING POINT TO FIXED POINT CONVERSION
/
ER2,	FIX
FIX,	BLOCK	2
	TAD	ER2
	DCA	ER0
	TAD	ACH
	JMS	SPLIT
	DCA	HAC
	TAD	ACM
	DCA	MAC
	TAD	ACX
	TAD	(-214
	SMA
	JMP	ERR
	TAD	(-3
	DCA	SRM
RSH,	JMS	ARS
	ISZ	SRM
	JMP	RSH
	TAD	ACS
	RAL
	TAD	MAC
	SZL
	CIA
	DCA	ACS
	DCA	ACH
	DCA	ACM
	DCA	ACL
	TAD	ACS
	RETRN	FIX
/
IFIX,	BLOCK	2
	TAD I	IFIX
	INC	IFIX#
	DCA	ADDR
	TAD I	IFIX
	INC	IFIX#
	DCA	ADDR#
	JMS	RIFF
	DCA	FAD
	CPAGE	5
	JMS	FAD#
ADDR,	BLOCK	2
	JMS	RIFF
	DCA	FIX
	JMS	FIX#
	RETRN	IFIX
/
/		FLOATING POINT MULTIPLICATION
/
ER3,	FMP
FMP,	BLOCK	2
	TAD	ER3
	DCA	ER0
	TAD I	FMP
	INC	FMP#
	DCA	DUM
	TAD I	FMP
	INC	FMP#
	JMS	GTSPLT
	JMP	MULZRO
	TAD	ACS
	TAD	SRS
	DCA	ACS
	TAD	ACX
	TAD	SRX
MULZRO, TAD	(-201
	DCA	ACX
	TAD	HAC
	DCA	MQH
	TAD	MAC
	DCA	MQM
	TAD	LAC
	DCA	MQL
	DCA	HAC
	TAD	(-33
	DCA	CTR
/
MULT,	JMS	ARS
	TAD	MQH
	RAR
	DCA	MQH
	TAD	MQM
	RAR
	DCA	MQM
	TAD	MQL
	RAR
		DCA	MQL
	SZL
	JMS	ADSRAC
	ISZ	CTR
	JMP	MULT
/
	JMS	NORMAC
	RETRN	FMP
/
CTR,	0
/
/		FLOATING POINT DIVISION
/
ER4,	FDV
FDV,	BLOCK	2
	TAD	ER4
	DCA	ER0
	TAD I	FDV
	INC	FDV#
	DCA	DUM
	TAD I	FDV
	INC	FDV#
	JMS	GTSPLT
	JMP	ERR
	TAD	ACS
	TAD	SRS
	DCA	ACS
	TAD	SRX
	CIA
	TAD	ACX
	TAD	(177
	DCA	ACX
	DCA	MQL
	TAD	(-35
	DCA	CTR
DVID,	TAD	SRH
	AND	(4000
	TAD	HAC
	SMA CLA
	JMS	COM
	JMS	ADSRAC
	TAD	MQL
	RAL
	DCA	MQL
	TAD	MQM
	RAL
	DCA	MQM
	TAD	MQH
	RAL
	DCA	MQH
/
	JMS	ALS
	ISZ	CTR
	JMP	DVID
/
	TAD	MQH
	DCA	HAC
	TAD	MQM
	DCA	MAC
	TAD	MQL
	DCA	LAC
	JMS	NORMAC
	RETRN	FDV
/
/	CONVERT FIXED POINT TO FLOATING POINT
/
FLOAT,	BLOCK	2
	TAD I	FLOAT
	INC	FLOAT#
	DCA	ISTO
	TAD I	FLOAT
	INC	FLOAT#
	DCA	ISTO#
	JMS	RIFF
	DCA	FLOT
	TAD I	ISTO
	JMS	FLOT#
	RETRN	FLOAT
/
/	INDIRECT STORE
/
ISTO,	BLOCK	2
	TAD I	ISTO
	INC	ISTO#
	DCA	FLOAT
	TAD I	ISTO
	INC	ISTO#
	DCA	FLOAT#
	TAD I	FLOAT
	INC	FLOAT#
	DCA	OUT
	TAD I	FLOAT
	DCA	OUT#
	JMS	RIFF
	DCA	STO
	CPAGE	5
	JMS	STO#
OUT,	BLOCK	2
	RETRN	ISTO
/
/		INDIRECT ADD
/
IFAD,	BLOCK	2
	TAD I	IFAD
	INC	IFAD#
	DCA	ISTO
	TAD I	IFAD
	INC	IFAD#
	DCA	ISTO#
	TAD I	ISTO
	INC	ISTO#
	DCA	ADD
	TAD I	ISTO
	DCA	ADD#
	JMS	RIFF
	DCA	FAD
	CPAGE	5
	JMS	FAD#
ADD,	BLOCK	2
	RETRN	IFAD
/
/	INTEGER TO FLOATING POINT CONVERSION
/
FLOT,	BLOCK	2
	CLL
	SPA
	CIA CML
	DCA	MAC
	DCA	HAC
	DCA	LAC
	RAR
	DCA	ACS
	TAD	(217
	DCA	ACX
	DCA	RSW
	JMS	NORMAC
	RETRN	FLOT
/
/	ROUTINE TO CHANGE SIGN OF FL. PT. ACCUMULATOR
CHS,	BLOCK	2
	TAD	ACH
	SZA
	TAD	(4000
	DCA	ACH
	RETRN	CHS
RIFF,	0
	6224
	TAD	(6201
	JMP I	RIFF
/
/	CLEAR FLOATING AC
/
CLEAR,	BLOCK	2
	DCA	EPNT	/SAVE THE AC
	DCA	ACH
	DCA	ACM
	DCA	ACL
	TAD	EPNT
	RETRN	CLEAR
/
/	ERROR ROUTINES
/
ERR,	CLA
	TAD I	ER0	/BANK CALL IS FROM
	DCA	EPNT	/TO FAKED ENTRY POINT
	ISZ	ER0	/INDEX TO ADDRESS
	TAD I	ER0	/ADDRESS
	DCA	EPNT#	/TO SECOND WORD OF FAKED ENTRY POINT
	CALL	1,SETERR	/CALL SET UP FOR ERROR ROUTINE
	ARG	FPER
	CALL	0,ERROR
	CPAGE	4
FPER,	0620			/"FPNT" ERROR AT LOC XXXXX
	1624
EPNT,	BLOCK	2		/THIS IS A FAKED ENTRY POINT
ER0,	BLOCK	1
	END
