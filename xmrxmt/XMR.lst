


      /XMODEM RECEIVE OS/8 DEVICE HANDLER                                 Page 1


    1              /XMODEM RECEIVE OS/8 DEVICE HANDLER
    2              /**************************************************************
    3              /THIS 2-PAGE OS/8 DEVICE HANDLER RECEIVES BINARY DATA VIA
    4              /A KL8-E-TYPE SERIAL PORT, USING THE XMODEM PROTOCOL.
    5              /LIMITATIONS:
    6              / 1. CRC ERROR CHECKING IS NOT SUPPORTED
    7              / 2. NO LIMIT ON RETRIES. BUT THE USER CAN ^C FROM THE CONSOLE.
    8              /**************************************************************
    9              /FOR DEVICE HANDLER DOCUMENTATION, SEE THE FOLLOWING:
   10              /  OS/8 SOFTWARE SUPPORT MANUAL (DEC-S8-OSSMB-A-D),
   11              /     CHAPTER 4: USING DEVICE HANDLERS
   12              /     SECTION 5.1: WRITING DEVICE HANDLERS
   13              /  OS/8 HANDBOOK, APRIL 1974 (DEC-S8-0SHBA-A-D)
   14              /     PAGES 2-56 TO 2-61: BUILD HANDLER DEVICE FORMAT
   15              /**************************************************************
   16              /REVISION HISTORY
   17              / 1.00 23 AUGUST 2020  M. EBERHARD
   18              /    CREATED
   19              /**************************************************************
   20              /LIMIATIONS:
   21              / 1. XMODEM-CRC IS NOT SUPPORTED
   22              / 2. THE BUFFER SIZE MUST BE AN EVEN NUMBER OF 128-WORD
   23              /    OS/8 RECORDS. (ODD WILL GENERATE A FATAL ERROR RETURN)
   24              / 3. RETRIES ARE UNLIMITED. (THE XMODEM SPEC SAYS TO ABORT
   25              /    AFTER 10 RETRIES OF ANY RECORD. THE USER CAN ALWAYS
   26              /    ABORT WITH ^C)
   27              /**************************************************************
   28        0100          XMRVERSION=0100 /OCTAL VERSION
   29              
   30        0560          DEVTYPE=0560    /DEVICE TYPE, 0NN0,
   31                                      /NN BETWEEN 40 AND 77
   32                                      /(SEE DEC-S8-0SHBA-A-D PAGE 2-59)
   33              
   34              /--------------------------------
   35              /TRANSFER PORT DEFINITIONS
   36              /DTPORT MUST BE OF THE FORM 0NN0,
   37              /WHERE N IS AN OCTAL DIGIT
   38              /--------------------------------
   39              
   40              /DTPORT=0030            /OS/8 CONSOLE
   41        0300  DTPORT=0300             /2ND KL8-E
   42              /DTPORT=0400            /2ND "TELETYPE" ON THE PDP-8 SIMULATOR
   43              
   44              /CALCULATE THE SPECIFIED KL8-E IOT'S FOR THE TRANSFER PORT
   45              
   46        6301  DTPKSF=6001+DTPORT      /SKIP ON INPUT FLAG
   47        6302  DTPKCC=6002+DTPORT      /CLEAR INPUT FLAG
   48        6306  DTPKRB=6006+DTPORT      /READ INPUT BUFFER, CLEAR FLAG
   49        6310  DTPTFL=6010+DTPORT      /SET OUTPUT FLAG
   50        6311  DTPTSF=6011+DTPORT      /SKIP ON OUTPUT FLAG



      /XMODEM RECEIVE OS/8 DEVICE HANDLER                                 Page 2


   51        6316  DTPTLS=6016+DTPORT      /WRITE TO OUTPUT, CLEAR FLAG
   52              
   53              /**********************************
   54              /* DEVICE HANDLER HEADER BLOCK    *
   55              /* SEE DEC-S8-0SHBA-A-D PAGE 2-57 *
   56              /**********************************
   57        0000          *0
   58 00000  7777          -1              /-NUMBER OF DEVICE HANDLERS HERE
   59              
   60 00001  3015          DEVICE XMR      /DEVICE GROUP NAME
      00002  2200
   61 00003  3015          DEVICE XMR      /OS/8 DEVICE NAME
      00004  2200
   62 00005  1560          DEVTYPE+1000    /DCB WORD: NOT FILE-STRUC'D,
   63                                      /WRITE-ONLY,DEVICE TYPE
   64 00006  4070          XMR&177+4000    /ENTRY POINT (MUST BE>24)
   65                                      /4000 INDICATES 2-PAGE HANDLER                  
   66                                      /(SEE DEC-S8-0SHBA-A-D PAGE 2-60)
   67 00007  0000          ZBLOCK 2        /2 WORDS MUST BE 0
      00010  0000
   68              
   69              /***********************
   70              /* DEVICE HANDLER BODY *
   71              /***********************        
   72        0200          *200            /(SEE DEC-S8-0SHBA-A-D PAGE 2-57)
   73              
   74              /VARIABLES
   75              
   76 00200  0000  BUFADR, 0               /BUFFER ADDRESS
   77              
   78 00201  0000  BPTRA,  0               /BUFPTR ADDRESS
   79 00202  0000  B123A,  0               /BUF123 ADDRESS
   80 00203  0000  SPTRA,  0               /BUFPTR ADDRESS
   81 00204  0000  S123A,  0               /BUF123 ADDRESS
   82              
   83 00205  0000  PRVREC, 0               /PREVIOUS XMODEM RECORD NUMBER
   84 00206  0000  XRECCNT,0               /NUMBER OF XWINDOW RECORDS THAT FIT
   85              
   86              /CONSTANTS
   87              
   88 00207  0232  CTLZ,   232             /OS/8 EOF MARK
   89 00210  4400  CTLZH,  4400            /CTLZ<0:3> IN <0:3>
   90              /CTLZL, 5000            /CTLZ<4:7> IN <0:3>
   91 00211  4546  CZLMCZ, 5000-232        /CTLZL - CTLZ
   92 00212  3700  BWCMSK, 3700            /MASK FOR BUFFER WORD COUNT
   93 00213  6203  CIFCDF, CDF CIF 0       /PROTOTYPE CDF CIF INSTRUCTION
   94              
   95              /*** INITIALIZATION ***
   96              /ON ENTRY:
   97              /  AC=0



      /XMODEM RECEIVE OS/8 DEVICE HANDLER                                 Page 3


   98              /**********************
   99 00214  0252  DELTA,  NEWREC-IRET     /BE POSITION-INDEPENDENT
  100              
  101              TEMP1,                  /(REUSE)        
  102 00215  0000  INIT,   0
  103              
  104              /INITIALIZE THE SERIAL PORT
  105              
  106 00216  6302          DTPKCC          /CLEAR INPUT FLAG
  107 00217  6310          DTPTFL          /SET OUTPUT FLAG
  108              
  109              /INITIALIZE PAGE 1 VARIABLES
  110              
  111 00220  3205          DCA     PRVREC
  112              
  113              /COMPUTE & REMEMBER ADDRESSES OF PAGE 2 VARIABLES
  114              /INITALIZE PAGE 2 VARIABLES TOO
  115              
  116 00221  1215          TAD     INIT    /GET PAGE ADDRESS
  117 00222  1214          TAD     DELTA   /POINT TO NEWREC
  118 00223  3204          DCA     S123A   /TEMP USE B123A AS POINTER
  119 00224  7040          CMA
  120 00225  3604          DCA I   S123A   /INITIALIZE TO -1 FOR INIT NAKS
  121              
  122 00226  2204          ISZ     S123A   /POINT TO BUFPTR
  123 00227  1204          TAD     S123A
  124 00230  3201          DCA     BPTRA   /CREATE LINK TO BUFPTR
  125              
  126 00231  2204          ISZ     S123A   /POINT BUF123
  127 00232  1204          TAD     S123A
  128 00233  3202          DCA     B123A   /CREATE LINK TO BUF123
  129              
  130 00234  2204          ISZ     S123A   /POINT TO SAVPTR
  131 00235  1204          TAD     S123A
  132 00236  3203          DCA     SPTRA   /CREATE LINK TO SAVPTR
  133              
  134 00237  2204          ISZ     S123A   /FINALLY BECOMES LINK TO SAV123
  135              
  136 00240  5615          JMP I   INIT    /RETURN
  137              
  138              /*** EXIT *************************************************
  139              /RECEIVED THE EOT. INSTALL A ^Z AND FILL THE REST OF THE
  140              /BUFFER WITH 0'S, THEN ENDICATE THE END OF FILE VIA A SOFT-
  141              /ERROR RETURN (RETURN1 WITH AC=0).
  142              /(SEE DEC-S8-OSSMB-A-D PAGE 5-1 AND 5-3 ITEM 11)
  143              /NOTE THAT THE BUFFER CAN'T BE COMPLETELY FULL WHEN THE EOT
  144              /ARRIVES, BECAUSE WE HAD NO IDEA THAT THE NEXT RECORD WOULD
  145              /IN FACT BE THE EOT - SO MUST HAVE ROOM FOR A RECORD.
  146              /
  147              /ON ENTRY:



      /XMODEM RECEIVE OS/8 DEVICE HANDLER                                 Page 4


  148              /  DATA FIELD IS FIELD 0 (WHERE WE ARE RUNNING)
  149              /  AC=0
  150              /  BUFADR = -(LAST BUFFER ADDRESS+1)
  151              /  BUFPTR = NEXT BUFFER ADDRESS TO WRITE
  152              /           (SPECIAL CASE IF BUF123=-1, FOR BYTE 3)
  153              /  BUF123 = NEXT BYTE 1-2-3 POSITION
  154              /           0 FOR BYTE 1
  155              /           1 FOR BYTE 2
  156              /          -1 FOR BYTE 3 (MEANING THE ^Z MUST BE SPLIT)
  157              /  BPTRA POINTS TO BUFPTR IN FIELD 0
  158              /  B123A POINTS TO BUF123 IN FIELD 0
  159              /**********************************************************
  160 00241  1601  GOTEOT, TAD I   BPTRA   /GET BUFPTR, THE FINAL ADDRESS
  161 00242  3201          DCA     BPTRA   /..MOVED TO THIS PAGE           
  162              
  163 00243  1602          TAD I   B123A   /WHICH 1-OF-3 BYTES?
  164              
  165 00244  7402  XMCDF2, HLT             /(GETS OVERWRITTEN)
  166                                      /SET DATA FIELD FOR BUFFER
  167              
  168              /AC=0 FOR BYTE 1, 1 FOR BYTE 2 NEXT, -1 FOR BYTE3
  169              /AS THE NEXT BUFFER 8-BIT BYTE. IF THE NEXT BYTE
  170              /IS BYTE 3, THEN THE TERMINATING ^Z MUST BE SPLIT
  171              /ACROSS THE LAST TWO 12-BIT BUFFER WORDS.
  172              
  173 00245  7700          SMA CLA         /IS IT -1?
  174 00246  5257          JMP     GEOT1   /N: BYTE 1 OR 2
  175              
  176 00247  7240          STA             /-1
  177 00250  1201          TAD     BPTRA   /AC=-1: BACK UP TO WORD 1
  178 00251  3215          DCA     TEMP1
  179              
  180 00252  1615          TAD I   TEMP1   /INSTALL CTLZ<0:3>
  181 00253  1210          TAD     CTLZH   /IN BITS <0:3>
  182 00254  3615          DCA I   TEMP1
  183              
  184 00255  1601          TAD I   BPTRA   /GET LAST BUFFER WORD TO INSTALL
  185                                      /..CTLZ<4:7> IN BITS <0:3>
  186 00256  1211          TAD     CZLMCZ  /THIS WILL BECOME CTLZL COMBINED
  187                                      /..WITH THE LAST BYTE OF DATA
  188              
  189              /JUMP HERE IF BYTE 1 OR BYTE 2 IS NEXT:
  190              /INSTALL A ^Z IN THE BYTE 1 OR BYTE 2 LOCATION
  191              
  192 00257  1207  GEOT1,  TAD     CTLZ    /INSTALL ^Z THERE       
  193              
  194              /AC=CTLZ OR CTLZL COMBINED WITH THE LAST BYTE OF DATA.
  195              /INSTALL THIS IN THE BUFFER, AND FILL THE REST OF THE
  196              /BUFFER WITH 0'S.
  197              



      /XMODEM RECEIVE OS/8 DEVICE HANDLER                                 Page 5


  198 00260  3601  CLRLUP, DCA I   BPTRA   /0
  199 00261  2201          ISZ     BPTRA   /NEXT ADDRESS
  200              
  201 00262  0070  C0070,  0070            /A HARMLESS "AND" INSTRUCTION
  202                                      /SINCE BPTRA CAN WRAP
  203              
  204 00263  1201          TAD     BPTRA   /NEXT ADDRESS TO WRITE
  205 00264  1200          TAD     BUFADR  /-(LAST BUFFER ADDRESS +1)
  206 00265  7640          SZA CLA         /END YET?
  207 00266  5260          JMP     CLRLUP  /N: KEEP CLEARING       
  208              
  209              /RETURN1 FROM HANDLER, WITH AC=0 INDICATING EOF
  210              
  211 00267  5372          JMP     EOTEXT  /RETURN1 FROM HANDLER   
  212              
  213              /***********************
  214              /* HANDLER ENTRY POINT *
  215              /***********************
  216 00270  0100  XMR,    XMRVERSION      /THIS CODE'S VERSION NUMBER
  217                                      /..IN ITS RETURN ADDRESS SLOT
  218              
  219              /-------------------------------
  220              /PARSE HANDLER INPUT PARAMETERS
  221              /(SEE DEC-S8-OSSMB-A-D PAGE 5-1)
  222              /-------------------------------
  223 00271  7330          STL CLA RAR     /AC=4000
  224 00272  1670          TAD I   XMR     /GET FUNCTION WORD, R/W BIT TO LINK
  225 00273  0212          AND     BWCMSK  /EXTRACT MAX # OF RECORDS TO TRANSFER
  226 00274  7002          BSW             /BITS 1-5 INTO BITS 7-11
  227 00275  3206          DCA     XRECCNT /OS/8 128-WORD RECORD COUNT FOR NOW
  228              
  229 00276  6214          RDF             /FIND OUT THE USER'S INSTR. FIELD
  230 00277  1213          TAD     CIFCDF  /FORM OUR EXIT CIF CDF
  231 00300  3373          DCA     RSTFLD  /STORE AWAY FOR EXIT ROUTINE
  232              
  233 00301  1670          TAD I   XMR     /GET FUNCTION WORD AGAIN
  234 00302  0262          AND     C0070   /ISOLATE FIELD OF BUFFER
  235 00303  1316          TAD     CDFOP   /FORM CDF TO BUFFER'S FIEL
  236 00304  3347          DCA     XMCDF1  /STORE WHERE IT WILL BE USEFUL
  237 00305  1347          TAD     XMCDF1  /..TWO PLACES
  238 00306  3244          DCA     XMCDF2
  239              
  240 00307  2270          ISZ     XMR     /POINT TO BUFFER ADDRESS
  241 00310  1670          TAD I   XMR     /GET BUFFER ADDRESS
  242 00311  3200          DCA     BUFADR  /AND SAVE IT IN PAGE 1
  243              
  244 00312  2270          ISZ     XMR     /POINT TO OS/8 RECORD NUMBER
  245              
  246 00313  7630          SZL CLA         /LINK=1 MEANS OUTPUT
  247 00314  5371          JMP     ERREXT  /OUTPUT IS AN ERROR: ERROR RETURN



      /XMODEM RECEIVE OS/8 DEVICE HANDLER                                 Page 6


  248              
  249              /------------------------------------------------------
  250              /SET UP FOR NEW TRANSFER IF STARTING WITH 0S/8 RECORD 0
  251              /(SEE DEC-S8-OSSMB-A-D PAGE 5-1 ITEM 2)
  252              /ON ENTRY:
  253              /  AC=0
  254              /   L=0
  255              /  XMT POINTS TO OS/8 RECORD NUMBER
  256              /------------------------------------------------------
  257 00315  1670          TAD I   XMR     /GET OS/8 RECORD NUMBER
  258              
  259 00316  6201  CDFOP,  CDF 0           /THE FOLLOWING OPS ARE IN FIELD 0
  260                                      /ALSO PROTOTYPE FOR CDF NN
  261              
  262 00317  7650          SNA CLA         /RECORD 0 MEANS INITIALIZE 1ST
  263 00320  4215          JMS     INIT
  264              IRET,
  265              
  266              /--------------------------------------------------
  267              /INITIALIZE VARIABLES FOR EACH CALL TO THIS HANDLER
  268              /--------------------------------------------------
  269 00321  1200          TAD     BUFADR
  270 00322  3601          DCA I   BPTRA   /PUT BUFFER ADDRESS INTO PAGE 2
  271 00323  3602          DCA I   B123A   /INITIALIZE 1-2-3 BYTE COUNTER
  272              
  273              /-------------------------------------------------
  274              /COMPUTE AND REMEMBER THE LAST BUFFER ADDRESS.
  275              /ALSO TEST XRECCNT FOR BITS 1-5 & 9-11 ALL 0,
  276              /WHICH MEANS CLOSE. (WE DON'T ACTUALLY CHECK
  277              /BITS 9-11 HERE. ONLY 0 IS MEANINGFUL ANYWAY.)
  278              /ON ENTRY:
  279              /  AC=0
  280              /  XRECCNT<7:11> = # OF 128-WORD RECORDS IN BUFFER
  281              /  BUFADR = FIRST BUFFER ADDRESS
  282              /ON EXIT:
  283              /  AC=0
  284              /  BUFADR = -(LAST BUFFER ADDRESS+1)
  285              /-------------------------------------------------
  286 00324  1206          TAD     XRECCNT /NUMBER OF 128-WORD RECORDS
  287              
  288 00325  7450          SNA
  289 00326  5367          JMP     NRMEXT  /XRECCNT=0 MEANS CLOSE (DO NOTHING)
  290              
  291 00327  7002          BSW             /BITS <7:11> INTO BITS <1:5>
  292 00330  7104          CLL RAL         /..AND THEN INTO <0:4>, TO BE THE
  293                                      /..NUMBER OF 12-BIT WORDS IN BUFFER
  294              
  295 00331  1200          TAD     BUFADR  /+ 1ST BUFFER ADDRESS
  296 00332  7041          CIA             /MAKE IT NEGATIVE FOR COMPARING
  297 00333  3200          DCA     BUFADR  /-(LAST BUFFER ADDRESS+1)



      /XMODEM RECEIVE OS/8 DEVICE HANDLER                                 Page 7


  298              
  299              /-----------------------------------------------------------
  300              /COMPUTE XMODEM RECORD COUNT = -(OS/8 RECORD COUNT)*3/2
  301              /ALSO CHECK FOR ILLEGAL ODD NUMBER OF OS/8 RECORDS.
  302              /(ONE OS/8 BLOCK COMPRISES TWO 128-WORD RECORDS)
  303              /(SEE DEC-S8-OSSMB-A-D PAGE 4-3 ITEM 5 AND PAGE 5-3 ITEM 12)
  304              /ON ENTRY:
  305              /  AC=0
  306              /  XRECCNT=NUMBER OF 0S/8 128-WORD RECORDS
  307              /ON EXIT:
  308              /  AC=0
  309              /  XRECCNT=-(NUMBER OF 128-BYTE XMODEM RECORDS)
  310              /-----------------------------------------------------------
  311 00334  1206          TAD     XRECCNT /OS/8 128-WORD RECORD COUNT
  312 00335  7110          CLL RAR         /DIVIDE BY 2, REMAINDER TO L
  313 00336  7430          SZL
  314 00337  5371          JMP     ERREXT  /ODD IS AN ERROR: FATAL ERROR RETURN
  315              
  316 00340  1206          TAD     XRECCNT /(OS/8 RECORD COUNT)*3/2
  317              
  318 00341  7041          CIA             /MAKE IT NEGATIVE FOR COUNTER
  319 00342  3206          DCA     XRECCNT
  320              
  321              /---------------------------------------------------
  322              /RECEIVE AND VALIDATE AN XMODEM RECORD
  323              /ON ENTRY:
  324              /  ACHCHR=NAK THE FIRST TIME, ACK THEREAFTER
  325              /  PRVREC=PREVIOUS XMODEM RECORD NUMBER
  326              /  BUFPTR=ADDRESS OF NEXT BUFFER WORD
  327              /  BUF123=STARTING 8-BIY BYTE LOCATION
  328              /         0 FOR 1ST BYTE
  329              /         1 FOR 2ND BYTE
  330              /        -1 FOR 3RD BYTE
  331              /---------------------------------------------------
  332              RECLUP,
  333              
  334              /-------------------------------------
  335              /SAVE BUFFER LOCATION FOR XMODEM RETRY
  336              /ON ENTRY:
  337              /  AC=0
  338              /-------------------------------------
  339 00343  1601          TAD I   BPTRA
  340 00344  3603          DCA I   SPTRA
  341 00345  1602          TAD I   B123A
  342 00346  3604          DCA I   S123A
  343              
  344              /------------------------------------------------------
  345              /GO TO PAGE 2 TO RECEIVE THE ENTIRE NEXT XMODEM RECORD.
  346              /GETREC RETURNS WITH DATA FIELD=0
  347              /------------------------------------------------------



      /XMODEM RECEIVE OS/8 DEVICE HANDLER                                 Page 8


  348              GOGETR,                 /ENTRY FOR IGNORING REPEATED REC
  349              
  350 00347  7402  XMCDF1, HLT             /(GETS OVERWRITTEN)
  351                                      /SET DATA FIELD FOR BUFFER
  352              
  353 00350  4376          JMS     GETREC  /GET RECORD DATA
  354 00351  5371          JMP     ERREXT  /RETURN1 MEANS FATAL ERROR
  355 00352  5241          JMP     GOTEOT  /RETURN2 MEANS EOT RECEIVED
  356                                      /RETURN3 MEANS GOOD RECORD
  357                                      /AC=NEW RECORD NUMBER
  358              
  359              /-----------------------------------------
  360              /GOT AN ERROR-FREE RECORD. SEE IF IT'S THE
  361              /RIGHT RECORD NUMBER. ABORT IF NOT. 
  362              /ON ENTRY:
  363              /  AC=NEWREC > 0
  364              /-----------------------------------------
  365 00353  7041          CIA             /SUBTRACT NEWREC
  366 00354  1205          TAD     PRVREC  /..FROM PREVIOUS RECORD
  367              
  368 00355  7450          SNA             /SAME RECORD?
  369 00356  5347          JMP     GOGETR  /Y: IGNORE IT
  370              
  371              /AC=PRVREC - NEWREC <> 0
  372              
  373 00357  7001          IAC             /TEST
  374 00360  0364          AND     BMASK1  /BOTTOM 8 BITS ONLY
  375 00361  7640          SZA CLA
  376 00362  5371          JMP     ERREXT  /LOST RECORD FATAL ERROR
  377              
  378              /CORRECT (NEXT SEQUENTIAL) RECORD RECEIVED WITHOUT ERRORS.
  379              /UPDATE PRVREC
  380              
  381 00363  2205          ISZ     PRVREC  /WON'T WRAP UNTIL 4K RECORDS...
  382              
  383 00364  0377  BMASK1, 0377            /BYTE MASK
  384                                      /ALSO HARMLESS "AND" INSTRUCTION
  385                                      /SINCE PRVREC COULD POSSIBLY WRAP
  386              
  387              /MORE ROOM FOR RECORDS? LOOP TO GET THEM
  388              /AC=0
  389 00365  2206          ISZ     XRECCNT /ROOM FOR ANOTHER?
  390 00366  5343          JMP     RECLUP
  391              
  392              /-----------------------------------------------------------
  393              /EXITS FROM HANDLER
  394              /  NRMEXT IS THE NORMAL EXIT FOR A FULL BUFFER
  395              /     ON ENTRY:
  396              /        AC=0
  397              /     ON EXIT VIA RETURN2



      /XMODEM RECEIVE OS/8 DEVICE HANDLER                                 Page 9


  398              /        AC=0
  399              /  ERREXT INIDCATES A FATAL ERROR:
  400              /      -HANDLER CALL FOR OUTPUT
  401              /      -HANDLER CALL WITH ODD NUMBER OF 128-WORD RECORDS
  402              /      -TIMEOUT WAITING FOR THE SENDER
  403              /      -A LOST XMODEM RECORD
  404              /     ON EXIT VIA RETURN1
  405              /        AC=-1
  406              /  EOTEXT INDICATES END OF FILE; THE EOT WAS ENCOUNTERED
  407              /     ON ENTRY:
  408              /        AC=0
  409              /     ON EXIT VIA RETURN1
  410              /        AC=0
  411              /        A ^Z HAS BEEN INSALLED IN THE BUFFER AFTER THE LAST
  412              /          WORD, AND THE REMAINDER OF THE BUFFER IS ZEROED.
  413              /-----------------------------------------------------------
  414 00367  2270  NRMEXT, ISZ     XMR     /POINT TO NORMAL RETURN2
  415 00370  5372          JMP     EOTEXT  /SKIP OVER ERROR
  416 00371  7240  ERREXT, STA             /AC=-1 FOR FATAL ERROR
  417              
  418 00372  2270  EOTEXT, ISZ     XMR     /FATAL ERROR OR EOF RETURN1
  419              
  420 00373  7402  RSTFLD, HLT             /(GETS OVERWRITTEN) RESTORE FIELDS
  421 00374  5670          JMP I   XMR     /AND RETURN
  422              
  423              /*** SUBROUTINE **************************************
  424              /RECEIVE A COMPLETE XMODEM RECORD, WRITING ITS DATA
  425              /INTO THE OS/8 BUFFER, WITH RETRIES ON CHECKSUM ERRORS
  426              /AND TIMEOUTS ON RECEIVED CHARACTERS
  427              /
  428              /THIS SUBROUTINE CROSSES THE PAGE BOUNDARY
  429              /
  430              /ON ENTRY:
  431              /  AC=0
  432              /  BUFPTR=ADDRESS OF NEXT BUFFER WORD
  433              /  BUF123=0 FOR BYTE 1
  434              /         1 FOR BYTE 2
  435              /        -1 FOR BYTE 3
  436              /  SAVPTR=BUFPTR
  437              /  SAV123=BUF123
  438              /  NEWREC = 0 ON FIRST CALL
  439              /ON EXIT:
  440              /  RETURN1 (FATAL TIMEOUT):
  441              /    AC=0
  442              /    DATA FIELD IS 0
  443              /  RETURN2 (EOT RECEIVED):
  444              /    AC=0
  445              /    BUF123=NEXT 1-OF-3 POSITION:
  446              /           0: BYTE 1, 1: BYTE 2, -1: BYTE 3
  447              /    IF BUF123=0: BUFPTR=NEXT BUFFER ADDRESS TO WRITE



      /XMODEM RECEIVE OS/8 DEVICE HANDLER                                Page 10


  448              /    OTHERWISE BUFPTR=LAST BUFFER ADDRESS WRITTEN
  449              /    DATA FIELD IS 0
  450              /  RETURN3(SUCCESS):
  451              /    AC=0
  452              /    NEWREC=RECEIVED RECORD NUMBER
  453              /    BUF123=NEXT 1-OF-3 POSITION:
  454              /           0: BYTE 1, 1: BYTE 2, -1: BYTE 3
  455              /    IF BUF123=-1, BUFPTR=LAST BUFFER ADDRESS WRITTEN
  456              /    OTHERWISE BUFPTR=NEXT BUFFER ADDRESS TO WRITE
  457              /    DATA FIELD IS 0
  458              /*****************************************************
  459        0376          *376            /MAKE ALIGNMENT MAGIC
  460              
  461 00376  0000  GETREC, 0               /RETURN ADDRESS
  462              
  463 00377  1376          TAD     GETREC  /RETURN ADDRESS
  464              
  465              /---PAGE BREAK HERE---
  466              
  467 00400  3324          DCA     GRRET   /CREATE RETURN ADDRESS
  468              
  469              /----------------------------------------------
  470              /ACK THE PREVIOUS RECORD (OR NAK IF ERROR)
  471              /ON ENTRY:
  472              /  AC=0
  473              /  NEWREC<0 TO START THE TRANSFER (WITH NAKS)
  474              /ON ENTRY AT XRETRY:
  475              /  AC=0
