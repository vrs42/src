QAKRB=6036	/PDP-8 IOT KBD
QATSF=6041	/TSF
QATLS=6046	/TLS
/
GETKBD,	LDA
	0
	STC QAEXIT+6	/SAVE RETURN
	ADD 1		/SAVE XRS 1 AND 2
	STC QAEXIT+3
	ADD 2
	STC QAEXIT+5
	STC QAEXIT+1
	KST	/WAS SOMETHING TYPED?
	JMP 0		/NO: EXIT
	IOB
	QAKRB	/GET TTY CHAR, CLEAR FLAG
	STA I		/SAVE IT
QATY,	0
	ADA I
	-237
	APO		/BETWEEN 200 AND 237?
	JMP QACNTR	/CONTROL CHAR. CHECK FOR CR,LF,TAB
/
	SET I 1		/NO
	QACHAR-1
	SET I 2
	-7
	LDA
	QATY
	SAE I 1
	JMP .+2
	JMP QAEXIT	/ILLEGAL CHAR. DONT ECHO
	XSK I 2	/CHECKED THEM ALL?
	JMP .-4
/
	ADA I
	-337
	APO		/BETWEEN 240 AND 337?
	JMP QALEGL	/YES. LEGAL CHAR
/
	SAE I 1		/NO. CHECK FURTHER.
	JMP .+7
	LDA I		/RUBOUT
	334
	JMP QATPE	/ECHO BACKSLASH
	LDA I
	37
	JMP QAEXIT+2	/LEGAL EXIT
/
	SAE I 1
	JMP QAEXIT	/ILLEGAL
			/ALT
	JMP QAEXIT+2	/EXIT, DONT ECHO
/
QALEGL,	LDA
	QATY
	JMP QATPE	/ECHO CHAR
	ADD QATY
	BCL I		/STRIP IT TO 6-BIT
	7700
	JMP QAEXIT+2
/TO HERE IF CONTROL CHAR
QACNTR,	SAE I
	7755
	JMP QACKLF
	LDA I		/CR
	43
	STC QAEXIT+1
	LDA I
	215
	JMP QATPE
	LDA I
	212
	JMP QATPE
	JMP QAEXIT
/
QACKLF,	SAE I
	7752
	JMP .+4
	LDA I		/LF
	45
	JMP QACNTR+5
	SAE I
	7751
	JMP QAEXIT	/ILLEGAL
	LDA I
	47
	JMP QAEXIT+2	/EXIT, DONT ECHO
/
QAEXIT,	LDA I	/GET 6-BIT ASCII
	0
	SET I 1		/RESTORE XRS
	0
	SET I 2
	0
	JMP		/EXIR S\R GETKBD
/S\R TO PRINT C(AC)
QATPE,	IOB
	QATLS	/PDP-8 IOT TLS
	LDA
	0
	STC .+4	/SAVE RETURN
	IOB
	QATSF	/WAIT FOR FLAG
	JMP .-2
	JMP 	/EXIT
/
QACHAR,	243	/HASH
	244	/DOLLAR SIGN
	245	/PER CENT
	247	/APOSTROPHE
	300	/AT SIGN
	336	/UP ARROW
	337	/BACK ARROW
	40	/RUBOUT
/GET8
/SYNC SIGNAL (PRECS PULSE) GOES INTO INPUT 1
/AND TWO AMPLITUDES FOR EACH.
/SAMPLE LOOP TIME IS 130 MICROSECONDS
/THIS PROGRAM SUPPORTS CLASSICAL CONDITIONING BY DEFAULT.
/       BY DISCONNECTING INPUTS TO SXL 12 AND 13
/  INSTRUMENTAL CONDITIONING IS SUPPORTED BY CONNECTING 12 TO THE NEGATIVE OUT
/OF A COMPARATOR. SAID COMPARATOR TRIGGERING WHEN THE AMPLITUDE OF THE DEPENDENT
/VARIABLE EXCEEDS THE MOVEABLE REFERENCE VOLTAGE
/IN THIS CASE RELAY K1 IS NOT SET.
/
/
/K0 IS SET FOR 128 TIME POINTS, THEN BOTH K0 AND K1 ARE SET FOR AN
/ADDITIONAL 128 TIME POINTS, (SUBJECT TO INSTRUMENTAL RESPONSE)
/
/
/PROGRAM ALSO SUPPORTS DIFFERENTIAL CONDITIONING VIA K5
/K5 IS SET DURING ODD AVERAGES AND IS USED IN CONJUNCTION WITH SENSE LINE 13
/WITH 13 GROUNDED NO DATA ARE COLLECTED /WITH 13 HIGH DATA ARE COLLECTED IN DF5-7
/EIGHT POSTSTIMULUS HISTOGRAMS ARE COLLECTED
/ONE FOR EACH OF EIGHT ELECTRODES, THE  SIGNALS ARE PRE-
/PROCESSED BY THE COMPARATORS
