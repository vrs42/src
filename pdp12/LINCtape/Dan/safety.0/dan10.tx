	377
	JMP .-5
	CLR
	STC 17
	SET I 13
	-777
	ADD VERT
	DIS I 17
	XSK I 13
	JMP .-2
	SNS 1
	JMP START
EX,	CLR
	SET I 17
	4000
	SET I 16
	-377
	SET I 15
	0000
	SET I 14
	0377
	SET I 13
	-777
