	KRB		/PUT.
	TLS
	JMP I LISN
TYPE,	0
	TSF		/SUBROUTINE TO
	JMP .-1		/TYPE OUTPUT.
	TLS
	CLA 		/DONT CLEAR LINK
	JMP I TYPE	/!!!!!!!!!!!!!!
CRLF,	0
	TAD K215	/SUBROUTINE TO
	JMS TYPE	/CR AND LF TTY.
	TAD K212	/CR FIRST!!!
	JMS TYPE
	JMP I CRLF
