/SAMPLE 512 TIMES
/SAVE DATA IN 7000-7777
/THEN DISPLAY THE DATA
SAMP, SET I 2	/POINTER FOR DATA
	6777
/SET UP CLOCK
	PDP
	PMODE
	CLA	/CLEAR CLK 
	CLAB
	CLLR
	TAD K100
	CLLR
	CLSA
	CLA	/SET BUFFER PRESET REG
	TAD K2
	CLAB
	CLA	/ENABLE OVERFLOW
	TAD K300
	CLEN
	CLA	/100 KC, MODE 1
	TAD K2100
	CLLR
	LINC
	LMODE
	JMP SP1
K2100,	2100
K300,	300
K2,	SAMSET
K100,	100
/SAMPLE 512 TIMES
SP1,	IOB
	CLSK
	JMP SP1
	CLR
	IOB
	CLSA	/CLEAR FLAG
	SAM 10
	SCR 1	/MIMIC LINC-8 SAMPLE
	STA I 2	/STORE DATA IN Q6 & Q7
	DIS I 3
	DIS 3
	XSK 2	/ALL DATA STORED ?
	JMP SP1
/STOP CLOCK
	CLR
	IOB
	CLLR
	IOB
	CLEN
/DISPLAY DATA
SP2,	SET I 2
6777
SET I 3
1777
SP3, LDA I 2
DIS I 3
XSK 2	/SWEEP DONE ?
