*20
/
/DBL3GOX
/ALLOWS ACCESS TO DBLFLT3 ROUTINES
/PUT IN CURRENT INST.FIELD 
/ENTER VIA DESIRED JMP
/
/MEMORY SEGMENTS
	SEGA=3
	SEGB=1
/
/SET IR.17 = 0 IN USER PGM
	DBL3GX=.
	*17
	0
	*DBL3GX
/
/USER ENTRY POINTS TO DBLFLTA
KBDX,	XSK I 17
KBDIX,	XSK I 17
TYP6X,	XSK I 17
TEN2NX,	XSK I 17
TTYOUX,	XSK I 17
TTYINX,	XSK I 17
COM1X,	XSK I 17
ABS1X,	XSK I 17
TYP8X,	XSK I 17
COMPAX,	XSK I 17
FLOATX,	XSK I 17
FIXX,	XSK I 17
TRANSX,	XSK I 17
DIVIDX,	XSK I 17
MULTX,	XSK I 17
SUBTX,	XSK I 17
ADDTX,	LIF SEGA
	JMP 20	/TO DBLFLTA CNTL PGM
/
/USER ENTRY POINTS TO DBLFLTB
NEGFAX,	XSK I 17
SINPIX,	XSK I 17
COSPIX,	XSK I 17
LOG2X,	XSK I 17
ARCSIX,	XSK I 17
ARCTAX,	XSK I 17
POWSEX,	XSK I 17
EXPONX,	XSK I 17
MAGTSX,	XSK I 17
SIGNX,	XSK I 17
LOGNX,	XSK I 17
LOG10X,	XSK I 17
SINRAX,	XSK I 17
COSRAX,	XSK I 17
SINDEX,	XSK I 17
COSDEX,	XSK I 17
SQROOX,	XSK I 17
LFCRX,	XSK I 17
IRLOAX,	XSK I 17
FIX12X,	XSK I 17
FLOT1X,	LIF SEGB
	JMP 20	/TO DBLFLTB CNTL PGM
	/END DBL3GOX
/
/
