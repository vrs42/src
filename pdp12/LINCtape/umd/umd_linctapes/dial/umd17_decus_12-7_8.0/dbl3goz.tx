*20
/
/DBL3GOZ
/ALLOWS ACCESS TO DBLFLT3 ROUTINES
/PUT IN CURRENT INST.FIELD 
/ENTER VIA DESIRED JMP
/
/MEMORY SEGMENTS
	SEGA=3
	SEGB=1
/
/SET IR.17 = 0 IN USER PGM
	DBL3GZ=.
	*17
	0
	*DBL3GZ
/
/USER ENTRY POINTS TO DBLFLTA
KBDZ,	XSK I 17
KBDIZ,	XSK I 17
TYP6Z,	XSK I 17
TEN2NZ,	XSK I 17
TTYOUZ,	XSK I 17
TTYINZ,	XSK I 17
COM1Z,	XSK I 17
ABS1Z,	XSK I 17
TYP8Z,	XSK I 17
COMPAZ,	XSK I 17
FLOATZ,	XSK I 17
FIXZ,	XSK I 17
TRANSZ,	XSK I 17
DIVIDZ,	XSK I 17
MULTZ,	XSK I 17
SUBTZ,	XSK I 17
ADDTZ,	LIF SEGA
	JMP 20	/TO DBLFLTA CNTL PGM
/
/USER ENTRY POINTS TO DBLFLTB
NEGFAZ,	XSK I 17
SINPIZ,	XSK I 17
COSPIZ,	XSK I 17
LOG2Z,	XSK I 17
ARCSIZ,	XSK I 17
ARCTAZ,	XSK I 17
POWSEZ,	XSK I 17
EXPONZ,	XSK I 17
MAGTSZ,	XSK I 17
SIGNZ,	XSK I 17
LOGNZ,	XSK I 17
LOG10Z,	XSK I 17
SINRAZ,	XSK I 17
COSRAZ,	XSK I 17
SINDEZ,	XSK I 17
COSDEZ,	XSK I 17
SQROOZ,	XSK I 17
LFCRZ,	XSK I 17
IRLOAZ,	XSK I 17
FIX12Z,	XSK I 17
FLOT1Z,	LIF SEGB
	JMP 20	/TO DBLFLTB CNTL PGM
	/END DBL3GOZ
/
/
