*20
/BINOCT 2
/FOR PDP-12
/D. J. NICHOLS
/UNIV. WISCONSIN
/
/SINGLE-PRECISION BINARY-TO-OCTAL CONVERSION
/
/ENTER WITH BINARY NUMBER IN ACCUMULATOR
/  VIA A: JMP BO2
/OCTAL ASCII CODES STORED VIA IR 1
/  WITH LEADING ZEROES SUPPRESSED
/NON-INTERRUPTABLE
/USES IR 1
/
BO2,	STC K9BO2+1 /SAVE ARG.
	ADD 0	/SAVE RET.
	STC L9BO2
	JMP K9BO2 /CONVERT ONE DIGIT
	AZE	/LEADING ZERO?
	JMP .+5	/NO: STORE IT
	LDH I	/YES: STORE A SPACE
	4000
	STH I 1
	JMP .-6
	BSE I	/MAKE ASCII
	60
	STH I 1	/STORE DIGITS
	JMP K9BO2 /CONVERT
	JMP .-4
/LITLE SUBROUTINE
K9BO2,	LDA I 
	0
	ROL 3
	STA
	K9BO2+1
	BCL I
	7770
	SRO I	/4 DIGITS DONE?
	3567
	JMP 0	/NO: RETURN
	ADD K9BO2-4 /YES: MAKE ASCII
	STH I 1 /STORE IT
L9BO2,	JMP 0	/BACK TO MAIN PROGRAM
/END BINOCT 2
/
