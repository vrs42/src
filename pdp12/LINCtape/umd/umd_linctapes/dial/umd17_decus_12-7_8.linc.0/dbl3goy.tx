*20
/
/DBL3GOY
/ALLOWS ACCESS TO DBLFLT3 ROUTINES
/PUT IN CURRENT INST.FIELD 
/ENTER VIA DESIRED JMP
/
/MEMORY SEGMENTS
	SEGA=3
	SEGB=1
/
/SET IR.17 = 0 IN USER PGM
	DBL3GY=.
	*17
	0
	*DBL3GY
/
/USER ENTRY POINTS TO DBLFLTA
KBDY,	XSK I 17
KBDIY,	XSK I 17
TYP6Y,	XSK I 17
TEN2NY,	XSK I 17
TTYOUY,	XSK I 17
TTYINY,	XSK I 17
COM1Y,	XSK I 17
ABS1Y,	XSK I 17
TYP8Y,	XSK I 17
COMPAY,	XSK I 17
FLOATY,	XSK I 17
FIXY,	XSK I 17
TRANSY,	XSK I 17
DIVIDY,	XSK I 17
MULTY,	XSK I 17
SUBTY,	XSK I 17
ADDTY,	LIF SEGA
	JMP 20	/TO DBLFLTA CNTL PGM
/
/USER ENTRY POINTS TO DBLFLTB
NEGFAY,	XSK I 17
SINPIY,	XSK I 17
COSPIY,	XSK I 17
LOG2Y,	XSK I 17
ARCSIY,	XSK I 17
ARCTAY,	XSK I 17
POWSEY,	XSK I 17
EXPONY,	XSK I 17
MAGTSY,	XSK I 17
SIGNY,	XSK I 17
LOGNY,	XSK I 17
LOG10Y,	XSK I 17
SINRAY,	XSK I 17
COSRAY,	XSK I 17
SINDEY,	XSK I 17
COSDEY,	XSK I 17
SQROOY,	XSK I 17
LFCRY,	XSK I 17
IRLOAY,	XSK I 17
FIX12Y,	XSK I 17
FLOT1Y,	LIF SEGB
	JMP 20	/TO DBLFLTB CNTL PGM
	/END DBL3GOY
/
/
