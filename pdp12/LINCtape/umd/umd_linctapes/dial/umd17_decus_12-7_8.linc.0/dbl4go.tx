*20
/DBL4GO
/ALLOWS ACCESS TO DBLFLT4 ROUTINES
/PLACE IN EACH INST.FIELD USING DBLFLT4
/ENTER VIA DESIRED JUMP TO DBL4GO
/RETURNS TO .+1, .+2, .+3, .+4 OR .+5
/ OF USER PGM, AS APPROPRIATE
/
/DBLFLT4 SYMBOLS FOR USER PGM REFERENCE
/
 /MEMORY SEGMENT ASSIGNMENT
	SEGA=3
 /DBLFLT FORMAT CONSTANTS IN SEGA
	DC0=1634
	DC1=1637
	DC2=1650
	DC3=1621
	DC4=1642
	DC10=1631
	DCRT2=1645
	DCLOG2=1626
	DCLN2=1623
	DCPI=1653
	DCE=1616
 /DBLFLT4 STORAGE LOCATIONS IN SEGA
	FAC=1763
	TEM1=1766
	TEM2=1771
	TEM3=1774
 /USER PGM STORAGE LOCATIONS IN SEGA
	DS1=1704
	DS2=1707
	DS3=1712
	DS4=1715
	DS5=1720
	DS6=1723
	DS7=1726
	DS8=1731
	DS9=1734
	DS10=1737
	DS11=1742
	DS12=1745
	DS13=1752
/
/SET IR.17 = 0 IN USER PGM
	DBL4GO=.
	*17
	0
	*DBL4GO
/
/USER PGM ENTRY POINTS TO DBLFLT4 ROUTINES
/UNARGUMENTED ENTRY POINTS
LOGN,	XSK I 17
LOG10,	XSK I 17
LOG2,	XSK I 17
EXPON,	XSK I 17
SQROOT,	XSK I 17
MAGTST,	XSK I 17
SIGN,	XSK I 17
FLOT12,	XSK I 17
FIX12,	XSK I 17
/ARGUMENTED ENTRIES: NUMBER OF ARGS.
POWSER,	XSK I 17	/ 1
NEGATE,	XSK I 17	/ 1
ABSVAL,	XSK I 17	/ 1
COMPAR,	XSK I 17	/ 1-2
FLOAT,	XSK I 17	/ 1
FIX,	XSK I 17	/ 1
TRANS,	XSK I 17	/ 1-2
DIVIDE,	XSK I 17	/ 1-3
MULT,	XSK I 17	/ 1-3
SUBT,	XSK I 17	/ 1-3
ADDT,	LIF SEGA	/ 1-3
	JMP 20	/TO DBLFLT4 CONTROL PGM
/
	/END DBL4GO
	/6-6-71
/
/
/
