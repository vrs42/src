*20
	*0
TEXT /F      *ECHASK*
H             (ETCH-A-SKETCH)
F 
F THIS PROGRAM TRACES
F  THE PATH OF A DOT 
F    AS YOU MOVE IT 
F  ACROSS THE SCREEN.\/
*200
TEXT /F       ECHASK
F 
H  KNOB 0 - MOVES DOT VERTICALLY
H  KNOB 4 - MOVES DOT HORIZONTALLY
F 
FSENSE SWITCH 5:
H 
H      =1 - ERASE SCREEN
F 
H 
H              (MORE)\/ 		
	*400
TEXT /F 
FSENSE SWITCH 4:
H 
H    =0 - STOP WHEN BUFFER
H         IS FULL
H 
H    =1 - WHEN BUFFER FILLS,
H         BEGIN ERASING FROM
H         BEGINNING
F 
H             (MORE)\/
*600
TEXT /F 
FSENSE SWITCH 3:
H 
H  =0 - TRACE CONTINUOUS
H       PATH OF DOT
H 
H  =1 - ERASE SEGMENT DRAWN
H       WHILE SWITCH=1 WHEN
H       SWITCH IS SET BACK =0
H 
H   (USED TO DRAW DISJOINTED
H    LINE SEGMENTS)
F 
H         CONTROL S TO START.\/
