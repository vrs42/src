	TAD	LOCTR2
	DCA I	X10
DEFIND,	CDF	FLD0		/GO LOOK FOR ANOTHER TAG
	JMP I	(ASMBL
TRYEQU,	TAD	(-21		/CHECK FOR EQUAL SIGN
	SZA
	JMP	TRYBLK		/NO, TRY BLANK
	TAD	NAME1
	DCA	EQUN		/SAVE 6 CHARACTER NAME
	TAD	NAME2
	DCA	EQUN+1
	TAD	NAME3
	DCA	EQUN+2
	TAD	BUCKET
	DCA	EQUN+3
	JMS I	[EXPR		/GET VALUE RIGHT OF EQUALS
	JMP	EQUERR		/BAD EQU
	TAD	EXPTYP		/IS EXPR UNDEFINED ?
	SNA CLA
	JMP I	[NEXTST		/YES, LEAVE SYMBOL UNDEFINED
	TAD	EQUN		/RESTORE NAME
	DCA	NAME1
	TAD	EQUN+1
	DCA	NAME2
	TAD	EQUN+2
	DCA	NAME3
	TAD	EQUN+3
	DCA	BUCKET
	JMS I	[LOOKUP		/LOOKUP SYMBOL
	JMP	NEWSYM		/NEW SYMBOL
/	SNA
/	IAC			/REFNCD BUT UNDEF, ASSUME ADDR TYPE
/	CIA
/	TAD	EXPTYP		/COMPARE TYPES
/	SZA CLA
/	JMP	EQUERR		/TYPE CONFLICT
	CLA
MOV2WD,	TAD	EXPVAL+1	/D.P. OR ADDRESS SYMBOL
