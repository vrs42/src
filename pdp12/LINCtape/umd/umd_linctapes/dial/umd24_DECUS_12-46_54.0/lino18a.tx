GETEM,	0
	CLA CMA			/CHECK PASS NUMBER
	TAD	PASSNO
	SNA CLA
	JMP	START		/IF PASS 1 THEN NO LISTING
	TAD	LISTSW		/CHECK LIST STATUS
	SNA CLA
	JMP	START		/NO, DONT LIST
	TAD	OUTSWT		/DID THIS LINE GENERATE OUTPUT?
	SZA CLA
	JMP	START		/YES, NO PRINT NECESSARY
	JMS I	[PRINTC		/PRINT CR/LF
	TAD	LINENO		/PRINT LINE NUMBER
