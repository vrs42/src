	JMP	NOTEG
	JMS I	[ERMSG		/EXTRA GARBAGE ON LAST LINE
	0507			/*EG*
NOTEG,	TAD	SCSWT		/DID LAST LINE END WITH SEMICOLON ?
	SNA CLA
	JMP	.+5		/NO
	DCA	SCSWT		/KILL SC SWITCH
	ISZ	CHRPTR		/SKIP OVER SEMICOLON
