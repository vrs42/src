	1504			/*MD*
	JMP I	(ASMBL		/FIELD IS OK
NEWLBL,	CLL CML RTL		/BUMP NEXT BY 2
	TAD	NEXT		/TO MAKE ROOM
	DCA	NEXT		/FOR NEW SYMBOL
