	ISZ	OCNT
	JMP	OLOOP
	TAD	[240		/PRINT BLANK
	JMS I	[PRINTC
	JMP I	OCTOUT
ENDEXP,	JMS I	[BACK1		/END OF EXPR, PUT BACK CHAR
	TAD	LITRL		/LITERAL ?
	SZA CLA
	JMS I	(CRLIT		/GO CREATE LITERAL
	TAD	EXPSW		/DONT SKIP IF NO EXPRESSION
	SZA CLA
	JMP I	(BAD		/BECAUSE ITS AN ERROR
	TAD	LASTOP		/WAS THERE A TRAILING OPERATOR ?
