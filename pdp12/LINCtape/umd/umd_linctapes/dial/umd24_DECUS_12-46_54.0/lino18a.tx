	TAD	M1000		/NUMBER OF CHARS PER BLOCK
	DCA	CHRCNT
	TAD	[SOURCE		/SOURCE FILE BUFFER
	DCA	WDPTR		/INTO POINTER
	DCA	ODDEVN		/START WITH EVEN CHAR
	TAD	SBLOCK		/FIND BLOCK NUMBER
/	TAD	SFUDGE
	DCA	RDBLOK
	TAD	STAR20		/CHECK FOR FIRST READ
	SZA CLA
	JMP	.+6
