*20
/DEMO PROGRAM FOR KWANDA
/
/NOTE THAT TO REFRESH,THE DATA FIELD
/MUST BE SET TO THE SEGMENT IN WHICH
/THE TEXT AND ANSWER BUFFERS ARE LOCATED.
/
/TO CONTINUOUSLY REFRESH UNTIL A LF IS TYPED,
/I.E. ONLY DISPLAY THE TEXT,CHANGE LOC.31
/TO JMP QARFSH
	SEGMNT 0
	*20
	IOB
	6032		/CLR TTY FLAGS
	IOB
	6046
	CLR
	LIF 1
	JMP QENTR	/GO TO KWANDA IN SEG 1
	TXT1		/TEXT & ANSWER STRINGS
	ANS		/IN SEG 0
	JMP EXIT	/DONT REFRESH YET
	HLT
TXT1,	TEXT ZFDISPLAY O.K.<03\Z
ANS,	0
	0
	0
EXIT,	LIF 2		/GO SAMPLE & DISPLAY
	JMP 20
REENT,	LIF 1		/NOW REFRESH
	LDF 0		/1ST CHANGE TO DF=0
	JMP QARFSH	/REFRESH
	SEGMNT 2
	*20
	SAM 0		/SAMPLE & DISPLAY
	AZE I
	HLT
	DIS I 1
	LIF 0
	JMP REENT
	QENTR=1703
	QARFSH=1061
