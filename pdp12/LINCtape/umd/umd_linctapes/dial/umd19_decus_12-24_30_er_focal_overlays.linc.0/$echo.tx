*20
/
/THIS OVERLAY DEFINES AN FZ
/FUNCTION TO DELETE OR RESTORE
/THE TTY INPUT ECHO.
/
/FZ=0--RESTORE ECHO
/FZ=1--DELETE ECHO
/
	PMODE
	*35
	XFZ-1		/BOTTOM
	*412
	XFZ		/INSERT FUNCTION IN TABLE
	*2165
ECHOLC,	4551		/ECHO LOCATION
	*4604
XFZ,	JMS I 53
	SZA CLA
	JMP .+3
	TAD ECHO
	JMP .+2
	TAD NOECHO
	DCA I LCECHO
	CLA CLL
	JMP I 136
ECHO,	4551
NOECHO,	7000
LCECHO,	ECHOLC
	LISTAP-7
