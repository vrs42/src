*20
	
/FOCAL-12 OVERLAY TO READ THE
/SWITCHES
/WRITTEN BY MARTY KAYE
/DIGITAL EQUIPMENT CORP.
/
/USE THE COMMAND:
/SET A=FX(N)
/WHERE N IS SNS 0 TO 5
/TO READ THAT SNS
/ERROR MESSAGE:
/?18.93 - N > 5 TYPED
/
	*20
	PMODE
	BOTTOM=35
	FEXP=4620
	FLAC=44
	ERROR2=4566
	EFUN3I=136
	PFZ=412
	PFX=PFZ-1
	INTEGER=53
	*BOTTOM
	FX-1
	*PFX
	FX
	*FEXP-70
FX,	JMS I INTEGER	/GET N
	SPA		/N MUST BE POS.
	ERROR2
	TAD M5
	SMA SZA CLA	/N MUST BE 0-5
	ERROR2
	TAD FLAC+2	/GET N
	TAD P440
	DCA TAG		/MAKE SNS INSTR.
	IAC
	IOF
	LINC
TAG,	0		/READ SNS N
	11
	2
	ION
	DCA FLAC+2
	JMP I EFUN3I
C7,	0007
TEMP,	0000
M5,	-5
TRY,	0000
C7770,	7770
P440,	440
	LISTAP-7
