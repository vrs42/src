*20
/FX FOR ADDITIONAL FUNCTIONS
/PRELIMINARY VERSION PER
/DAVE COPE.
/IMPLEMENTS FUNCTIONS AS
/DESCRIBED ON PAGE 61
/LAB. COMPUTER HANDBOOK.
/15 JAN 1971.
/
/OPTIMIZED AND ADAPTED FOR FOCAL-RT
/ED RAPOPORT
/MARCH 1973
	PMODE
	BOTTOM=35
	FEXP=5112	/IN2 FOR FOCAL-RT
	FLAC=44
	EFUN3I=136
	PFZ=412
	PFX=PFZ-1
	PFNEW=PFZ-2
	INTEGE=53
	P13=5
/
/
	*BOTTOM
	FX-1
	*PFX
	FX
	*FEXP-142
FX,	JMS I INTEGE	/GET INTEGER ARG
	IOF		/FOR LMODE CODE
	LINC
	LMODE
	STC ARG		/SAVE ARG
	ADD 0
	STC ZERO
	ADD ARG
	ADD M5
	APO I		/SENSE SWITCHES?
	JMP NOTSNS	/NO
	LDA I		/YES
ARG,	0
	ADD ISNSI	/FORM SNS I N
	STC .+1
	0		/SNS I N
	ADD ONE		/SW=1
EXIT,	PDP		/SW=0
	PMODE
	DCA FLAC+1	/STORE ANSWER
	DCA FLAC+2
	TAD P13
	DCA FLAC
	LINC
	LMODE
	SET I 0		/RESTORE LOC 0
ZERO,	0
	PDP
	PMODE
	ION
	JMP I EFUN3I	/BACK TO FOCAL.
	LMODE
M5,	-5
ISNSI,	SNS I
ONE,	1
/
/
NOTSNS,	ADD M2		/HERE WITH ARG-5
	APO I		/LSW OR RSW?
	JMP STATUS	/NEITHER
	COM		/AC=-1 FOR LSW,    OR -0 FOR RSW
	ADD ISW		/FORM LSW OR RSW
	STC .+1
	0
	JMP EXIT
M2,	-2
ISW,	RSW
/
/
STATUS,	ADD M28		/HERE WITH ARG-7
	APO I		/RELAYS?
	JMP XSENS	/NO, SENSE LINES
	STC ARG		/YES
	RTA		/GET RELAY STATUS
	STC RELAYS
	ADD ARG
	ADD P6
	APO		/CLOSE RELAYS?
	JMP OPEN	/NO
	JMP GETBIT	/SET AC BIT
	BSE I
RELAYS,	0		/OR WITH RELAYS
	ATR
	JMP EXIT
P6,	6
M28,	-34
/
/
OPEN,	ADD P10
	APO		/OPEN RELAYS?
	JMP READ	/NO, READ STATUS
	JMP GETBIT	/YES
	COM
	PDP
	PMODE
	AND RELAYS
	LINC
	LMODE
	JMP OPEN-4
P10,	12
/
/
READ,	ADD P10
	JMP GETBIT
	PDP
	PMODE
	AND RELAYS
	LINC
	LMODE
	AZE I		/RELAY CLOSED?
	JMP EXIT	/NO
	CLR		/YES
	ADD ONE
	JMP EXIT
/
/
XSENS,	ADD M20
	APO		/SENSE LINES?
	JMP .+3		/YES
	CLR		/NO, INVALID ARG
	JMP EXIT
	ADD P15
	ADA I
	SXL I
	STC .+1
	0		/SXL I N
	ADD ONE
	JMP EXIT
M20,	-24
P15,	17
/
/
GETBIT,	COM		/WE MUST FORM A
	ADA I		/BIT IN THE AC
	ROL 6		/CORRESPONDING
	STC .+2		/TO THE
	ADD ONE		/REQUIRED RELAY.
	0
	JMP 0
/
	LISTAP -7
