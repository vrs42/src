ASULP2,	DECODE			/GET THE OUTPUT UNIT
	COUTPUT			/OUTPUT OPTIONS
	SEARCH			/LOOKUP REPLY
	ACPL1			/REPLY LIST
	ASUGO2			/WHERE TO GO WHEN FOUND
