/
DSET,	0
	MONE			/SET TO ALL ONES SO RK08 CONTROLLER WILL THINK ITS THE
	DCA I	CRKPTN		/WRONG UNIT AND WILL GIVE A POWER CLEAR.
	TAD	BNUM		/GET THE NUMBER OF BUFFERS NOW.
	AND	L7770		/SEE IF GREATER THEN 20. ACTUALLY 10 WILL DO
	SNA CLA			/?
	JMP	DSETP1		/NOT 8K. NO REBOOTSTRAP.
	MOVE
	RKBTST			/SAVE OLD INSTRUCTIONS
	RKBST			/IN CARD READER TEMP.
	2
	MOVE
	RKSETU			/NOW MOVE IN KEYBOARD TEST INSTRUCTIONS.
	RKBTST
	2
DSETP1,	TAD	DTAB1		/GET THE FIRST TABLE LOCATIONS
	DCA	AUTO1		/SAVE AWAY
DCLOOP,	TAD I	AUTO1		/GET THE NEX ADDRESS
	SNA			/IS IT ZERO????
	JMP I	DSET		/YEP. RETURN
	DCA	TEMP		/SAVE THE ADDRESS
	TAD	DSYSBIN		/GET THE CORRECT NEW UNIT
	DCA I	TEMP		/AND SET IT UP.
	JMP	DCLOOP		/GO BACK FOR NEXT.
/
