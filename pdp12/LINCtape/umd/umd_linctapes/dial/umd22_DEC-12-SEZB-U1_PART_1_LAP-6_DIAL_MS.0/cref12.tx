	JMP	NBAD		/NO - GO TO NEXT SYMBOL
	ISZ	AUTO2		/YES - END OF SYMBOL?
	JMP	NLOOP2		/NO - COMPARE NEXT WORD
	ISZ	NSERCH		/YES - MATCH IS HERE
