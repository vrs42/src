	JMP I	AAAAAA		/YEP. IGNORE IT.
	TAD	BTEMP1		/UPDATE OLD CHAR
	DCA	ALASTC
	ISZ	ORIGIN		/TEST LEFT OR RIGHT SWITCH
	JMP	AAA2		/RIGHT HALF
	TAD	BTEMP1		/LEFT HALF
	RTL
	RTL
	RTL
	AND	L7700		/PLACE IN LEFT HALF OF WORD
