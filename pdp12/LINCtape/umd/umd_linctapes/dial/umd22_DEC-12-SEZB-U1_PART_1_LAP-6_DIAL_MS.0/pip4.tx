AGETN,	0			/CONVERTS FNAME INTO A NUMBER(IF NOT THERE RETURNS TO .+1, OTHERWSIE TO .+2)
	LINC			/GO OVELMODE
	LMODE
	SET I	1		/SET 1 TO POINT TO FNAME BLOCK.
	FNAME+6000-1
	LDF	0		/IN DF 0
	STC	AGNUM		/ZAP OUT PRESENT NUMBER.
	SET I	2		/SET 2 TO A COUNT.
	-5
