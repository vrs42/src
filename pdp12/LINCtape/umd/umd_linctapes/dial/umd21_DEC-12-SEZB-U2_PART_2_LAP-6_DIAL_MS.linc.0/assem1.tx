			/GENERATES A -2 IN AC WHEN EXECUTED.
MTHREE=7346		/CLA CLL CMA RTL
				/GENERATES A -3 IN AC WHEN EXECUTED.
/
/
/
/
/
/
TERMC=00			/SET TERMC TO 44 IF DOLLAR SIGN IS THE END OF FILE CHAR.
