*20
	PMODE
	FLAC=44
	INBUF=34
	EFUN3I=136
	PRINTC=4551
	INTEGER=53
	BOTTOM=35
	PFNEW=410
	FINT=4407
	FNOR=7000
	FEXT=0
	FEXP=4620
	*BOTTOM
	OUTPUT-1	/NB USUALLY FNEW-1
	*PFNEW
	FNEW
	*FEXP-31
OUTPUT,	JMS I INTEGER
	PRINTC
	JMP I EFUN3I
/S A=FNEW(N)  IF N=0,TYPE FLAC;IF NOT 0,KBD TO FLAC
FNEW,	JMS I INTEGER
	SZA CLA
	JMP OUTPUT
	TAD INBUF
	SNA
	JMP .-2
	PRINTC
	TAD INBUF
	DCA FLAC+2
	DCA FLAC+1
	DCA INBUF
	TAD P27
	DCA FLAC
	FINT
	FNOR
	FEXT
	JMP I EFUN3I
P27,	27
	LISTAP -7
