	CLA CMA		/NO. ADD 1 TO SKIP BECAUSE OF END OF THIS STATEMENT.
	TAD	ACOUNT
	DCA	ACOUNT
	TAD	PACHECK
	DCA I	PSWITCH
	TAD	ASEND
	DCA I	PDOLLAR
	TAD	AMAINPS
