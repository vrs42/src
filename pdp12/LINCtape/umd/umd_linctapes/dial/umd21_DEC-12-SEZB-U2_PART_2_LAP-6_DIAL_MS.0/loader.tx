BM1,	-1
BM4,	-4
BNOL74,	NOL74
BMOVE,	MOVE
BLN4,	LN4
BBTAB,	PTABLE+340
BTEMP,	TEMP
BM17,	-17
BLITLOD,LITLOD
BBTAB2,	PTABLE+357
BCIFCDF,CIF CDF	0
BLRET,	LRET
BLUNIT,	LUNIT
BINDEX,	INDEX
BLBLOCK,LBLOCK
BINCR2,	INCOR2
BLLOC,	LLOC
BLNUM,	LNUM
BREAD,	READ
BM100,	-100
