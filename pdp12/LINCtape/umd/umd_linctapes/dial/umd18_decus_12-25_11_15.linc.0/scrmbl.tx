*20
/
/
/QANDA UNSCRAMBLER
/CONVERTS ASCII NUMBERS TO OCTAL CODE
/
/LEADING ZEROS NOT REQUIRED FOR OCTAL INPUT
/LEADING ZEROS REQUIRED FOR DECIMAL INPUT
/
/A ? ENTRY CAUSES ERROR EXIT
/
/+ NUMBER MEANS INPUT IS OCTAL
/- NUMBER, INPUT INTERPRETED AS DECIMAL
/
/USES INDEX REGISTERS 1,2 ? 3
/
SCRMBL,	LDA
	0
	BCL I
	6000
	STC 1
	LDA 1
	STC 2
	LDA I 1
	STC 1
	ADD 0
	ADD TWO
	STC E4
	ADD E4
	ADD ONE
	STC EXIT3
	STA 1		/CLEAR IT UP
	STC 3
ANOTHR,	LDH I 2
	SHD I
	7400
	JMP ADVANC
	SHD I
	3400
EXIT3,	0		/TERMINATOR
	SHD I
	7700
E4,	0		/? EXIT
	AZE I
	JMP ANOTHR
	BCL I
	7760
	STC TEMP
	JMP TEST
	LDA 1
	ROL 3
	ADD TEMP
	STA 1
	JMP ANOTHR
TEST,	LDA I
OCTDEC,	0
	APO I
	JMP 0		/+ = OCTAL
	LDA
	3
	ADA I
	MULIST
	STC.+2
	LDA
	0
	STC.+3
	ADD TEMP
	MUL I
	0
	ADM 1
	XSK I 3
	JMP ANOTHR
ADVANC,	XSK I 1
	CLR
	STA 1		/CLEAR IT UP
	STC 3
	JMP ANOTHR
MULIST,	1750
	144
	12
ONE,	1
TWO,	2
TEMP,	0
/
/
/TITLE: SCRMBL
/
/R.E.K.
/LAST REVISION:
/23-OCT-70
