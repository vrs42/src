	CLA
	MQA		/QUOTIENT TO AC
	TAD	ROOT	/ADD APPROX TO QUOTIENT
	IAC
	CLL RAR		/DIVIDE BY 2
	DCA	SINE	/SAVE
	TAD	ROOT	/SUBTRACT OLD ROOT FROM NEW ONE
	CIA
	TAD	SINE
	SNA CLA
	JMP	SQRT1	/=0
	TAD	SINE
	DCA	ROOT	/NEW ROOT
	JMP	SQRT2
	 
SQRT1,	TAD	ROOT
	JMP I	SQRT
	 
	 
	EJECT
	PMODE
/MOVE PTS FROM ONE AREA TO ANOTHER
/10 = OLD BUFFER
/11 = NEW   "
/IF CMPFLG=1, COMPLEMENT VALUE
MOVPTS,	0
	CDF1
NXTPT,	TAD	CMPFLG
	CLL RAR		/TO LK
	TAD I	10
	SZL
	CIA
	DCA I	11
	ISZ	TEMPR
	JMP	NXTPT
	CDF0
	JMP I	MOVPTS
	 
/MOVE REAL OR MAGNITUDE VALUES
/FROM 0 TO 2000
/AND SWAP HALVES
/DO NOT COMPLEMENT
MVRLMG,	0
	CMA		/OLD ADDR OF 1ST 1/2 = 0
	DCA	10
	TAD	GR	/NEW ADDR OF 1ST 1/2 = 2000 + 1/2 NO OF PTS
	TAD	C1777
	DCA	11
	TAD	ADD2
	DCA	TEMPR	/MOVE 1/2 NO OF PTS
	DCA	CMPFLG	/DONT COMPLEMENT
	JMS I	PMVPTS	/MOVE THEM
	CMA		/OLD ADDR OF 2ND 1/2 = 1/2 NO OF PTS
	TAD	GR
	DCA	10
	TAD	C1777	/NEW ADDR OF 2ND 1/2 = 2000
	DCA	11
	TAD	ADD2
	DCA	TEMPR	/1/2 NO OF PTS
	JMS I	PMVPTS	/MOVE THEM
	JMP I	MVRLMG
	 
	EJECT
