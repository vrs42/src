	SUBROUTINE DPARM(M,K)
C			FILE: ADTAPE:DPARM.FT
	COMMON NDEV,N1,N2,N3,N4,NBLK,NMAX,NLEN
	COMMON NEW,NSAM,NDIS,NADC,NADCS
	COMMON NSPB,NCAL,JC,IC
	DIMENSION NDEV(2),NADCS(8)
C
	DIMENSION DC(8)
C
	SR=ENCODE(NSAM)
	DCAL=ENCODE(NCAL)
C
C	CONVERT CHANNEL NUMBERS
	DO 15 J=1,NADC
	DC(J)=ENCODE(NADCS(J)/8*10+IREM(0))
15	CONTINUE
C
C	LOAD FILE NAME
STAD \N1
SDCA FN1
STAD \N2
SDCA FN1#
STAD \N3
SDCA FN2
STAD \N4
SDCA FN3
C
C
30	CONTINUE
C	DISPLAY CURSOR:  1920=3700=^
	CALL DISP9(JC,IC,1920)
C	DISPLAY 'FILE NAME'
SCALL 3,DISP9
SARG (60
SARG (300
SARG FN
SCALL 3,DISP9
SARG (320
SARG (300
SARG (5600
SCALL 3,DISP9
SARG (324
SARG (300
SARG FN3
	CALL DFILE
C
C	DISPLAY 'SAMPLE RATE'
SCALL 3,DISP9
SARG (60
SARG (200
SARG SR
	CALL DISP9(158,128,SR)
	CALL DISP9(208,128,' MS')
C	DISPLAY '# OF CHANNELS'
SCALL 3,DISP9
SARG (60
SARG (100
SARG NCH
	CALL DISP9(188,64,64*(NADC+48))
C	DISPLAY 'CHANNELS:'
SCALL 3,DISP9
SARG (60
SARG (0
SARG CHS
	DO 45 I=1,NADC
	CALL DISP9(83+I*30,0,DC(I))
45	CONTINUE
C	DISPLAY #CAL
	CALL DISP9(48,-64,'# CAL')
	CALL DISP9(78,-64,DCAL)
SCPAGE 2
S6031		/KSF: SKIP IF FLAG SET
SJMP \30
	CALL GCHAR(M,K)
	RETURN
C
C======================================
C
C	SUBROUTINE DFILE
SENTRY DFILE
SDFILE,	BLOCK 2
	CALL DISP9(238,192,NEW)
	CALL DISP9(278,192,ENCODE(NBLK))
	CALL DISP9(338,192,ENCODE(NMAX))
	CALL DISP9(398,192,ENCODE(NLEN+1))
	CALL DISP9(418,208,'BLOCK')
SRETRN DFILE
C
C=====================================
C
SCPAGE 11
SFN,	TEXT 'FILE NAME '
SFN1,	BLOCK 2
SFN2,	BLOCK 2
SFN3,	BLOCK 2
SCPAGE 13
SSR,	TEXT 'SAMPLE RATE'
SNCH,	TEXT '# OF CHANNELS'
SCHS,	TEXT 'CHANNELS:'
	END
