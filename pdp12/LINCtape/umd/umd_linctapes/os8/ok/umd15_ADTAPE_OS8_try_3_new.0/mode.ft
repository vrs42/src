	SUBROUTINE MODE
C			FILE: MODE.FT
	COMMON NDEV,NAME,NBLK,NMAX,NLEN
	COMMON NEW,NSAM,NDIS,NADC,NADCS
	DIMENSION NDEV(2),NAME(4),NADCS(8)
C
C	ISENS(2) -> CALL CALIBRATION
C	ISENS(1) -> CALL WAIT ('BEGIN')
C
	ICC=64+3
	ICL=64+12
	ICX=64+24
C
5	CONTINUE
	IF(LSENS(2))33,33,63
63	IF(LSENS(3))23,23,64
64	CALL DFILE
	CALL DISP9(-200,100,'MODE')
C	CALL DISP9(-140,64,\91)
SCALL 3,DISP9
SARG (-200
SARG (100
SARG \91
C
SCPAGE 2
S6031		/KSF:
SJMP \5
	CALL GCHAR(M,K)
	M=M+48
	IF(K-6)5,6,5
6	IF(ICC-M)61,33,61
61	IF(ICX-M)5,7,7
7	M=M-ICL+1
	IF(M)5,5,8
C
C	     L M  N O P  Q  R  S  T U  V  W X
8	GOTO(5,5,14,5,5,17,18,19,20,5,22,23,5)M
14	CALL RNAME
17	STOP
18	CALL RPARM
19	NEW=1984
	CALL RFILE(-1,NBLK,NLEN)
	CALL CFILE(NLEN+1)
	CALL RNAME
20	CALL TAPER
	GOTO 5
22	CALL VDISP
23	CALL BOE
33	CALL RELAY(1,1)
	CALL TAPEC
	CALL RELAY(1,0)
	GOTO 5
91	FORMAT(CNQRSTVW)
	END
$
