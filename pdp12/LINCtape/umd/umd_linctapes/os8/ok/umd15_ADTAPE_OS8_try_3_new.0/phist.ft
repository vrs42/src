	SUBROUTINE PHIST(M,NB,MIN,MB)
	DIMENSION M(50)
	WRITE(3,97)0,(J,J=5,60,5)
	WRITE(3,98)('----I',J=5,60,5)
	K=-1376
	MI=M(0)
	MT=MI
	MH=MIN
	WRITE(3,94)   MH,MI,(K,J=1,MI)
	DO 87 I=1,NB
	ML=MH
	MH=MH+MB
	MI=M(I)
	MT=MT+MI
	IF(MI-60)87,87,86
86	MI=61
87	WRITE(3,95)ML,MH,M(I),(K,J=1,MI)
	MI=M(NB+1)
	MT=MT+MI
	WRITE(3,96)MH,   MI,(K,J=1,MI)
	WRITE(3,98)('----I',J=5,60,5)
	WRITE(3,97)MT,(J,J=5,60,5)
	RETURN
94	FORMAT(8H [BELOW I4,2H ]I3,2H I99A1)
95	FORMAT(2H [I4,2H :I4,2H ]I3,2H I99A1)
96	FORMAT(2H [I4,8H AND UP]I3,2H I99A1)
97	FORMAT(8X,4HN = I5,2H I,20I5)
98	FORMAT(12X,7H------I,20A5)
	END
$
