C	PROGARM ADISP
C	THIS PROGRAM DISPLAYS THE VALUE OF AD CHANNELS 0-17
	DIMENSION IC(16)
	DO 1 I=1,16
1	IC(I)=LO+I-1

15	DO 2 I=1,16
	IV=NALOG(IC(I))
	ID=(I-1)/4
	IR=IREM(0)
	IX=40+80*ID
	IY=192-48*IR
	CALL DISP7(IX,IY,IV)
2	CONTINUE
	IF(KEYBD(0))3,15,3
3	M=KEYBD(0)
	IF(M-203)15,4,15
4	STOP
	END
