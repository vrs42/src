	SUBROUTINE IPTIM(I,L,K)
	DIMENSION ITIM(75,40)
	ITIM(I,L)=K
	RETURN
C
C--------------------------------
C
C	FUNCTION IGTIM(I,L)
C
SOPDEF TADI 1400
SOPDEF JMPI 5400
SENTRY IGTIM
SIGTIM,BLOCK 2
SJMS GARG
3	CONTINUE
	II=0
SJMS GARG
5	CONTINUE
	LL=0
10	IGTIM=ITIM(II,LL)
STAD \IGTIM
SRETRN IGTIM
C
SGARG,0
STAD IGTIM
SDCA ICGDF
SICGDF,0
STADI IGTIM#
SDCA ARGDF
SINC IGTIM#
STADI IGTIM#
SDCA ARGAD
SINC IGTIM#
SARGDF,0
STADI ARGAD
SJMPI GARG
SARGAD,0
	II=LL
	END
$
