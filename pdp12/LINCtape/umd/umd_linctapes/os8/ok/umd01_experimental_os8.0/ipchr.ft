	SUBROUTINE IPCHR(I,L,K)
	DIMENSION ICHR(75,40)
	ICHR(I,L)=K
	RETURN
C
C--------------------------------
C
C	FUNCTION IGCHR(I,L)
C
SOPDEF TADI 1400
SOPDEF JMPI 5400
SENTRY IGCHR
SIGCHR,BLOCK 2
SJMS GARG
3	CONTINUE
	II=0
SJMS GARG
5	CONTINUE
	LL=0
10	IGCHR=ICHR(II,LL)
STAD \IGCHR
SRETRN IGCHR
C
SGARG,0
STAD IGCHR
SDCA ICGDF
SICGDF,0
STADI IGCHR#
SDCA ARGDF
SINC IGCHR#
STADI IGCHR#
SDCA ARGAD
SINC IGCHR#
SARGDF,0
STADI ARGAD
SJMPI GARG
SARGAD,0
	II=LL
	END
$
