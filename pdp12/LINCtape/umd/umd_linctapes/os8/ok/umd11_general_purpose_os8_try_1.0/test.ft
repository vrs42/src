C	PROGRAM TEST

	DIMENSION ICRC(2,100)
	PI=3.14159
10	CONTINUE
	READ(1,91)IX,IY
91	FORMAT(' RX=',I3 / ' RY=',I3)
	RX=IX
	RY=IY
	Q=2.*PI/100.
	DO 15 I=1,100
	XC=RX*SIN(FLOAT(I)*Q)
	YC=RY*COS(FLOAT(I)*Q)
	ICRC(1,I)=XC+.5
	ICRC(2,I)=YC+.5
15	CONTINUE
20	IF(ISENS(0))20,20,21
21	CONTINUE
	CALL DISP2(100,ICRC)
	IF(ISENS(0))22,22,21
22	CONTINUE
	GOTO 10
	END
