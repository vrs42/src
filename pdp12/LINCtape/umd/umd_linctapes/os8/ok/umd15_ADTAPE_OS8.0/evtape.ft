C	PROGRAM ADTAPE (EVOKED POTENTIAL VERSION)
C	THIS PROGRAM USES THE NEW:EVPTAP VERSION OF TAPER.FT
	COMMON NDEV,N1,N2,N3,N4,NBLK,NMAX,NLEN
	COMMON NEW,NSAM,NDIS,NADC,NADCS
	COMMON NSPB,NCAL,JC,IC,JB,IB
	COMMON NBI,NII,NBF,NIF,IFIL
	COMMON IBUF,JBUF,KBUF
	DIMENSION NDEV(2),NADCS(8)
	DIMENSION IFIL(97),IBUF(256),JBUF(256),KBUF(256)
C	NAME=X.AD
	N1=1536
	N2=0
	N3=0
	N4=68
	NCAL=99
C
	NSAM=6
	NADC=6
	NADCS(1)=8
	NADCS(2)=9
	NADCS(3)=10
	NADCS(4)=11
	NADCS(5)=12
	NADCS(6)=13
	NDEV=1
	CALL SETU
C
C====================================
C
C	SUBROUTINE BOE
C
C	NLEN: NEXT BLOCK TO FILL
C
C*** LSENS(1): BEGIN TAPING
C*** LSENS(2): ABORT TRIAL
C	PUSH 'ALT MODE' TO GET OUT
C
C*** RELAY(1): DATA OVERRUN
C*** RELAY(2): READY SIGNAL TO LAB
C*** RELAY(3): TRIAL ON
C
SENTRY BOE
SBOE, BLOCK 2
8	CONTINUE
	CALL RFILE(2,NBLK+NLEN,KBUF)
	CALL TAPEI
	CALL RELAY(2,1)
10	CONTINUE
	CALL DISP9(-200,100,'BEGIN')
	CALL DFILE
C	IF(KRB=375)GOTO 15
SKSF
SJMP \11
SKRB
STAD (-375
SSNA CLA
SJMP \15
11	IF(LSENS(1))12,12,10
12	CONTINUE
	JBLK=IBLK
	CALL RELAY(3,1)
	CALL TAPER
	CALL RELAY(3,0)
	CONTINUE
	CALL KWMEA(-1984,400,0)
	CONTINUE
13	CALL TAPED
	IF(ICLCK(0))14,13,14
14	CONTINUE
	GOTO 11
15	CALL RELAY(2,0)
	CALL MODE
	END
$
