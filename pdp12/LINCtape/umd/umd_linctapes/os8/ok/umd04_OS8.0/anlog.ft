2	CALL DISP7(200,50,NALOG(0+ISENS(1)*8))
	CALL DISP7(200,40,NALOG(1+ISENS(1)*8))
	CALL DISP7(200,30,NALOG(2+ISENS(1)*8))
	CALL DISP7(200,15,NALOG(3+ISENS(1)*8))
	CALL DISP7(350,50,NALOG(4+ISENS(1)*8))
	CALL DISP7(350,40,NALOG(5+ISENS(1)*8))
	CALL DISP7(350,30,NALOG(6+ISENS(1)*8))
	CALL DISP7(350,15,NALOG(7+ISENS(1)*8))
	K1=ISENS(0)*1024+ISENS(1)*64+ISENS(2)*8+ISENS(3)
	K2=ISENS(4)*1024+ISENS(5)*64
	CALL DISP7(100,-10,K1)
	CALL DISP7(NALOG(0),-10,K2)
	CALL DISP7(100,30,ISWCH(0))
	CALL DISP7(NALOG(0),30,ISWCH(1))
	K1=LSENS(0)*512+LSENS(1)*64+LSENS(2)*8+LSENS(3)
	K2=LSENS(4)*512+LSENS(5)*64+LSENS(6)*8+LSENS(7)
	CALL DISP7(200,-30,K1)
	CALL DISP7(200,-40,K2)
	IF (KEYBD(0))4,2,4
4	CONTINUE
	END
