CTEST INTERRUPT ROUTINES IN GRAB.
C
C .FORT
C *TEST/L$
C
	DIMENSION IR(5)
	I=IRAN(1)
S	JMS GRAB
S	CPAGE 4
S	TAD (20 ; 6141;0004;0002;CLL CLA
S	TAD (5100 ; DCA \KLR	/CLOCK RATE
S	TAD (0100 ; DCA \KLE	/CLOCK ENABLE
503	DO 502 I=1,5
502	IR(I)=0
	CALL KWMEAS(KLR,IRDSW(0)+1,KLE)
C
C - - - - -
C
500	J=0
S	TAD IR;DCA P1#
S	TAD NM;DCA P2#
	DO 501 I=1,5
S	ION;NOP;IOF
	J=J-16
S	CALL 3,DISP9
SP1,	ARG \IR
S	ARG \J
SP2,	ARG NAM
S	INC P1#; INC P2#; INC P2#
501	CONTINUE
	GOTO 500
C
SIR,	\IR
SNM,	NAM
S	CPAGE 12
SNAM,	TEXT "LF";0
S	TEXT "GB";0
S	TEXT "BG";0
S	TEXT "RA";0
S	TEXT "RK";0
C
SPROG1,	0
S	7325;TAD I P1#;AND (777;DCA I P1#
S	JMP I PROG1
C
C - - - - -
C
CGRAB.TX	MH-ICD.		04/26/75.
C
C SEE GRAB.WU ON TAPE MH #1 FOR INFO.
C
S	PAGE
SGRAB,	0 ; 6203
S	TAD (5100 ; DCA 1
S	TAD SERV  ; DCA 2
SC1,	TAD CODE  ; SNA
SC4,	JMP C3
SC2,	DCA 100 ; INC C1 ; INC C2 ; JMP C1
SC3,	TAD C4 ; DCA GRAB# ; JMP I GRAB
SCODE,	6002;6203;4402;6244;6001;5400;0
SSERV,	SER
SSER,	0 ; DCA AC ; RAR ; DCA AC#
S	6131; SKP ; JMP IN1	/CLOCK INTERRUPT
S	6031; SKP ; JMP IN2	/KEYBOARD
S	6661; SKP ; JMP IN3	/LPT INTERRUPT
SIN0,	6203 ; CLL CLA ; TAD AC# ; RAL ; TAD AC
S	JMP I SER
SAC,	BLOCK 2
SIN1,	JMS PROG1 ; 6135 ; JMP IN0
SIN2,	JMS TTYCH ; JMP IN0		/CLEAR TTY KEYBOARD
SIN3,	6662 ; JMP IN0		/CLEAR LPT
C
STTYCH,	0
S	6036;DCA IT
S	TAD IT;TAD (-203;SNA CLA
S	JMP EXTI
S	TAD IT;TAD (-217;SNA CLA
S	JMP \503 ; JMP I TTYCH
SIT,	0
SEXTI,	JMP I EXOT
SEXOT,	7600
	END
