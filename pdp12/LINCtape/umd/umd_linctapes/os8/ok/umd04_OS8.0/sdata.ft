C SDATA		MH:WRK-ICD,MN.		06/13/75.
C
C WRITE 4 RECORDS OF SOUND TEST DATA WITH NAMES A,B,C,D.
C
C
C PAUSE AC=7; ENTER RECORD NAME CHARACTER IN RIGHT SWITCHES.
C NAMES START AT RS+1 (IF RS=0, FIRST NAME IS 'A')
C
C
C .FORT
C *SDATA/L$
C
C
	COMMON IBUF
	DIMENSION IBUF(256)
	DIMENSION IBUF1(256),IDMY(10)
C
510	PAUSE 7
S	TAD NAM
S	AND (7700
S	OSR		/OR RIGHT SWITCHES WITH AC
S	IAC		/START AT OSR+1 ('A')
S	DCA NAM
C
	IBL=0
	DO501 I=1,4
C
	DO 503 K=17,256
503	IBUF1(K)=I
	DO 504 K=1,256
504	IBUF(K)=I
	CALL WLINC(1,IBL,1,IBUF1,256)
	IBL=IBL+1
C
	DO500 J=1,28
	CALL WLINC(1,IBL,1,IBUF,256)
500	IBL=IBL+1
S	ISZ NAM
C
501	CONTINUE
	GOTO 510
C
S	REORG 200
S	LAP
S	5252;5252;5252;5252
SNAM,	7401
S	BLOCK 4
S	3400;0000;2000;2020;2040
S	0;0
S	BLOCK 200
S	EAP
	END
