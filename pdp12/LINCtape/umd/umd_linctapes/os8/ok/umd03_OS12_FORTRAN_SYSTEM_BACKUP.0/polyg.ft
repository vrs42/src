C     THIS PROGRAM IS TO TEST THE
C     ANALOG INPUTS FOR M. H. 'S
C     VETTER INPUT.
      DIMENSION L1(512),L2(512)
      DO 2 I=1,512
      L1(I)=0
2     L2(I)=0
1     CONTINUE
      L1(I)=NALOG(1)
      L2(I)=NALOG(2)
      CALL DISP6(8)
      CALL DISPA(L1,I)
      CALL DISPA(L2,I)
      CALL DISP5(0)
S     CLA CMA  /-1
S     TAD \I   /FROM I
S     AND (777  /MODULO 512
S     DCA \I
      CALL DISP7(10,200,M1)
      CALL DISP7(10,140,M2)
      IF(KEYBD(0))3,1,3
3     M=KEYBD(0)
      IF(M-203)1,4,1
4     STOP
      END
