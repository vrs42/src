      DIMENSION XNAME(2)
      DIMENSION NBUFF(256)

      XNAME(1) = 'MGD'
      XNAME(2) = 'XX'
      NSTRT = MFILE('DSK',XNAME,MAX)

      DO 100 J = 1,25
  100 NBUFF(J) = J

      CALL WFILE(2,NSTRT,NBUFF)

      LNGTH = 1
      CALL CFILE(LNGTH)

      WRITE (3,200) NSTRT
  200 FORMAT ('1STARTING BLOCK = ',I3)
      WRITE (3,300) LNGTH
  300 FORMAT (' FILE LENGTH    = ',I3)
      WRITE (3,400) MAX
  400 FORMAT (' UNUSED BLOCKS  = ',I3)

      END
