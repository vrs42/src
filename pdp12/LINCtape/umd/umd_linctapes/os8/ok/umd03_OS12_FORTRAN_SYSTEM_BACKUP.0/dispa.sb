      SUBROUTINE DISPA(L,I)
      DIMENSION L(1)
      DIMENSION LXY(2)
      EQUIVALENCE(LX,LXY(1))
	EQUIVALENCE(LXY(2),LYY)
      LX=0
      DO 2 IY=I,512
      LYY=L(IY)
      CALL DISP1(1,LXY)
2     LX=LX+1
      N=I-1
      IF(N)5,5,3
3     DO 4 LY=1,N
      LYY=L(LY)
      CALL DISP1(1,LXY)
4     LX=LX+1
5     RETURN
      END
