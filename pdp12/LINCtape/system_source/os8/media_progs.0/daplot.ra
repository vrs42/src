/ DAPLOT.RA	7/23/75



/ FPP FORTRAN IV D-A PLOTTER DRIVER
/ COMPATIBLE WITH DPLOT, FPLOT, MPLOT, ETC.
/ THIS VERSION IS UNBUFFERED & NON-INTERUPT DRIVEN

/ CALLS ARE:
/	CALL INITDP	(NOT NEEDED)
/	CALL DSCALE(XMIN,YMIN,XMAX,YMAX)
/	CALL DPLOT(N,X,Y,PEN)
/	CALL DPWAIT	(NOT NEEDED)


/ WRITTEN BY:
/	DENNIS MCGHIE
/	CARDIAC SURGERY
/	STANFORD MED. CENTER
/	STANFORD, CALIF.  94305

/	JULY 1975


	SECT	DPLOT


	JA	#DPLOT
	TEXT	+DAPLOT+

DRTN,	SETX	#X0
	SETB	#BASE
#BASE,	FNOP
	ORG	.+2
XMIN,
N,	ORG	.+3
YMIN,
X,	ORG	.+3
XMAX,
Y,	ORG	.+3
YMAX,
PEN,	ORG	.+3
XRANGE,	F 850.
YRANGE,	F 1092.
YTOP,	F 1000.



	ORG	#BASE+30
	FNOP
	JA	DRTN
	FNOP
DPBAK,	JA	.

YSCALE,	F 1.
YZERO,	F 0.
XSCALE,	F 1.
XZERO,	F 0.


#DPLOT,	JSA	PICKUP		/ GET 4 ARGS
	BASE	#BASE
	FLDA%	N
	FNEG
	ATX	1		/ -# OF POINTS TO PLOT
	LDX	-1,2		/ INDEX OFFSET FOR ARRAYS

DPLOO,	FLDA%	PEN,2+		/ GET PEN UP-DOWN VALUE
	ATX	7		/ PUT IN WORD 3 OF XYP
	FLDA%	Y,2		/ GET Y & SCALE IT
	FMUL	YSCALE
	FSUB	YZERO
	ATX	6		/ PUT IN WORD 2 OF TRIPLE
	JGE	DPYGE0		/ CLIP AT 0
	FCLA
	ATX	6
DPYGE0,	FSUB	YTOP		/ CLIP AT YTOP
	JLE	DPYLTT
	FLDA	YTOP
	ATX	6
DPYLTT,	FLDA%	X,2		/ GET X & SCALE IT
	FMUL	XSCALE
	FSUB	XZERO
	ATX	5		/ PUT IN WORD 1 OF XYP
	TRAP4	PLOTX		/ GO MOVE PEN AROUND
DPLO3,	JXN	DPLOO,1+	/ DO MORE IF NOT DONE
	JA	DPBAK



	BASE	0

PICKUP,	JA	.	/ SUBROUTINE ENTRY POINT
	STARTD
	FLDA	30		/ RETN JA
	FSTA	DPBAK
	FLDA	0		/ ARG PTR
	BASE	#BASE
	SETB	#BASE		/ MY BASE LOC
	SETX	#X0		/ ON PLOTTER PAGE
	FSTA	#BASE
	LDX	1,1		/ ARG OFFSET REGISTER

	FLDA%	#BASE,1
	FSTA	N		/ POINTS TO ARG1
	FLDA%	#BASE,1+
	FSTA	X		/ POINTS TO ARG2
	FLDA%	#BASE,1+
	FSTA	Y		/ POINTS TO ARG3
	FLDA%	#BASE,1+
	FSTA	PEN		/ POINTS TO ARG4
	STARTF
	JA	PICKUP		/ RETURN



/ ENTRY TO SCALE PLOT SPACE

	ENTRY	DSCALE

DSCALE,	JSA	PICKUP
	BASE	#BASE
	FLDA%	XMAX
	FSUB%	XMIN
	FSTA	XMAX		/ X RANGE

	FLDA%	YMAX
	FSUB%	YMIN
	FSTA	YMAX		/ Y RANGE

	FLDA	XRANGE
	FDIV	XMAX
	FSTA	XSCALE

	FMUL%	XMIN
	FSTA	XZERO

	FLDA	YRANGE
	FDIV	YMAX
	FSTA	YSCALE

	FMUL% 	YMIN
	FSTA	YZERO

	JA	DPBAK



/ PLOTTER SOFTWARE INITIALIZATION ROUTINE
/ HERE FOR COMPATIBILITY WITH OTHER DPLOTS

	ENTRY INITDP
INITDP,	BASE	0
	FLDA	30
	JAC			/ QUICK RETURN



/ WAIT FOR PLOTTER COMPLETE ROUTINE
/ ALSO NOT NEEDED & IS A NOP

	ENTRY DPWAIT
DPWAIT,	FLDA	30
	JAC			/ QUICK RETURN



	FIELD1	DPLT


/ BASIC PLOTTER MOVE ROUTINE
/ CALLING SEQUENCE:
/   (XYP+0)      X LOCATION IN .01S
/   (XYP+1)      Y LOCATION IN .01S
/   (XYP+2)=-1   INITIALIZE
/   (XYP+2)=0    PLOT WITH PEN DOWN
/   (XYP+2)=1    PLOT WITH PEN UP
/   TRAP4  PLOTX  EFFECTIVE CALL TO PLOTX
	 
/ PLOTTER DEFINITIONS FOLLOW, REMOVE
/ IF ALREADY IN SYMBOL TABLE

	LDP=6177	/ PEN CONTROL
			/ PEN UP IF AC=0
			/ PEN DOWN IF AC=100
	DAX=6152	/ LOAD X DAC
	DAY=6154	/ LOAD Y DAC
	 
PLOTX,	 0
	TAD XYP+2	/ GET PEN
	SMA
	JMP PLOTB

/ INIT SECTION

	CLA CLL
	LDP		/ RAISE PEN ON INIT
	DCA PLOTPN
	TAD XYP		/ GET INIT X
	DCA PLOTNX
	TAD XYP+1	/ GET INIT Y
	DCA PLOTNY
	JMS% DPSWA+1	/ WAIT FOR DONE BEFORE RETURN
PLOTRT,	CDF CIF 0
	JMP% PLOTX

PLOTB,	TAD PLOTPN
	CLL RTR
	SPA CLA
	JMP PLOT1	/ NO CHANGE TO PEN UP OR DOWN
	SNL CLA
	JMP LOWER
RAISE,	DCA PLOTPN	/ WAS DOWN, WANT UP
	LDP
	JMP PLOT1A	/ GO TO COMMON PART
LOWER,	ISZ PLOTPN	/ WAS UP, WANT DOWN
	TAD P100
	LDP		/ LOWER PEN
PLOT1A,	JMS% DPSWA+1	/ WAIT FOR PEN DONE

/ PEN MOVE PART (ALREADY UP OR DOWN)

PLOT1,	DCA PLOTMV	/ AC=0
	TAD XYP		/ GET NEW X
	JMS% COMPA+1
PLOTNX,	0
	DCA PLOTDX	/ ABSOLUTE DELTA FOR X MOVE
	TAD XYP+1	/ GET NEW Y
	JMS% COMPA+1
PLOTNY,	0
	DCA PLOTDY	/ ABSOLUTE DELTA FOR Y MOVE
	TAD PLOTDX
	CLL CIA
	TAD PLOTDY	/ COMPARE DELTA X TO DELTA Y
	SNL CLA
	JMP PLOT2	/ PLOTDY.LT.PLOTDX, LEAVE ALONE
	TAD PLOTDX	/ PLOTDY.GE.PLOTDX, REVERSE THEM
	DCA PLOTNA	/ USE AS A TEMP HERE
	TAD PLOTDY
	DCA PLOTDX	/ PLOTDX= MAX(DELTA X, DELTA Y)
	TAD PLOTNA
	DCA PLOTDY	/ PLOTDY= MIN(DELTA X, DELTA Y)
	IAC		/ MASK FOR Y DIRECTION
	AND PLOTMV	/ (AC)=1 IF Y DIRECTION IS POSITIVE
	TAD PLOTT1-1	/ GENERATE PROPER INSTRUCTION FOR Y MOVE
	JMP .+4
PLOT2,	TAD PLOTMV	/ DELTA X.GE.DELTA Y IF HERE
	CLL RAR		/ X DIRECTION TO BIT 11
	TAD PLOTT2-1	/ GENERATE PROPER INSTRUCTION FOR X MOVE
	DCA .+1
	0000
	DCA PLOT4	/ DROP X OR Y MOVE IN LINE
	TAD PLOTMV
	TAD PLOTT3-1
	DCA .+1
	0000
	DCA PLOTDB	/ DROP COMBINED X,Y MOVE IN LINE
	TAD PLOTDX
	CLL RAR
	DCA PLOTNA
	TAD PLOTDX
	CMA
	DCA PLOTMV	/ COUNTER FOR # MOVE INCREMENTS
	JMP PLOT5	/ END OF LOOP IN CASE DELTAS ARE BOTH 0

PLOT3,	TAD PLOTDY
	TAD PLOTNA
	DCA PLOTNA
	TAD PLOTDX
	CLL CIA
	TAD PLOTNA
	SPA CLA
	JMP PLOT4
PLOTDB,	0000		/ DO 45,135,225,315 DEGREE MOVE
	TAD PLOTDX
	CIA
	TAD PLOTNA
	DCA PLOTNA
	JMP PLOT5-1
PLOT4,	0000		/ DO 0,90,180,270 DEGREE MOVE
	JMS% DPSWA+1	/ WAIT FOR DONE
PLOT5,	ISZ PLOTMV
	JMP PLOT3
	JMP PLOTRT	/ BACK FOR MORE


	TAD .+1
PLOTT1,	JMS% MYA+1	/ PEN RIGHT (-Y)
	JMS% PYA+1	/ PEN LEFT (+Y)

	TAD .+1
PLOTT2,	JMS% MXA+1	/ DRUM UP (-X)
	JMS% PXA+1	/ DRUM DOWN (+X)

	TAD .+1
PLOTT3,	JMS% MXMYA+1	/ DRUM UP, PEN RIGHT (-X,-Y)
	JMS% MXPYA+1	/ DRUM UP, PEN LEFT (-X,+Y)
	JMS% PXMYA+1	/ DRUM DOWN, PEN RIGHT (+X,-Y)
	JMS% PXPYA+1	/ DRUM DOWN, PEN LEFT (+X,+Y)

PLOTPN,		/ 0=UP, 1= DOWN
MYA,	ADDR MY
PYA,	ADDR PY
MXA,	ADDR MX
PXA,	ADDR PX
MXMYA,	ADDR MXMY
MXPYA,	ADDR MXPY
PXMYA,	ADDR PXMY
PXPYA,	ADDR PXPY


PLOTMV,
DPSWA,	ADDR	DPSW+1
PLOTNA,
COMPA,	ADDR COMPAR
P100,	100



/ INDEX REGISTERS

#X0,	0
	0	/ LOOP COUNTER IN DPLOT
	0	/ INDEXER IN DPLOT
PLOTDX,	0
PLOTDY,	0
XYP,	0	/ X
	0	/ Y
	0	/ PEN



	ORG	PLOTX+200	/ PAGE



MOVEX,	0000
	TAD% PLTNXA+1
	DAX
	DCA% PLTNXA+1
	JMP% MOVEX

PLTNXA,	ADDR PLOTNX


PX,	0000
	CLA IAC
	JMS MOVEX
	JMP% PX


MX,	0000
	CLA CMA
	JMS MOVEX
	JMP% MX


MOVEY,	0000
	TAD% PLTNYA+1
	DAY
	DCA% PLTNYA+1
	JMP% MOVEY

PLTNYA,	ADDR PLOTNY


PY,	0000
	CLA IAC
	JMS MOVEY
	JMP% PY


MY,	0000
	CLA CMA
	JMS MOVEY
	JMP% MY


PXPY,	0000
	JMS PX
	JMS PY
	JMP% PXPY


PXMY,	0000
	JMS PX
	JMS MY
	JMP% PXMY


MXPY,	0000
	JMS MX
	JMS PY
	JMP% MXPY


MXMY,	0000
	JMS MX
	JMS MY
	JMP% MXMY



COMPAR,	0
	CIA
	TAD% COMPAR
	DCA CTMP
	ISZ COMPAR
	TAD% PLMVA+1
	RAL CLL
	DCA% PLMVA+1
	TAD CTMP
	SMA
	JMP% COMPAR
	CIA
	ISZ% PLMVA+1
	JMP% COMPAR

CTMP,
PLMVA,	ADDR	PLOTMV



DPSW,	0000
	ISZ WAIT
	JMP .-1
	JMP% DPSW

WAIT,	0
