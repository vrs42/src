/	SUBROUTINE READB (UNIT, BUFR)
/	DIMENSION BUFR(256)
/
/READS 256 (ONE BLOCK OF) BINARY WORDS FROM UNIT <UNIT>
/INTO THE SPECIFIED BUFFER.
/
/
/	SUBROUTINE WRITEB (UNIT, BUFR)
/	DIMENSION BUFR(256)
/
/WRITES 256 (ONE BLOCK OF) BINARY WORDS ONTO UNIT <UNIT>
/FROM THE SPECIFIED BUFFER
/
/	WRITTEN BY:
/	  ROBERT PHELPS
/	  BEHAVIOR LAB
/	  DEPT. RAD. BIOL. & BIOPHYSICS
/	  UNIVERSITY OF ROCHESTER
/	  ROCHESTER, NY  14620
/
/
/
/THE ROUTINE WILL NOT READ OR WRITE PAST THE LENGTH OF THE FILE AS
/DEFINED IN THE DIRECTORY.  AN END OF FILE CAN BE SENSED USING THE
/FOLLOWING CODE IN THE USER'S PROGRAM:
/
/	EXTERNAL EOF
/	LOGICAL EOF
/	.
/	.
/	.
/	IF (EOF) GO TO 900
/	.
/	.
/	.
/  900	[PROCESS END OF FILE]
/	.
/
/	SUBROUTINE RLINK (BLOCK, BUFR)
/
/READ THE SPECIFIED BLOCK ON A LINK FORMAT LINK-TAPE.
/INTO <BUFR> FROM TAPE UNIT 1.
/
/
/EDIT HISTORY:
/	1. (GBI) ALLOW LONG LINK-TAPES. (READB3)
/	2. (RWP) 12/19/78 FIX INCORRECT END OF FILE WHEN AVAILABLE
/			  SPACE ON DEVICE TOO LARGE. (READB4)
	SECT8	READB
	JA	#ST
/
/THE FOLLOWING LOCATINS ARE USED IN THE <FRTS> RESIDENT AND
/MUST BE PROPERLY DEFINED...
/
BADFLD,	102		/LOCATIONS IN <FRTS>************
CHRPTR=	103
RELBLK,	106
TOTBLK,	107
HIFLD,	121		/!!REQUIRES FRTS PATCH FOR DEFINITION!!!!!!!
/
MASSIO=3311
/
RDSRN,	0		/DECODE INFORMATION FROM DSRN TABLE
#CDF,	CDF 0
/
	TAD% BADFLD	/GET BUFFER ADDRESS
	AND K7700
	DCA #XR+5
/
	TAD% BADFLD	/GET BUFFER FIELD
	AND K70
	CLL RTR
	RAR
	DCA #XR+4
	TAD% TOTBLK
	SNA
	JMP RDSRNX	/DON'T FORCE EOF ON NON-FILE STRUCTURED DEVICES
	CLL CIA
	TAD% RELBLK	/ROOM ENOUGH FOR ANOTHER BLOCK?
	SZL CLA
	JMP #EOF	/ATTEMPT TO READ PAST EOF
RDSRNX,	CIF CDF 0
	JMP% RDSRN
/
#EOF,	IAC		/PUT F 1.0 INTO <EOF>
	DCA EOF
	CLL CML RTR
	DCA EOF+1
	DCA #XR+6	/NOTIFY CALLING ROUTINE VIA XR 6
	JMP RDSRNX
/
	ENTRY EOF
EOF,	F 0.0
/
/
/
K70,	70
K7700,	7700
/
#MASS,	0		/ROUTINE TO TRAP4 MASSIO
	CDF CIF 0	/WITH AC SET TO INDICATE A
	TAD #MASS	/WRITE OPERATION
	DCA% #LMASS	/SET RETURN LOCATION
	TAD #LMASS	/GENERATE ENTRY
	IAC		/(COULD HAVE BEEN WITH ADDR PSEUDO-OP)
	DCA #MASS
	CLL CML RAR	/4000 => AC (WRITE)
	JMP% #MASS
/
#RLINK,	0		/PERFORM THE READ OPERATION
	TAD #XR		/  FOR A LINK-TAPE
	AND 	K3777
	DCA BLOCK	/SET-UP THE BLOCK NUMBER
	TAD K7400	/BUFFER STARTING ADDRES
	IOF		/NO INTERRUPTS ALLOWED WHILE IN LINK-MODE
	6141	/SHIFT TO LINK-MODE
	  23	/AC TO TMA 
	1020	/LDA I (LOAD AC FROM .+1
	7020	/FIELD 7 WITH EXTENDED ADDRES MODE
	   1	/LOAD AXO FROM AC
	0710	/READ & CHECK UNIT 1 
BLOCK,	  0
	0002	/RETURN TO 8-MODE
	ION
	CLA
	TAD K7400	/SET BUFFER LOCATION IN XR
	DCA #XR+5
	CIF CDF 0
	TAD% HIFLD
	DCA #XR+4
	JMP% #RLINK
/
K7400,	7400		/LOCATION OF LINK BUFFER
K3777,	3777
/K7000,	7000
/
/
	TEXT	+BIN IO+
#RET,	SETX	#XR
	SETB	#BASE
	JA	.+3
#BASE,	ORG	.+6
#XR,	ORG .+10	/0-2  TEMP FOR WORD BEING SPLIT
			/  3  XR FOR GET
			/4-5  POINTER TO INPUT BUFFER
			/  6  COUNTER
			/  7  XR FOR OUTPUT BUFFER
#LMASS,	MASSIO
FK4096,	F 4096.0
UNIT,	ORG	.+3
	ORG	#BASE+30
	FNOP
	JA	#RET
#RTN,	BASE	#BASE
	JA	.
#ST,	JSA SETUP
	FLDA QUITW	/KLUDGE TO CORRECT POSSIBLE INSTRUCTION
	FSTA QUIT	/  CHANGE LEFT OVER FROM RLINK.
	EXTERN	#RUO
	TRAP3	#RUO
#G0001,	JA	.	/STUFFED WITH UNIT #
	TRAP4 RDSRN
	XTA 6		/WAS AN EOF SENSED?
	JEQ QUIT
	SETX CHRPTR
	LDX 0,0
	SETX #XR
LMASS,	TRAP4 MASSIO	/READ IN NEXT BLOCK
/
#G2,	FLDA% #XR+3,3+	/READ NEXT WORD FROM INPUT BUFFER
	FSTA #XR	/PUT IN XR'S 0-2
	XTA 0		/GET FIRST ONE
	JGE L1
	FADD FK4096
L1,	FSTA% #BASE+3,7+ /STORE IT AWAY
	JXN #G3,6+	/STOP HERE ON THE 86TH ENTRY
	EXTERN	#RENDO
QUIT,	TRAP3	#RENDO
	JA	#RTN
/
#G3,	XTA 1		/GET SECOND WORD
	JGE L2
	FADD FK4096
L2,	FSTA% #BASE+3,7+
	XTA 2		/AND THIRD
	JGE L3
	FADD FK4096
L3,	FSTA% #BASE+3,7+
	JA #G2
SETUP,	JA .
	STARTD
	0210
	FSTA	#RTN,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FLDA%	#BASE,1+
	FSTA	UNIT
	FSTA #G0001,0
	FSTA #G0011,0
	FLDA%	#BASE,1+
	FSTA #BASE+3
	STARTF
	FCLA		/CLEAR EOF FLAG
	FSTA EOF
	LDX -126,6	/# WORDS TO READ -2/3
	LDX -1,3	/XR FOR INPUT
	LDX -1,7	/XR FOR OUTPUT
/
	JA SETUP
/
	ENTRY WRITEB
WRITEB,	JSA SETUP
	TRAP3 #RUO	/SINCE WE DO OUR OWN WRITE VIA #MASS,
			/WE SIMULATE A READ HERE SO
			/THAT AN EXTRA BLOCK IS NOT WRITTEN
			/FOR EVERY RENDO CALL

#G0011,	JA .		/STUFFED WITH UNIT #
	TRAP4 RDSRN
	XTA 6
	JEQ QUITW	/WAS AN EOF SENSED?
	ADDX 1,6	/DON'T INCLUDE LAST WORD IN COUNT
#G12,	FLDA% #BASE+3,3+ /GET THE FIRST WORD
	ATX 0		/PACK IT
	FLDA% #BASE+3,3+
	ATX 1
	FLDA% #BASE+3,3+
	ATX 2
	FLDA #XR	/GET THE PACKED WORD
	FSTA% #XR+3,7+	/PUT IT IN BUFFER
	JXN #G12,6+
	FLDA% #BASE+3,3+ /GET THE LAST WORD
	ATX 3
	ADDX 1,5	/TRICK TO GET LAST WORD STORED
	FLDA #XR+1,0
	FSTA% #XR+3,7
	FCLA
	SETX CHRPTR
	ATX 0		/FORCE MASSIO TO DO I/O OPERATION
	SETX #XR
	TRAP4 #MASS
QUITW,	TRAP3 #RENDO
	JA #RTN
/SUBROUTINE TO READ A BLOCK FROM A LINK FORMAT LINK-TAPE
/
/	THE BLOCK SPECIFIED IS READ AS UNSIGNED INTEGERS
/	INTO THE BUFFER SPECIFIED FROM UNIT 1.
/
	ENTRY RLINK
RLINK,	JSA SETUP
	FLDA QUITW+2	/KLUDGE RETURN SO NO RENDO CALL
	FSTA QUIT	/  WHEN EXITING
	FLDA% UNIT	/GET BLOCK NUMBER
	ATX 0		/PASS IT IN XR-0
	TRAP4 #RLINK	/GO READ THE TAPE
	JA #G2		/USE READB PROGRAM TO PROCESS IT
			/  INTO THE BUFFER.
