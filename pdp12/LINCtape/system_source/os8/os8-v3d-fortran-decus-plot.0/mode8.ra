/SUBROUTINE MODE8 --TO ALLOW EASY CALL OF AN
/	"8" MODE SUBROUTINE FROM FORTRAN IV.
/
/	WRITTEN BY:
/		ROBERT PHELPS
/		COLUMBINE CONSULTANTS
/		AND DEPT. OF RADIATION BIOLOGY
/		UNIVERSITY OF ROCHESTER
/
/	8 SEPTEMBER, 1974
/	MODIFIED 5 AUGUST, 1975
/	TRACEBACK ERROR CORRECTED, 1 APRIL, 1976
/
/CALLED FROM FORTRAN BY:
/
/	EXTERNAL NAME
/	CALL MODE8 (NAME, ARG1, ARG2, ... ARG6)
/
/A MAXIMUM OF 6 ARGUMENTS ARE ALLOWED.  ARGUMENTS NOT NEEDED
/MAY BE OMITTED.  THUS THE SIMPLEST CALL IS:
/
/	EXTERNAL NAME
/	CALL MODE8 (NAME)
/
/IF ARGUMENTS ARE PASSED, ONLY THE LOW ORDER 12 BIT INTEGER
/VALUES ARE USED.  THE VALUES OF THE ARGUMENTS ARE PASSED
/BOTH FROM THE CALLING PROGRAM TO THE 8-MODE SUBROUTINE, AND
/FROM THE 8-MODE SUBROUTINE BACK TO THE CALLING ROUTINE.
/
/8-MODE CODE MUST BE ASSEMBLED BY RALF AND LOADED AS
/ANY OTHER RALF MODULE.  THE CALLING SEQUENCE IS:
/
/	JMS NAME	/DATA FIELD IS SET TO CALLING FIELD
/	JMP CONTIN
/	  (VALUE OF ARG 1)
/	  (VALUE OF ARG 2)
/	    .
/	    .
/	    .
/CONTIN, (CONTINUATION OF CALLING PROGRAM)
/
/
/A SAMPLE SUBROUTINE FOLLOWS:
/
/	SECT8 NAME	/"FIELD1 NAME" MAY ALSO BE USED
/			/	AND THE EFFECT WILL BE TO FORCE
/			/	THE 8-MODE CODE INTO FIELD 1.
/	0		/RECEIVES RETURN LOCATION
/			/	THE RETURN FIELD IS CURRENTLY
/			/	SET TO THE DATA FIELD.
/	RDF		/SET UP THE RETURN FIELD
/	TAD KCIF
/	DCA EXIT
/
/	TAD NAME	/SET UP TO GET PARAMETERS
/	IAC
/	DCA TEMP
/	TAD% TEMP	/GET FIRST PARAMETER
/	DCA FIRST
/	ISZ TEMP
/	TAD% TEMP	/GET SECOND PARAMETER
/	DCA SECOND
/	ISZ TEMP
/	  .
/	  .
/	  .
/	(ASSEMBLER CODE)
/	  .
/	  .
/	  .
/EXIT,	0		/STUFFED WITH RETURN FIELD (CIF N)
/	JMP% NAME
/
/KCIF,	CIF 0
/TEMP,	  0
/FIRST,  0
/SECOND, 0
/	  .
/	  .
/	  .
/
/
SECT8	MODE8
	JA #ST
	TEXT +MODE8 +	/TRACEBACK INFORMATION
#RET,	SETB #BASE
	SETX PARM
	JA .+3
#BASE,	ORG .+6
LOC,	FNOP		/STUFFED WITH ADDRESS OF CALLED
	ADDR .		/   8-MODE SUBROUTINE
#PARMS,	F 0.0
	ORG #BASE+30	/FOR TRACEBACK CONVENTION
	FNOP
	JA #RET
	FNOP
#RTN,	JA .
	BASE 0
ST8,	0
	RIF		/SET DATA FIELD TO CURRENT
	TAD #CDF	/  INSTRUCTION FELD
	DCA .+1
	HLT

	TAD LOC+1		/SET UP INSTRUCTION FIELD OF CALLED SUBROUTINE
	AND K7
	CLL RTL
	RAL
	TAD #CIF
	DCA .+1
	HLT
	JMS% LOC+2	/CALL THE SUBROUTINE!!!
	JMP EXIT
PARM,	0;0;0;0;0;0	/PARAMETERS
	0;0
EXIT,	CDF CIF 0
	JMP% ST8	/RETURN

#CDF,	CDF 0
#CIF,	CIF 0

K7,	7		/MASK
/
/
#ST,	STARTD		/SUBROUTINE STARTS HERE
	FLDA 30		/SET UP RETURN
	FSTA #RTN
	FLDA 0		/GET POINTER TO PARAMETER LIST
	SETX PARM
	SETB #BASE
	BASE #BASE
	LDX 0,7
	FSTA #BASE

	FLDA% #BASE,7+	/GET FIRST FORTRAN PARAMETER
			/  (SR LOCATION POINTER)
	FSTA LOC
	FLDA #BASE	/COMPUTE NUMBER OF PARAMETERS
	FSUB% #BASE	/(POINTS TO END OF PARAMETER STRING)
	LDX 1,6
	ALN 6		/DIVIDE BY 2
	FADD D1		/DON'T COUNT SR POINTER
	ATX 6
	FSTA #PARMS
	STARTF
/
	FCLA
	FSTA PARM,0	/ZERO ANY UNUSED PARAMETERS
	FSTA PARM+3,0
	JSA GET
	ATX 0
	JSA GET
	ATX 1
	JSA GET
	ATX 2
	JSA GET
	ATX 3
	JSA GET
	ATX 4
	JSA GET
	ATX 5
/
DONE,	FLDA% LOC
	FSTA LOC

	TRAP4 ST8

	STARTD		/RESTORE ANY CHANGES IN PARAMETERS
	FLDA #PARMS
	ATX 6
	LDX 1,7
	STARTF
	XTA 0
	JSA PUT
	XTA 1
	JSA PUT
	XTA 2
	JSA PUT
	XTA 3
	JSA PUT
	XTA 4
	JSA PUT
	XTA 5
	JSA PUT
	EXTERN #UE
	TRAP3 #UE
	JA #RTN


D1,	0;1
/
GET,	JA .
	STARTD
	FLDA% #BASE,7+
	FSTA #BASE+3
	STARTF
	FLDA% #BASE+3
	JXN GET,6+
	JA DONE
/
PUT,	JA .
	JXN PCONT,6+
	JA #RTN
PCONT,	ATX 0
	STARTD
	FLDA% #BASE,7+
	FSTA #BASE+3
	STARTF
	XTA 0
	FSTA% #BASE+3
	JA PUT
