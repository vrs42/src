/DISPLAY FORTRAN OUTPUT ON THE LINK SCOPE
/
/CALLING SEQUENCE FROM FORTRAN IV:
/
/	EXTERNAL TV
/	CALL MODE8 (TV, UNIT)
/
/WRITTEN BY
/	R. W. PHELPS
/	DEPT. RAD. BIOL. & BIOPHYSICS
/	UNIVERSITY OF ROCHESTER MEDICAL CENTER
/	ROCHESTER, NY  14642
/
FIELD1 TV; 0
	CLA IAC
	TAD TV
	DCA TEMP	/POINTER TO UNIT NUMBER
	TAD% TEMP	/GET UNIT NUMBER
	CLL RTL		/MULT BY 9
	RAL
	TAD% TEMP
	TAD DSRNBF	/ADD DSRN BUFFER LOCATION
	DCA TEMP
	RDF
	TAD #CIF	/SET RETURN FIELD
	DCA EXIT
#CDF,	CDF 0
	TAD% TEMP	/GET BUFFER & FIELD
	AND K70
	TAD #CDF
	DCA EXDO
	TAD% TEMP
	AND K7700
	DCA BSTART
	ISZ TEMP	/NOW POINTS TO CHAR POINTER
	TAD EXDO
	DCA DL2-1
/
K70,	70		/EFFECTIVE NOP TO MAKE
			/  INST. BELOW ODD
ONCE,	CDF 10		/DO THIS CODE ONLY ONCE
	JMS% #ONQB	/SET UP BACKGROUND JOB
BSTART,	  ADDR #ENTRY
	TAD #ENTRY	/***THIS LOCATION MUST BE ODD***
	DCA ONCE
	TAD% #ONQB	/GET ADDRESS OF BETA REG. 1
	AND K6001
	DCA BETA
EXIT,	HLT
	JMP% TV
/
TEMP,	ADDR ONQB
#ONQB=	.-1
	EXTERN ONQB
BETA=	ONCE+5
#CIF,	CIF 0/BACKGROUND DISPLAY PROGRAM FOR LINK SCOPE
/
#ENTRY,	JMP EXIT
	TAD BSTART	/SET POINTER TO BUFFER
	DCA BPNTR
	TAD KTOP	/SET Y LOC OF FIRST LINE
	DCA TOP
	DCA BETAX
/
DL1,	JMS DO		/DISPLAY 3RD WORD
			/  (LEAVES FIELD SET TO BUFFER
	TAD BPNTR
	CLL CMA
	CDF 0
	TAD% TEMP
	SNL CLA		/END OF BUFFER?
	JMP #EXIT	/YES
	HLT		/RESET DATA FIELD TO BUFFER
DL2,	RTL		/HO BITS OF WRD 1 => BITS 9-11
	RTL		/  OR 3RD WRD => BITS 4-11
	SPA
	JMP DL1		/GO DISPLAY 3RD WORD IF MARKER BIT
			/  IS IN 0 POSN
	DCA W3		/10 => W3 (MARKER BIT FROM LINK SET ABOVE)
	TAD% BPNTR	/GET NEXT CHARACTER
	JMS DO
	TAD% BPNTR	/AGAIN FOR HO BITS
	ISZ BPNTR
	AND K7400	/GET THE HO BITS
	CLL RAL
	TAD W3		/ADD IN OLD BITS OR SAVE
	JMP DL2
/
/
DO,	0		/DISPLAY A CHARACTER
	CDF 10		/SET TO FIELD OF BIT PATTERN (THIS FIELD)
KTOP,	AND K177
	SNA		/NULL?
	JMP EXDO	/YES - SKIP IT
	TAD MCR
	SNA		/WAS CHARACTER A CR (215)?
	JMP CR		/YES
	TAD M40CR	/MAKE IT CHAR -40
	SPA		/WAS IT A NON-PRINTING CHARACTER?
	CLA		/YES - PRINT A BLANK
	CLL RAL
DL3,	TAD LCHARS
	DCA H1
	IAC
	TAD H1
	DCA H2
	IOF		/DISABLE INTERRUPT BECAUSE
			/  BETA REG. MAY BE USED BY
			/  ANOTHER SUBROUTINE.
	TAD% BETA	/SAVE C(BETA)
	DCA X
	TAD BETAX
	DCA% BETA	/CLEAR BETA
	TAD TOP
	  6141	/TO LINK MODE
	  1740	/DISPLAY A CHARACTER
H1,	  0	/  BIT PATTERN
	2
	CLA CLL CMA RTL	/-2 => AC (NEED 7753)
	TAD M40CR
	DCA ONCE+6
	ISZ ONCE+6
	JMP .-1
	TAD TOP
	6141
	  1740	/DISPLAY SECOND HALF
H2,	  0	/  BIT PATTERN
	  2	/TO 8 MODE
	CLA CLL CML RTL	/SPACE BETWEEN CHARACTERS
	TAD% BETA
	DCA BETAX
	TAD X		/RESTORE BETA REG. LOC.
	DCA% BETA
K6001,	ION
EXDO,	HLT		/CDF BUFFER FIELD
	JMP% DO
/
/
CR,	DCA BETAX	/RESET BETA
	TAD TOP
	TAD M100	/SET TO NEW LINE
	DCA TOP
	JMP EXDO
/
/
#EXIT,	CIF CDF 10
	JMP% #ENTRY
/
/
DSRN=	4244
DSRNBF,	DSRN+2-11
BPNTR=	ONCE+1
TOP=	ONCE+3
W3=	ONCE+4
K177,	177
X,	ADDR CHARS
LCHARS=	.-1
M100,
K7700,	7700
MCR,	-15
M40CR,	-40+15
K7400,	7400
/
/
BETAX,	0
