/LOOP WHICH RELATES OS/8 AND RTS HANDLERS

/ *** CAN'T USE LITERALS ON THIS PAGE - S.R. -  1975

INIHNL,	ISZ	HPTR
	TAD I	HPTR	/GET NEXT HANDLER NAME
	SNA
	JMP	ASDONE	/NO MORE
	DCA	ASNAM1
	ISZ	HPTR
	TAD I	HPTR
	DCA	ASNAM2	/STORE HANDLER NAME IN "INQUIRE"
	ISZ	HPTR
	CIF 10
	JMS I	L200
	12		/IS HANDLER THERE?
ASNAM1,	0
ASNAM2,	0
	0
	JMP	INIHNL	/HANDLER NOT IN SYSTEM CONFIGURATION
	TAD	ASNAM2
	TAD	POSHN
	DCA	HNDPTR	/GET POINTER INTO RESIDENT HANDLER TABLE
	TAD	ASNAM2
	TAD	PHNDTAB
	DCA	HTBPTR	/AND EQUIVALENT PTR INTO RTS-8 TABLE
	CDF OS8F1
	TAD	PFAKSYS
	TAD	ASNAM2	/ASSIGN ONE OF THE 17 ENTRY POINTS IN THE
	DCA I	HNDPTR	/FAKE SYSTEM HANDLER TO THIS DEVICE
	CDF OS8F0
	TAD I	HPTR	/GET THE RTS-8 TASK AND UNIT NUMBER
	IFDEF	QDEV2	<
	DCA	QTEMP2
	TAD	QTEMP2
	TAD	MQDEV2
	SZA CLA		/CHECK TO SEE IF HANDLER CORRESPONDS TO QDEV2
	JMP	NOGO
	TAD 	HTBPTR	/GET POINTER TO QDEV2 IN RTS-8 HANDLER TABLE
	CDF	CUR3
	DCA I	DPOINT	/AND SAVE IT FOR QTASK 
	CDF	0
	DCA	QTEMP2	/NOW ZERO THE ENTRY 
NOGO,	TAD	QTEMP2	/GET THE TASK AND UNIT NUMBER
			>
	CDF 0
	DCA I	HTBPTR	/MAKE THE CORRESPONDING ENTRY IN THE
	CDF OS8F0	/OS8 SUPPORT TASK TABLE
	JMP	INIHNL	/GET THE NEXT HANDLER

ASDONE,	CIF 10
	JMS I	L200
	11		/KICK OUT THE USR
	CDF OS8F0
	TAD I	PINITOS
	DCA	HPTR
	CDF CIF 0
	ION		/INTERRUPTS CAN GO BACK ON NOW
	JMP I	HPTR	/RETURN TO OS8SUP

L200,	200
POSHN,	OS8HND-1
PHNDTAB,HNDTAB
PFAKSYS,FAKSYS-1
PINITOS,INITOS
HTBPTR,	HNDTAB+1
HNDPTR,	0
	IFDEF	QDEV2	<
MQDEV2,	-QDEV2
DPOINT,	QDEVPT
QTEMP2,	0		>
