	ENTRCE		/RE-ENABLE TRACE
	JMP I	[IREST	/COMMAND ' NO ACTION TO TAKE

CNDI,	SCAN		/HIT ANOTHER "
	STA		/SO SKIP MATCHING '
	TAD	SKIP
	DCA	SKIP
	RESORT		/GO BACK TO CSML

CTLTAB,	OUTLF	/BELL
	OUTFF
	OUTVT
	OUTLF
	OUTCR
POUTHT,	OUTHT
	4044		/$ WITH SIGH BIT ON

ALTTAB,	4033
	4033		/ALTMODE WITH SIGN BIT ON
