*20
	08-D20A
	 
	CR03 G.D.I. CARD READER TEST
	 
	ST ADD
	LOC 0200=DATA TSTS (8 OR 8I)
	LOC 0201=DATA TSTS (8S)
	LOC 0202=STATIC IOT TSTS
	LOC 0700=SCOPE LOOP
	 
	SW SET
	SW0=0 TST ALPHA-NUMERIC DK
	SW0=1 TST BINARY DK
	SW1=0 SUP DATA ERR TYPE
	SW1=1 PNT DATA ERR
	SW2=0 SUP HLT AFTER ERR TYPE
	SW2=1 HLT AFTER DATA ERR
	SW3=0 HLT END TST DK
	SW3=1 CONT TO NEXT DK
