*20
	MAINDEC-8I-D2AA
	 
	LP08 LINE PRINTER TEST
	 
	ST ADD
	8-MODE
	LOC 200 INITIAL START
	LOC 201 RESTART WITHOUT PWR UP
	LOC 202 PRINT SPEED TEST
	LOC 203 RIBBON TST
	 
	SW SET
	SW11=1 TST 1  PRELIMINARY TST
	SW10=1 TST 2  SING CHAR ALL COL
	SW9=1  TST 3  ROT PAT
	SW8=1  TST 4  WEDGE PAT
	SW7=1  TST 5  HAMMER ALIGNMENT
	SW6=1  TST 6  SLEW TST
	SW5=1  TST 7
	    SUB TSTS
	    SW6 SCOPE DRIVE
	    SW7 PRINT SEG SW9 10 11 FOR SEG
	    SW8 PWR SUPPLY TST
	SW4  PERFORM ALL TST IN SEQ
	SW3  80 COL OR 120 COL
	SW2  64CHAR OR 96 CHAR
	SW1  96 CHAR
	SW1=1  HLT AFTER ERR PRINT
