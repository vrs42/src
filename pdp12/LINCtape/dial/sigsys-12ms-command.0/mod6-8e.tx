	JMP FNDDIQ
	 JMP ENDCOM
/
	LDA
	DILBLK
	SCR 13
	LDA
	DILUN
	LIF 0
DEFX,	JMP
	EJECT
/GET NAME FROM TEXT STRING
/ENTER WITH POINTER IN AC
GTDILQ,	STC BETA3
	ADD 0
	STC GTDIXQ
	SET I BETA2
	4\DILNAM-1
	SET I 17
	-10
PDQ,	LDH I BETA3
