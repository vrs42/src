	PARTM
	ADD MONE
	APO		/HANDLE -0
	COM
	ROL I 11
LDSK,	STC LODSK	/LO 12 BITS
	ROL I 1		/LINK TO BIT0
	ADD HIDSK
	STC HIDSK	/HI 1 BIT
	RETURN
	 
/PARTITION 0 (SYSTEM) HANDLER.
SYSTEM,	ADD KP6000
	ROL I 1		/4000 + 1 IN LINK
AADSK,	JMP LDSK
/END OF DISK ROUTINES.
	 
