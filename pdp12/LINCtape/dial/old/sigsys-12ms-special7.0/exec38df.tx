/0  = SYSTEM = 14000 - 14177 (MAX 14537)
/1  = DATA   = 00000 - 00777
/2  = DATA   = 01000 - 01777
/3  = DATA   = 02000 - 02777
/4  = DATA   = 03000 - 03777
/5  = DATA   = 04000 - 04777
