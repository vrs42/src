	JMP I ISLOWR	/RESP=0:INCREASE
	SMA CLA		/COND. EXP
	JMP FASTER	/RESP=1:DECREASE
/SW 3 -ON:INCORRECT IDENT.(RESP=-1)
/INCREASES STAIRCASE EXPOSURE -OFF:
/DOESNT EFFECT STAIRCASE
	LINC
	LMODE
