*20
// SUBROUTINE COSINE.
	 
/ENTER WITH ANGLE IN RADIANS IN FAC.
/LEAVE WITH COSINE IN FAC.
	 
	 
/FORMULA: COSX= 1 + A2*X^2 + A4*X^4
/         A2= -.49670
/         A4= +.03705
	 
/WHERE, 0<X<PI\2
	 
COSINE,	STORE
	XFAC
	ADD 0
	STC .+11
	LOAD
	A4
	JMP MULT
	FADD
	A2
	JMP MULT
	FADD
	FP1
	0		/LEAVE
	 
A2,	7776		/-.4967
	4015
	4105
	 
A4,	7773		/+.03705
	2276
	0337
	 
FP1,	1
	2000
	0
	 
MULT,	FMUL
	XFAC
	FMUL
	XFAC
	JMP 0
	 
XFAC,	0
	0
	0
//END SUBROUTINE COSINE.
/NOV 73
/FHD
