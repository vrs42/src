*20
/// SAMTTY.
/TYPICAL CLK TIC WAITING ROUTINE WITH
/TTY INTERRUPT CAPABILITY.
	 
/CLOCK SAMPLING ROUTINE.
SAMTIM,	SET 3
	0
	PDP
	PMODE
	 
	6131		/?, CLK
	JMP .-1		/NO
	CLA		/YES
	6135
	LINC
	LMODE
	JMP 3
/END SAMTIM.
	 
	 
/TTY CHECKING LOOP.
TSTKEY,	SET 3
	0
	IOB
	6031		/?, TTY
	JMP 3		/NO, LEAVE
	IOB		/YES
	6036
	SAE I
	377		/RUBOUT
	SKP
	JMP FDONE	/EARLY EXIT
	SAE I
	240		/SPACE
	JMP 3		/BOGUS TTY, LEAVE
	IOB
	6031
	JMP .-2
	IOB
	6036
	JMP 3
/END TSTKEY.
