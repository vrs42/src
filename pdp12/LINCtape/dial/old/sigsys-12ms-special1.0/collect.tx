	P135=1723
/GY,GY,A5INT
	P136=1726
/GYVAR,GYVAR,A5INTVAR
	P137=1731
/HX,HX,A5MN
	P140=1734
/HXVAR,HXVAR,A5MNVAR
	P141=1737
/HY,HY,B1CNT
	P142=1742
/HYVAR,HYVAR,B1CNTVAR
	P143=1745
/IX,IX,B1INT
	P144=1750
/IXVAR,IXVAR,B1INTVAR
	P145=1753
/IY,IY,B1MN
	P146=1756
/IYVAR,IYVAR,B1MNVAR
	P147=1761
/JX,JX,PF
	P150=1764
/JXVAR,JXVAR,PFVAR
	P151=1767
