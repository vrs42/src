*20
///KOSSPRT
/
/PROGRAM TO DUMP THE OUTPUT TAPE
/PRODUCED BY THE PROGRAM "KOSSTRAN"
/
/MOUNT THE OUTPUT TAPE ON UNIT 1
/AND RUN "KOSSPRT"
/
	MESOUT=JMP 43
/
	SEGMNT 5
	*20
	CLR
	AXO
	LDA I
	7000
	STC INBLK
	JMP RDEBLK
/
NXLINE,	JMP GETLIN
	 JMP ENDPRG
/
	LIF 4
	MESOUT
	 LINE
	JMP NXLINE
/
ENDPRG,	LIF 4
	JMP 20
/
/
GETLIN,	SET 1
	0
	SET I 17
	4\LINE-1
/CHECK FIRST CHAR
ISTCHR,	JMP BLKCHK
	LDH I 16
	SAE I
	77
	JMP NXCHR
	SET 15
	16
	LDH I 15
	SAE I
	77
	JMP EOL		/NEW CELL
	JMP 1		/EOF
/
NXCHR,	STH I 17
	JMP BLKCHK
	LDH I 16
	SHD I
	4500
	JMP EOL
	JMP NXCHR
/
EOL,	LDA I
	45
	STH I 17
	LDA I
	43
	STH I 17
	XSK I 1
	JMP 1
/
BLKCHK,	SET 2
	0
	LDA
	16
	SAE I
	7777
	JMP 2
	JMP RDEBLK
	JMP 2
/
RDEBLK,	LDF 7
	RDC 10
INBLK,	0
	LDA I
	1
	ADM
	INBLK
	SET I 16
	4\3400-1
	JMP 0
/
LINE,	0
/
/
//END KOSSPRT
