*20
	MAINDEC-12-D3DB-D
	 
	PDP-12 TAPE DATA EXERCISER
	 
	ST ADD
	LINC MODE LOC 200
	 
	SW SET
	RSW 0=1 DEL ERR HLTS AND RESTART CURRENT PASS
	RSW 1=1 DELETE ERR MESSAGES
	RSW 6-8=NUM OF EXTRA TAPE TRANSPORTS THAN 1
	RSW 9-11=NUM EXTRA 4K MEMORY FIELDS
	 
	SET UP
	MOUNT TAPE ON DRIVES TO BE TESTED
	SET UNIT SEL ST FROM 0 AND INC
	SET REMOTE AND WRITE ENABLE
	 
	ANALOG CH 0-4 CONTROL DISPLAY
