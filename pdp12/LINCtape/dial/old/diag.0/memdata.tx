	MAINDEC-12-DIEA-D
	 
	FLOAT 0NES AND ZEROS THROUGH MEM
	 
	STARTING ADDRESS
	START 20
	 
	SWITCH SETTINGS
	SR00 = 1 SUPPRESS HALT
