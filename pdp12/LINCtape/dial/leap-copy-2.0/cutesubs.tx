[
[JUMP-FF
[
[JUMP FLIP-FLOP
[IF SET, WILL RETURN AT .+2
[IF RESET, WILL RETURN AT .+1
[
[TO SET, JMP 8J-3
[TO RESET, JMP 8J-7
[TO UTILIZE, JMP 8J
[ENTRY AT 8J
[CALL: JMP 8J
[      <RESET DISPATCH>
[      <SET DISPATCH>
[
[RESET
LDA I
NOP
