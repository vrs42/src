SYEX12
	PDP12 SYSTEM EXERCISER
	12-D7CD
	 
	8-1-71
	PDP-12 SYSTEMS EXERCISER
	 
	ST ADD
	PDP-8 MODE
	START 20
	 
	SW SET
	RSW 0 = 1  DEL REC ERR HLTS - RESTART THE CUR PASS
	RSW 1 = 1  DEL ERR MESSAGES
	RSW 2 = 1  INH ST OF LP08-LP12
	RSW 3 = 1  INH ST OF FPP-12
	RSW 4 = 1  INH ST OF RF08-DF32
	RSW 5 = 1  INH ST OF RK08
	RSW 6 - 8  NUM EXTRA TRANSPORTS GREATER THAN 0
	RSW 9 - 11 NUM EXTRA MEM BANKS GREATER THAN 4K
