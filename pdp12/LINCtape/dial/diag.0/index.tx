TC12 I
	MAINDEC-12-D3AE-D
	 
	PDP-12 TAPE CONTROL TEST (PART I OF 2)
	 
	ST ADD
	LSW = 200
	RSW = 0
	8 MODE
	I-O PRES
	ST LEFT SW
	 
	SW SET
	SR00 = 1 SUPPRESS ERROR HALTS
	SR01 = 1 SUPPRESS TYPEOUTS RING BELL ON ERROR
	SR02 = 1 SCOPE LOOP ON A FAILING TEST
	SR03 = 1 SCOPE LOOP ON A NON-FAILING TEST
