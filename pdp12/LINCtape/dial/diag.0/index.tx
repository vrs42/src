EXTAT
	 
	MAINDEC-8-D1HA
	 
	PDP-8 8I EXTENDED MEMORY ADDRESS TEST
	 
	MARCH 13 1968
	 
	OPERATING PROCEDURE
	LSR=200
	8-MODE
	PRESS ST LEFT SW
	TTY PRINTS  TEST LIMITS
	SPECIFY LIMITS VIA KEYBOARD
	TTY PRINTS  SETUP SR
	SET RSW TO 0000
	SW SET
	SR0=1  HLT AFTER TST OR ERR
	SR1=1  INHIBIT ERR PRINTOUT
	SR2=1  BELL ON ERR
	SR3-6  SEL TST
	SR9=1  INHIBIT PROG RELOCATION
	SR11=1 CHANGE LIMITS
	 
	 
	 
	-	-	-	-	-	-	
	 
	 
