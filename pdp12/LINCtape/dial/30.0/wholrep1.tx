/SUBR TYPES CR.LF + PACKED ASCII MESSAGE
/POINTED BY 11, LDF 1
/
MESSAG,	LDA
	0
	STC RJMESG
	LDF 1
	LDH I 11
	AZE I
RJMESG,	HLT		/RETURN:00=END
	SAE I
	43		/CRLF?
	JMP .+3
	JMP CRLF
	JMP RJMESG-2
	ADA I
	-37		/ADD 100 OR 200
	APO		/FOR 8-BIT CODE
	ADD C100
	ADA I
	237
	JMP TYPE
	JMP RJMESG-2
C100,	100
