	XSK I 3		/SKIP MASKED PW
	DSC
	POSMSK
	XSK I 3
	LDA I
DX,	1		/CHAR SPACING
	ADM
	1
	JMP POST
DISPLA,	SET 2
	MNSHOW		/-NO. SHOWN
	XSK I 2		/DONE WITH THEM?
	SKP
	JMP PRE		/YES:PREMASK
	LDA
	VERCO
	DSC I 3		/SHOW 2 CHAR PWS
	DSC I 3
	LDA
	DX
	ADM
	1		/ADVANCE H.C.
	JMP DISPLA+2
PRE,	SET 2
	MNPRE		/-NO. PREMASKED
	XSK I 2		/DONE?
	SKP
	JMP RETURN
	LDA
	VERCO
	DSC I
PREMSK,	7777		/PREMASK PW
	DSC
	PREMSK
	LDA
	DX
	ADM
	1		/ADVANCE H.C.
	JMP PRE+2
RETURN,	PDP
	PMODE
	CLA
	JMP I WINDOW
