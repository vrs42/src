STUNT,	DCA L
	TAD W
	DCA D
	JMP STUNT-5
	CLA
	DCA R
SHRINK,	TAD S
	TAD L
	DCA L
	TAD L
	CIA
	TAD N
	SPA SNA
	JMP EXIT
	DCA D
/SECTION GENERATES LINKAGE FOR DISPLAY
/SUBROUTINE: MNPOST=-(L+1), MNSHOW=-(D+1
/AND MNPRE=-(R+1): -"S ARE 1"S COMPLS.
SHOW,	CLA IAC
	TAD L
	CMA
	DCA MNPOST
	IAC
	TAD D
	CMA
	DCA MNSHOW
	IAC
	TAD R
	CMA
	DCA MNPRE
