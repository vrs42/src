ALTART,	JMP QAINIT
	ART1
	ART2
	JMP QARFSH
	JMP ART3
ART1,	TEXT ZSET ARTIFACT DURATION
	EQUAL TO  <3\Z
ART2,	0
	0
	0
ART3,	LDA
	ART2		/GET 3 DIGIT BCD
	BCL I
	7760
	ROR 4
	STA I
ART5,	0
	LDA
	ART2+1
	BCL I
	6077
	ROR 2
	BSE 
	ART5
	STA 
        ART5
	LDA
	ART2+1
	BCL I
	7760
	BSE
	ART5
	JMP BCDBN	/CONVERT
	LDF 0
	STA
	ART6+UM
	LIF 0
	JMP 21
