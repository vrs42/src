	TAD ASCII
	AND C77
	SNA
	JMP RETURN	/IGNORE "OPEN"
	DCA ASCII	/STRIPPED
	JMS STORE	/PUT INTO BUFFER
RETURN,	ION		/INTER. BACK ON
	JMP I DWRITE
BLNK,	CLA
	TAD C40
	JMP RETURN-2
CR,	CLA
	TAD C43
	DCA ASCII
	JMS STORE	/43=CR CODE
