*20
//SUBROUTINE RADIAN.
	 
/CALLS:  JMP RADIAN
/        ENTER WITH DEGREES IN FAC.
/        EXIT WITH RADIANS IN FAC.
/        RAD=DEG X 2PI\360
/           =DEG X 0.0174533
	 
/        JMP DEGREE
/        ENTER WITH RADIANS IN FAC.
/        EXIT WITH DEGREES IN FAC.
/        DEG=RAD X 360\2PI
/           =RAD \ 0.0174533
	 
/SIGN IS CARRIED THROUGH.
	 
RADIAN,	FMUL
	FCON
	JMP 0
	 
DEGREE,	FDIV
	FCON
	JMP 0
	 
FCON,	7772		/.0174533
	2167
	6435
//END SUBROUTINE RADIAN.
/NOV 73
/FHD
