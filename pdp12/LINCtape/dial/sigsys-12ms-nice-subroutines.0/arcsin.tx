*20
/SUBROUTINE ARCSIN
	 
/ENTER WITH SINE BETWEEN 0 & 1.
/EXIT WITH ANGLE IN RADIANS IN
/FAC & XFAC.
	 
/ARCSIN X = PI/2 - SQRT(1-X) * H(X)
/WHERE H(X)=A0+A1*X+A2*X^2+A3*X^3
	 
ARCSIN,	STORE
	XFAC
	FCOMP
	FADD
	FP1
	SQRT
	FAC
	STORE
	TEMP1
	 
	LOAD
	ASA3
	FMUL
	XFAC
	FADD
	ASA2
	FMUL
	XFAC
	FADD
	ASA1
	FMUL
	XFAC
	FADD
	ASA0
	FMUL
	TEMP1
	FCOMP
	FADD
	PID2
	STORE
	XFAC
	JMP 0		/LEAVE
	 
ASA0,	0001		/1.5707288
	3110
	3322
	 
ASA1,	7775		/-.2121144
	4466
	2675
	 
ASA2,	7774		/.0742610
	2300
	5423
	 
ASA3,	7772		/-.0187293
	5464
	4350
	 
PID2,	0001		/PI/2=1.5707963
	3110
	3756
	 
TEMP1,	0
	0
	0
	 
XFAC,	0
	0
	0
	 
FP1,	0001
	2000
	0000
	 
/END SUBROUTINE ARCSIN.
