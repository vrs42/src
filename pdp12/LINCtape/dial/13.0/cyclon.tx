	PMODE
	ISZ NTIME	/DONE?
	JMP .+2
	JMP I WINDOW	/RETURN
	CLA
	TAD WINDSP
	JMS DOUBLE
	TAD 1
	DCA 1		/INCR H.C.
	JMP WNEXT	/DO NEXT CHAR
/SUBR SAMPLES A-D CHAN 10:EVERY -RSAMP
/TIMES PUTS AC=1 IF ABOVE 200, AC=-1 IF
/BELOW -200, AC=0 OTHERWISE
SAMPLE,	0
	LINC
	LMODE
	SAM 10
	PDP
	PMODE
	TAD M200
	SMA
	JMP .+6
	TAD C400
	SMA CLA
	JMP I SAMPLE	/NEITHER:AC=0
	STA		/LOW:AC=-1
	JMP I SAMPLE
	CLA IAC		/HIGH:AC=1
	JMP I SAMPLE
/SUBR INCR OR DECR DISPOF ACCORDING 
/TO OUTPUT OF SAMPLE
ANADIG,	0
