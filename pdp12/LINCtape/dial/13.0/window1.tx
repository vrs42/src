MODE,	RDC U		/READ TAPE 1
	0		/2ND TAPE INSTR
	PDP
	PMODE
	CLA
	TAD ONCE
	SZA CLA		/DO ONLY ONCE
	JMP CONT
	TAD INPUT+3	/SET LDF 1 FOR
	DCA HOKEY	/LATER USE
	TAD I FIRST	/GET ADD OF
	AND C7400	/HOW MANY I/O
	CLL RTR		/BLOCKS MORE?
	CLL RTR
	CLL RTR
