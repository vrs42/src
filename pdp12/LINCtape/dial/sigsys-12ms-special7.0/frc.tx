	2\FPMDS
	1044
/END PNTRS.
	 
/ROUTINE TO TYPEOUT A CRLF.
	CRLF=JMP .
	SET 4
	0
	LIF 4
	MESOUT
	MCRLF
	JMP 4		/LEAVE
/END CRLF.
/END TYPO.
	 
	 
