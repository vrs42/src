	LIF 4
	MESOUT
	M11		/MSRD DEAD SPACES
	LDF 5
	LDA
	2\DEADN
	COM
	STC 10		/CNTR
	SET I 16
	2000		/PNTR
	LDF 11
BKD,	LOAD
	4\16
	SETWRD
	1044
	OUTPUT
	MDED
	LIF 4
	MESOUT
	MDED
	XSK I 10
	 JMP BKD
	LIF 5
TYPOX,	0		/LEAVE TYPO
MDED,	
MTYP,	00
	00
	00
	00
MCRLF,	4543
	 
PNTRS,	M4		/BODY WEIGHT
	2\FPKG
	1043
	 
	M5		/RECTAL TEMP
	2\FPRTMP
	1043
	 
	M6		/AMBIENT TEMP
	2\FPATMP
	1043
	 
	M7		/REL HUMIDITY
	2\FPHUM
	1043
	 
	M8		/KBD AMB N2
	2\FPAN2E
	1043
	 
	M9		/KBD DEAD SPACE
	2\FPDSE
	1044
	 
	M10		/AMBIENT N2 MEASURED
	2\FPAN2
	1043
	 
	M13		/FRC
	2\FPFRC
	1043
	 
	M14		/CORRECTED FRC
	2\FPCFRC
	1043
	 
	M15		/FRC\KG
	2\FRCKG
	1044
	 
	M16		/DURATION
	2\FPDUR
	1042
	 
