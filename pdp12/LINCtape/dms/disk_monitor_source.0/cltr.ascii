/CHECK PRINTER FLAG
/
PRINT,	TSF TCF		/CHECK AND CLEAR PRINTER FLAG
	JMP	CLTR	/NOT SET, CHECK COULTER S
/
/PRINTER FLAG WAS SET
/
	ISZ	PRFLG	/IS PRINT FLAG SET
	JMP 	BDONEB2	/NO
	TAD I	CHAR	/GET A CHARACTER
	TPC		/PRINT IT
	TAD	(-212	/SUBTRACT LINE FEED
