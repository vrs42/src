os8_info(FILE *in, char *tofn, int start, int len, char *to, char *infn) {
  UINT16 awData[OS8_BLOCK_SIZE];  UINT8 abData[OS8_BYTE_BLOCK_SIZE];
  int cntr;

      OS8BlockToBytes(awData, abData);

   mime_header("text/html");
   printf("<!doctype html public \"-//w3c//dtd html 4.0 transitional//en\"> <html> <head> <title>Information on file %s</title> <meta http-equiv=\"Content-Type\" content=\"text/html; charset=iso-8859-1\"> </head> <body>\n",tofn);
   printf("<center>Information on file %s</center><br>\n",tofn);

   ReadOS8Block(start, awData);
   if ((awData[0] >= (07777 - 32)) && (awData[1] & 07707) == 06203) {
      int num_segs = (awData[0] ^ 07777) + 1;
      int pages = 0;

      printf("This file is an OS/8 executable save file.<br>\n");
      printf("Start Address %04o in field %d.<br>\n", awData[2], 
          ((awData[1] >> 3) & 07));
      printf("Memory blocks used:<br>\n");
    
      for (cntr = 0; cntr < num_segs; cntr++) {
         int start = awData[4+cntr*2] + ((awData[5+cntr*2] >> 3) & 07);
         pages += awData[5+cntr*2];
         printf("%5o-%5o",start, start + (awData[5+cntr*2] * 128));
      }
      if (pages != len * 2) {
         printf("File size does not match header, size %d 256 word pages, header %d",len * 2, pages);
      }
   }
   printf("<br>\n");
   printf("<a href='os8_html/%s?act=file&fn=%s&blk=%d,%d&to=os8_sv'>Convert to OS/8 SV format</a> in 8 bit <a href='/pip_image.shtml'>PIP image</a> format.<br>\n",
      tofn, infn, start, len);
   printf("<a href='os8_html/%s?act=file&fn=%s&blk=%d,%d&to=bin'>Convert to BIN loader format</a><br>\n", 
      tofn, infn, start, len);

   include_file("footer.shtml");
   html_end();
}

