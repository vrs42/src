  80                                   / FROM UNIT 1
  81                                   /
  82 000252  7300          CLA CLL
  83 000253  1172          TAD [0-16.  / HNKCNT = -16.
  84 000254  3073          DCA HNKCNT
  85 000255  3074          DCA HNKMEM  / HNKMEM = 0
