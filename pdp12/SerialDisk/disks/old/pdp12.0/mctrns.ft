C	SUBROUTINE FOR TRANSLATING PULMAONARY
C	FUNCTION DATA STORED IN 730(10) BLOCK FILES GENERATED
C	BY SAMP3.PA & FILPAK.FT
	SUBROUTINE TRANS
	INTEGER BLNO,ARRAY
	COMMON ARRAY(411),DUMI(90),MANU,BLNO
C	COMMON BLOCK SET THIS WAY BECAUSE OF EQUIVALENCE PROBLEMS
C	WITH MCFOVC.FT. MAY WISH TO ALTER IF MCFOVC IS.
	DEFINE FILE 5(730,85,U,IREC)
	IREC=MANU*16+BLNO
	READ(5'IREC)(DUMI(I),I=1,85)
   	CALL PFTRNS
	RETURN
	END
